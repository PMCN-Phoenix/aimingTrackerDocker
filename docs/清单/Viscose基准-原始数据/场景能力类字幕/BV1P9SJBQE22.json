  {
   "from": 196.53,
   "to": 199.25,
   "content": "♪ 你能拥吗 ♪"
  },
  {
   "from": 200.14,
   "to": 204.3,
   "content": "♪ 别说都太高深 ♪"
  },
  {
   "from": 204.78,
   "to": 207.26,
   "content": "♪ 能自愿变相亲 ♪"
  },
  {
   "from": 208.42,
   "to": 210.96,
   "content": "♪ 旧决心越中坚 ♪"
  },
  {
   "from": 210.96,
   "to": 213.12,
   "content": "♪ 我越勇敢 ♪"
  },
  {
   "from": 213.6,
   "to": 215.78,
   "content": "♪ 宁愿天去收 ♪"
  },
  {
   "from": 215.78,
   "to": 220.29,
