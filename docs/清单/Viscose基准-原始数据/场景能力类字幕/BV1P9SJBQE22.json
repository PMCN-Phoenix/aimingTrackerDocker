  {
   "from": 111.49,
   "to": 113.49,
   "content": "你无处可逃"
  },
  {
   "from": 114.21,
   "to": 117.76,
   "content": "♪ 若你我可抱着谁 ♪"
  },
  {
   "from": 117.76,
   "to": 120.1,
   "content": "♪ 连命也甘心 ♪"
  },
  {
   "from": 120.1,
   "to": 121.34,
   "content": "♪ 短几岁 ♪"
  },
  {
   "from": 121.34,
   "to": 127.56,
   "content": "♪ 谁能给我将姓名也别出口 ♪"
  },
  {
   "from": 128.54,
   "to": 132.7,
   "content": "♪ 若如你可有罪 ♪"
  },
  {
   "from": 133.18,
   "to": 135.66,
   "content": "♪ 全是伦理不对 ♪"
  },
  {
   "from": 136.74,
   "to": 141.48,
   "content": "♪ 我要追离弃世界亦要追 ♪"
  },
  {
   "from": 141.96,
   "to": 144.16,
   "content": "♪ 宁愿天去收 ♪"
  },
  {
   "from": 144.16,
   "to": 148.66,
   "content": "♪ 我也替你受重伤 ♪"
  },
  {
   "from": 149.1,
   "to": 152.42,
   "content": "♪ 今刚跟你女恋上 ♪"
  },
  {
   "from": 152.42,
   "to": 154.82,
   "content": "♪ 也是个传奇 ♪"
  },
  {
   "from": 154.82,
   "to": 158.38,
   "content": "♪ 过生纵是遗憾 ♪"
  },
  {
   "from": 158.38,
   "to": 164.6,
   "content": "♪ 收藏都必须跟你命都明处 ♪"
  },
  {
   "from": 165.2,
   "to": 167.64,
   "content": "♪ 只胆不怕赏一刻 ♪"
  },
  {
   "from": 167.64,
   "to": 173.94,
   "content": "♪ 却想踏沾音赏欣赏你忧伤 ♪"
  },
  {
   "from": 185.86,
   "to": 193.21,
   "content": "♪ 就算你嘴有别人无碍我争取梦中人 ♪"
  },
  {
   "from": 193.21,
   "to": 196.53,
   "content": "♪ 无要直想高度共 ♪"
