  },
  {
   "from": 220.73,
   "to": 224.07,
   "content": "♪ 刚刚跟你女恋上 ♪"
  },
  {
   "from": 224.07,
   "to": 227.87,
   "content": "♪ 也是个准期狂心 ♪"
  },
  {
   "from": 228.39,
   "to": 230.01,
   "content": "♪ 纵是遗憾 ♪"
  },
  {
   "from": 230.01,
   "to": 236.25,
   "content": "♪ 收着都必须跟你凝都凝唱 ♪"
  },
  {
   "from": 236.85,
   "to": 240.29,
   "content": "♪ 只胆不怕想一刻刻想踏 ♪"
  },
  {
   "from": 240.29,
   "to": 241.29,
   "content": "♪ 渐因伤 ♪"
  },
  {
   "from": 242.89,
   "to": 245.36,
   "content": "♪ 因想你忧伤 ♪"
  },
  {
   "from": 245.8,
   "to": 250.28,
