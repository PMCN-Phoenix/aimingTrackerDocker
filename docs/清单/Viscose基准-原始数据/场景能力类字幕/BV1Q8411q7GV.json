{
 "bvid": "BV1Q8411q7GV",
 "title": "热身≠练枪。如何进行有效的赛前热身。【无畏契约/valorant】",
 "owner": "恶魔林一",
 "duration": 122,
 "lan": "ai-zh",
 "segments": 73,
 "body": [
  {
   "from": 0.0,
   "to": 0.3,
   "content": "大家好"
  },
  {
   "from": 0.3,
   "to": 1.14,
   "content": "我是JDM"
  },
  {
   "from": 1.14,
   "to": 4.09,
   "content": "林一玩PS游戏如何快速热身进入状态"
  },
  {
   "from": 4.09,
   "to": 6.55,
   "content": "其实很多人把热身和练枪混为一谈了"
  },
  {
   "from": 6.55,
   "to": 8.38,
   "content": "热身是快速激活自己的状态"
  },
  {
   "from": 8.38,
   "to": 9.64,
   "content": "让自己手感发热"
  },
  {
   "from": 9.64,
   "to": 10.42,
   "content": "反应变快"
  },
  {
   "from": 10.42,
   "to": 12.52,
   "content": "而练枪只是通过不断的重复定位"
  },
  {
   "from": 12.52,
   "to": 13.44,
   "content": "形成肌肉记忆"
  },
  {
   "from": 13.44,
   "to": 16.11,
   "content": "那我们要怎么样快速让自己进入游戏状态呢"
  },
  {
   "from": 16.11,
   "to": 18.18,
   "content": "我这里推荐四个快速热身的项目"
  },
  {
   "from": 18.18,
   "to": 19.32,
   "content": "热身和练枪不同"
  },
  {
   "from": 19.32,
   "to": 22.3,
   "content": "所以我们不用拿数位选择自己实战使用的枪械"
  },
  {
   "from": 22.3,
   "to": 24.16,
   "content": "就好比如狂徒或者幻影"
  },
  {
   "from": 24.16,
   "to": 26.18,
   "content": "但请不要拿奥丁进行热身"
  },
  {
   "from": 26.18,
   "to": 28.46,
   "content": "第一个训练有M的可以打开M"
  },
  {
   "from": 28.46,
   "to": 29.24,
   "content": "没有这个软件"
  },
  {
   "from": 29.24,
   "to": 30.14,
   "content": "也有别的打法"
  },
  {
   "from": 30.14,
   "to": 32.24,
   "content": "打开M以后打一下网格射击"
  },
  {
   "from": 32.24,
   "to": 33.74,
   "content": "这个项目热身效果特别好"
  },
  {
   "from": 33.74,
   "to": 35.12,
   "content": "而且可以直观的表现出来"
  },
  {
   "from": 35.12,
   "to": 36.22,
   "content": "你现在状态好不好"
  },
  {
   "from": 36.22,
   "to": 37.42,
   "content": "7月份以上算及格"
  },
  {
   "from": 37.42,
   "to": 38.5,
   "content": "10万分算优秀"
  },
  {
   "from": 38.5,
   "to": 39.67,
   "content": "但如果没有这个软件"
  },
  {
   "from": 39.67,
   "to": 41.08,
   "content": "在游戏中也是可以训练的"
  },
  {
   "from": 41.08,
   "to": 42.1,
   "content": "我们来到训练场"
  },
  {
   "from": 42.1,
   "to": 43.21,
   "content": "点击下方训练"
  },
  {
   "from": 43.21,
   "to": 44.38,
   "content": "然后站在台子上"
  },
  {
   "from": 44.38,
   "to": 46.52,
   "content": "用地上的竖线区分左右两边"
  },
  {
   "from": 46.52,
   "to": 47.39,
   "content": "先打左边"
  },
  {
   "from": 47.39,
   "to": 48.62,
   "content": "把电脑人全部打到"
  },
  {
   "from": 48.62,
   "to": 49.58,
   "content": "刷新到右边去"
  },
  {
   "from": 49.58,
   "to": 50.36,
   "content": "再去打右边"
  },
  {
   "from": 50.36,
   "to": 52.76,
   "content": "就这样重复也能达到热身的效果"
  },
  {
   "from": 52.76,
   "to": 54.52,
   "content": "但要注意尽量全是一枪头"
  },
  {
   "from": 54.52,
   "to": 55.72,
   "content": "不要做多余的动作"
  },
  {
   "from": 55.72,
   "to": 56.56,
   "content": "而且尽量快"
  },
  {
   "from": 56.56,
   "to": 58.42,
   "content": "第二个训练只需要后退一步"
  },
  {
   "from": 58.42,
   "to": 59.38,
   "content": "来到台子下面"
  },
  {
   "from": 59.38,
   "to": 60.76,
   "content": "我们持续进行移动"
  },
  {
   "from": 60.76,
   "to": 61.66,
   "content": "急停射击"
  },
  {
   "from": 61.66,
   "to": 63.88,
   "content": "让我们快速找到移动和瞄准的感觉"
  },
  {
   "from": 63.88,
   "to": 64.72,
   "content": "第三个训练"
  },
  {
   "from": 64.72,
   "to": 65.56,
   "content": "选个保安"
  },
  {
   "from": 65.56,
   "to": 66.46,
   "content": "就是玩摄像头"
  },
  {
   "from": 66.46,
   "to": 68.23,
   "content": "那个白帽子来到这个位置"
  },
  {
   "from": 68.23,
   "to": 70.66,
   "content": "拿出C技能半线"
  },
  {
   "from": 72.7,
   "to": 74.76,
   "content": "然后找到瞄准我们头部的位置"
  },
  {
   "from": 74.76,
   "to": 75.33,
   "content": "放半线"
  },
  {
   "from": 75.33,
   "to": 78.62,
   "content": "这也就是敌人的头像换成一个交叉的十字"
  },
  {
   "from": 84.3,
   "to": 86.33,
   "content": "然后我们瞄准第一个起始点"
  },
  {
   "from": 86.33,
   "to": 89.12,
   "content": "再去瞄准左边或者右边90度的点"
  },
  {
   "from": 89.12,
   "to": 91.34,
   "content": "然后再去瞄准身后180度的点"
  },
  {
   "from": 91.34,
   "to": 92.87,
   "content": "一个点一个点的慢慢瞄"
  },
  {
   "from": 92.87,
   "to": 95.48,
   "content": "打游戏之前这样训练几分钟会很有用"
  },
  {
   "from": 95.48,
   "to": 97.94,
   "content": "对我们在队列中的爆头率会有很大提升"
  },
  {
   "from": 97.94,
   "to": 100.16,
   "content": "最后一个训练开一把无声死斗"
  },
  {
   "from": 100.16,
   "to": 101.0,
   "content": "无声死斗"
  },
  {
   "from": 101.0,
   "to": 101.54,
   "content": "顾名思义"
  },
  {
   "from": 101.54,
   "to": 102.96,
   "content": "就会把声音全部关掉"
  },
  {
   "from": 102.96,
   "to": 105.06,
   "content": "让我们每次对枪都属于反应对枪"
  },
  {
   "from": 105.06,
   "to": 107.12,
   "content": "从而快速激活我们的反应速度"
  },
  {
   "from": 107.12,
   "to": 109.34,
   "content": "这也是很多职业选手以及高分论文"
  },
  {
   "from": 109.34,
   "to": 110.72,
   "content": "经常用的一个热身方式"
  },
  {
   "from": 110.72,
   "to": 112.04,
   "content": "那本期视频就到这里结束了"
  },
  {
   "from": 112.04,
   "to": 112.82,
   "content": "如果对你有帮助的话"
  },
  {
   "from": 112.82,
   "to": 113.5,
   "content": "可以可以给我留个赞"
  },
  {
   "from": 113.5,
   "to": 114.1,
   "content": "点个关注"
  },
  {
   "from": 114.1,
