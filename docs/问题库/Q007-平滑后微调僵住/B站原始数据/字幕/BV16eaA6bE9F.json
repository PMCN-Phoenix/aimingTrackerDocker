      "to": 6.36,
      "sid": 3,
      "location": 2,
      "content": "拉枪也是无畏学中非常重要的基本功",
      "music": 0.0
    },
    {
      "from": 6.36,
      "to": 7.9,
      "sid": 4,
      "location": 2,
      "content": "这节课也要好好听啊",
      "music": 0.0
    },
    {
      "from": 7.9,
      "to": 9.12,
      "sid": 5,
      "location": 2,
      "content": "假设这样一个场景",
      "music": 0.0
    },
    {
      "from": 9.12,
      "to": 9.78,
      "sid": 6,
      "location": 2,
      "content": "架枪时啊",
      "music": 0.0
    },
    {
      "from": 9.78,
      "to": 11.1,
      "sid": 7,
      "location": 2,
      "content": "余光看到敌人拉出",
      "music": 0.0
    },
    {
      "from": 11.1,
      "to": 13.02,
      "sid": 8,
      "location": 2,
      "content": "我们可能会做出拉回掩体预瞄",
      "music": 0.0
    },
    {
      "from": 13.02,
      "to": 14.82,
      "sid": 9,
      "location": 2,
      "content": "拉出同向移动补偿等操作",
      "music": 0.0
    },
    {
      "from": 14.82,
      "to": 16.92,
      "sid": 10,
      "location": 2,
      "content": "在移动中衔接拉枪完成回调",
      "music": 0.0
    },
    {
      "from": 16.92,
      "to": 18.21,
      "sid": 11,
      "location": 2,
      "content": "最终爆头击杀",
      "music": 0.0
    },
    {
      "from": 18.21,
      "to": 19.29,
      "sid": 12,
      "location": 2,
      "content": "在这一过程中啊",
      "music": 0.0
    },
    {
      "from": 19.29,
      "to": 20.67,
      "sid": 13,
      "location": 2,
      "content": "抛开左手移动操作",
      "music": 0.0
    },
    {
      "from": 20.67,
      "to": 21.95,
      "sid": 14,
      "location": 2,
      "content": "右手控制鼠标",
      "music": 0.0
    },
    {
      "from": 21.95,
      "to": 24.05,
      "sid": 15,
      "location": 2,
      "content": "将准星移至目标附近的这个部分",
      "music": 0.0
    },
    {
      "from": 24.05,
      "to": 25.23,
      "sid": 16,
      "location": 2,
      "content": "就是拉枪哎",
      "music": 0.0
    },
    {
      "from": 25.23,
      "to": 26.67,
      "sid": 17,
      "location": 2,
      "content": "如果拉枪的基本功不扎实啊",
      "music": 0.0
    },
    {
      "from": 26.67,
      "to": 27.71,
      "sid": 18,
      "location": 2,
      "content": "容易出现拉过头",
      "music": 0.0
    },
    {
      "from": 27.71,
      "to": 28.43,
      "sid": 19,
      "location": 2,
      "content": "拉太近",
      "music": 0.0
    },
    {
      "from": 28.43,
      "to": 29.83,
      "sid": 20,
      "location": 2,
      "content": "动作不干脆等问题",
      "music": 0.0
    },
    {
      "from": 29.83,
      "to": 30.67,
      "sid": 21,
      "location": 2,
      "content": "影响微调",
      "music": 0.0
    },
    {
      "from": 30.67,
      "to": 31.9,
      "sid": 22,
      "location": 2,
      "content": "最终导致马枪",
      "music": 0.0
    },
    {
      "from": 31.9,
      "to": 32.86,
      "sid": 23,
      "location": 2,
      "content": "但需要意识到",
      "music": 0.0
    },
    {
      "from": 32.86,
      "to": 35.46,
      "sid": 24,
      "location": 2,
      "content": "这类转火场景在实战中其实并不频繁",
      "music": 0.07031249725341791
    },
    {
      "from": 35.46,
      "to": 38.35,
      "sid": 25,
      "location": 2,
      "content": "训练拉枪并非只是为了应对这一种情况",
      "music": 0.0
    },
    {
      "from": 38.35,
      "to": 40.51,
      "sid": 26,
      "location": 2,
      "content": "拉枪贯穿于游戏中的各类操作",
      "music": 0.0
    },
    {
      "from": 40.51,
      "to": 43.38,
      "sid": 27,
      "location": 2,
      "content": "准星摆放啊",
      "music": 0.0
    },
    {
      "from": 44.3,
      "to": 45.06,
      "sid": 28,
      "location": 2,
      "content": "喷火",
      "music": 0.0
    },
    {
      "from": 47.54,
      "to": 48.7,
      "sid": 29,
      "location": 2,
      "content": "预瞄",
      "music": 0.0
    },
    {
      "from": 50.66,
      "to": 52.42,
      "sid": 30,
      "location": 2,
      "content": "背闪等都是它的体现",
      "music": 0.0
    },
    {
      "from": 52.42,
      "to": 54.14,
      "sid": 31,
      "location": 2,
      "content": "和拉枪类似的核心基本功",
      "music": 0.0
    },
    {
      "from": 54.14,
      "to": 55.49,
      "sid": 32,
      "location": 2,
      "content": "比如上期讲到的微调",
      "music": 0.0
    },
    {
      "from": 55.49,
      "to": 56.61,
      "sid": 33,
      "location": 2,
      "content": "后面的复位等",
      "music": 0.0
    },
    {
      "from": 56.61,
      "to": 58.49,
      "sid": 34,
      "location": 2,
      "content": "同样广泛存在于实战操作中",
      "music": 0.0
    },
    {
      "from": 58.49,
      "to": 59.87,
      "sid": 35,
      "location": 2,
      "content": "并遵循木桶效应",
      "music": 0.0
    },
    {
      "from": 59.87,
      "to": 61.33,
      "sid": 36,
      "location": 2,
      "content": "即便你的微调天赋不错",
      "music": 0.0
    },
    {
      "from": 61.33,
      "to": 63.25,
      "sid": 37,
      "location": 2,
      "content": "导致你频频马枪的可能是拉枪",
      "music": 0.0
    },
    {
      "from": 63.25,
      "to": 64.629,
      "sid": 38,
      "location": 2,
      "content": "这里出了问题啊",
      "music": 0.0
    },
    {
      "from": 65.029,
      "to": 66.789,
      "sid": 39,
      "location": 2,
      "content": "拉枪的操作本身并不复杂",
      "music": 0.0
    },
    {
      "from": 66.789,
      "to": 69.069,
      "sid": 40,
      "location": 2,
      "content": "控制鼠标将准星移至目标区域",
      "music": 0.0
    },
    {
      "from": 69.069,
      "to": 71.1,
      "sid": 41,
      "location": 2,
      "content": "真正的区别在于拉枪的质量",
      "music": 0.0
    },
    {
      "from": 71.1,
      "to": 73.289,
      "sid": 42,
      "location": 2,
      "content": "高质量的拉枪体现在两个层面",
      "music": 0.0
    },
    {
      "from": 73.289,
      "to": 74.369,
      "sid": 43,
      "location": 2,
      "content": "一是拉枪过程",
      "music": 0.0
    },
    {
      "from": 74.369,
      "to": 76.429,
      "sid": 44,
      "location": 2,
      "content": "准星移动是否快准稳",
      "music": 0.0
    },
    {
      "from": 76.429,
      "to": 78.789,
      "sid": 45,
      "location": 2,
      "content": "直接决定视角的流畅度和操作上限",
      "music": 0.0
    },
    {
      "from": 78.789,
      "to": 80.629,
      "sid": 46,
      "location": 2,
      "content": "二是准星制动和微调状态",
      "music": 0.0
    },
    {
      "from": 80.629,
      "to": 82.645,
      "sid": 47,
      "location": 2,
      "content": "这一点更为关键了",
      "music": 0.0
    },
    {
      "from": 83.05,
      "to": 84.87,
      "sid": 48,
      "location": 2,
      "content": "假设你刚完成一次转火拉枪",
      "music": 0.0
    },
    {
      "from": 84.87,
      "to": 87.05,
      "sid": 49,
      "location": 2,
      "content": "但拉枪结束时右手僵硬紧绷",
      "music": 0.0
    },
    {
      "from": 87.05,
      "to": 88.77,
      "sid": 50,
      "location": 2,
      "content": "那后续的微调不仅会失准",
      "music": 0.0
    },
    {
      "from": 88.77,
      "to": 90.919,
      "sid": 51,
      "location": 2,
      "content": "连操作本身都是一种折磨",
      "music": 0.0
    },
    {
      "from": 90.919,
      "to": 92.939,
      "sid": 52,
      "location": 2,
      "content": "所以我们明确了一个大方向",
      "music": 0.0
    },
    {
      "from": 92.939,
      "to": 94.46,
      "sid": 53,
      "location": 2,
      "content": "游戏里的绝大多数操作",
      "music": 0.0
    },
    {
      "from": 94.46,
      "to": 96.86,
      "sid": 54,
      "location": 2,
      "content": "最终都是为了微调击杀去服务的",
      "music": 0.0
    },
    {
      "from": 96.86,
      "to": 100.22,
      "sid": 55,
      "location": 2,
      "content": "任何操作结束时都要尽可能让手腕手指舒适",
      "music": 0.0
    },
    {
      "from": 100.22,
      "to": 102.24,
      "sid": 56,
      "location": 2,
      "content": "以保证微调的精度和速度",
      "music": 0.0
    },
    {
      "from": 102.24,
      "to": 104.7,
      "sid": 57,
      "location": 2,
      "content": "唉那么是不是大范围主要靠手臂",
      "music": 0.0
    },
    {
      "from": 104.7,
      "to": 106.38,
      "sid": 58,
      "location": 2,
      "content": "小范围靠手腕瞄准就行了",
      "music": 0.0
    },
    {
      "from": 106.38,
      "to": 107.52,
      "sid": 59,
      "location": 2,
      "content": "唉这个想法很好",
      "music": 0.0
    },
    {
      "from": 107.52,
      "to": 108.789,
      "sid": 60,
      "location": 2,
      "content": "但容易掉进一个陷阱",
      "music": 0.0
    },
    {
      "from": 108.789,
      "to": 110.369,
      "sid": 61,
      "location": 2,
      "content": "把瞄准拆成两部",
      "music": 0.0
    },
    {
      "from": 110.369,
      "to": 111.729,
      "sid": 62,
      "location": 2,
      "content": "产生了切换成本",
      "music": 0.0
    },
    {
      "from": 111.729,
      "to": 112.949,
      "sid": 63,
      "location": 2,
      "content": "拖慢了反应速度",
      "music": 0.0
    },
    {
      "from": 112.949,
      "to": 114.07,
      "sid": 64,
      "location": 2,
      "content": "唉所以重点来了",
      "music": 0.0
    },
    {
      "from": 114.07,
      "to": 115.67,
      "sid": 65,
      "location": 2,
      "content": "我们要将身体的整个右侧",
      "music": 0.0
    },
    {
      "from": 115.67,
      "to": 117.45,
      "sid": 66,
      "location": 2,
      "content": "当成一个整体进行移动",
      "music": 0.0
    },
    {
      "from": 117.45,
      "to": 118.27,
      "sid": 67,
      "location": 2,
      "content": "诶没听懂",
      "music": 0.0
    },
    {
      "from": 118.27,
      "to": 118.87,
      "sid": 68,
      "location": 2,
      "content": "别着急",
      "music": 0.0
    },
    {
      "from": 118.87,
      "to": 120.25,
      "sid": 69,
      "location": 2,
      "content": "再跟我感受一下",
      "music": 0.0
    },
    {
      "from": 120.25,
      "to": 121.15,
      "sid": 70,
      "location": 2,
      "content": "松开鼠标",
      "music": 0.0
    },
    {
      "from": 121.15,
      "to": 123.25,
      "sid": 71,
      "location": 2,
      "content": "把食指当做咱们的鼠标传感器",
      "music": 0.0
    },
    {
      "from": 123.25,
      "to": 124.55,
      "sid": 72,
      "location": 2,
      "content": "在桌面上画条直线",
      "music": 0.0
    },
    {
      "from": 124.55,
      "to": 127.73,
      "sid": 73,
      "location": 2,
      "content": "你会发现整条手臂都跟着食指这个基准点",
      "music": 0.0
    },
    {
      "from": 127.73,
      "to": 129.09,
      "sid": 74,
      "location": 2,
      "content": "自然流畅的移动",
      "music": 0.0
    },
    {
      "from": 129.09,
      "to": 130.77,
      "sid": 75,
      "location": 2,
      "content": "画完直线接着写字",
      "music": 0.0
    },
    {
      "from": 130.77,
      "to": 132.69,
      "sid": 76,
      "location": 2,
      "content": "画圈同样灵活舒适",
      "music": 0.0
    },
    {
      "from": 132.69,
      "to": 135.59,
      "sid": 77,
      "location": 2,
      "content": "并没有拆分成划线和写字两个步骤",
      "music": 0.0
    },
    {
      "from": 135.59,
      "to": 137.2,
      "sid": 78,
      "location": 2,
      "content": "而是一个流畅的整体",
      "music": 0.0
    },
    {
      "from": 137.2,
      "to": 138.46,
      "sid": 79,
      "location": 2,
      "content": "并且在这一过程中啊",
      "music": 0.0
    },
    {
      "from": 138.46,
      "to": 140.68,
      "sid": 80,
      "location": 2,
      "content": "无论是划线还是写字阶段",
      "music": 0.0
    },
    {
      "from": 140.68,
      "to": 142.73,
      "sid": 81,
      "location": 2,
      "content": "整个右侧都没有僵硬感",
      "music": 0.0
    },
    {
      "from": 142.73,
      "to": 144.19,
      "sid": 82,
      "location": 2,
      "content": "现在握住鼠标",
      "music": 0.0
    },
    {
      "from": 144.19,
      "to": 146.35,
      "sid": 83,
      "location": 2,
      "content": "将注意力放在鼠标的传感器上",
      "music": 0.0
    },
    {
      "from": 146.35,
      "to": 147.75,
      "sid": 84,
      "location": 2,
      "content": "回想刚才那个感觉",
      "music": 0.0
    },
    {
      "from": 147.75,
      "to": 148.82,
      "sid": 85,
      "location": 2,
      "content": "复现一次",
      "music": 0.0
    },
    {
      "from": 148.82,
      "to": 151.18,
      "sid": 86,
      "location": 2,
      "content": "你大概率就能找到整体协同的感觉了",
      "music": 0.0
    },
    {
      "from": 152.18,
      "to": 153.08,
      "sid": 87,
      "location": 2,
      "content": "我解释一下",
      "music": 0.0
    },
    {
      "from": 153.08,
      "to": 154.78,
      "sid": 88,
      "location": 2,
      "content": "在我们私教课程中的第一节课",
      "music": 0.0
    },
    {
      "from": 154.78,
      "to": 156.44,
      "sid": 89,
      "location": 2,
      "content": "会讲到一个火车模型",
      "music": 0.0
    },
    {
      "from": 156.44,
      "to": 158.12,
      "sid": 90,
      "location": 2,
      "content": "我在这里简单跟大家说一下",
      "music": 0.0
    },
    {
      "from": 158.12,
      "to": 161.36,
      "sid": 91,
      "location": 2,
      "content": "帮助同学们理解并更好地感受到整体协同啊",
      "music": 0.0
    },
    {
      "from": 161.36,
      "to": 164.73,
      "sid": 92,
      "location": 2,
      "content": "我们空数时将我们整个右侧当成一列火车",
      "music": 0.0
    },
    {
      "from": 164.73,
      "to": 166.49,
      "sid": 93,
      "location": 2,
      "content": "我们的鼠标呢就是火车头",
      "music": 0.0
    },
    {
      "from": 166.49,
      "to": 169.35,
      "sid": 94,
      "location": 2,
      "content": "而我们的鼠标传感器就是火车头里的驾驶员",
      "music": 0.0
    },
    {
      "from": 169.35,
      "to": 172.73,
      "sid": 95,
      "location": 2,
      "content": "我们只管根据驾驶员的意愿去控制火车头移动",
      "music": 0.0
    },
    {
      "from": 172.73,
      "to": 176.09,
      "sid": 96,
      "location": 2,
      "content": "整列火车会自然地跟随火车头的移动而移动",
      "music": 0.0
    },
    {
      "from": 176.09,
      "to": 178.17,
      "sid": 97,
      "location": 2,
      "content": "自然整个右侧就会很灵活了",
      "music": 0.0
    },
    {
      "from": 178.17,
      "to": 179.43,
      "sid": 98,
      "location": 2,
      "content": "也不会有僵硬感",
      "music": 0.0
    },
    {
      "from": 179.43,
      "to": 180.71,
      "sid": 99,
      "location": 2,
      "content": "在大幅度拉枪时",
      "music": 0.0
    },
    {
      "from": 180.71,
      "to": 182.05,
      "sid": 100,
      "location": 2,
      "content": "我们并不用去考虑啊",
      "music": 0.0
    },
    {
      "from": 182.05,
      "to": 184.23,
      "sid": 101,
      "location": 2,
      "content": "是先动手腕还是先动手臂",
      "music": 0.0
    },
    {
      "from": 184.23,
      "to": 186.31,
      "sid": 102,
      "location": 2,
      "content": "分别动多少等等这些问题",
      "music": 0.0
    },
    {
      "from": 186.31,
      "to": 187.73,
      "sid": 103,
      "location": 2,
      "content": "只需要在前期训练时啊",
      "music": 0.0
    },
    {
      "from": 187.73,
      "to": 190.53,
      "sid": 104,
      "location": 2,
      "content": "养成习惯去感受鼠标传感器的移动即可",
      "music": 0.0
    },
    {
      "from": 190.53,
      "to": 191.73,
      "sid": 105,
      "location": 2,
      "content": "比如很多职业选手",
      "music": 0.0
    },
    {
      "from": 191.73,
      "to": 192.53,
      "sid": 106,
      "location": 2,
      "content": "比如Steal啊",
      "music": 0.0
    },
    {
      "from": 192.53,
      "to": 195.86,
      "sid": 107,
      "location": 2,
      "content": "flower sen那种行云流水的大范围拉枪并衔接",
      "music": 0.0
    },
    {
      "from": 195.86,
