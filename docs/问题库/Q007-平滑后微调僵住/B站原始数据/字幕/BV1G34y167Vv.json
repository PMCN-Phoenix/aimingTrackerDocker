{
  "bvid": "BV1G34y167Vv",
  "title": "帮助你提升微调精准度的握姿小技巧",
  "owner": "吃个面包吧O_o",
  "duration": 327,
  "lan": "ai-zh",
  "body": [
    {
      "from": 4.8,
      "to": 6.88,
      "sid": 1,
      "location": 2,
      "content": "大家好，欢迎来到PS教练"
    },
    {
      "from": 6.88,
      "to": 8.34,
      "sid": 2,
      "location": 2,
      "content": "我叫罗恩•兰博•金"
    },
    {
      "from": 8.34,
      "to": 10.34,
      "sid": 3,
      "location": 2,
      "content": "在这个视频中，我要谈谈"
    },
    {
      "from": 10.34,
      "to": 14.15,
      "sid": 4,
      "location": 2,
      "content": "我应该把指尖放在鼠标垫上吗"
    },
    {
      "from": 14.15,
      "to": 17.03,
      "sid": 5,
      "location": 2,
      "content": "我的意思是当你抓住鼠标"
    },
    {
      "from": 17.03,
      "to": 20.13,
      "sid": 6,
      "location": 2,
      "content": "有很多职业游戏玩家喜欢"
    },
    {
      "from": 20.13,
      "to": 22.78,
      "sid": 7,
      "location": 2,
      "content": "只是他们指尖的一点点"
    },
    {
      "from": 22.78,
      "to": 25.04,
      "sid": 8,
      "location": 2,
      "content": "轻轻地抚摸着老鼠"
    },
    {
      "from": 25.04,
      "to": 29.2,
      "sid": 9,
      "location": 2,
      "content": "有些人只喜欢竖起大拇指的小指"
    },
    {
      "from": 29.2,
      "to": 31.01,
      "sid": 10,
      "location": 2,
      "content": "有些人两者都喜欢"
    },
    {
      "from": 31.01,
      "to": 34.55,
      "sid": 11,
      "location": 2,
      "content": "然后玩家用三指握法"
    },
    {
      "from": 34.55,
      "to": 38.39,
      "sid": 12,
      "location": 2,
      "content": "他们喜欢让他们的小指和拇指触摸鼠标垫"
    },
    {
      "from": 38.39,
      "to": 41.55,
      "sid": 13,
      "location": 2,
      "content": "那么这口井的优点是什么呢？"
    },
    {
      "from": 41.55,
      "to": 43.11,
      "sid": 14,
      "location": 2,
      "content": "优点之一就是"
    },
    {
      "from": 43.11,
      "to": 50.12,
      "sid": 15,
      "location": 2,
      "content": "它可以让你在鼠标或鼠标垫上保持均匀的压力"
    },
    {
      "from": 50.12,
      "to": 51.84,
      "sid": 16,
      "location": 2,
      "content": "所以我的意思是"
    },
    {
      "from": 51.84,
      "to": 55.54,
      "sid": 17,
      "location": 2,
      "content": "如果我的拇指和小指碰到鼠标垫"
    },
    {
      "from": 55.54,
      "to": 60.34,
      "sid": 18,
      "location": 2,
      "content": "如果他们都用同样的方式触摸和放牧鼠标垫"
    },
    {
      "from": 60.34,
      "to": 62.48,
      "sid": 19,
      "location": 2,
      "content": "就像等量的下压力"
    },
    {
      "from": 62.48,
      "to": 65.42,
      "sid": 20,
      "location": 2,
      "content": "那你就知道你的抓地力没有不平衡"
    },
    {
      "from": 65.42,
      "to": 66.16,
      "sid": 21,
      "location": 2,
      "content": "例如"
    },
    {
      "from": 66.16,
      "to": 67.4,
      "sid": 22,
      "location": 2,
      "content": "如果我抓住鼠标"
    },
    {
      "from": 67.4,
      "to": 71.52,
      "sid": 23,
      "location": 2,
      "content": "然后我的左手拇指在鼠标垫上按得更重"
    },
    {
      "from": 71.52,
      "to": 73.02,
      "sid": 24,
      "location": 2,
      "content": "与我的右小指相比"
    },
    {
      "from": 73.02,
      "to": 76.62,
      "sid": 25,
      "location": 2,
      "content": "那么你可能会有更多的重量转移靠在那边"
    },
    {
      "from": 76.62,
      "to": 79.39,
      "sid": 26,
      "location": 2,
      "content": "这不一定是坏事"
    },
    {
      "from": 79.39,
      "to": 80.71,
      "sid": 27,
      "location": 2,
      "content": "但对我个人来说"
    },
    {
      "from": 80.71,
      "to": 83.57,
      "sid": 28,
      "location": 2,
      "content": "我确实喜欢让我的小指和拇指碰到垫子"
    },
    {
      "from": 83.57,
      "to": 90.12,
      "sid": 29,
      "location": 2,
      "content": "所以我可以一直抓住我的鼠标的方法是利用放牧的感觉"
    },
    {
      "from": 90.12,
      "to": 94.289,
      "sid": 30,
      "location": 2,
      "content": "知道如果我的小指和拇指都用同样的压力接触"
    },
    {
      "from": 94.289,
      "to": 98.329,
      "sid": 31,
      "location": 2,
      "content": "那么我的鼠标抓地力通常对我来说是一个很好的地方"
    },
    {
      "from": 98.329,
      "to": 102.69,
      "sid": 32,
      "location": 2,
      "content": "我从老板那里听到的另一个好处是挤在一起"
    },
    {
      "from": 102.69,
      "to": 105.11,
      "sid": 33,
      "location": 2,
      "content": "我相信他是Yuki Aim的创始人"
    },
    {
      "from": 105.11,
      "to": 108.31,
      "sid": 34,
      "location": 2,
      "content": "Yuki的目标是一个非常受欢迎的目标社区"
    },
    {
      "from": 108.31,
      "to": 108.87,
      "sid": 35,
      "location": 2,
      "content": "他们有"
    },
    {
      "from": 108.87,
      "to": 111.17,
      "sid": 36,
      "location": 2,
      "content": "你知道一些世界纪录保持者"
    },
    {
      "from": 111.17,
      "to": 115.55,
      "sid": 37,
      "location": 2,
      "content": "我听他在广播里说拥有这些指尖的好处"
    },
    {
      "from": 115.55,
      "to": 117.95,
      "sid": 38,
      "location": 2,
      "content": "你实际上可以把它们作为一种"
    },
    {
      "from": 117.95,
      "to": 124.45,
      "sid": 39,
      "location": 2,
      "content": "比如休息或其他让你锁定在鼠标垫上的东西"
    },
    {
      "from": 124.45,
      "to": 127.51,
      "sid": 40,
      "location": 2,
      "content": "所以我所说的锁在垫子里的意思是"
    },
    {
      "from": 127.51,
      "to": 129.61,
      "sid": 41,
      "location": 2,
      "content": "如果你做这些微小的动作"
    },
    {
      "from": 129.61,
      "to": 133.31,
      "sid": 42,
      "location": 2,
      "content": "所以你必须瞄准很远很远的一个非常非常小的目标"
    },
    {
      "from": 133.31,
      "to": 133.67,
      "sid": 43,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 133.67,
      "to": 136.43,
      "sid": 44,
      "location": 2,
      "content": "你可以把它压进垫子里"
    },
    {
      "from": 136.43,
      "to": 138.91,
      "sid": 45,
      "location": 2,
      "content": "用你的拇指和小指一点点"
    },
    {
      "from": 138.91,
      "to": 142.42,
      "sid": 46,
      "location": 2,
      "content": "它提供了一个小制动系统"
    },
    {
      "from": 142.42,
      "to": 146.3,
      "sid": 47,
      "location": 2,
      "content": "或者让它保持在另一边的地方"
    },
    {
      "from": 146.3,
      "to": 150.15,
      "sid": 48,
      "location": 2,
      "content": "如果我的拇指和小指轻轻地擦着垫子"
    },
    {
      "from": 150.15,
      "to": 151.99,
      "sid": 49,
      "location": 2,
      "content": "好吧，鼠标会更容易移动"
    },
    {
      "from": 151.99,
      "to": 153.33,
      "sid": 50,
      "location": 2,
      "content": "因为摩擦力比较小"
    },
    {
      "from": 153.33,
      "to": 156.87,
      "sid": 51,
      "location": 2,
      "content": "但如果我把多余的压力压下去"
    },
    {
      "from": 156.87,
      "to": 161.31,
      "sid": 52,
      "location": 2,
      "content": "它允许鼠标在这个小微运动区域中移动"
    },
    {
      "from": 161.31,
      "to": 164.85,
      "sid": 53,
      "location": 2,
      "content": "所以它不会像滑倒或滑到某个地方"
    },
    {
      "from": 164.85,
      "to": 166.69,
      "sid": 54,
      "location": 2,
      "content": "因为我找到了突破口"
    },
    {
      "from": 166.69,
      "to": 171.47,
      "sid": 55,
      "location": 2,
      "content": "我也见过职业玩家伸出他们的小指和无名指"
    },
    {
      "from": 171.47,
      "to": 173.95,
      "sid": 56,
      "location": 2,
      "content": "例如，它看起来像这样"
    },
    {
      "from": 173.95,
      "to": 175.89,
      "sid": 57,
      "location": 2,
      "content": "所以这可能有点夸张"
    },
    {
      "from": 175.89,
      "to": 179.31,
      "sid": 58,
      "location": 2,
      "content": "我是说我见过一个职业玩家做这样的事情"
    },
    {
      "from": 179.31,
      "to": 182.15,
      "sid": 59,
      "location": 2,
      "content": "所以它们锁住并伸出小指"
    },
    {
      "from": 182.15,
      "to": 185.44,
      "sid": 60,
      "location": 2,
      "content": "像这样那样的是他们的舒适"
    },
    {
      "from": 185.44,
      "to": 187.6,
      "sid": 61,
      "location": 2,
      "content": "感觉他们喜欢那种感觉对吧"
    },
    {
      "from": 187.619,
      "to": 190.179,
      "sid": 62,
      "location": 2,
      "content": "所以我这里有这支笔"
    },
    {
      "from": 190.179,
      "to": 192.639,
      "sid": 63,
      "location": 2,
      "content": "我想不出更好的类比了"
    },
    {
      "from": 192.639,
      "to": 193.59,
      "sid": 64,
      "location": 2,
      "content": "但你知道"
    },
    {
      "from": 193.59,
      "to": 194.25,
      "sid": 65,
      "location": 2,
      "content": "如果我在写作"
    },
    {
      "from": 194.25,
      "to": 197.23,
      "sid": 66,
      "location": 2,
      "content": "我的手也没有放在鼠标垫上"
    },
    {
      "from": 197.23,
      "to": 198.96,
      "sid": 67,
      "location": 2,
      "content": "看看我这里画得好不好"
    },
    {
      "from": 198.96,
      "to": 199.84,
      "sid": 68,
      "location": 2,
      "content": "没有摩擦"
    },
    {
      "from": 199.84,
      "to": 202.18,
      "sid": 69,
      "location": 2,
      "content": "因为没有手或手指在垫子上摩擦"
    },
    {
      "from": 202.18,
      "to": 204.3,
      "sid": 70,
      "location": 2,
      "content": "所以它给了我这个像浮子一样的东西"
    },
    {
      "from": 204.3,
      "to": 206.6,
      "sid": 71,
      "location": 2,
      "content": "感觉自由滑翔"
    },
    {
      "from": 206.6,
      "to": 209.22,
      "sid": 72,
      "location": 2,
      "content": "而如果我的手放在鼠标垫上"
    },
    {
      "from": 209.22,
      "to": 213.599,
      "sid": 73,
      "location": 2,
      "content": "它增加了一个休息或其他东西，使它保持坚实的位置"
    },
    {
      "from": 213.599,
      "to": 215.859,
      "sid": 74,
      "location": 2,
      "content": "所以现在我可以移动笔"
    },
    {
      "from": 215.859,
      "to": 217.539,
      "sid": 75,
      "location": 2,
      "content": "我知道它不会溜走"
    },
    {
      "from": 217.539,
      "to": 220.66,
      "sid": 76,
      "location": 2,
      "content": "而在这里，它可能会变得有点松散和通风"
    },
    {
      "from": 220.679,
      "to": 223.179,
      "sid": 77,
      "location": 2,
      "content": "所以选票有好处也有坏处"
    },
    {
      "from": 223.179,
      "to": 223.639,
      "sid": 78,
      "location": 2,
      "content": "你知道很明显"
    },
    {
      "from": 223.639,
      "to": 226.24,
      "sid": 79,
      "location": 2,
      "content": "如果我的小指和拇指离开垫子"
    },
    {
      "from": 226.24,
      "to": 228.02,
      "sid": 80,
      "location": 2,
      "content": "我不用担心摩擦"
    },
    {
      "from": 228.02,
      "to": 230.36,
      "sid": 81,
      "location": 2,
      "content": "或者我的手在出汗什么的"
    },
    {
      "from": 230.36,
      "to": 230.92,
      "sid": 82,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 230.92,
      "to": 235.24,
      "sid": 83,
      "location": 2,
      "content": "所以归根结底，这是个人的感觉或个人的偏好"
    },
    {
      "from": 235.24,
      "to": 237.16,
      "sid": 84,
      "location": 2,
      "content": "这取决于你的感觉"
    },
    {
      "from": 237.16,
      "to": 239.48,
      "sid": 85,
      "location": 2,
      "content": "意识到或弄清楚"
    },
    {
      "from": 239.48,
      "to": 239.8,
      "sid": 86,
      "location": 2,
      "content": "你知道的"
    },
    {
      "from": 239.8,
      "to": 243.71,
      "sid": 87,
      "location": 2,
      "content": "有多大的下压力，有多大的摩擦或放牧"
    },
    {
      "from": 243.71,
      "to": 245.29,
      "sid": 88,
      "location": 2,
      "content": "鼠标垫上有"
    },
    {
      "from": 245.29,
      "to": 250.1,
      "sid": 89,
      "location": 2,
      "content": "我最后想说的是有点夸张"
    },
    {
      "from": 250.1,
      "to": 253.71,
      "sid": 90,
      "location": 2,
      "content": "但我知道一个著名的狙击手，他以前也是这样玩的"
    },
    {
      "from": 253.71,
      "to": 255.14,
      "sid": 91,
      "location": 2,
      "content": "他有一些最好的目标"
    },
    {
      "from": 255.22,
      "to": 256.339,
      "sid": 92,
      "location": 2,
      "content": "我不知道"
    },
    {
      "from": 256.339,
      "to": 259.56,
      "sid": 93,
      "location": 2,
      "content": "如果他的五个手指都碰到鼠标垫"
    },
    {
      "from": 259.56,
      "to": 263.06,
      "sid": 94,
      "location": 2,
      "content": "但他确实喜欢把鼠标重叠"
    },
    {
      "from": 263.06,
      "to": 266.02,
      "sid": 95,
      "location": 2,
      "content": "就像这种扭曲和炖菜"
    },
    {
      "from": 266.02,
      "to": 266.76,
      "sid": 96,
      "location": 2,
      "content": "我已经谈过了"
    },
    {
      "from": 266.76,
      "to": 267.14,
      "sid": 97,
      "location": 2,
      "content": "呃"
    },
    {
      "from": 267.14,
      "to": 268.42,
      "sid": 98,
      "location": 2,
      "content": "如果你看我的一个视频"
    },
    {
      "from": 268.42,
      "to": 269.38,
      "sid": 99,
      "location": 2,
      "content": "向上看曲折"
    },
    {
      "from": 269.38,
      "to": 270.159,
      "sid": 100,
      "location": 2,
      "content": "鼠标脚本"
    },
    {
      "from": 270.159,
      "to": 274.089,
      "sid": 101,
      "location": 2,
      "content": "他们有这样的福特手位置"
    },
    {
      "from": 274.089,
      "to": 279.32,
      "sid": 102,
      "location": 2,
      "content": "他们的五个手指都像这样触摸鼠标垫"
    },
    {
      "from": 279.38,
      "to": 282.34,
      "sid": 103,
      "location": 2,
      "content": "所以你知道同样的概念"
    },
    {
      "from": 282.34,
      "to": 285.92,
      "sid": 104,
      "location": 2,
      "content": "如果你有相同数量的放牧或压力"
    },
    {
      "from": 285.94,
      "to": 286.46,
      "sid": 105,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 286.46,
      "to": 289.38,
      "sid": 106,
      "location": 2,
      "content": "你知道鼠标在你手中的大部分时间里都是平衡的"
    },
    {
      "from": 289.38,
      "to": 291.72,
      "sid": 107,
      "location": 2,
      "content": "所以你可以利用这种感觉和这种反馈"
    },
    {
      "from": 291.72,
      "to": 296.51,
      "sid": 108,
      "location": 2,
      "content": "这种摩擦表面的摩擦帮助你移动鼠标"
    },
    {
      "from": 296.51,
      "to": 299.27,
      "sid": 109,
      "location": 2,
      "content": "然后如果你需要快速停止鼠标并打破它"
    },
    {
      "from": 299.27,
      "to": 301.289,
      "sid": 110,
      "location": 2,
      "content": "只是做这些微小的动作"
    },
    {
      "from": 301.289,
      "to": 304.24,
      "sid": 111,
      "location": 2,
      "content": "你可以用那些指尖进入鼠标垫来这样做"
    },
    {
      "from": 304.24,
      "to": 304.6,
      "sid": 112,
      "location": 2,
      "content": "所以是的"
    },
    {
      "from": 304.6,
      "to": 305.46,
      "sid": 113,
      "location": 2,
      "content": "我试试看"
    },
    {
      "from": 305.46,
      "to": 308.36,
      "sid": 114,
      "location": 2,
      "content": "继续尝试不同数量的手指放置"
    },
    {
      "from": 308.36,
      "to": 311.13,
      "sid": 115,
      "location": 2,
      "content": "手指有多少在吃草"
    },
    {
      "from": 311.13,
      "to": 312.59,
      "sid": 116,
      "location": 2,
      "content": "如果只是一点点"
    },
    {
      "from": 312.59,
      "to": 315.02,
      "sid": 117,
      "location": 2,
      "content": "或者是不是有点重"
    },
    {
      "from": 315.02,
      "to": 316.4,
      "sid": 118,
      "location": 2,
      "content": "可能对你有帮助"
    },
    {
      "from": 316.4,
      "to": 318.94,
      "sid": 119,
      "location": 2,
      "content": "感谢观看点赞"
    },
    {
      "from": 318.94,
      "to": 321.2,
      "sid": 120,
      "location": 2,
      "content": "如果有帮助，订阅保持最新"
    }
  ]
}