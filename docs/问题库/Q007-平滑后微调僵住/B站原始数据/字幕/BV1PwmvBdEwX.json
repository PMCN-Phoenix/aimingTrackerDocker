{
  "bvid": "BV1PwmvBdEwX",
  "title": "一个技巧解决你实战时手臂手腕结合僵硬的问题",
  "owner": "bili_62193067145",
  "duration": 58,
  "lan": "ai-zh",
  "body": [
    {
      "from": 0.08,
      "to": 2.88,
      "sid": 1,
      "location": 2,
      "content": "如果你在实战中经常感觉握不稳鼠标",
      "music": 0.0
    },
    {
      "from": 2.88,
      "to": 3.96,
      "sid": 2,
      "location": 2,
      "content": "用力捏鼠标",
      "music": 0.0
    },
    {
      "from": 3.96,
      "to": 5.12,
      "sid": 3,
      "location": 2,
      "content": "导致拉枪不稳",
      "music": 0.0
    },
    {
      "from": 5.12,
      "to": 5.66,
      "sid": 4,
      "location": 2,
      "content": "失瞄",
      "music": 0.0
    },
    {
      "from": 5.66,
      "to": 8.16,
      "sid": 5,
      "location": 2,
      "content": "且感觉手臂手腕的结合异常僵硬",
      "music": 0.0
    },
    {
      "from": 8.16,
      "to": 11.01,
      "sid": 6,
      "location": 2,
      "content": "那么一个技巧可以显著改善这种情况",
      "music": 0.0
    },
    {
      "from": 11.01,
      "to": 11.95,
      "sid": 7,
      "location": 2,
      "content": "那么第一步呢",
      "music": 0.0
    },
    {
      "from": 11.95,
      "to": 14.27,
      "sid": 8,
      "location": 2,
      "content": "先把你的肩膀放下来固定住",
      "music": 0.0
    },
    {
      "from": 14.27,
      "to": 18.64,
      "sid": 9,
      "location": 2,
      "content": "就用你握鼠标的这面肩往下往后沉一下",
      "music": 0.0
    },
    {
      "from": 18.64,
      "to": 20.12,
      "sid": 10,
      "location": 2,
      "content": "贴着你的身体就可以了",
      "music": 0.0
    },
    {
      "from": 20.12,
      "to": 23.32,
      "sid": 11,
      "location": 2,
      "content": "类似你在健身中啊做稳定肩胛骨的训练一样",
      "music": 0.0
    },
    {
      "from": 23.32,
      "to": 25.46,
      "sid": 12,
      "location": 2,
      "content": "很多人一紧张就会抬肩",
      "music": 0.0
    },
    {
      "from": 25.46,
      "to": 26.38,
      "sid": 13,
      "location": 2,
      "content": "你肩一抬",
      "music": 0.0
    },
    {
      "from": 26.38,
      "to": 28.36,
      "sid": 14,
      "location": 2,
      "content": "那你的枪口肯定就会跟着飘",
      "music": 0.0
    },
    {
      "from": 28.36,
      "to": 29.08,
      "sid": 15,
      "location": 2,
      "content": "那第二步",
      "music": 0.0
    },
    {
      "from": 29.08,
      "to": 30.76,
      "sid": 16,
      "location": 2,
      "content": "手臂要自然地放在桌面上",
      "music": 0.0
    },
    {
      "from": 30.76,
      "to": 31.72,
      "sid": 17,
      "location": 2,
      "content": "沉好肩以后",
      "music": 0.0
    },
    {
      "from": 31.72,
      "to": 33.64,
      "sid": 18,
      "location": 2,
      "content": "让整条手臂顺着放下来",
      "music": 0.0
    },
    {
      "from": 33.64,
      "to": 35.09,
      "sid": 19,
      "location": 2,
      "content": "不要紧绷鼠标",
      "music": 0.0
    },
    {
      "from": 35.09,
      "to": 37.31,
      "sid": 20,
      "location": 2,
      "content": "就让手腕带一点点小动作就够了",
      "music": 0.0
    },
    {
      "from": 37.31,
      "to": 38.45,
      "sid": 21,
      "location": 2,
      "content": "如果你越用力",
      "music": 0.0
    },
    {
      "from": 38.45,
      "to": 39.93,
      "sid": 22,
      "location": 2,
      "content": "那么你就越瞄不准",
      "music": 0.0
    },
    {
      "from": 39.93,
      "to": 40.65,
      "sid": 23,
      "location": 2,
      "content": "第三步",
      "music": 0.0
    },
    {
      "from": 40.65,
      "to": 42.31,
      "sid": 24,
      "location": 2,
      "content": "鼠标不要死抓着手指",
      "music": 0.0
    },
    {
      "from": 42.31,
      "to": 43.57,
      "sid": 25,
      "location": 2,
      "content": "自然的放着掌心",
      "music": 0.0
    },
    {
      "from": 43.57,
      "to": 44.33,
      "sid": 26,
      "location": 2,
      "content": "别太用力",
      "music": 0.0
    },
    {
      "from": 44.33,
      "to": 46.05,
      "sid": 27,
      "location": 2,
      "content": "真正让你稳定的不是你的手指",
      "music": 0.0
    },
    {
      "from": 46.05,
      "to": 47.88,
      "sid": 28,
      "location": 2,
      "content": "是你沉肩之后的稳定发力",
      "music": 0.0
    },
    {
      "from": 47.88,
      "to": 48.64,
      "sid": 29,
      "location": 2,
      "content": "简单来说呢",
      "music": 0.0
    },
    {
      "from": 48.64,
      "to": 50.08,
      "sid": 30,
      "location": 2,
      "content": "只要你的肩膀沉住了",
      "music": 0.0
    },
    {
      "from": 50.08,
      "to": 52.04,
      "sid": 31,
      "location": 2,
      "content": "然后找到一个合适的发力方式",
      "music": 0.0
    },
    {
      "from": 52.04,
      "to": 53.38,
      "sid": 32,
      "location": 2,
      "content": "动作就会很稳定",
      "music": 0.0
    },
    {
      "from": 53.38,
      "to": 54.64,
      "sid": 33,
      "location": 2,
      "content": "这里是不做比较",
      "music": 0.0
    },
    {
      "from": 54.64,
      "to": 55.75,
      "sid": 34,
      "location": 2,
      "content": "只做分享的GIN",
      "music": 0.0
    },
    {
      "from": 55.75,
      "to": 56.86,
      "sid": 35,
      "location": 2,
      "content": "我们下期见",
      "music": 0.0
    }
  ]
}