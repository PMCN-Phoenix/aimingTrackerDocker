{
  "bvid": "BV1o87S62Ezw",
  "title": "【死斗复盘】黄金死斗 开枪节奏就是二次调整能力和移动蹲操作结合的东西",
  "owner": "般K驾到",
  "duration": 284,
  "lan": "ai-zh",
  "body": [
    {
      "from": 0.12,
      "to": 0.48,
      "sid": 1,
      "location": 2,
      "content": "大家好",
      "music": 0.0
    },
    {
      "from": 0.48,
      "to": 1.08,
      "sid": 2,
      "location": 2,
      "content": "我是bk",
      "music": 0.0
    },
    {
      "from": 1.08,
      "to": 2.92,
      "sid": 3,
      "location": 2,
      "content": "今天来帮粉丝看一期死斗",
      "music": 0.0
    },
    {
      "from": 2.92,
      "to": 5.08,
      "sid": 4,
      "location": 2,
      "content": "复盘段位是黄金",
      "music": 0.0
    },
    {
      "from": 5.08,
      "to": 7.28,
      "sid": 5,
      "location": 2,
      "content": "我们来看一下他有什么样的问题",
      "music": 0.0
    },
    {
      "from": 7.28,
      "to": 10.4,
      "sid": 6,
      "location": 2,
      "content": "那这个话其实第一个就是说死斗",
      "music": 0.0
    },
    {
      "from": 10.4,
      "to": 13.58,
      "sid": 7,
      "location": 2,
      "content": "他其实是一个比较偏专项的一个练习方法",
      "music": 0.0
    },
    {
      "from": 13.58,
      "to": 14.52,
      "sid": 8,
      "location": 2,
      "content": "就打死斗",
      "music": 0.0
    },
    {
      "from": 14.52,
      "to": 18.13,
      "sid": 9,
      "location": 2,
      "content": "一方面是巩固我们一天的一个对枪手感",
      "music": 0.0
    },
    {
      "from": 18.13,
      "to": 20.69,
      "sid": 10,
      "location": 2,
      "content": "还有对这个游戏的枪械熟悉程度",
      "music": 0.0
    },
    {
      "from": 20.69,
      "to": 21.73,
      "sid": 11,
      "location": 2,
      "content": "因为附件的话",
      "music": 0.0
    },
    {
      "from": 21.73,
      "to": 24.84,
      "sid": 12,
      "location": 2,
      "content": "打死斗和团队死斗都是最好的一种选择",
      "music": 0.0
    },
    {
      "from": 24.84,
      "to": 27.88,
      "sid": 13,
      "location": 2,
      "content": "然后其次的话就是来练习我们的育苗是吧",
      "music": 0.0
    },
    {
      "from": 27.88,
      "to": 30.2,
      "sid": 14,
      "location": 2,
      "content": "巩固一下我们的育苗基础",
      "music": 0.0
    },
    {
      "from": 31.19,
      "to": 34.75,
      "sid": 15,
      "location": 2,
      "content": "然后这里的几个击杀已经初见端倪了啊",
      "music": 0.0
    },
    {
      "from": 34.75,
      "to": 37.81,
      "sid": 16,
      "location": 2,
      "content": "就是说打静态目标应该平时没少练",
      "music": 0.0
    },
    {
      "from": 37.81,
      "to": 39.97,
      "sid": 17,
      "location": 2,
      "content": "静态目标打的都是比较游刃有余",
      "music": 0.0
    },
    {
      "from": 39.97,
      "to": 42.45,
      "sid": 18,
      "location": 2,
      "content": "但一旦对面地速稍微快一点",
      "music": 0.0
    },
    {
      "from": 42.45,
      "to": 45.48,
      "sid": 19,
      "location": 2,
      "content": "或者说摆设摆起来就有点处理不了了",
      "music": 0.0
    },
    {
      "from": 45.48,
      "to": 48.9,
      "sid": 20,
      "location": 2,
      "content": "并且你的这个摆设基基础也有点差",
      "music": 0.0
    },
    {
      "from": 48.9,
      "to": 51.62,
      "sid": 21,
      "location": 2,
      "content": "就你这个摆设一定是空",
      "music": 0.0
    },
    {
      "from": 51.62,
      "to": 53.4,
      "sid": 22,
      "location": 2,
      "content": "第一枪的时候就要开始动了",
      "music": 0.0
    },
    {
      "from": 53.4,
      "to": 55.62,
      "sid": 23,
      "location": 2,
      "content": "就你自己要有一个调整",
      "music": 0.0
    },
    {
      "from": 55.62,
      "to": 56.52,
      "sid": 24,
      "location": 2,
      "content": "就是在死斗里面",
      "music": 0.0
    },
    {
      "from": 56.52,
      "to": 57.78,
      "sid": 25,
      "location": 2,
      "content": "可能说对方诶",
      "music": 0.0
    },
    {
      "from": 57.78,
      "to": 58.62,
      "sid": 26,
      "location": 2,
      "content": "你射击他的时候",
      "music": 0.0
    },
    {
      "from": 58.62,
      "to": 59.66,
      "sid": 27,
      "location": 2,
      "content": "他背身他不看",
      "music": 0.0
    },
    {
      "from": 59.66,
      "to": 60.22,
      "sid": 28,
      "location": 2,
      "content": "你对吧",
      "music": 0.0
    },
    {
      "from": 60.22,
      "to": 61.26,
      "sid": 29,
      "location": 2,
      "content": "他死了就拉倒",
      "music": 0.0
    },
    {
      "from": 61.26,
      "to": 63.72,
      "sid": 30,
      "location": 2,
      "content": "但实战里面这种场景是比较少的",
      "music": 0.0
    },
    {
      "from": 63.72,
      "to": 67.48,
      "sid": 31,
      "location": 2,
      "content": "所以说你要给自己马上有个调整的这个空间",
      "music": 0.0
    },
    {
      "from": 67.48,
      "to": 68.64,
      "sid": 32,
      "location": 2,
      "content": "是不是第一枪空了",
      "music": 0.0
    },
    {
      "from": 68.64,
      "to": 69.88,
      "sid": 33,
      "location": 2,
      "content": "马上就开始摆",
      "music": 0.0
    },
    {
      "from": 69.88,
      "to": 70.54,
      "sid": 34,
      "location": 2,
      "content": "对不对",
      "music": 0.0
    },
    {
      "from": 70.54,
      "to": 71.32,
      "sid": 35,
      "location": 2,
      "content": "要么就蹲下来",
      "music": 0.0
    },
    {
      "from": 71.32,
      "to": 72.44,
      "sid": 36,
      "location": 2,
      "content": "直接就压枪",
      "music": 0.0
    },
    {
      "from": 72.44,
      "to": 74.84,
      "sid": 37,
      "location": 2,
      "content": "就这种二选一",
      "music": 0.0
    },
    {
      "from": 74.84,
      "to": 79.12,
      "sid": 38,
      "location": 2,
      "content": "是不是在死斗里面我们去做这个育苗啊",
      "music": 0.0
    },
    {
      "from": 79.12,
      "to": 80.6,
      "sid": 39,
      "location": 2,
      "content": "你说这个总是老找人",
      "music": 0.0
    },
    {
      "from": 80.6,
      "to": 81.72,
      "sid": 40,
      "location": 2,
      "content": "我也没看出来啊",
      "music": 0.0
    },
    {
      "from": 81.72,
      "to": 84.6,
      "sid": 41,
      "location": 2,
      "content": "就感觉你一复活以后就两边架",
      "music": 0.0
    },
    {
      "from": 84.6,
      "to": 85.68,
      "sid": 42,
      "location": 2,
      "content": "那正常来讲",
      "music": 0.0
    },
    {
      "from": 85.68,
      "to": 89.21,
      "sid": 43,
      "location": 2,
      "content": "两边架是更容易拿到击杀的一个方式",
      "music": 0.0
    },
    {
      "from": 89.21,
      "to": 89.89,
      "sid": 44,
      "location": 2,
      "content": "是不是",
      "music": 0.0
    },
    {
      "from": 89.89,
      "to": 92.75,
      "sid": 45,
      "location": 2,
      "content": "那如果说你是去做预瞄练习",
      "music": 0.0
    },
    {
      "from": 92.75,
      "to": 96.87,
      "sid": 46,
      "location": 2,
      "content": "实际上你的这个击杀的正反馈是很少",
      "music": 0.0
    },
    {
      "from": 96.87,
      "to": 98.07,
      "sid": 47,
      "location": 2,
      "content": "就会你你会一直死",
      "music": 0.0
    },
    {
      "from": 98.07,
      "to": 98.87,
      "sid": 48,
      "location": 2,
      "content": "就像我打死斗",
      "music": 0.0
    },
    {
      "from": 98.87,
      "to": 100.33,
      "sid": 49,
      "location": 2,
      "content": "有时候去练这些东西",
      "music": 0.0
    },
    {
      "from": 100.33,
      "to": 102.11,
      "sid": 50,
      "location": 2,
      "content": "我甚至都不戴耳机啊",
      "music": 0.0
    },
    {
      "from": 102.11,
      "to": 105.57,
      "sid": 51,
      "location": 2,
      "content": "顶多就开个音响在这呃练习啊",
      "music": 0.0
    },
    {
      "from": 105.57,
      "to": 107.45,
      "sid": 52,
      "location": 2,
      "content": "我就大概能听到附近可能有个脚步",
      "music": 0.0
    },
    {
      "from": 107.45,
      "to": 110.15,
      "sid": 53,
      "location": 2,
      "content": "然后去强制自己对吧",
      "music": 0.0
    },
    {
      "from": 110.15,
      "to": 112.09,
      "sid": 54,
      "location": 2,
      "content": "快速的暴力瞄准",
      "music": 0.0
    },
    {
      "from": 112.09,
      "to": 114.61,
      "sid": 55,
      "location": 2,
      "content": "或者说强制自己去做一些反应",
      "music": 0.0
    },
    {
      "from": 114.61,
      "to": 115.93,
      "sid": 56,
      "location": 2,
      "content": "或者说去做预判啊",
      "music": 0.0
    },
    {
      "from": 115.93,
      "to": 116.87,
      "sid": 57,
      "location": 2,
      "content": "哪个地方会有人",
      "music": 0.0
    },
    {
      "from": 116.87,
      "to": 118.67,
      "sid": 58,
      "location": 2,
      "content": "然后去甩那个位置",
      "music": 0.0
    },
    {
      "from": 118.67,
      "to": 120.71,
      "sid": 59,
      "location": 2,
      "content": "然后在那个位置做那个位置的预瞄",
      "music": 0.0
    },
    {
      "from": 120.71,
      "to": 123.03,
      "sid": 60,
      "location": 2,
      "content": "你看你这时候复活又在架枪",
      "music": 0.0
    },
    {
      "from": 123.03,
      "to": 123.97,
      "sid": 61,
      "location": 2,
      "content": "对不对",
      "music": 0.0
    },
    {
      "from": 123.97,
      "to": 127.49,
      "sid": 62,
      "location": 2,
      "content": "那你这其实是单纯在对你自己的一个瞄准",
      "music": 0.0
    },
    {
      "from": 127.49,
      "to": 128.71,
      "sid": 63,
      "location": 2,
      "content": "做一个针对训练",
      "music": 0.0
    },
    {
      "from": 128.71,
      "to": 131.25,
      "sid": 64,
      "location": 2,
      "content": "那这其实不是说死都没效果",
      "music": 0.0
    },
    {
      "from": 131.25,
      "to": 133.55,
      "sid": 65,
      "location": 2,
      "content": "而是你这个瞄准有问题不",
      "music": 0.0
    },
    {
      "from": 133.55,
      "to": 136.99,
      "sid": 66,
      "location": 2,
      "content": "你现在瞄准就是动态目标的微调有问题对吧",
      "music": 0.0
    },
    {
      "from": 136.99,
      "to": 138.65,
      "sid": 67,
      "location": 2,
      "content": "静态靶打太多了",
      "music": 0.0
    },
    {
      "from": 138.65,
      "to": 140.41,
      "sid": 68,
      "location": 2,
      "content": "如果说你想要再去调整一下",
      "music": 0.0
    },
    {
      "from": 140.41,
      "to": 143.01,
      "sid": 69,
      "location": 2,
      "content": "你可以平时再多去打打这个团队死斗",
      "music": 0.0
    },
    {
      "from": 143.01,
      "to": 145.09,
      "sid": 70,
      "location": 2,
      "content": "因为团队死斗更多的都是正面对枪",
      "music": 0.0
    },
    {
      "from": 145.09,
      "to": 148.49,
      "sid": 71,
      "location": 2,
      "content": "大家基本上很少会去走左右两边啊",
      "music": 0.0
    },
    {
      "from": 148.49,
      "to": 149.89,
      "sid": 72,
      "location": 2,
      "content": "你基本打十把有七把",
      "music": 0.0
    },
    {
      "from": 149.89,
      "to": 152.13,
      "sid": 73,
      "location": 2,
      "content": "大家都是在这个中路对枪的啊",
      "music": 0.0
    },
    {
      "from": 152.13,
      "to": 154.95,
      "sid": 74,
      "location": 2,
      "content": "这个时候你就可以去练习一下自己的这个",
      "music": 0.0
    },
    {
      "from": 154.95,
      "to": 157.43,
      "sid": 75,
      "location": 2,
      "content": "对于动态目标的调整能力啊",
      "music": 0.0
    },
    {
      "from": 157.43,
      "to": 158.51,
      "sid": 76,
      "location": 2,
      "content": "可能刚开始的话",
      "music": 0.0
    },
    {
      "from": 158.51,
      "to": 161.48,
      "sid": 77,
      "location": 2,
      "content": "你的这个正面对枪挫败感会比较强",
      "music": 0.0
    },
    {
      "from": 161.48,
      "to": 163.42,
      "sid": 78,
      "location": 2,
      "content": "你会打的很恼火是吧",
      "music": 0.0
    },
    {
      "from": 163.42,
      "to": 165.5,
      "sid": 79,
      "location": 2,
      "content": "浑身燥热都是有可能的",
      "music": 0.0
    },
    {
      "from": 165.5,
      "to": 167.02,
      "sid": 80,
      "location": 2,
      "content": "但但是这都是好事啊",
      "music": 0.0
    },
    {
      "from": 167.02,
      "to": 170.22,
      "sid": 81,
      "location": 2,
      "content": "打多了你慢慢慢慢就调整过来了好吧",
      "music": 0.0
    },
    {
      "from": 170.429,
      "to": 172.549,
      "sid": 82,
      "location": 2,
      "content": "但是你看这一波又是这样子",
      "music": 0.0
    },
    {
      "from": 172.549,
      "to": 174.98,
      "sid": 83,
      "location": 2,
      "content": "就是说你是没有摆设的这个能力的",
      "music": 0.0
    },
    {
      "from": 174.98,
      "to": 177.3,
      "sid": 84,
      "location": 2,
      "content": "或者说你有摆设这个想法",
      "music": 0.0
    },
    {
      "from": 177.3,
      "to": 178.38,
      "sid": 85,
      "location": 2,
      "content": "但是你摆不出来",
      "music": 0.0
    },
    {
      "from": 178.38,
      "to": 181.02,
      "sid": 86,
      "location": 2,
      "content": "或者说达不成不了这样的效果好吧",
      "music": 0.0
    },
    {
      "from": 181.02,
      "to": 184.67,
      "sid": 87,
      "location": 2,
      "content": "这个这个就是比较显著的几个问题",
      "music": 0.0
    },
    {
      "from": 184.67,
      "to": 188.71,
      "sid": 88,
      "location": 2,
      "content": "然后另外的话哎我在这个片尾也会放上一段",
      "music": 0.0
    },
    {
      "from": 188.71,
      "to": 190.75,
      "sid": 89,
      "location": 2,
      "content": "我在打这张地图的这个死斗啊",
      "music": 0.0
    },
    {
      "from": 190.75,
      "to": 194.82,
      "sid": 90,
      "location": 2,
      "content": "就是说你在做这个地图的预瞄啊",
      "music": 0.0
    },
    {
      "from": 194.82,
      "to": 196.76,
      "sid": 91,
      "location": 2,
      "content": "也不是那么熟练",
      "music": 0.0
    },
    {
      "from": 196.76,
      "to": 200.17,
      "sid": 92,
      "location": 2,
      "content": "就是说你对这个地图还没有那么熟悉好吧",
      "music": 0.0
    },
    {
      "from": 200.17,
      "to": 201.71,
      "sid": 93,
      "location": 2,
      "content": "然后这里再稍微提一嘴",
      "music": 0.0
    },
    {
      "from": 201.71,
      "to": 205.11,
      "sid": 94,
      "location": 2,
      "content": "就是说你这个灵敏度平时经常去调整",
      "music": 0.0
    },
    {
      "from": 205.11,
      "to": 206.43,
      "sid": 95,
      "location": 2,
      "content": "其实也没有什么太大问题",
      "music": 0.0
    },
    {
      "from": 206.43,
      "to": 208.39,
      "sid": 96,
      "location": 2,
      "content": "就是你觉得快了就调慢对吧",
      "music": 0.0
    },
    {
      "from": 208.39,
      "to": 209.15,
      "sid": 97,
      "location": 2,
      "content": "慢了就调快",
      "music": 0.0
    },
    {
      "from": 209.15,
      "to": 210.86,
      "sid": 98,
      "location": 2,
      "content": "然后调个差不多就可以不动",
      "music": 0.0
    },
    {
      "from": 210.86,
      "to": 212.98,
      "sid": 99,
      "location": 2,
      "content": "就灵敏度对于你的瞄准能力啊",
      "music": 0.0
    },
    {
      "from": 212.98,
      "to": 214.98,
      "sid": 100,
      "location": 2,
      "content": "是没有什么很大的影响",
      "music": 0.0
    },
    {
      "from": 214.98,
      "to": 218.449,
      "sid": 101,
      "location": 2,
      "content": "就是只要不是那种非人类灵敏度就行",
      "music": 0.0
    },
    {
      "from": 218.449,
      "to": 220.569,
      "sid": 102,
      "location": 2,
      "content": "1600×5啊乘四啊",
      "music": 0.0
    },
    {
      "from": 220.569,
      "to": 221.809,
      "sid": 103,
      "location": 2,
      "content": "这种超级快的灵敏度",
      "music": 0.0
    },
    {
      "from": 221.809,
      "to": 224.91,
      "sid": 104,
      "location": 2,
      "content": "或者说那种超级慢的灵敏度都没有问题",
      "music": 0.0
    },
    {
      "from": 224.91,
      "to": 228.67,
      "sid": 105,
      "location": 2,
      "content": "因为这种话就属于天赋流选手的一个使用区间",
      "music": 0.0
    },
    {
      "from": 228.67,
      "to": 232.5,
      "sid": 106,
      "location": 2,
      "content": "就是这些人他正好哎我玩这个灵敏度",
      "music": 0.0
    },
    {
      "from": 232.5,
      "to": 233.26,
