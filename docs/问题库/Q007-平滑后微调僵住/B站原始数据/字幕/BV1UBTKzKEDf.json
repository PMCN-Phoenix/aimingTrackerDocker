{
  "bvid": "BV1UBTKzKEDf",
  "title": "预瞄不是无畏契约的一切，微调才是大拉击杀效率的关键！",
  "owner": "大东彦",
  "duration": 323,
  "lan": "ai-zh",
  "body": [
    {
      "from": 0.08,
      "to": 0.92,
      "sid": 1,
      "location": 2,
      "content": "哈喽各位观众朋友们",
      "music": 0.0
    },
    {
      "from": 0.92,
      "to": 1.28,
      "sid": 2,
      "location": 2,
      "content": "大家好",
      "music": 0.0
    },
    {
      "from": 1.28,
      "to": 2.04,
      "sid": 3,
      "location": 2,
      "content": "我是东彦",
      "music": 0.0
    },
    {
      "from": 2.04,
      "to": 5.12,
      "sid": 4,
      "location": 2,
      "content": "那么今天给大家聊一聊无畏区一些常见的瞄准",
      "music": 0.0
    },
    {
      "from": 5.12,
      "to": 6.22,
      "sid": 5,
      "location": 2,
      "content": "认知上的一些误区啊",
      "music": 0.0
    },
    {
      "from": 6.22,
      "to": 8.36,
      "sid": 6,
      "location": 2,
      "content": "那么首先就是无畏缺大拉准度",
      "music": 0.0
    },
    {
      "from": 8.36,
      "to": 10.42,
      "sid": 7,
      "location": 2,
      "content": "有很多观众看我这个直播的时候",
      "music": 0.0
    },
    {
      "from": 10.42,
      "to": 11.9,
      "sid": 8,
      "location": 2,
      "content": "说我的大拉击杀效率高",
      "music": 0.0
    },
    {
      "from": 11.9,
      "to": 13.06,
      "sid": 9,
      "location": 2,
      "content": "是因为我的预瞄够好",
      "music": 0.0
    },
    {
      "from": 13.06,
      "to": 15.9,
      "sid": 10,
      "location": 2,
      "content": "但实际上这种观点很大程度上忽略了微调",
      "music": 0.0
    },
    {
      "from": 15.9,
      "to": 17.08,
      "sid": 11,
      "location": 2,
      "content": "对于瞄准的一个参与度",
      "music": 0.0
    },
    {
      "from": 17.08,
      "to": 17.3,
      "sid": 12,
      "location": 2,
      "content": "呃",
      "music": 0.0
    },
    {
      "from": 17.3,
      "to": 19.74,
      "sid": 13,
      "location": 2,
      "content": "至于大家经常在我直播的时候能见到的",
      "music": 0.0
    },
    {
      "from": 19.74,
      "to": 22.14,
      "sid": 14,
      "location": 2,
      "content": "深海明珠防守方B小双门开竹峰",
      "music": 0.0
    },
    {
      "from": 22.14,
      "to": 23.38,
      "sid": 15,
      "location": 2,
      "content": "拿手上一个场景为例",
      "music": 0.0
    },
    {
      "from": 23.38,
      "to": 26.02,
      "sid": 16,
      "location": 2,
      "content": "很多人说这是一个预瞄加提前枪的动作啊",
      "music": 0.0
    },
    {
      "from": 26.02,
      "to": 28.36,
      "sid": 17,
      "location": 2,
      "content": "但实际上这跟提前枪是一点不沾边的",
      "music": 0.0
    },
    {
      "from": 28.36,
      "to": 30.4,
      "sid": 18,
      "location": 2,
      "content": "以画面上的这两波漫风的击杀为例",
      "music": 0.0
    },
    {
      "from": 30.4,
      "to": 32.159,
      "sid": 19,
      "location": 2,
      "content": "我为了追求横拉最大移速",
      "music": 0.0
    },
    {
      "from": 32.159,
      "to": 32.999,
      "sid": 20,
      "location": 2,
      "content": "不可能进步",
      "music": 0.0
    },
    {
      "from": 32.999,
      "to": 35.479,
      "sid": 21,
      "location": 2,
      "content": "慢慢拿准星扫过从左到右的所有角度",
      "music": 0.0
    },
    {
      "from": 35.479,
      "to": 36.599,
      "sid": 22,
      "location": 2,
      "content": "只能分段式预瞄",
      "music": 0.0
    },
    {
      "from": 36.599,
      "to": 38.439,
      "sid": 23,
      "location": 2,
      "content": "大致瞄一个差不多的位置拉出去",
      "music": 0.0
    },
    {
      "from": 38.439,
      "to": 39.659,
      "sid": 24,
      "location": 2,
      "content": "那么在这种情况下啊",
      "music": 0.0
    },
    {
      "from": 39.659,
      "to": 42.22,
      "sid": 25,
      "location": 2,
      "content": "准星是不会直接出现在敌人头上的",
      "music": 0.0
    },
    {
      "from": 42.22,
      "to": 44.54,
      "sid": 26,
      "location": 2,
      "content": "所以需要我们在遇到敌人的人物模型之后",
      "music": 0.0
    },
    {
      "from": 44.54,
      "to": 45.66,
      "sid": 27,
      "location": 2,
      "content": "再接一个小微条",
      "music": 0.0
    },
    {
      "from": 45.66,
      "to": 47.44,
      "sid": 28,
      "location": 2,
      "content": "经过一个快速确认再开枪",
      "music": 0.0
    },
    {
      "from": 47.44,
      "to": 48.78,
      "sid": 29,
      "location": 2,
      "content": "才能造成这个击杀",
      "music": 0.0
    },
    {
      "from": 48.78,
      "to": 51.54,
      "sid": 30,
      "location": 2,
      "content": "那有些玩家在自己刚刚学会如何预瞄之后",
      "music": 0.0
    },
    {
      "from": 51.54,
      "to": 52.78,
      "sid": 31,
      "location": 2,
      "content": "经常会着急开枪",
      "music": 0.0
    },
    {
      "from": 52.78,
      "to": 54.26,
      "sid": 32,
      "location": 2,
      "content": "预瞄一个位置横拉出去",
      "music": 0.0
    },
    {
      "from": 54.26,
      "to": 56.64,
      "sid": 33,
      "location": 2,
      "content": "直接就是一个不经过确认的一个蹲坡提前枪",
      "music": 0.0
    },
    {
      "from": 56.64,
      "to": 57.84,
      "sid": 34,
      "location": 2,
      "content": "那这种枪能不能杀人",
      "music": 0.0
    },
    {
      "from": 57.84,
      "to": 58.82,
      "sid": 35,
      "location": 2,
      "content": "真的纯看运气",
      "music": 0.0
    },
    {
      "from": 58.82,
      "to": 60.2,
      "sid": 36,
      "location": 2,
      "content": "除了偶尔才会用到的",
      "music": 0.0
    },
    {
      "from": 60.2,
      "to": 62.92,
      "sid": 37,
      "location": 2,
      "content": "需要用提前枪来破局的比较极限的情况之外",
      "music": 0.0
    },
    {
      "from": 62.92,
      "to": 65.06,
      "sid": 38,
      "location": 2,
      "content": "这样的击杀方式是绝对不稳定的",
      "music": 0.0
    },
    {
      "from": 65.06,
      "to": 66.04,
      "sid": 39,
      "location": 2,
      "content": "在位缺里",
      "music": 0.0
    },
    {
      "from": 66.04,
      "to": 68.0,
      "sid": 40,
      "location": 2,
      "content": "你的预瞄精度和人物的横拉速度",
      "music": 0.0
    },
    {
      "from": 68.0,
      "to": 69.64,
      "sid": 41,
      "location": 2,
      "content": "只能在二者之中择其一",
      "music": 0.0
    },
    {
      "from": 69.64,
      "to": 70.9,
      "sid": 42,
      "location": 2,
      "content": "就算再怎么会预瞄",
      "music": 0.0
    },
    {
      "from": 70.9,
      "to": 73.02,
      "sid": 43,
      "location": 2,
      "content": "你也不可能做到每一波大拉之后",
      "music": 0.0
    },
    {
      "from": 73.02,
      "to": 75.2,
      "sid": 44,
      "location": 2,
      "content": "准星都能精确地出现在敌人头上",
      "music": 0.0
    },
    {
      "from": 75.2,
      "to": 76.68,
      "sid": 45,
      "location": 2,
      "content": "那这个时候决定胜负的",
      "music": 0.0
    },
    {
      "from": 76.68,
      "to": 79.2,
      "sid": 46,
      "location": 2,
      "content": "就是你一瞬间的专注程度和一个微调能力了",
      "music": 0.0
    },
    {
      "from": 79.2,
      "to": 80.42,
      "sid": 47,
      "location": 2,
      "content": "要知道无畏缺理",
      "music": 0.0
    },
    {
      "from": 80.42,
      "to": 83.1,
      "sid": 48,
      "location": 2,
      "content": "你只要学会了以正确的方式横拉你的大拉",
      "music": 0.0
    },
    {
      "from": 83.1,
      "to": 84.84,
      "sid": 49,
      "location": 2,
      "content": "其实真的没有那么容易被别人架住",
      "music": 0.0
    },
    {
      "from": 84.84,
      "to": 87.4,
      "sid": 50,
      "location": 2,
      "content": "很多新手朋友就是太害怕被别人架住了",
      "music": 0.0
    },
    {
      "from": 87.4,
      "to": 88.6,
      "sid": 51,
      "location": 2,
      "content": "拉出去之后太着急",
      "music": 0.0
    },
    {
      "from": 88.6,
      "to": 89.6,
      "sid": 52,
      "location": 2,
      "content": "反而会先开枪",
      "music": 0.0
    },
    {
      "from": 89.6,
      "to": 90.62,
      "sid": 53,
      "location": 2,
      "content": "被别人后手打死",
      "music": 0.0
    },
    {
      "from": 90.62,
      "to": 91.42,
      "sid": 54,
      "location": 2,
      "content": "大拉之后",
      "music": 0.0
    },
    {
      "from": 91.42,
      "to": 94.34,
      "sid": 55,
      "location": 2,
      "content": "看到敌人再接一个有确认过程的精确微调",
      "music": 0.0
    },
    {
      "from": 94.34,
      "to": 94.78,
      "sid": 56,
      "location": 2,
      "content": "再开枪",
      "music": 0.0
    },
    {
      "from": 94.78,
      "to": 97.5,
      "sid": 57,
      "location": 2,
      "content": "真的是每一个无畏缺玩家都需要学习的能力",
      "music": 0.0
    },
    {
      "from": 97.5,
      "to": 100.18,
      "sid": 58,
      "location": 2,
      "content": "那我推荐大家找一个和自己水平差不多的朋友",
      "music": 0.0
    },
    {
      "from": 100.18,
      "to": 100.94,
      "sid": 59,
      "location": 2,
      "content": "来到自定义的",
      "music": 0.0
    },
    {
      "from": 100.94,
      "to": 101.98,
      "sid": 60,
      "location": 2,
      "content": "于是这张图单挑",
      "music": 0.0
    },
    {
      "from": 101.98,
      "to": 104.14,
      "sid": 61,
      "location": 2,
      "content": "让让你的朋友在画面上这一块区域",
      "music": 0.0
    },
    {
      "from": 104.14,
      "to": 105.14,
      "sid": 62,
      "location": 2,
      "content": "换着位置来架枪",
      "music": 0.0
    },
    {
      "from": 105.14,
      "to": 107.54,
      "sid": 63,
      "location": 2,
      "content": "你的话则是每一波都可以在出生点箱子",
      "music": 0.0
    },
    {
      "from": 107.54,
      "to": 109.24,
      "sid": 64,
      "location": 2,
      "content": "这里进行一个贴墙的大佬",
      "music": 0.0
    },
    {
      "from": 109.24,
      "to": 110.1,
      "sid": 65,
      "location": 2,
      "content": "每一波预瞄好",
      "music": 0.0
    },
    {
      "from": 110.1,
      "to": 110.82,
      "sid": 66,
      "location": 2,
      "content": "拉出去之后",
      "music": 0.0
    },
    {
      "from": 110.82,
      "to": 113.78,
      "sid": 67,
      "location": 2,
      "content": "你都要确保自己有一个确认的过程的一个微调",
      "music": 0.0
    },
    {
      "from": 113.78,
      "to": 115.66,
      "sid": 68,
      "location": 2,
      "content": "在开枪多这么练上几个小时",
      "music": 0.0
    },
    {
      "from": 115.66,
      "to": 117.86,
      "sid": 69,
      "location": 2,
      "content": "你会发现你大拉之后着急开身的坏习惯",
      "music": 0.0
    },
    {
      "from": 117.86,
      "to": 119.2,
      "sid": 70,
      "location": 2,
      "content": "可能就会慢慢的改正",
      "music": 0.0
    },
    {
      "from": 119.2,
      "to": 120.48,
      "sid": 71,
      "location": 2,
      "content": "那纠正习惯之后",
      "music": 0.0
    },
    {
      "from": 120.48,
      "to": 121.4,
      "sid": 72,
      "location": 2,
      "content": "再需要提升的",
      "music": 0.0
    },
    {
      "from": 121.4,
      "to": 123.62,
      "sid": 73,
      "location": 2,
      "content": "可能就是自身的一个瞄准的微调效率了",
      "music": 0.0
    },
    {
      "from": 123.62,
      "to": 125.16,
      "sid": 74,
      "location": 2,
      "content": "具体怎么提升微调能力",
      "music": 0.0
    },
    {
      "from": 125.16,
      "to": 126.58,
      "sid": 75,
      "location": 2,
      "content": "我们可以先放后面再讲",
      "music": 0.0
    },
    {
      "from": 126.58,
      "to": 127.86,
      "sid": 76,
      "location": 2,
      "content": "我们可以先聊一下呃",
      "music": 0.0
    },
    {
      "from": 127.86,
      "to": 129.58,
      "sid": 77,
      "location": 2,
      "content": "微调能力不足或者着急开枪",
      "music": 0.0
    },
    {
      "from": 129.58,
      "to": 131.22,
      "sid": 78,
      "location": 2,
      "content": "在游戏的另外一种表现形式",
      "music": 0.0
    },
    {
      "from": 131.22,
      "to": 133.86,
      "sid": 79,
      "location": 2,
      "content": "也就是一个公式摆设周的瞎开枪",
      "music": 0.0
    },
    {
      "from": 133.86,
      "to": 134.94,
      "sid": 80,
      "location": 2,
      "content": "有很多玩家知道",
      "music": 0.0
    },
    {
      "from": 134.94,
      "to": 137.68,
      "sid": 81,
      "location": 2,
      "content": "这个摆设是一种可以躲子弹的一种移动方式",
      "music": 0.0
    },
    {
      "from": 137.68,
      "to": 140.06,
      "sid": 82,
      "location": 2,
      "content": "然后也知道摆设呢可以让自己没那么容易死",
      "music": 0.0
    },
    {
      "from": 140.06,
      "to": 141.26,
      "sid": 83,
      "location": 2,
      "content": "知道了这个事情之后",
      "music": 0.0
    },
    {
      "from": 141.26,
      "to": 142.94,
      "sid": 84,
      "location": 2,
      "content": "总是有这个玩家喜欢短点",
      "music": 0.0
    },
    {
      "from": 142.94,
      "to": 145.08,
      "sid": 85,
      "location": 2,
      "content": "射一波之后就来一段公式的摆设",
      "music": 0.0
    },
    {
      "from": 145.08,
      "to": 146.56,
      "sid": 86,
      "location": 2,
      "content": "虽然是一个不错的技巧",
      "music": 0.0
    },
    {
      "from": 146.56,
      "to": 148.2,
      "sid": 87,
      "location": 2,
      "content": "但问题是你摇摆一段之后",
      "music": 0.0
    },
    {
      "from": 148.2,
      "to": 150.76,
      "sid": 88,
      "location": 2,
      "content": "你得确保自己的准星能在移动的间隙内",
      "music": 0.0
    },
    {
      "from": 150.76,
      "to": 152.64,
      "sid": 89,
      "location": 2,
      "content": "及时的微调到敌人头部",
      "music": 0.0
    },
    {
      "from": 152.64,
      "to": 155.46,
      "sid": 90,
      "location": 2,
      "content": "但很多新手就是攻摇摆一段距离之后",
      "music": 0.0
    },
    {
      "from": 155.46,
      "to": 157.0,
      "sid": 91,
      "location": 2,
      "content": "直接跳过瞄准确认过程",
      "music": 0.0
    },
    {
      "from": 157.0,
      "to": 157.9,
      "sid": 92,
      "location": 2,
      "content": "准心瞎甩",
      "music": 0.0
    },
    {
      "from": 157.9,
      "to": 158.68,
      "sid": 93,
      "location": 2,
      "content": "然后瞎开枪",
      "music": 0.0
    },
    {
      "from": 158.68,
      "to": 160.78,
      "sid": 94,
      "location": 2,
      "content": "这一波打不中就再接一波摇摆",
      "music": 0.0
    },
    {
      "from": 160.78,
      "to": 162.7,
      "sid": 95,
      "location": 2,
      "content": "那看起来真的非常慌张",
      "music": 0.0
    },
    {
      "from": 162.7,
      "to": 164.42,
      "sid": 96,
      "location": 2,
      "content": "想要提升自己的微调能力",
      "music": 0.0
    },
    {
      "from": 164.42,
      "to": 166.48,
      "sid": 97,
      "location": 2,
      "content": "摆脱这种匆匆忙忙开枪的窘境",
      "music": 0.0
    },
    {
      "from": 166.48,
      "to": 169.68,
      "sid": 98,
      "location": 2,
      "content": "在游戏内有推荐大家可以在靶场打开移动选项",
      "music": 0.0
    },
    {
      "from": 169.68,
      "to": 170.84,
      "sid": 99,
      "location": 2,
      "content": "打侧面的100把",
      "music": 0.0
    },
    {
      "from": 170.84,
      "to": 171.92,
      "sid": 100,
      "location": 2,
      "content": "那么在游戏外呢",
      "music": 0.0
    },
    {
      "from": 171.92,
      "to": 173.56,
      "sid": 101,
      "location": 2,
      "content": "我推荐大家可以试试这两类",
      "music": 0.0
    },
    {
      "from": 173.56,
      "to": 174.88,
      "sid": 102,
      "location": 2,
      "content": "带这个动态目标的项目",
      "music": 0.0
    },
    {
      "from": 174.88,
      "to": 175.24,
      "sid": 103,
      "location": 2,
      "content": "第一种呢",
      "music": 0.0
    },
    {
      "from": 175.24,
      "to": 177.76,
      "sid": 104,
      "location": 2,
      "content": "就是画面上这种需要连续点击目标两下",
      "music": 0.0
    },
    {
      "from": 177.76,
      "to": 178.8,
      "sid": 105,
      "location": 2,
      "content": "才能消灭靶子",
      "music": 0.0
    },
    {
      "from": 178.8,
      "to": 179.94,
      "sid": 106,
      "location": 2,
      "content": "reactive clicking项目",
      "music": 0.0
