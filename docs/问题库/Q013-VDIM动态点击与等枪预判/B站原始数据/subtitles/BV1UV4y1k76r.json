      "sid": 30,
      "location": 2,
      "content": "反应比左手快"
    },
    {
      "from": 66.68,
      "to": 69.48,
      "sid": 31,
      "location": 2,
      "content": "为了解决他右手的问题"
    },
    {
      "from": 69.48,
      "to": 71.18,
      "sid": 32,
      "location": 2,
      "content": "反应比左手快"
    },
    {
      "from": 71.18,
      "to": 74.55,
      "sid": 33,
      "location": 2,
      "content": "为了这次训练，我给了他一个训练练习"
    },
    {
      "from": 74.55,
      "to": 76.37,
      "sid": 34,
      "location": 2,
      "content": "让我们跳到靶场"
    },
    {
      "from": 76.37,
      "to": 79.35,
      "sid": 35,
      "location": 2,
      "content": "把射程设置在一百个锅炉上"
    },
    {
      "from": 79.35,
      "to": 81.61,
      "sid": 36,
      "location": 2,
      "content": "随着扫射的开始"
    },
    {
      "from": 81.61,
      "to": 83.75,
      "sid": 37,
      "location": 2,
      "content": "然后按下开始键"
    },
    {
      "from": 83.75,
      "to": 87.59,
      "sid": 38,
      "location": 2,
      "content": "我们要做的是瞄准机器人的头部"
