 },
 {
  "from": 232.14,
  "to": 236.35,
  "sid": 106,
  "location": 2,
  "content": "基于对面习惯做出的阅读去惩罚对面的习惯",
  "music": 0.0
 },
 {
  "from": 236.35,
  "to": 238.9,
  "sid": 107,
  "location": 2,
  "content": "当你基于地图控制来梳理思路",
  "music": 0.0
 },
 {
  "from": 238.9,
  "to": 241.74,
  "sid": 108,
  "location": 2,
  "content": "就很容易构建起自己的行动逻辑",
  "music": 0.0
 },
 {
  "from": 241.74,
  "to": 244.44,
  "sid": 109,
  "location": 2,
  "content": "而在没有思路或者缺乏阅读的时候",
  "music": 0.0
 },
 {
  "from": 244.44,
  "to": 246.54,
  "sid": 110,
