 },
 {
  "from": 181.07,
  "to": 183.36,
  "sid": 89,
  "location": 2,
  "content": "理解了这一点我们就可以来到下一步",
  "music": 0.0
 },
 {
  "from": 183.36,
  "to": 186.36,
  "sid": 90,
  "location": 2,
  "content": "那就是在攫取地图控制为目标的基础上",
  "music": 0.0
 },
 {
  "from": 186.36,
  "to": 188.13,
