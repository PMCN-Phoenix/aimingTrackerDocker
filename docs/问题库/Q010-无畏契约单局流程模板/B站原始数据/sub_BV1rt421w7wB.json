 },
 {
  "from": 30.49,
  "to": 32.53,
  "sid": 16,
  "location": 2,
  "content": "能支撑我上分的也只有意识了",
  "music": 0.0
 },
 {
  "from": 32.53,
  "to": 34.7,
  "sid": 17,
  "location": 2,
  "content": "你们学会后只会比我更强",
  "music": 0.0
 },
 {
  "from": 34.7,
  "to": 36.44,
  "sid": 18,
  "location": 2,
  "content": "想拥有好意识的第一步",
  "music": 0.0
 },
 {
  "from": 36.44,
  "to": 38.78,
  "sid": 19,
  "location": 2,
  "content": "就是尽量减少临场决策的数量",
