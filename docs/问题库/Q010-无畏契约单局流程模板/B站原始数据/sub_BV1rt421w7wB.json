 },
 {
  "from": 38.78,
  "to": 41.6,
  "sid": 20,
  "location": 2,
  "content": "因为每场游戏用来做出决策的时间不多",
  "music": 0.0
 },
 {
  "from": 41.6,
  "to": 43.29,
  "sid": 21,
  "location": 2,
  "content": "而一旦进入执行阶段",
  "music": 0.0
 },
 {
  "from": 43.29,
  "to": 45.42,
  "sid": 22,
  "location": 2,
  "content": "就要把注意力放回准星上",
  "music": 0.0
 },
 {
  "from": 45.42,
  "to": 47.67,
  "sid": 23,
  "location": 2,
  "content": "如果每件事都要临场决策",
  "music": 0.0
 },
 {
  "from": 47.67,
  "to": 49.41,
  "sid": 24,
  "location": 2,
  "content": "只会导致过度思考",
  "music": 0.0
 },
 {
  "from": 49.41,
  "to": 50.32,
  "sid": 25,
  "location": 2,
  "content": "错过时机",
  "music": 0.0
 },
 {
  "from": 50.32,
  "to": 52.66,
  "sid": 26,
  "location": 2,
  "content": "那么无畏契约行动的底层逻辑",
  "music": 0.0
 },
 {
  "from": 52.66,
  "to": 54.7,
  "sid": 27,
  "location": 2,
  "content": "或者说每回合应该去干什么呢",
  "music": 0.0
 },
 {
  "from": 54.7,
  "to": 56.26,
  "sid": 28,
  "location": 2,
  "content": "我认为是地图控制",
  "music": 0.0
 },
 {
  "from": 56.26,
  "to": 58.76,
  "sid": 29,
  "location": 2,
  "content": "进攻方需要控制地图才能下包",
  "music": 0.0
 },
 {
  "from": 58.76,
  "to": 61.52,
  "sid": 30,
  "location": 2,
  "content": "防守方需要地图控制布置防御",
  "music": 0.0
 },
 {
  "from": 61.52,
  "to": 65.209,
  "sid": 31,
  "location": 2,
  "content": "对于双方额外的地图控制都能轻易转化为优势",
  "music": 0.0
 },
 {
  "from": 65.209,
  "to": 66.169,
  "sid": 32,
  "location": 2,
  "content": "换句话说",
  "music": 0.0
 },
 {
  "from": 66.169,
  "to": 68.929,
  "sid": 33,
  "location": 2,
  "content": "无畏契约里最能对胜率施加影响的条件",
  "music": 0.0
 },
 {
  "from": 68.929,
  "to": 70.75,
  "sid": 34,
  "location": 2,
  "content": "一切决策的基石地位",
  "music": 0.0
 },
 {
  "from": 70.75,
  "to": 72.85,
  "sid": 35,
  "location": 2,
  "content": "相当于英雄联盟产金币的小兵",
  "music": 0.0
 },
 {
  "from": 72.85,
  "to": 74.539,
  "sid": 36,
  "location": 2,
  "content": "一有机会就应该攫取",
  "music": 0.0
 },
 {
  "from": 74.539,
  "to": 75.319,
  "sid": 37,
  "location": 2,
  "content": "举个例子",
  "music": 0.0
 },
 {
  "from": 75.319,
  "to": 78.679,
  "sid": 38,
  "location": 2,
  "content": "你肯定被每回合冲同一个位置的瑞娜杀穿过",
  "music": 0.0
 },
 {
  "from": 78.679,
  "to": 80.839,
  "sid": 39,
  "location": 2,
  "content": "你可能觉得这是枪法的问题",
  "music": 0.0
 },
 {
  "from": 80.839,
  "to": 81.95,
  "sid": 40,
  "location": 2,
  "content": "跟决策无关",
  "music": 0.0
 },
 {
  "from": 81.95,
  "to": 84.83,
  "sid": 41,
  "location": 2,
  "content": "但在对面无法阻止你获取地图控制时",
  "music": 0.0
 },
 {
  "from": 84.83,
  "to": 86.57,
  "sid": 42,
  "location": 2,
  "content": "这其实就是最佳的决策",
  "music": 0.0
 },
 {
  "from": 86.57,
  "to": 87.71,
  "sid": 43,
  "location": 2,
  "content": "理清这件事",
  "music": 0.0
 },
 {
  "from": 87.71,
  "to": 88.52,
  "sid": 44,
  "location": 2,
  "content": "是要说明",
  "music": 0.0
 },
 {
  "from": 88.52,
  "to": 91.82,
  "sid": 45,
  "location": 2,
  "content": "决策和之后的博弈都建立在如何应对敌人",
  "music": 0.0
 },
 {
  "from": 91.82,
  "to": 93.44,
  "sid": 46,
  "location": 2,
  "content": "阻止你获取地图控制",
  "music": 0.0
 },
 {
  "from": 93.44,
  "to": 95.06,
  "sid": 47,
  "location": 2,
  "content": "如果对面无法阻止你",
  "music": 0.0
 },
 {
  "from": 95.06,
  "to": 97.32,
  "sid": 48,
  "location": 2,
  "content": "那么请你直接追求地图控制",
  "music": 0.0
 },
 {
  "from": 97.32,
  "to": 100.02,
  "sid": 49,
  "location": 2,
  "content": "有时候这意味着冲A大13个回合",
  "music": 0.0
 },
 {
  "from": 100.02,
  "to": 102.13,
  "sid": 50,
  "location": 2,
  "content": "或者防守前压13个回合",
  "music": 0.0
 },
 {
  "from": 102.13,
  "to": 103.39,
  "sid": 51,
  "location": 2,
  "content": "这听着像废话",
  "music": 0.0
 },
 {
  "from": 103.39,
  "to": 105.52,
  "sid": 52,
  "location": 2,
  "content": "但真的是很多人枪法优势很大",
  "music": 0.0
 },
 {
  "from": 105.52,
  "to": 106.93,
  "sid": 53,
  "location": 2,
  "content": "还无法上分的病因",
  "music": 0.0
 },
 {
  "from": 106.93,
  "to": 110.23,
  "sid": 54,
  "location": 2,
  "content": "很多人会在对面无法阻止他获取地图控制时",
  "music": 0.0
 },
 {
  "from": 110.23,
  "to": 112.14,
  "sid": 55,
  "location": 2,
  "content": "去变速或者改变战术",
  "music": 0.0
 },
 {
  "from": 112.14,
  "to": 114.42,
  "sid": 56,
  "location": 2,
  "content": "仅仅因为这样似乎更不好阅读",
  "music": 0.0
 },
 {
  "from": 114.42,
  "to": 115.02,
  "sid": 57,
  "location": 2,
  "content": "更高端",
  "music": 0.0
 },
 {
  "from": 115.02,
  "to": 116.58,
  "sid": 58,
  "location": 2,
  "content": "白白葬送自己的优势",
  "music": 0.0
 },
 {
  "from": 116.58,
  "to": 118.26,
  "sid": 59,
  "location": 2,
  "content": "所以不要再有迷茫的回合",
  "music": 0.0
 },
 {
  "from": 118.26,
  "to": 120.72,
  "sid": 60,
  "location": 2,
  "content": "如果你没有对敌人的行动做出阅读",
  "music": 0.0
 },
 {
  "from": 120.72,
  "to": 123.44,
  "sid": 61,
  "location": 2,
  "content": "那么你就必须在抢地图控制的路上",
  "music": 0.0
 },
 {
  "from": 123.44,
  "to": 125.24,
  "sid": 62,
  "location": 2,
  "content": "除非你有明确的阅读",
  "music": 0.0
 },
 {
  "from": 125.24,
  "to": 127.94,
  "sid": 63,
  "location": 2,
  "content": "这么抢地图控制会死到这一步",
