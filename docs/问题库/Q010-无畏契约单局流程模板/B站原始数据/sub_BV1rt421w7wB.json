 },
 {
  "from": 127.94,
  "to": 129.87,
  "sid": 64,
  "location": 2,
  "content": "就可以开始拥有意识了",
  "music": 0.0
 },
 {
  "from": 129.87,
  "to": 131.25,
  "sid": 65,
  "location": 2,
  "content": "决策是一种应对",
  "music": 0.0
 },
 {
  "from": 131.25,
  "to": 133.71,
  "sid": 66,
  "location": 2,
  "content": "如果你当时没想到有什么东西要应对",
  "music": 0.0
 },
 {
  "from": 133.71,
  "to": 135.75,
  "sid": 67,
  "location": 2,
  "content": "顺着最近的路冲出去就行了",
  "music": 0.0
 },
 {
  "from": 135.75,
  "to": 137.46,
  "sid": 68,
  "location": 2,
  "content": "不要和空气斗智斗勇",
