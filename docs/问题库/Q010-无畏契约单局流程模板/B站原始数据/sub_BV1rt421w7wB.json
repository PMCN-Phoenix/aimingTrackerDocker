 },
 {
  "from": 158.43,
  "to": 160.82,
  "sid": 79,
  "location": 2,
  "content": "如果你经常看排位高手的视角",
  "music": 0.0
 },
 {
  "from": 160.82,
  "to": 163.52,
  "sid": 80,
  "location": 2,
  "content": "就会发现他们都特别擅长寻找对枪",
  "music": 0.0
 },
 {
  "from": 163.52,
  "to": 165.23,
  "sid": 81,
  "location": 2,
  "content": "而不是想方设法的避战",
