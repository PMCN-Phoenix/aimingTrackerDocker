 },
 {
  "from": 209.96,
  "to": 211.58,
  "sid": 100,
  "location": 2,
  "content": "然后做出应对",
  "music": 0.0
 },
 {
  "from": 211.58,
  "to": 214.85,
  "sid": 101,
  "location": 2,
  "content": "比较经典的就是提前背闪",
