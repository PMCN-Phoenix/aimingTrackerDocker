 },
 {
  "from": 141.96,
  "to": 144.72,
  "sid": 71,
  "location": 2,
  "content": "则是默认你只能寻找不这么做的理由",
  "music": 0.0
 },
 {
  "from": 144.72,
  "to": 146.82,
  "sid": 72,
  "location": 2,
  "content": "而不能反过来做完这一步",
  "music": 0.0
 },
 {
  "from": 146.82,
  "to": 147.72,
  "sid": 73,
  "location": 2,
  "content": "你可能会疑惑",
  "music": 0.0
 },
 {
  "from": 147.72,
  "to": 149.49,
  "sid": 74,
  "location": 2,
  "content": "难道意识就是出去拼枪吗",
  "music": 0.0
 },
 {
  "from": 149.49,
  "to": 151.23,
  "sid": 75,
  "location": 2,
  "content": "某种程度来说是的",
  "music": 0.0
 },
 {
  "from": 151.23,
  "to": 153.21,
  "sid": 76,
  "location": 2,
  "content": "在无畏契约里逃避对枪",
  "music": 0.0
 },
 {
  "from": 153.21,
  "to": 155.85,
  "sid": 77,
  "location": 2,
  "content": "是只有在有明确收益时的应对措施",
