{
  "P1": [
    {
      "from": 0.0,
      "to": 1.32,
      "sid": 1,
      "location": 2,
      "content": "开始练枪很简单",
      "music": 0.0
    },
    {
      "from": 1.32,
      "to": 3.16,
      "sid": 2,
      "location": 2,
      "content": "但真正难的是坚持",
      "music": 0.0
    },
    {
      "from": 3.16,
      "to": 5.54,
      "sid": 3,
      "location": 2,
      "content": "至于发现自己到底哪里练错了",
      "music": 0.0
    },
    {
      "from": 5.54,
      "to": 7.78,
      "sid": 4,
      "location": 2,
      "content": "很多玩家可能一直都没意识到",
      "music": 0.0
    },
    {
      "from": 7.78,
      "to": 10.02,
      "sid": 5,
      "location": 2,
      "content": "所以这期视频我们就来聊聊",
      "music": 0.0
    },
    {
      "from": 10.02,
      "to": 12.14,
      "sid": 6,
      "location": 2,
      "content": "练枪时最常见的一些问题",
      "music": 0.0
    },
    {
      "from": 12.14,
      "to": 13.72,
      "sid": 7,
      "location": 2,
      "content": "以及应该怎么改",
      "music": 0.0
    },
    {
      "from": 13.72,
      "to": 16.74,
      "sid": 8,
      "location": 2,
      "content": "先从大部分玩家都会遇到的问题开始",
      "music": 0.0
    },
    {
      "from": 16.74,
      "to": 18.56,
      "sid": 9,
      "location": 2,
      "content": "再看看几个相对少见",
      "music": 0.0
    },
    {
      "from": 18.56,
      "to": 21.6,
      "sid": 10,
      "location": 2,
      "content": "但同样可能影响实战表现的问题",
      "music": 0.0
    },
    {
      "from": 21.6,
      "to": 23.88,
      "sid": 11,
      "location": 2,
      "content": "一甩枪效率低",
      "music": 0.0
    },
    {
      "from": 23.88,
      "to": 27.15,
      "sid": 12,
      "location": 2,
      "content": "第一个常见问题就是甩枪效率低",
      "music": 0.0
    },
    {
      "from": 27.15,
      "to": 30.15,
      "sid": 13,
      "location": 2,
      "content": "正常的甩枪路线应该尽可能直接",
      "music": 0.0
    },
    {
      "from": 30.15,
      "to": 32.65,
      "sid": 14,
      "location": 2,
      "content": "但如果你的准星经常走弧线",
      "music": 0.0
    },
    {
      "from": 32.65,
      "to": 36.98,
      "sid": 15,
      "location": 2,
      "content": "走之字或者中间明显犹豫一下才落到目标上",
      "music": 0.0
    },
    {
      "from": 36.98,
      "to": 39.629,
      "sid": 16,
      "location": 2,
      "content": "就说明移动路线不够干净",
      "music": 0.0
    },
    {
      "from": 39.629,
      "to": 41.029,
      "sid": 17,
      "location": 2,
      "content": "你可以打开回放",
      "music": 0.0
    },
    {
      "from": 41.029,
      "to": 43.369,
      "sid": 18,
      "location": 2,
      "content": "开启准星移动轨迹来检查",
      "music": 0.0
    },
    {
      "from": 43.369,
      "to": 46.23,
      "sid": 19,
      "location": 2,
      "content": "也可以练aim laps里的直线跟枪",
      "music": 0.0
    },
    {
      "from": 46.23,
      "to": 49.11,
      "sid": 20,
      "location": 2,
      "content": "看看自己用鼠标实际画出来的路线",
      "music": 0.0
    },
    {
      "from": 49.11,
      "to": 52.99,
      "sid": 21,
      "location": 2,
      "content": "当然每一次甩枪都做到完美并不现实",
      "music": 0.09866666403555495
    },
    {
      "from": 52.99,
      "to": 55.23,
      "sid": 22,
      "location": 2,
      "content": "但路线越干净越直接",
      "music": 0.033980580874729306
    },
    {
      "from": 55.23,
      "to": 57.45,
      "sid": 23,
      "location": 2,
      "content": "你就能越快到达目标",
      "music": 0.2211055165273596
    },
    {
      "from": 57.45,
      "to": 58.65,
      "sid": 24,
      "location": 2,
      "content": "放到实战里",
      "music": 0.0
    },
    {
      "from": 58.65,
      "to": 64.26,
      "sid": 25,
      "location": 2,
      "content": "这一点点时间差有时候就足以决定谁先打中二",
      "music": 0.0
    },
    {
      "from": 64.26,
      "to": 65.8,
      "sid": 26,
      "location": 2,
      "content": "发力控制不对",
      "music": 0.0
    },
    {
      "from": 65.8,
      "to": 68.06,
      "sid": 27,
      "location": 2,
      "content": "第二个问题是发力控制",
      "music": 0.0
    },
    {
      "from": 68.06,
      "to": 70.99,
      "sid": 28,
      "location": 2,
      "content": "这个问题在跟枪时尤其明显",
      "music": 0.0
    },
    {
      "from": 70.99,
      "to": 74.39,
      "sid": 29,
      "location": 2,
      "content": "这里的跟枪不只是持续扫射战术",
      "music": 0.0
    },
    {
      "from": 74.39,
      "to": 76.59,
      "sid": 30,
      "location": 2,
      "content": "FPS里的轻点搜脚",
      "music": 0.0
    },
    {
      "from": 76.59,
      "to": 79.19,
      "sid": 31,
      "location": 2,
      "content": "同样需要连续控制准星",
      "music": 0.0
    },
    {
      "from": 79.19,
      "to": 82.41,
      "sid": 32,
      "location": 2,
      "content": "而且发力也不只是握鼠标有多紧",
      "music": 0.16312056159146762
    },
    {
      "from": 82.41,
      "to": 85.17,
      "sid": 33,
      "location": 2,
      "content": "大范围移动靠手臂对准目标",
      "music": 0.0
    },
    {
      "from": 85.17,
      "to": 86.09,
      "sid": 34,
      "location": 2,
      "content": "靠手腕",
      "music": 0.0
    },
    {
      "from": 86.09,
      "to": 88.79,
      "sid": 35,
      "location": 2,
      "content": "最后的小幅修正靠手指",
      "music": 0.0
    },
    {
      "from": 88.79,
      "to": 91.59,
      "sid": 36,
      "location": 2,
      "content": "最常见的问题就是过度发力",
      "music": 0.0
    },
    {
      "from": 91.59,
      "to": 93.89,
      "sid": 37,
      "location": 2,
      "content": "尤其是鼠标握的太紧",
      "music": 0.0967741883454698
    },
    {
      "from": 93.89,
      "to": 95.89,
      "sid": 38,
      "location": 2,
      "content": "你可能会觉得这样更稳",
      "music": 0.0
    },
    {
      "from": 95.89,
      "to": 97.91,
      "sid": 39,
      "location": 2,
      "content": "但实际上肌肉会更快",
      "music": 0.0
    },
    {
      "from": 97.91,
      "to": 98.74,
      "sid": 40,
      "location": 2,
      "content": "疲劳",
      "music": 0.0
    },
    {
      "from": 98.74,
      "to": 100.12,
      "sid": 41,
      "location": 2,
      "content": "一旦开始疲劳",
      "music": 0.0
    },
    {
      "from": 100.12,
      "to": 101.7,
      "sid": 42,
      "location": 2,
      "content": "修正就容易变抖",
      "music": 0.0
    },
    {
      "from": 101.7,
      "to": 103.6,
      "sid": 43,
      "location": 2,
      "content": "跟枪也会开始飘",
      "music": 0.0
    },
    {
      "from": 103.6,
      "to": 105.86,
      "sid": 44,
      "location": 2,
      "content": "而且疲劳会不断累积",
      "music": 0.0
    },
    {
      "from": 105.86,
      "to": 108.0,
      "sid": 45,
      "location": 2,
      "content": "连续几波对枪不放松",
      "music": 0.0
    },
    {
      "from": 108.0,
      "to": 111.14,
      "sid": 46,
      "location": 2,
      "content": "可能到了第三波手臂就已经累了",
      "music": 0.0
    },
    {
      "from": 111.14,
      "to": 113.86,
      "sid": 47,
      "location": 2,
      "content": "当然完全放松也不是答案",
      "music": 0.0
    },
    {
      "from": 113.86,
      "to": 115.52,
      "sid": 48,
      "location": 2,
      "content": "如果目标变向时",
      "music": 0.0
    },
    {
      "from": 115.52,
      "to": 118.18,
      "sid": 49,
      "location": 2,
      "content": "经常修正过头可能是太紧",
      "music": 0.0
    },
    {
      "from": 118.18,
      "to": 120.36,
      "sid": 50,
      "location": 2,
      "content": "如果准星总是落后于目标",
      "music": 0.0
    },
    {
      "from": 120.36,
      "to": 122.34,
      "sid": 51,
      "location": 2,
      "content": "就适当增加发力",
      "music": 0.0
    },
    {
      "from": 122.34,
      "to": 124.88,
      "sid": 52,
      "location": 2,
      "content": "真正要练的是在移动过程中",
      "music": 0.0
    },
    {
      "from": 124.88,
      "to": 127.6,
      "sid": 53,
      "location": 2,
      "content": "察觉自己什么时候开始越来越紧",
      "music": 0.0
    },
    {
      "from": 127.6,
      "to": 129.82,
      "sid": 54,
      "location": 2,
      "content": "然后及时放松",
      "music": 0.0
    },
    {
      "from": 130.24,
      "to": 133.38,
      "sid": 55,
      "location": 2,
      "content": "三只用手腕或者只用手臂",
      "music": 0.1416666607638919
    },
    {
      "from": 133.38,
      "to": 137.73,
      "sid": 56,
      "location": 2,
      "content": "很多玩家会把自己定义成手腕流或者手臂流",
      "music": 0.0
    },
    {
      "from": 137.73,
      "to": 140.43,
      "sid": 57,
      "location": 2,
      "content": "有自己更习惯的方式没问题",
      "music": 0.2368420948753556
    },
    {
      "from": 140.43,
      "to": 142.55,
      "sid": 58,
      "location": 2,
      "content": "但如果只依赖其中一种",
      "music": 0.0
    },
    {
      "from": 142.55,
      "to": 144.31,
      "sid": 59,
      "location": 2,
      "content": "完全忽略其他部位",
      "music": 0.09467455061097144
    },
    {
      "from": 144.31,
      "to": 145.8,
      "sid": 60,
      "location": 2,
      "content": "就容易出问题",
      "music": 0.0
    },
    {
      "from": 145.8,
      "to": 150.739,
      "sid": 61,
      "location": 2,
      "content": "实际上整条手臂应该一起配合大范围移动",
      "music": 0.0
    },
    {
      "from": 150.739,
      "to": 152.059,
      "sid": 62,
      "location": 2,
      "content": "主要靠墙壁",
      "music": 0.0
    },
    {
      "from": 152.059,
      "to": 154.999,
      "sid": 63,
      "location": 2,
      "content": "手腕负责把准心带到目标上",
      "music": 0.36507935059208285
    },
    {
      "from": 154.999,
      "to": 158.03,
      "sid": 64,
      "location": 2,
      "content": "手指负责最后的小幅修正",
      "music": 0.0
    },
    {
      "from": 158.03,
      "to": 161.19,
      "sid": 65,
      "location": 2,
      "content": "如果其中一个部分没有参与其他部分",
      "music": 0.0
    },
    {
      "from": 161.19,
      "to": 166.02,
      "sid": 66,
      "location": 2,
      "content": "就只能去补偿大范围移动吃力就重点练前臂",
      "music": 0.0
    },
    {
      "from": 166.02,
      "to": 169.7,
      "sid": 67,
      "location": 2,
      "content": "准星很难快速对到目标就练手腕",
      "music": 0.0
    },
    {
      "from": 169.7,
      "to": 173.3,
      "sid": 68,
      "location": 2,
      "content": "远距离或者小目标经常打不准则",
      "music": 0.0
    },
    {
      "from": 173.3,
      "to": 176.25,
      "sid": 69,
      "location": 2,
      "content": "通常和手指的精细控制有关",
      "music": 0.08461538136095756
    },
    {
      "from": 176.25,
      "to": 177.99,
      "sid": 70,
      "location": 2,
      "content": "找到真正的弱项",
      "music": 0.0
    },
    {
      "from": 177.99,
      "to": 179.49,
      "sid": 71,
      "location": 2,
      "content": "再针对性训练",
      "music": 0.0
    },
    {
      "from": 179.49,
      "to": 183.19,
      "sid": 72,
      "location": 2,
      "content": "比每天重复刷同一套训练方案有效的多",
      "music": 0.0
    },
    {
      "from": 183.19,
      "to": 185.26,
      "sid": 73,
      "location": 2,
      "content": "四灵敏度不适合自己",
      "music": 0.0
    },
    {
      "from": 185.26,
      "to": 188.3,
      "sid": 74,
      "location": 2,
      "content": "灵敏度的问题不只是简单的太高或者太低",
      "music": 0.0
    },
    {
      "from": 188.3,
      "to": 189.88,
      "sid": 75,
      "location": 2,
      "content": "它还要适合你玩的游戏",
      "music": 0.11111110339506007
    },
    {
      "from": 189.88,
      "to": 192.84,
      "sid": 76,
      "location": 2,
      "content": "自己的打法以及实际能使用的鼠标空间",
      "music": 0.06569342825936621
    },
    {
      "from": 192.84,
      "to": 194.72,
      "sid": 77,
      "location": 2,
      "content": "更高的灵敏度适合更快",
      "music": 0.0
    },
    {
      "from": 194.72,
      "to": 196.34,
      "sid": 78,
      "location": 2,
      "content": "更强调反应的场景",
      "music": 0.0
    },
    {
      "from": 196.34,
      "to": 200.17,
      "sid": 79,
      "location": 2,
      "content": "更低的灵敏度则能给远距离跟枪带来更多控制",
      "music": 0.0
    },
    {
      "from": 200.17,
      "to": 202.03,
      "sid": 80,
      "location": 2,
      "content": "不同游戏的需求也不一样",
      "music": 0.0
    },
    {
      "from": 202.03,
      "to": 205.45,
      "sid": 81,
      "location": 2,
      "content": "如果灵敏度已经快到自己很难舒服的控制身体",
      "music": 0.0
    },
    {
      "from": 205.45,
      "to": 207.61,
      "sid": 82,
      "location": 2,
      "content": "就会下意识增加发力来补偿",
      "music": 0.0
    },
    {
      "from": 207.61,
      "to": 209.99,
      "sid": 83,
      "location": 2,
      "content": "这又会回到前面讲的发力问题",
      "music": 0.0
    },
    {
      "from": 209.99,
      "to": 211.29,
      "sid": 84,
      "location": 2,
      "content": "真正的目标是",
      "music": 0.0
    },
    {
      "from": 211.29,
      "to": 213.55,
      "sid": 85,
      "location": 2,
      "content": "找到一个自己能够稳定控制的灵敏度",
      "music": 0.0
    },
    {
      "from": 213.55,
      "to": 215.089,
      "sid": 86,
      "location": 2,
      "content": "然后坚持使用",
      "music": 0.0
    },
    {
      "from": 215.089,
      "to": 217.509,
      "sid": 87,
      "location": 2,
      "content": "如果你每隔几次训练就换一次",
      "music": 0.0
    },
    {
      "from": 217.509,
      "to": 220.009,
      "sid": 88,
      "location": 2,
      "content": "一直在寻找所谓更舒服的设置",
      "music": 0.0
    },
    {
      "from": 220.009,
      "to": 223.68,
      "sid": 89,
      "location": 2,
      "content": "那频繁换灵敏度这件事本身可能才是问题",
      "music": 0.0
    },
    {
      "from": 223.68,
      "to": 225.92,
      "sid": 90,
      "location": 2,
      "content": "关于怎么找适合自己的灵敏度",
      "music": 0.0
    },
    {
      "from": 225.92,
      "to": 228.08,
      "sid": 91,
      "location": 2,
      "content": "我们还有一期完整的视频链接",
      "music": 0.0
    },
    {
      "from": 228.08,
      "to": 229.61,
      "sid": 92,
      "location": 2,
      "content": "放在简介里",
      "music": 0.0
    },
    {
      "from": 229.93,
      "to": 233.29,
      "sid": 93,
      "location": 2,
      "content": "五手腕或者手肘一直固定在桌面上",
      "music": 0.0
    },
    {
      "from": 233.29,
      "to": 234.57,
      "sid": 94,
      "location": 2,
      "content": "第五个问题是",
      "music": 0.0
    },
    {
      "from": 234.57,
      "to": 237.6,
      "sid": 95,
      "location": 2,
      "content": "把手腕或者手肘一直固定在桌面上",
      "music": 0.0
    },
    {
      "from": 237.6,
      "to": 239.56,
      "sid": 96,
      "location": 2,
      "content": "正常搭在桌面上没问题",
      "music": 0.0
    },
    {
      "from": 239.56,
      "to": 241.77,
      "sid": 97,
      "location": 2,
      "content": "甚至可以帮助稳定和转动",
      "music": 0.0
    },
    {
      "from": 241.77,
      "to": 244.13,
      "sid": 98,
      "location": 2,
      "content": "但如果从头到尾都完全锁死",
      "music": 0.0
    },
    {
      "from": 244.13,
      "to": 245.73,
      "sid": 99,
      "location": 2,
      "content": "就会限制活动范围",
      "music": 0.0
    },
    {
      "from": 245.73,
      "to": 247.93,
      "sid": 100,
      "location": 2,
      "content": "逼着手臂的其他部分去完成",
      "music": 0.0
    },
    {
      "from": 247.93,
      "to": 249.61,
      "sid": 101,
      "location": 2,
      "content": "并不适合他们的动作",
      "music": 0.0
    },
    {
      "from": 249.61,
      "to": 251.73,
      "sid": 102,
      "location": 2,
      "content": "玩的时候可以观察一下自己",
      "music": 0.0
    },
    {
      "from": 251.73,
      "to": 255.33,
      "sid": 103,
      "location": 2,
      "content": "如果手腕或者手肘已经很长时间完全没动过",
      "music": 0.0
    },
    {
      "from": 255.33,
      "to": 256.519,
      "sid": 104,
      "location": 2,
      "content": "就要注意了",
      "music": 0.0
    },
    {
      "from": 256.519,
      "to": 259.259,
      "sid": 105,
      "location": 2,
      "content": "这里也不是让你整条手臂一直悬空",
      "music": 0.0
    },
    {
      "from": 259.259,
      "to": 261.89,
      "sid": 106,
      "location": 2,
      "content": "而是根据情况使用不同部位",
      "music": 0.0
    },
    {
