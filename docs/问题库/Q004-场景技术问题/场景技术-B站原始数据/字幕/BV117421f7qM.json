{
  "P1": [
    {
      "from": 0.24,
      "to": 4.01,
      "sid": 1,
      "location": 2,
      "content": "之前制作了一个关于薄片和如何正确训练它们的视频"
    },
    {
      "from": 4.01,
      "to": 7.01,
      "sid": 2,
      "location": 2,
      "content": "但我没有深入探讨一部电影后到底发生了什么"
    },
    {
      "from": 7.01,
      "to": 10.98,
      "sid": 3,
      "location": 2,
      "content": "瞄准微调最重要的一个方面"
    },
    {
      "from": 11.139,
      "to": 13.26,
      "sid": 4,
      "location": 2,
      "content": "我的团是什么"
    },
    {
      "from": 13.34,
      "to": 18.04,
      "sid": 5,
      "location": 2,
      "content": "微调是我们为获得目标而进行的小瞄准动作"
    },
    {
      "from": 18.04,
      "to": 20.22,
      "sid": 6,
      "location": 2,
      "content": "它们基本上发生在最初的"
    },
    {
      "from": 20.22,
      "to": 20.92,
      "sid": 7,
      "location": 2,
      "content": "就像"
    },
    {
      "from": 24.219,
      "to": 25.98,
      "sid": 8,
      "location": 2,
      "content": "在改变方向之后"
    },
    {
      "from": 28.42,
      "to": 30.34,
      "sid": 9,
      "location": 2,
      "content": "或者当我们只是在微观"
    },
    {
      "from": 30.34,
      "to": 31.3,
      "sid": 10,
      "location": 2,
      "content": "刚好在射程内"
    },
    {
      "from": 36.06,
      "to": 38.28,
      "sid": 11,
      "location": 2,
      "content": "为了正确地训练你的微技术"
    },
    {
      "from": 38.28,
      "to": 41.7,
      "sid": 12,
      "location": 2,
      "content": "重温基本方法和瞄准习惯是很重要的"
    },
    {
      "from": 41.7,
      "to": 43.79,
      "sid": 13,
      "location": 2,
      "content": "当训练你的微调整时"
    },
    {
      "from": 43.79,
      "to": 46.72,
      "sid": 14,
      "location": 2,
      "content": "你在练习中需要小心的是什么"
    },
    {
      "from": 49.24,
      "to": 50.7,
      "sid": 15,
      "location": 2,
      "content": "瞄准方法的理想"
    },
    {
      "from": 50.7,
      "to": 54.14,
      "sid": 16,
      "location": 2,
      "content": "当训练时，你的微调整是以一定程度的甜蜜来执行它们"
    },
    {
      "from": 54.14,
      "to": 56.56,
      "sid": 17,
      "location": 2,
      "content": "你希望你的微创作在理想情况下是平滑的"
    },
    {
      "from": 56.56,
      "to": 58.53,
      "sid": 18,
      "location": 2,
      "content": "为了开始强迫好的微技术"
    },
    {
      "from": 58.53,
      "to": 60.59,
      "sid": 19,
      "location": 2,
      "content": "因为这将有助于迫使正确的瞄准动作"
    },
    {
      "from": 60.59,
      "to": 65.54,
      "sid": 20,
      "location": 2,
      "content": "当涉及到调整剥离目标时，这将有利于您的控制发展"
    },
    {
      "from": 65.54,
      "to": 68.3,
      "sid": 21,
      "location": 2,
      "content": "在这个过程中，你不应该过度交易目标"
    },
    {
      "from": 68.3,
      "to": 71.179,
      "sid": 22,
      "location": 2,
      "content": "在这样做的时候应该总是有一定程度的速度匹配"
    },
    {
      "from": 72.2,
      "to": 74.94,
      "sid": 23,
      "location": 2,
      "content": "你想在投篮时保持纪律和深思熟虑"
    },
    {
      "from": 74.94,
      "to": 76.11,
      "sid": 24,
      "location": 2,
      "content": "微上市时"
    },
    {
      "from": 76.11,
      "to": 79.35,
      "sid": 25,
      "location": 2,
      "content": "这意味着不应该出现我们仓促出手的情况"
    },
    {
      "from": 79.35,
      "to": 82.259,
      "sid": 26,
      "location": 2,
      "content": "或者事先没有实际控制运动的垃圾邮件点击"
    },
    {
      "from": 82.3,
      "to": 85.7,
      "sid": 27,
      "location": 2,
      "content": "那应该是我们微观结构中不变的习惯"
    },
    {
      "from": 87.84,
      "to": 89.58,
      "sid": 28,
      "location": 2,
      "content": "目标交易对预交易至关重要"
    },
    {
      "from": 89.58,
      "to": 93.06,
      "sid": 29,
      "location": 2,
      "content": "确定目标扫射时微生物需要降落的地方"
    },
    {
      "from": 93.06,
      "to": 96.96,
      "sid": 30,
      "location": 2,
      "content": "在开始你的微调整之前，有一些老虎阅读是理想的"
    },
    {
      "from": 96.96,
      "to": 99.2,
      "sid": 31,
      "location": 2,
      "content": "因为这样可以建立一个正确的瞄准结构"
    },
    {
      "from": 99.2,
      "to": 102.22,
      "sid": 32,
      "location": 2,
      "content": "为了理解为什么要精确地瞄准你的CRO"
    },
    {
      "from": 105.62,
      "to": 108.539,
      "sid": 33,
      "location": 2,
      "content": "我们在训练我们的微生物时需要谨慎什么"
    },
    {
      "from": 109.14,
      "to": 111.18,
      "sid": 34,
      "location": 2,
      "content": "让我们从侵略性的微型开始"
    },
    {
      "from": 111.18,
      "to": 112.2,
      "sid": 35,
      "location": 2,
      "content": "攻击性微生物"
    },
    {
      "from": 112.2,
      "to": 114.33,
      "sid": 36,
      "location": 2,
      "content": "尽管这是不言自明的"
    },
    {
      "from": 114.33,
      "to": 116.13,
      "sid": 37,
      "location": 2,
      "content": "当我们把一个微小的调整"
    },
    {
      "from": 116.13,
      "to": 117.97,
      "sid": 38,
      "location": 2,
      "content": "我做了移动或目标"
    },
    {
      "from": 117.97,
      "to": 120.8,
      "sid": 39,
      "location": 2,
      "content": "以一种非常爆炸性和不受控制的方式"
    },
    {
      "from": 120.9,
      "to": 123.8,
      "sid": 40,
      "location": 2,
      "content": "效率动力将主要来自实际控制"
    },
    {
      "from": 123.8,
      "to": 127.92,
      "sid": 41,
      "location": 2,
      "content": "然而，你可以读取运动的类型，并相应地协调干扰运动"
    },
    {
      "from": 127.92,
      "to": 130.019,
      "sid": 42,
      "location": 2,
      "content": "但不是运动本身的真正速度"
    },
    {
      "from": 130.019,
      "to": 132.32,
      "sid": 43,
      "location": 2,
      "content": "这意味着你肯定能很快"
    },
    {
      "from": 132.32,
      "to": 135.16,
      "sid": 44,
      "location": 2,
      "content": "但如果你不习惯这个速度背后的正确瞄准习惯"
    },
    {
      "from": 135.16,
      "to": 138.26,
      "sid": 45,
      "location": 2,
      "content": "你的微精度会有很多不一致之处"
    },
    {
      "from": 138.26,
      "to": 140.34,
      "sid": 46,
      "location": 2,
      "content": "在你自由向微观过渡的过程中"
    },
    {
      "from": 142.06,
      "to": 144.16,
      "sid": 47,
      "location": 2,
      "content": "让我们继续紧张的习惯"
    },
    {
      "from": 144.239,
      "to": 147.019,
      "sid": 48,
      "location": 2,
      "content": "了解紧张可以与"
    },
    {
      "from": 147.019,
      "to": 148.55,
      "sid": 49,
      "location": 2,
      "content": "向下压入垫子"
    },
    {
      "from": 148.55,
      "to": 151.81,
      "sid": 50,
      "location": 2,
      "content": "而张力在一些微小的调整情况下是有益的"
    },
    {
      "from": 151.81,
      "to": 152.47,
      "sid": 51,
      "location": 2,
      "content": "例如"
    },
    {
      "from": 152.47,
      "to": 154.94,
      "sid": 52,
      "location": 2,
      "content": "增加我们微动作的爆发力"
    },
    {
      "from": 154.94,
      "to": 157.88,
      "sid": 53,
      "location": 2,
      "content": "向下压入垫子可能会产生额外的影响"
    },
    {
      "from": 157.88,
      "to": 158.52,
      "sid": 54,
      "location": 2,
      "content": "例如"
    },
    {
      "from": 158.52,
      "to": 160.38,
      "sid": 55,
      "location": 2,
      "content": "当我们按住一个升降按钮"
    },
    {
      "from": 160.38,
      "to": 162.18,
      "sid": 56,
      "location": 2,
      "content": "但对我们的微瞄准速度没有好处"
    },
    {
      "from": 162.18,
      "to": 162.88,
      "sid": 57,
      "location": 2,
      "content": "如果有什么"
    },
    {
      "from": 162.88,
      "to": 163.7,
      "sid": 58,
      "location": 2,
      "content": "它已经将你"
    },
    {
      "from": 163.7,
      "to": 165.4,
      "sid": 59,
      "location": 2,
      "content": "也限制了我们的微流动性"
    },
    {
      "from": 165.4,
      "to": 168.45,
      "sid": 60,
      "location": 2,
      "content": "因此，理想的情况是不要用力压入路径"
    },
    {
      "from": 168.45,
      "to": 170.29,
      "sid": 61,
      "location": 2,
      "content": "在执行你的微任务时"
    },
    {
      "from": 170.29,
      "to": 172.4,
      "sid": 62,
      "location": 2,
      "content": "从本质上讲，紧张应该是有限的"
    },
    {
      "from": 172.4,
      "to": 175.22,
      "sid": 63,
      "location": 2,
      "content": "重要的是不要依赖过度的张力"
    },
    {
      "from": 175.22,
      "to": 178.75,
      "sid": 64,
      "location": 2,
      "content": "因为这会降低我们的玫瑰平滑度，增加垃圾邮件点击的访问量"
    },
    {
      "from": 178.75,
      "to": 181.93,
      "sid": 65,
      "location": 2,
      "content": "这会使你很难在微观调整中减少攻击性"
    },
    {
      "from": 181.93,
      "to": 184.86,
      "sid": 66,
      "location": 2,
      "content": "当你不熟悉适当的紧张习惯时开始"
    },
    {
      "from": 184.86,
      "to": 187.44,
      "sid": 67,
      "location": 2,
      "content": "确保你没有养成不必要的紧张习惯"
    },
    {
      "from": 187.44,
      "to": 192.33,
      "sid": 68,
      "location": 2,
      "content": "你想在微晶的时候自由流畅地关注你的注意力水平"
    },
    {
      "from": 192.33,
      "to": 194.93,
      "sid": 69,
      "location": 2,
      "content": "试着减少来自指尖的张力"
    },
    {
      "from": 194.93,
      "to": 198.34,
      "sid": 70,
      "location": 2,
      "content": "不要依赖强烈的张力来控制"
    },
    {
      "from": 200.26,
      "to": 203.31,
      "sid": 71,
      "location": 2,
      "content": "最后但并非最不重要的是对我的纪律"
    },
    {
      "from": 203.31,
      "to": 206.27,
      "sid": 72,
      "location": 2,
      "content": "瞄准纪律是最重要的瞄准习惯之一"
    },
    {
      "from": 206.27,
      "to": 208.519,
      "sid": 73,
      "location": 2,
      "content": "为一致的微调整进行训练"
    },
    {
      "from": 208.519,
      "to": 213.719,
      "sid": 74,
      "location": 2,
      "content": "它本质上代表了与你的老虎协调强制投篮和控制投篮的能力"
    },
    {
      "from": 213.719,
      "to": 217.75,
      "sid": 75,
      "location": 2,
      "content": "真的，缺乏瞄准纪律会代表我们射击的情况"
    },
    {
      "from": 217.75,
      "to": 222.579,
      "sid": 76,
      "location": 2,
      "content": "一旦我们能够做出反应，我的超级快"
    },
    {
      "from": 222.579,
      "to": 225.679,
      "sid": 77,
      "location": 2,
      "content": "没有实际的纪律来允许我们自己开始微小的调整"
    },
    {
      "from": 225.679,
      "to": 226.72,
      "sid": 78,
      "location": 2,
      "content": "以适当的形式"
    },
    {
      "from": 227.5,
      "to": 232.48,
      "sid": 79,
      "location": 2,
      "content": "当目标突然出现在屏幕上时，这种纪律是理想的"
    },
    {
      "from": 232.48,
      "to": 234.56,
      "sid": 80,
      "location": 2,
      "content": "当它们突然改变方向时"
    },
    {
      "from": 234.56,
      "to": 238.68,
      "sid": 81,
      "location": 2,
      "content": "或者简单地说，当快速初始飞行后需要进行微小调整时"
    },
    {
      "from": 238.68,
      "to": 243.04,
      "sid": 82,
      "location": 2,
      "content": "像亚历山大或莎拉这样的球员在瓦兰斯和拉贝守望先锋展示台"
    },
    {
      "from": 243.04,
      "to": 244.72,
      "sid": 83,
      "location": 2,
      "content": "这个瞄准纪律非常好"
    },
    {
      "from": 244.72,
      "to": 247.34,
      "sid": 84,
      "location": 2,
      "content": "你可以注意到在他们开始拍摄之前有一些停机时间"
    },
    {
      "from": 247.34,
      "to": 249.64,
      "sid": 85,
      "location": 2,
      "content": "这种停机时间就是我所说的纪律"
    },
    {
      "from": 249.64,
      "to": 252.94,
      "sid": 86,
      "location": 2,
      "content": "在我们进入微调之前，我们先让自己读懂目标"
    },
    {
      "from": 252.94,
      "to": 254.98,
      "sid": 87,
      "location": 2,
      "content": "这让我们真正有效地进行时间马歇尔"
    },
    {
      "from": 254.98,
      "to": 256.459,
      "sid": 88,
      "location": 2,
      "content": "因为我们可以启动瞄准运动"
    },
    {
      "from": 256.459,
      "to": 259.079,
      "sid": 89,
      "location": 2,
      "content": "自信地进入目标的理想轨迹"
    },
    {
      "from": 259.079,
      "to": 261.16,
      "sid": 90,
      "location": 2,
      "content": "这个规律给了我们一个理想的瞄准形式"
    },
    {
      "from": 261.16,
      "to": 263.44,
      "sid": 91,
      "location": 2,
      "content": "至于何时启动微调"
    },
    {
      "from": 263.44,
      "to": 266.62,
      "sid": 92,
      "location": 2,
      "content": "本质上，我们想学会让自己从地球电影中充分学习"
    },
    {
      "from": 266.62,
      "to": 269.82,
      "sid": 93,
      "location": 2,
      "content": "然后以一种平稳而有效的方式启动我们的微工程"
    },
    {
      "from": 269.82,
      "to": 272.68,
      "sid": 94,
      "location": 2,
      "content": "瞄准纪律基本上是背后的心理过程"
    },
    {
      "from": 272.68,
      "to": 275.02,
      "sid": 95,
      "location": 2,
      "content": "当你最理想的时候"
    },
    {
      "from": 275.02,
      "to": 276.4,
      "sid": 96,
      "location": 2,
      "content": "会受到目标的影响"
    },
    {
      "from": 276.4,
      "to": 279.61,
      "sid": 97,
      "location": 2,
      "content": "阅读之后是瞄准过程本身"
    },
    {
      "from": 279.61,
      "to": 281.27,
      "sid": 98,
      "location": 2,
      "content": "受你的控制影响"
    },
    {
      "from": 281.27,
      "to": 282.87,
      "sid": 99,
      "location": 2,
      "content": "和瞄准习惯，如平滑"
    },
    {
      "from": 282.87,
      "to": 284.33,
      "sid": 100,
      "location": 2,
      "content": "紧张小说等"
    },
    {
      "from": 284.33,
      "to": 285.69,
      "sid": 101,
      "location": 2,
      "content": "两者都依赖于入侵者"
    },
    {
      "from": 285.69,
      "to": 289.29,
      "sid": 102,
      "location": 2,
      "content": "这就是为什么在训练宏时不要忽略它们中的任何一个是很重要的"
    },
    {
      "from": 289.29,
      "to": 290.64,
      "sid": 103,
      "location": 2,
      "content": "或者一般的瞄准"
    },
    {
      "from": 290.64,
      "to": 292.9,
      "sid": 104,
      "location": 2,
      "content": "如果你有任何问题，希望这个视频能有所帮助"
    },
    {
      "from": 292.9,
      "to": 294.2,
      "sid": 105,
      "location": 2,
      "content": "请随时在评论中伸出援手"
    },
    {
      "from": 294.2,
      "to": 295.48,
      "sid": 106,
      "location": 2,
      "content": "感谢大家的收看"
    }
  ]
}