{
  "P1": [
    {
      "from": 7.3,
      "to": 10.82,
      "sid": 1,
      "location": 2,
      "content": "这里是目标的诞生地"
    },
    {
      "from": 37.54,
      "to": 39.699,
      "sid": 2,
      "location": 2,
      "content": "如果你问我玛蒂"
    },
    {
      "from": 39.7,
      "to": 42.88,
      "sid": 3,
      "location": 2,
      "content": "你觉得什么样的目标最令人印象深刻"
    },
    {
      "from": 42.88,
      "to": 43.68,
      "sid": 4,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 43.68,
      "to": 47.98,
      "sid": 5,
      "location": 2,
      "content": "在鳏夫制造者身上，它不是快速的、勇敢的或华而不实的快速范围"
    },
    {
      "from": 47.98,
      "to": 48.82,
      "sid": 6,
      "location": 2,
      "content": "没有"
    },
    {
      "from": 48.82,
      "to": 49.7,
      "sid": 7,
      "location": 2,
      "content": "这些都不是"
    },
    {
      "from": 50.7,
      "to": 54.519,
      "sid": 8,
      "location": 2,
      "content": "对我来说最令人印象深刻的目标是这个"
    },
    {
      "from": 76.34,
      "to": 79.52,
      "sid": 9,
      "location": 2,
      "content": "一个意大利快速球员，也碰巧是"
    },
    {
      "from": 79.52,
      "to": 83.759,
      "sid": 10,
      "location": 2,
      "content": "如果不是所有瞄准训练中最流畅的跟踪球员"
    },
    {
      "from": 83.76,
      "to": 85.96,
      "sid": 11,
      "location": 2,
      "content": "看他的精准度"
    },
    {
      "from": 85.96,
      "to": 88.86,
      "sid": 12,
      "location": 2,
      "content": "他今天根本没有摆脱目标"
    },
    {
      "from": 88.86,
      "to": 90.74,
      "sid": 13,
      "location": 2,
      "content": "我们将欣赏幽灵的目标"
    },
    {
      "from": 90.74,
      "to": 94.6,
      "sid": 14,
      "location": 2,
      "content": "以及分解原始平滑子类别中使用的技术"
    },
    {
      "from": 94.6,
      "to": 96.7,
      "sid": 15,
      "location": 2,
      "content": "与精确跟踪相反"
    },
    {
      "from": 97.46,
      "to": 100.38,
      "sid": 16,
      "location": 2,
      "content": "如果你回顾一下OKY最古老的瞄准训练模型"
    },
    {
      "from": 100.38,
      "to": 105.329,
      "sid": 17,
      "location": 2,
      "content": "你会发现他在这么早的时候玩了相对正常的跟踪场景"
    },
    {
      "from": 105.329,
      "to": 106.869,
      "sid": 18,
      "location": 2,
      "content": "他还没有专门化"
    },
    {
      "from": 106.869,
      "to": 109.98,
      "sid": 19,
      "location": 2,
      "content": "就像大多数顶级瞄准者在单一类别中所做的那样"
    },
    {
      "from": 110.08,
      "to": 114.6,
      "sid": 20,
      "location": 2,
      "content": "在2011年4月幽灵发布了他的第一个中心世界纪录"
    },
    {
      "from": 114.6,
      "to": 118.87,
      "sid": 21,
      "location": 2,
      "content": "这是他在平滑跟踪场景中统治地位的开始"
    },
    {
      "from": 118.87,
      "to": 121.19,
      "sid": 22,
      "location": 2,
      "content": "居中是一种特殊的场景"
    },
    {
      "from": 121.19,
      "to": 125.25,
      "sid": 23,
      "location": 2,
      "content": "正是在这里，我们看到了原始平滑度和精确跟踪之间的区别"
    },
    {
      "from": 125.25,
      "to": 130.139,
      "sid": 24,
      "location": 2,
      "content": "作为子类，它们都依赖于鼠标连续运动的稳定性"
    },
    {
      "from": 132.0,
      "to": 137.28,
      "sid": 25,
      "location": 2,
      "content": "精确跟踪场景具有更多样化的斑点运动模式，通常是非线性的"
    },
    {
      "from": 137.28,
      "to": 140.0,
      "sid": 26,
      "location": 2,
      "content": "例如一个精确的恐惧和控制范围"
    },
    {
      "from": 140.979,
      "to": 144.579,
      "sid": 27,
      "location": 2,
      "content": "这些场景确实要求玩家在目标中有很好的平滑性"
    },
    {
      "from": 144.579,
      "to": 147.21,
      "sid": 28,
      "location": 2,
      "content": "但平滑本身并不是主要焦点"
    },
    {
      "from": 147.21,
      "to": 150.47,
      "sid": 29,
      "location": 2,
      "content": "居中对玩家的鼠标移动应用了更多的隔离"
    },
    {
      "from": 150.47,
      "to": 152.97,
      "sid": 30,
      "location": 2,
      "content": "以一种特别严格的模式"
    },
    {
      "from": 152.97,
      "to": 156.85,
      "sid": 31,
      "location": 2,
      "content": "几个像素宽度的机器人在没有加速度的情况下移动"
    },
    {
      "from": 156.85,
      "to": 157.83,
      "sid": 32,
      "location": 2,
      "content": "在一条直线上"
    },
    {
      "from": 157.83,
      "to": 158.77,
      "sid": 33,
      "location": 2,
      "content": "来来回回"
    },
    {
      "from": 158.77,
      "to": 160.2,
      "sid": 34,
      "location": 2,
      "content": "无变化"
    },
    {
      "from": 160.699,
      "to": 164.06,
      "sid": 35,
      "location": 2,
      "content": "这就是幽灵专业的原始光滑"
    },
    {
      "from": 166.26,
      "to": 169.44,
      "sid": 36,
      "location": 2,
      "content": "值得注意的是，仅仅居中是行不通的"
    },
    {
      "from": 169.48,
      "to": 170.16,
      "sid": 37,
      "location": 2,
      "content": "幽灵般的"
    },
    {
      "from": 170.16,
      "to": 173.94,
      "sid": 38,
      "location": 2,
      "content": "还玩了吨瘦战书和垂直流畅训练场景"
    },
    {
      "from": 173.94,
      "to": 175.14,
      "sid": 39,
      "location": 2,
      "content": "我们要记住"
    },
    {
      "from": 175.14,
      "to": 178.329,
      "sid": 40,
      "location": 2,
      "content": "在22年中期，有一段时间，在瞄准教练的平静时期"
    },
    {
      "from": 178.329,
      "to": 181.349,
      "sid": 41,
      "location": 2,
      "content": "在那里，库基可以说是名字训练中最好的跟踪球员"
    },
    {
      "from": 181.349,
      "to": 182.889,
      "sid": 42,
      "location": 2,
      "content": "有最高分和差距"
    },
    {
      "from": 182.889,
      "to": 187.24,
      "sid": 43,
      "location": 2,
      "content": "甚至对许多不同运动变化的反应性跟踪知识"
    },
    {
      "from": 187.24,
      "to": 191.66,
      "sid": 44,
      "location": 2,
      "content": "有助于幽灵在各种跟踪任务中持续得分的能力"
    },
    {
      "from": 191.66,
      "to": 192.74,
      "sid": 45,
      "location": 2,
      "content": "不只是罗斯"
    },
    {
      "from": 192.74,
      "to": 193.88,
      "sid": 46,
      "location": 2,
      "content": "莫斯一"
    },
    {
      "from": 195.22,
      "to": 198.96,
      "sid": 47,
      "location": 2,
      "content": "让我们回顾一下在平滑跟踪场景中得分的流行技术"
    },
    {
      "from": 199.38,
      "to": 203.58,
      "sid": 48,
      "location": 2,
      "content": "可能是在玩这些场景和训练时要记住的最重要的概念"
    },
    {
      "from": 203.58,
      "to": 205.88,
      "sid": 49,
      "location": 2,
      "content": "平滑是紧张管理"
    },
    {
      "from": 206.38,
      "to": 210.32,
      "sid": 50,
      "location": 2,
      "content": "这关系到你应该使用多大的张力和你应该在哪里使用它"
    },
    {
      "from": 210.42,
      "to": 213.14,
      "sid": 51,
      "location": 2,
      "content": "尽管本指南主要涉及被动跟踪"
    },
    {
      "from": 213.14,
      "to": 215.06,
      "sid": 52,
      "location": 2,
      "content": "你还是应该去看看"
    },
    {
      "from": 215.06,
      "to": 216.14,
      "sid": 53,
      "location": 2,
      "content": "反应瞄准导轨"
    },
    {
      "from": 216.14,
      "to": 218.02,
      "sid": 54,
      "location": 2,
      "content": "因为它分解得更详细"
    },
    {
      "from": 218.02,
      "to": 221.99,
      "sid": 55,
      "location": 2,
      "content": "这一部分将总结一下背后的紧张管理"
    },
    {
      "from": 221.99,
      "to": 225.33,
      "sid": 56,
      "location": 2,
      "content": "Spooky在原始平滑方面的能力是使用最小的张力"
    },
    {
      "from": 225.33,
      "to": 226.2,
      "sid": 57,
      "location": 2,
      "content": "跟踪时"
    },
    {
      "from": 226.2,
      "to": 229.7,
      "sid": 58,
      "location": 2,
      "content": "显然你需要一些张力来保持对目标的稳定跟踪"
    },
    {
      "from": 229.7,
      "to": 234.24,
      "sid": 59,
      "location": 2,
      "content": "但是Oky从来不会使用太多的张力来沉重地抓住鼠标"
    },
    {
      "from": 234.82,
      "to": 236.1,
      "sid": 60,
      "location": 2,
      "content": "紧绷手腕和手指"
    },
    {
      "from": 236.1,
      "to": 239.56,
      "sid": 61,
      "location": 2,
      "content": "往往是那些你在顶级球员身上看到的轻微紧张的原因"
    },
    {
      "from": 239.56,
      "to": 240.74,
      "sid": 62,
      "location": 2,
      "content": "光滑时尚"
    },
    {
      "from": 244.139,
      "to": 245.019,
      "sid": 63,
      "location": 2,
      "content": "幸运的是"
    },
    {
      "from": 245.019,
      "to": 246.979,
      "sid": 64,
      "location": 2,
      "content": "我们也可以准确地看到幽灵在哪里"
    },
    {
      "from": 246.979,
      "to": 250.14,
      "sid": 65,
      "location": 2,
      "content": "通过观察他的手凸轮来集中他手臂上的紧张"
    },
    {
      "from": 252.46,
      "to": 255.2,
      "sid": 66,
      "location": 2,
      "content": "我们可以非常清楚地观察到张力的转变"
    },
    {
      "from": 255.2,
      "to": 258.82,
      "sid": 67,
      "location": 2,
      "content": "取决于跟踪方向和每次扫射的持续时间"
    },
    {
      "from": 259.0,
      "to": 261.019,
      "sid": 68,
      "location": 2,
      "content": "我们可以将其分解如下"
    },
    {
      "from": 261.019,
      "to": 265.76,
      "sid": 69,
      "location": 2,
      "content": "假设每次机器人改变方向时，我们都玩基本的无变化定心游戏"
    },
    {
      "from": 265.76,
      "to": 269.44,
      "sid": 70,
      "location": 2,
      "content": "我们想从把张力转移到手腕上开始"
    },
    {
      "from": 269.44,
      "to": 272.66,
      "sid": 71,
      "location": 2,
      "content": "然后我们想尽可能长时间地继续使用手腕"
    },
    {
      "from": 272.66,
      "to": 274.1,
      "sid": 72,
      "location": 2,
      "content": "在伸展太多之前"
    },
    {
      "from": 274.1,
      "to": 275.86,
      "sid": 73,
      "location": 2,
      "content": "放射状的或老的粗糙的"
    },
    {
      "from": 277.94,
      "to": 281.48,
      "sid": 74,
      "location": 2,
      "content": "当我们到达一个点，在这些方向上感觉太多了"
    },
    {
      "from": 281.48,
      "to": 283.78,
      "sid": 75,
      "location": 2,
      "content": "我们需要把紧张转移到我们的前臂"
    },
    {
      "from": 283.78,
      "to": 287.58,
      "sid": 76,
      "location": 2,
      "content": "用手臂瞄准继续跟踪扫射，直到下一个支点"
    },
    {
      "from": 290.96,
      "to": 292.08,
      "sid": 77,
      "location": 2,
      "content": "我们可能会注意到"
    },
    {
      "from": 292.08,
      "to": 295.94,
      "sid": 78,
      "location": 2,
      "content": "在手腕旋转的过程中，保持适当的平滑变得有点棘手"
    },
    {
      "from": 295.94,
      "to": 300.1,
      "sid": 79,
      "location": 2,
      "content": "尤其是在将径向偏移和尺向偏移分开的位置"
    },
    {
      "from": 300.1,
      "to": 301.42,
      "sid": 80,
      "location": 2,
      "content": "反之亦然"
    },
    {
      "from": 304.02,
      "to": 304.98,
      "sid": 81,
      "location": 2,
      "content": "训练稳定性"
    },
    {
      "from": 304.98,
      "to": 307.82,
      "sid": 82,
      "location": 2,
      "content": "练习紧张管理有助于缓解这种情况"
    },
    {
      "from": 307.82,
      "to": 310.45,
      "sid": 83,
      "location": 2,
      "content": "以及鼠标有一个很好的中立位置"
    },
    {
      "from": 310.45,
      "to": 311.67,
      "sid": 84,
      "location": 2,
      "content": "就是因为这个原因"
    },
    {
      "from": 311.67,
      "to": 316.56,
      "sid": 85,
      "location": 2,
      "content": "除了手腕健康风险，你应该尽量避免开始风险偏差"
    },
    {
      "from": 318.38,
      "to": 321.22,
      "sid": 86,
      "location": 2,
      "content": "您可能还会注意到对枢轴的强烈关注"
    },
    {
      "from": 321.22,
      "to": 323.58,
      "sid": 87,
      "location": 2,
      "content": "手腕围绕固定点的旋转"
    },
    {
      "from": 324.079,
      "to": 328.679,
      "sid": 88,
      "location": 2,
      "content": "你的枢轴的稳定性将在很大程度上取决于有多强或多好地定义"
    },
    {
      "from": 328.679,
      "to": 330.3,
      "sid": 89,
      "location": 2,
      "content": "这个不动点是"
    },
    {
      "from": 330.32,
      "to": 333.58,
      "sid": 90,
      "location": 2,
      "content": "这就是VT三叶草枢轴最大技术背后的想法"
    },
    {
      "from": 333.58,
      "to": 336.06,
      "sid": 91,
      "location": 2,
      "content": "他的中指向内弯曲"
    },
    {
      "from": 336.06,
      "to": 338.6,
      "sid": 92,
      "location": 2,
      "content": "给自己一个更稳定的支点"
    },
    {
      "from": 341.22,
      "to": 342.94,
      "sid": 93,
      "location": 2,
      "content": "当我们进入更艰难的阶段"
    },
    {
      "from": 342.94,
      "to": 343.34,
      "sid": 94,
      "location": 2,
      "content": "生的"
    },
    {
      "from": 343.34,
      "to": 346.46,
      "sid": 95,
      "location": 2,
      "content": "最平滑的变体，如VT交换轨道和VT迷你轨道"
    },
    {
      "from": 346.46,
      "to": 348.36,
      "sid": 96,
      "location": 2,
      "content": "我们真的看到了幽灵"
    },
    {
      "from": 348.36,
      "to": 352.179,
      "sid": 97,
      "location": 2,
      "content": "对鼠标垫空间的慷慨使用为许多玩家带来了他"
    },
    {
      "from": 352.179,
      "to": 354.299,
      "sid": 98,
      "location": 2,
      "content": "知道如何充分利用他们的鼠标垫"
    },
    {
      "from": 354.299,
      "to": 357.699,
      "sid": 99,
      "location": 2,
      "content": "正确的时间重置他们的鼠标位置已经成为一个棘手的障碍"
    },
    {
      "from": 357.699,
      "to": 359.08,
      "sid": 100,
      "location": 2,
      "content": "关于这些平滑变体"
    },
    {
      "from": 361.799,
      "to": 365.159,
      "sid": 101,
      "location": 2,
      "content": "解决这个问题的最简单方法是研究机器人模式"
    },
    {
      "from": 365.159,
      "to": 367.899,
      "sid": 102,
      "location": 2,
      "content": "强迫自己突破舒适区的界限"
    },
    {
      "from": 367.899,
      "to": 369.58,
      "sid": 103,
      "location": 2,
      "content": "在我们的鼠标垫周围"
    },
    {
      "from": 369.64,
      "to": 372.66,
      "sid": 104,
      "location": 2,
      "content": "理想情况下，我们希望利用整个空间"
    },
    {
      "from": 372.719,
      "to": 375.419,
      "sid": 105,
      "location": 2,
      "content": "什么时候重置我们的鼠标合适"
    },
    {
      "from": 375.419,
      "to": 377.479,
      "sid": 106,
      "location": 2,
      "content": "很明显如果我们在垫子的边缘"
    },
    {
      "from": 377.479,
      "to": 379.319,
      "sid": 107,
      "location": 2,
      "content": "机器人还在接近一个支点"
    },
    {
      "from": 379.319,
      "to": 380.98,
      "sid": 108,
      "location": 2,
      "content": "然后我们需要重置"
    },
    {
      "from": 381.0,
      "to": 381.86,
      "sid": 109,
      "location": 2,
      "content": "否则"
    },
    {
      "from": 381.86,
      "to": 385.68,
      "sid": 110,
      "location": 2,
      "content": "重置的最佳时刻是机器人即将改变其直线方向的时候"
    },
    {
      "from": 385.68,
      "to": 388.88,
      "sid": 111,
      "location": 2,
      "content": "我们已经在向一个尴尬的鼠标角度前进"
    },
    {
      "from": 390.6,
      "to": 394.06,
      "sid": 112,
      "location": 2,
      "content": "最好的例子是当屁股弹跳时"
    },
    {
      "from": 394.06,
      "to": 396.76,
      "sid": 113,
      "location": 2,
      "content": "我们已经用了大部分舒适的空间"
    },
    {
      "from": 396.92,
      "to": 399.22,
      "sid": 114,
      "location": 2,
      "content": "空间不足造成的限制"
    },
    {
      "from": 399.22,
      "to": 402.32,
      "sid": 115,
      "location": 2,
      "content": "当运行太低时，复位的需要可能会变得更糟"
    },
    {
      "from": 402.32,
      "to": 403.5,
      "sid": 116,
      "location": 2,
      "content": "一种敏感"
    },
    {
      "from": 406.219,
      "to": 409.759,
      "sid": 117,
      "location": 2,
      "content": "当播放像居中这样的场景时，低灵敏度会有很大帮助"
    },
    {
      "from": 409.759,
      "to": 411.399,
      "sid": 118,
      "location": 2,
      "content": "但为了最大限度地利用它"
    },
    {
      "from": 411.399,
      "to": 413.48,
      "sid": 119,
      "location": 2,
      "content": "你应该用更高的灵敏度"
    },
    {
      "from": 413.64,
      "to": 416.97,
      "sid": 120,
      "location": 2,
      "content": "这样做可以让你专注于手腕和指尖的技能"
    },
    {
      "from": 416.97,
      "to": 418.71,
      "sid": 121,
      "location": 2,
      "content": "如果你想优化分数"
    },
    {
      "from": 418.71,
      "to": 420.64,
      "sid": 122,
      "location": 2,
      "content": "为你的手臂更光滑而努力"
    },
    {
      "from": 420.64,
      "to": 422.7,
      "sid": 123,
      "location": 2,
      "content": "您应该考虑运行较低的灵敏度"
    },
    {
      "from": 422.7,
      "to": 426.32,
      "sid": 124,
      "location": 2,
      "content": "但不要太低，以至于你用完了所有的鼠标垫空间"
    },
    {
      "from": 426.32,
      "to": 428.26,
      "sid": 125,
      "location": 2,
      "content": "在机器人方向改变之前"
    },
    {
      "from": 430.219,
      "to": 433.32,
      "sid": 126,
      "location": 2,
      "content": "这些都是被原始平滑强化的概念"
    },
    {
      "from": 433.32,
      "to": 436.0,
      "sid": 127,
      "location": 2,
      "content": "但大多数跟踪场景会有不同的模式"
    },
    {
      "from": 436.0,
      "to": 439.78,
      "sid": 128,
      "location": 2,
      "content": "在真正的游戏中，没有一个大脑正常的人会轻松地移动"
    },
    {
      "from": 439.78,
      "to": 441.26,
      "sid": 129,
      "location": 2,
      "content": "严格线性模式"
    },
    {
      "from": 441.34,
      "to": 442.68,
      "sid": 130,
      "location": 2,
      "content": "那么有什么意义呢"
    },
    {
      "from": 442.68,
      "to": 446.45,
      "sid": 131,
      "location": 2,
      "content": "嗯，幽灵仍然是世界上最强的跟踪玩家之一"
    },
    {
      "from": 446.45,
      "to": 449.67,
      "sid": 132,
      "location": 2,
      "content": "刻度转移不在整体跟踪运动中"
    },
    {
      "from": 449.67,
      "to": 454.48,
      "sid": 133,
      "location": 2,
      "content": "但在将世界纪录与简单的好成绩区分开来的细节中"
    },
    {
      "from": 454.98,
      "to": 456.22,
      "sid": 134,
      "location": 2,
      "content": "即使在更快的时间里"
    },
    {
      "from": 456.22,
      "to": 457.3,
      "sid": 135,
      "location": 2,
      "content": "反应情景"
    },
    {
      "from": 457.3,
      "to": 460.88,
      "sid": 136,
      "location": 2,
      "content": "在快速扫射的间隙中，你仍然需要原始的平滑"
    },
    {
      "from": 460.88,
      "to": 463.02,
      "sid": 137,
      "location": 2,
      "content": "以获得尽可能多的点击量"
    },
    {
      "from": 465.339,
      "to": 467.459,
      "sid": 138,
      "location": 2,
      "content": "这在真实游戏中更加适用"
    },
    {
      "from": 467.459,
      "to": 469.399,
      "sid": 139,
      "location": 2,
      "content": "更混乱的瞄准情况"
    },
    {
      "from": 469.399,
      "to": 473.22,
      "sid": 140,
      "location": 2,
      "content": "装满瞄准滤镜可以通过平滑瞄准使其更容易"
    },
    {
      "from": 473.44,
      "to": 476.18,
      "sid": 141,
      "location": 2,
      "content": "我在上一集的瞄准秘密中介绍过它是如何工作的"
    },
    {
      "from": 476.18,
      "to": 478.0,
      "sid": 142,
      "location": 2,
      "content": "以雪十字为特色"
    },
    {
      "from": 478.0,
      "to": 481.76,
      "sid": 143,
      "location": 2,
      "content": "平滑也有助于我们更容易识别整体扫射动作"
    },
    {
      "from": 481.76,
      "to": 485.0,
      "sid": 144,
      "location": 2,
      "content": "而不是在瞬时扫射上诉诸隧道视觉"
    },
    {
      "from": 485.0,
      "to": 486.58,
      "sid": 145,
      "location": 2,
      "content": "我们从训练中获得的稳定性"
    },
    {
      "from": 486.58,
      "to": 489.44,
      "sid": 146,
      "location": 2,
      "content": "它在游戏中对我们的好处就像在瞄准训练师中一样"
    },
    {
      "from": 489.44,
      "to": 494.0,
      "sid": 147,
      "location": 2,
      "content": "通过让我们在近距离决斗中打出几个额外的关键镜头来拯救我们"
    },
    {
      "from": 495.7,
      "to": 498.0,
      "sid": 148,
      "location": 2,
      "content": "记住它补充了一些小细节"
    },
    {
      "from": 498.0,
      "to": 498.84,
      "sid": 149,
      "location": 2,
      "content": "那些点击率"
    },
    {
      "from": 498.84,
      "to": 499.86,
      "sid": 150,
      "location": 2,
      "content": "虽然很难注意到"
    },
    {
      "from": 499.86,
      "to": 502.659,
      "sid": 151,
      "location": 2,
      "content": "会把最初失败的决斗变成胜利"
    },
    {
      "from": 502.659,
      "to": 503.719,
      "sid": 152,
      "location": 2,
      "content": "这更重要"
    },
    {
      "from": 503.719,
      "to": 507.4,
      "sid": 153,
      "location": 2,
      "content": "随着我们正在玩的游戏的ttk增加，像守望先锋这样的游戏"
    },
    {
      "from": 507.4,
      "to": 508.24,
      "sid": 154,
      "location": 2,
      "content": "顶点传说"
    },
    {
      "from": 508.24,
      "to": 508.72,
      "sid": 155,
      "location": 2,
      "content": "决赛"
    },
    {
      "from": 508.72,
      "to": 513.36,
      "sid": 156,
      "location": 2,
      "content": "竞技场FPS通常会跟踪更稳定的玩家会赢的情况"
    },
    {
      "from": 513.36,
      "to": 515.099,
      "sid": 157,
      "location": 2,
      "content": "仅仅是获得更多的点击率"
    },
    {
      "from": 517.799,
      "to": 519.5,
      "sid": 158,
      "location": 2,
      "content": "因为这些较小的好处"
    },
    {
      "from": 519.5,
      "to": 521.94,
      "sid": 159,
      "location": 2,
      "content": "我相信流畅是一种被低估的技能"
    },
    {
      "from": 521.94,
      "to": 524.039,
      "sid": 160,
      "location": 2,
      "content": "和瞄准训练师之外的FPS"
    },
    {
      "from": 524.039,
      "to": 525.76,
      "sid": 161,
      "location": 2,
      "content": "显然作为瞄准训练师"
    },
    {
      "from": 525.76,
      "to": 528.55,
      "sid": 162,
      "location": 2,
      "content": "我们可以亲身体验罗斯月亮的力量"
    },
    {
      "from": 528.55,
      "to": 531.31,
      "sid": 163,
      "location": 2,
      "content": "但是所有FPS的这么多玩家都结束了"
    },
    {
      "from": 531.31,
      "to": 533.71,
      "sid": 164,
      "location": 2,
      "content": "专注于快速轻弹和华而不实的瞄准"
    },
    {
      "from": 533.71,
      "to": 535.439,
      "sid": 165,
      "location": 2,
      "content": "就像裹尸布和尖叫"
    },
    {
      "from": 535.96,
      "to": 539.64,
      "sid": 166,
      "location": 2,
      "content": "但归根结底，世界上最好的瞄准者必须是稳定的瞄准者"
    },
    {
      "from": 539.64,
      "to": 541.64,
      "sid": 167,
      "location": 2,
      "content": "能在目标上保持轨迹的"
    },
    {
      "from": 541.64,
      "to": 545.24,
      "sid": 168,
      "location": 2,
      "content": "不会因为轻微的颤抖或手腕颤抖而损失一颗子弹"
    },
    {
      "from": 545.74,
      "to": 548.6,
      "sid": 169,
      "location": 2,
      "content": "我希望你们喜欢这集的目的秘密"
    },
    {
      "from": 548.6,
      "to": 551.24,
      "sid": 170,
      "location": 2,
      "content": "告诉我你们下一部想看什么"
    },
    {
      "from": 551.24,
      "to": 553.16,
      "sid": 171,
      "location": 2,
      "content": "检查我的抽搐，看看决赛的流"
    },
    {
      "from": 553.16,
      "to": 554.56,
      "sid": 172,
      "location": 2,
      "content": "监视和瞄准训练"
    },
    {
      "from": 554.56,
      "to": 556.0,
      "sid": 173,
      "location": 2,
      "content": "我们下期视频再见"
    },
    {
      "from": 556.0,
      "to": 557.06,
      "sid": 174,
      "location": 2,
      "content": "或者瞄准机器人"
    },
    {
      "from": 557.08,
      "to": 558.64,
      "sid": 175,
      "location": 2,
      "content": "快乐点点击"
    }
  ]
}