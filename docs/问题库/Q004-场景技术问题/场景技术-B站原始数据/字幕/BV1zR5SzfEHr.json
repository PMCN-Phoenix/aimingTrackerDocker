{
  "P1": [
    {
      "from": 0.04,
      "to": 3.88,
      "sid": 1,
      "location": 2,
      "content": "哎呀你说那些高手准心一甩就能爆头的操作",
      "music": 0.0
    },
    {
      "from": 3.88,
      "to": 5.24,
      "sid": 2,
      "location": 2,
      "content": "到底是咋做到的",
      "music": 0.0
    },
    {
      "from": 5.24,
      "to": 7.32,
      "sid": 3,
      "location": 2,
      "content": "怎么我练了这么久也打不出来呢",
      "music": 0.0
    },
    {
      "from": 7.32,
      "to": 10.67,
      "sid": 4,
      "location": 2,
      "content": "呃嗯你执着于去练这么一个根本不存在的东西",
      "music": 0.0
    },
    {
      "from": 10.67,
      "to": 12.07,
      "sid": 5,
      "location": 2,
      "content": "那能练的出来才怪了",
      "music": 0.0
    },
    {
      "from": 12.07,
      "to": 13.06,
      "sid": 6,
      "location": 2,
      "content": "这有啥意思",
      "music": 0.0
    },
    {
      "from": 13.06,
      "to": 15.9,
      "sid": 7,
      "location": 2,
      "content": "因为你被这种一甩就爆头的假象给骗了呀",
      "music": 0.0
    },
    {
      "from": 15.9,
      "to": 19.12,
      "sid": 8,
      "location": 2,
      "content": "你所看到的是一个高手瞄准速度很快的结果",
      "music": 0.0
    },
    {
      "from": 19.12,
      "to": 21.12,
      "sid": 9,
      "location": 2,
      "content": "但实际上他们实现这个结果",
      "music": 0.0
    },
    {
      "from": 21.12,
      "to": 22.96,
      "sid": 10,
      "location": 2,
      "content": "是经过了两个瞄准步骤的",
      "music": 0.0
    },
    {
      "from": 22.96,
      "to": 25.72,
      "sid": 11,
      "location": 2,
      "content": "你现在错误的追求这种一甩就爆头的操作",
      "music": 0.0
    },
    {
      "from": 25.72,
      "to": 27.18,
      "sid": 12,
      "location": 2,
      "content": "直接缺少了一半的步骤",
      "music": 0.0
    },
    {
      "from": 27.18,
      "to": 29.73,
      "sid": 13,
      "location": 2,
      "content": "那当然练不出同样的结果了啊",
      "music": 0.0
    },
    {
      "from": 29.73,
      "to": 31.61,
      "sid": 14,
      "location": 2,
      "content": "那完整的两个步骤是啥",
      "music": 0.0
    },
    {
      "from": 31.61,
      "to": 33.67,
      "sid": 15,
      "location": 2,
      "content": "依次瞄准加上微调",
      "music": 0.0
    },
    {
      "from": 33.67,
      "to": 35.55,
      "sid": 16,
      "location": 2,
      "content": "可是为啥非得两个步骤呢",
      "music": 0.0
    },
    {
      "from": 35.55,
      "to": 38.52,
      "sid": 17,
      "location": 2,
      "content": "因为瞄准的速度和准度是互相矛盾的",
      "music": 0.0
    },
    {
      "from": 38.52,
      "to": 39.16,
      "sid": 18,
      "location": 2,
      "content": "没办法",
      "music": 0.0
    },
    {
      "from": 39.16,
      "to": 42.04,
      "sid": 19,
      "location": 2,
      "content": "又要又要我们用非常快的速度去移动准星",
      "music": 0.0
    },
    {
      "from": 42.04,
      "to": 43.72,
      "sid": 20,
      "location": 2,
      "content": "那精准度就一定会下降",
      "music": 0.0
    },
    {
      "from": 43.72,
      "to": 46.6,
      "sid": 21,
      "location": 2,
      "content": "想控制准星很精确的落在自己想要的位置",
      "music": 0.0
    },
    {
      "from": 46.6,
      "to": 48.0,
      "sid": 22,
      "location": 2,
      "content": "那就只能慢慢挪",
      "music": 0.0
    },
    {
      "from": 48.0,
      "to": 49.52,
      "sid": 23,
      "location": 2,
      "content": "显然两种都不实际",
      "music": 0.0
    },
    {
      "from": 49.52,
      "to": 50.36,
      "sid": 24,
      "location": 2,
      "content": "那换个角度想",
      "music": 0.0
    },
    {
      "from": 50.36,
      "to": 51.1,
      "sid": 25,
      "location": 2,
      "content": "你就会发现",
      "music": 0.0
    },
    {
      "from": 51.1,
      "to": 53.2,
      "sid": 26,
      "location": 2,
      "content": "如果我们没法同时做到快和准",
      "music": 0.0
    },
    {
      "from": 53.2,
      "to": 54.72,
      "sid": 27,
      "location": 2,
      "content": "那我把它分成两个步骤来",
      "music": 0.0
    },
    {
      "from": 54.72,
      "to": 55.54,
      "sid": 28,
      "location": 2,
      "content": "一个负责快",
      "music": 0.0
    },
    {
      "from": 55.54,
      "to": 57.24,
      "sid": 29,
      "location": 2,
      "content": "一个负责准不就行了吗",
      "music": 0.0
    },
    {
      "from": 57.24,
      "to": 60.18,
      "sid": 30,
      "location": 2,
      "content": "所以说你应该先做一个尽可能快的一次瞄准",
      "music": 0.0
    },
    {
      "from": 60.18,
      "to": 62.68,
      "sid": 31,
      "location": 2,
      "content": "在一瞬间把准星先送到目标附近去",
      "music": 0.0
    },
    {
      "from": 62.68,
      "to": 64.819,
      "sid": 32,
      "location": 2,
      "content": "然后再做一个相对慢的微调",
      "music": 0.0
    },
    {
      "from": 64.819,
      "to": 66.079,
      "sid": 33,
      "location": 2,
      "content": "细腻的控制准心",
      "music": 0.0
    },
    {
      "from": 66.079,
      "to": 67.499,
      "sid": 34,
      "location": 2,
      "content": "最终落到目标脑袋上",
      "music": 0.0
    },
    {
      "from": 67.499,
      "to": 69.16,
      "sid": 35,
      "location": 2,
      "content": "因为第一次的预瞄准",
      "music": 0.0
    },
    {
      "from": 69.16,
      "to": 71.3,
      "sid": 36,
      "location": 2,
      "content": "已经让准星离目标非常近了",
      "music": 0.0
    },
    {
      "from": 71.3,
      "to": 72.56,
      "sid": 37,
      "location": 2,
      "content": "所以即使我们微调时",
      "music": 0.0
    },
    {
      "from": 72.56,
      "to": 73.86,
      "sid": 38,
      "location": 2,
      "content": "准星的移动速度很慢",
      "music": 0.0
    },
    {
      "from": 73.86,
      "to": 76.38,
      "sid": 39,
      "location": 2,
      "content": "这段路程也只需要花费一点点的时间了",
      "music": 0.0
    },
    {
      "from": 76.38,
      "to": 79.7,
      "sid": 40,
      "location": 2,
      "content": "这样才能实现你想要的又快又准的结果",
      "music": 0.0
    },
    {
      "from": 79.7,
      "to": 80.6,
      "sid": 41,
      "location": 2,
      "content": "缺水",
      "music": 0.0
    },
    {
      "from": 80.6,
      "to": 82.58,
      "sid": 42,
      "location": 2,
      "content": "我之前就是没有做微调",
      "music": 0.0
    },
    {
      "from": 82.58,
      "to": 83.96,
      "sid": 43,
      "location": 2,
      "content": "难怪只能甩的快",
      "music": 0.0
    },
    {
      "from": 83.96,
      "to": 85.1,
      "sid": 44,
      "location": 2,
      "content": "但根本打不准的",
      "music": 0.0
    },
    {
      "from": 85.1,
