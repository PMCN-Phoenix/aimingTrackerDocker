  },
  {
   "from": 195.1,
   "to": 195.88,
   "sid": 101,
   "location": 2,
   "content": "也就是说",
   "music": 0.0
  },
  {
   "from": 195.88,
   "to": 198.4,
   "sid": 102,
   "location": 2,
   "content": "假如有一天你的瞄准水平达到了所谓的六水平",
