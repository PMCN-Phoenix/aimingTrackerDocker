 "body": [
  {
   "from": 6.32,
   "to": 7.24,
   "sid": 1,
   "location": 2,
   "content": "各位朋友大家好",
   "music": 0.0
  },
  {
   "from": 7.24,
   "to": 7.84,
   "sid": 2,
   "location": 2,
   "content": "我是东彦",
   "music": 0.0
  },
  {
   "from": 7.84,
   "to": 10.15,
   "sid": 3,
   "location": 2,
   "content": "我今天带来这个瞄准系列教学第五期",
   "music": 0.0
  },
  {
   "from": 10.15,
   "to": 12.7,
   "sid": 4,
   "location": 2,
   "content": "我们在前面几期教学中阐述了瞄准的精髓",
   "music": 0.0
  },
  {
   "from": 12.7,
   "to": 13.54,
   "sid": 5,
   "location": 2,
   "content": "也是手眼协调",
   "music": 0.0
  },
  {
   "from": 13.54,
   "to": 14.52,
   "sid": 6,
   "location": 2,
   "content": "而不是肌肉记忆",
   "music": 0.0
  },
  {
   "from": 14.52,
   "to": 16.5,
   "sid": 7,
   "location": 2,
   "content": "又分别讲清楚了手部控制能力",
   "music": 0.0
  },
  {
   "from": 16.5,
   "to": 18.21,
   "sid": 8,
   "location": 2,
   "content": "和眼镜阅读的练习方法",
   "music": 0.0
  },
  {
   "from": 18.21,
   "to": 19.44,
   "sid": 9,
   "location": 2,
   "content": "同时还教会了大家",
   "music": 0.0
  },
  {
   "from": 19.44,
   "to": 21.39,
   "sid": 10,
   "location": 2,
   "content": "如何优化自己的握法和发力方式",
   "music": 0.0
  },
  {
   "from": 21.39,
   "to": 23.67,
   "sid": 11,
   "location": 2,
   "content": "嗯但根据很多观众朋友的反馈",
   "music": 0.0
  },
  {
   "from": 23.67,
   "to": 25.95,
   "sid": 12,
   "location": 2,
   "content": "我发现还是有蛮多朋友在使用练枪软件",
   "music": 0.0
  },
  {
   "from": 25.95,
   "to": 27.33,
   "sid": 13,
   "location": 2,
   "content": "来提升自身瞄准能力的时候",
   "music": 0.0
  },
  {
   "from": 27.33,
   "to": 28.29,
   "sid": 14,
   "location": 2,
   "content": "存在一些误区",
   "music": 0.0
  },
  {
   "from": 28.29,
   "to": 30.67,
   "sid": 15,
   "location": 2,
   "content": "跟枪猎人猎人实战反而越拉胯了",
   "music": 0.0
  },
  {
   "from": 30.67,
   "to": 33.25,
   "sid": 16,
   "location": 2,
   "content": "所以今天我来教大家如何更有效的练枪",
   "music": 0.0
  },
  {
   "from": 33.25,
   "to": 34.27,
   "sid": 17,
   "location": 2,
   "content": "同时再让大家知道",
   "music": 0.0
  },
  {
   "from": 34.27,
   "to": 36.07,
   "sid": 18,
   "location": 2,
   "content": "练枪对于实战到底有什么作用",
   "music": 0.0
  },
  {
   "from": 36.07,
   "to": 39.08,
   "sid": 19,
   "location": 2,
   "content": "练枪软件的局限性到底在哪里嗯",
   "music": 0.0
  },
  {
   "from": 39.08,
   "to": 41.54,
   "sid": 20,
   "location": 2,
   "content": "练枪软件相比于实战最有用的地方就在于",
   "music": 0.0
  },
  {
   "from": 41.54,
   "to": 44.63,
   "sid": 21,
   "location": 2,
   "content": "练枪软件对于瞄准水平提升更加直接和有效",
   "music": 0.0
  },
  {
   "from": 44.63,
   "to": 47.819,
   "sid": 22,
   "location": 2,
   "content": "你打一局CSGO瞄准定位的次数可能也就数十次",
   "music": 0.0
  },
  {
   "from": 47.819,
   "to": 50.909,
   "sid": 23,
   "location": 2,
   "content": "但打练枪软件一分钟可能就定位300多次",
   "music": 0.0
  },
  {
   "from": 50.909,
   "to": 52.919,
   "sid": 24,
   "location": 2,
   "content": "如此集中并针对性的练习",
   "music": 0.0
  },
  {
   "from": 52.919,
   "to": 55.36,
   "sid": 25,
   "location": 2,
   "content": "对于瞄准水平提高是有着显著作用的",
   "music": 0.0
  },
  {
   "from": 55.36,
   "to": 57.46,
   "sid": 26,
   "location": 2,
   "content": "同时练枪软件还以分数的形式",
   "music": 0.0
  },
  {
   "from": 57.46,
   "to": 59.14,
   "sid": 27,
   "location": 2,
   "content": "时刻对你自身的瞄准能力",
   "music": 0.0
  },
  {
   "from": 59.14,
   "to": 61.5,
   "sid": 28,
   "location": 2,
   "content": "提供了一个可量化的一个反馈呃",
   "music": 0.0
  },
  {
   "from": 61.5,
   "to": 63.06,
   "sid": 29,
   "location": 2,
   "content": "如果你的分数得以快速提高",
   "music": 0.0
  },
  {
   "from": 63.06,
   "to": 65.04,
   "sid": 30,
   "location": 2,
   "content": "这种可量化的正反馈带来的快感",
   "music": 0.0
  },
  {
   "from": 65.04,
   "to": 67.23,
   "sid": 31,
   "location": 2,
   "content": "甚至不亚于直接玩游戏并获胜",
   "music": 0.0
  },
  {
   "from": 67.23,
   "to": 68.86,
   "sid": 32,
   "location": 2,
   "content": "所能带来的快乐的",
   "music": 0.0
  },
  {
   "from": 68.86,
   "to": 71.44,
   "sid": 33,
   "location": 2,
   "content": "更别说还有多项目对比式的一个练习",
   "music": 0.0
  },
  {
   "from": 71.44,
   "to": 73.539,
   "sid": 34,
   "location": 2,
   "content": "对于自身瞄准缺陷的一个发掘作用了",
   "music": 0.0
  },
  {
   "from": 73.539,
   "to": 75.519,
   "sid": 35,
   "location": 2,
   "content": "因为磁力成长机最大的用处",
   "music": 0.0
  },
  {
   "from": 75.519,
   "to": 78.16,
   "sid": 36,
   "location": 2,
   "content": "就是短时间内快速提高自身瞄准水平",
   "music": 0.0
  },
  {
   "from": 78.16,
   "to": 80.14,
   "sid": 37,
   "location": 2,
   "content": "对于那些基础比较差的模型来说",
   "music": 0.0
  },
  {
   "from": 80.14,
   "to": 82.18,
   "sid": 38,
   "location": 2,
   "content": "练枪软件就是他们提高文章水平的",
   "music": 0.0
  },
  {
   "from": 82.18,
   "to": 83.42,
   "sid": 39,
   "location": 2,
   "content": "最有效的一个手段",
   "music": 0.0
  },
  {
   "from": 83.42,
   "to": 86.42,
   "sid": 40,
   "location": 2,
   "content": "那么练枪软件对于瞄准能力的提高如此显著",
   "music": 0.0
  },
  {
   "from": 86.42,
   "to": 88.16,
   "sid": 41,
   "location": 2,
   "content": "为什么会出现一片枪声数越高",
   "music": 0.0
  },
  {
   "from": 88.16,
   "to": 89.8,
   "sid": 42,
   "location": 2,
   "content": "实战越拉胯这种情况呢",
   "music": 0.0
  },
  {
   "from": 89.8,
   "to": 91.06,
   "sid": 43,
   "location": 2,
   "content": "呃那在很多情况下",
   "music": 0.0
  },
  {
   "from": 91.06,
   "to": 93.1,
   "sid": 44,
   "location": 2,
   "content": "都是因为你对于这个练枪软件的一个练习",
   "music": 0.0
  },
  {
   "from": 93.1,
   "to": 94.6,
   "sid": 45,
   "location": 2,
   "content": "时间安排出现了问题",
   "music": 0.0
  },
  {
   "from": 94.6,
   "to": 96.94,
   "sid": 46,
   "location": 2,
   "content": "那么练枪软件练习实战一样",
   "music": 0.0
  },
  {
   "from": 96.94,
   "to": 98.34,
   "sid": 47,
   "location": 2,
   "content": "都是需要全力以赴的",
   "music": 0.0
  },
  {
   "from": 98.34,
   "to": 101.04,
   "sid": 48,
   "location": 2,
   "content": "那么对于自身精力消耗也是不容小觑的",
   "music": 0.0
  },
  {
   "from": 101.04,
   "to": 102.48,
   "sid": 49,
   "location": 2,
   "content": "诶今天练枪两小时",
   "music": 0.0
  },
  {
   "from": 102.48,
   "to": 104.78,
   "sid": 50,
   "location": 2,
   "content": "可能瞄准水平从一提升到了一点一",
   "music": 0.0
  },
  {
   "from": 104.78,
   "to": 106.94,
   "sid": 51,
   "location": 2,
   "content": "但精力也可能从满状态的100%",
   "music": 0.0
  },
  {
   "from": 106.94,
   "to": 108.2,
   "sid": 52,
   "location": 2,
   "content": "消耗到90%",
   "music": 0.0
  },
  {
   "from": 108.2,
   "to": 109.64,
   "sid": 53,
   "location": 2,
   "content": "那么一乘以100%",
   "music": 0.0
  },
  {
   "from": 109.64,
   "to": 111.56,
   "sid": 54,
   "location": 2,
   "content": "大于一点一乘以90%",
   "music": 0.0
  },
  {
   "from": 111.56,
   "to": 113.48,
   "sid": 55,
   "location": 2,
   "content": "如果你练枪练了很长时间",
   "music": 0.0
  },
  {
   "from": 113.48,
   "to": 116.4,
   "sid": 56,
   "location": 2,
   "content": "然后在这种精力消耗有任何情况下要去打天梯",
   "music": 0.0
  },
  {
   "from": 116.4,
   "to": 119.04,
   "sid": 57,
   "location": 2,
   "content": "那你这个练枪分数即使练的再高",
   "music": 0.0
  },
  {
   "from": 119.04,
   "to": 120.42,
   "sid": 58,
   "location": 2,
   "content": "因为你精力消耗太严重了",
   "music": 0.0
  },
  {
   "from": 120.42,
   "to": 122.7,
   "sid": 59,
   "location": 2,
   "content": "所以实战反而会显得非常拉胯",
   "music": 0.0
  },
  {
   "from": 122.98,
   "to": 125.1,
   "sid": 60,
   "location": 2,
   "content": "因此在达到你满意的瞄准水平之前",
   "music": 0.0
  },
  {
   "from": 125.1,
   "to": 126.36,
   "sid": 61,
   "location": 2,
   "content": "更合理的时间安排的是",
   "music": 0.0
  },
  {
   "from": 126.36,
   "to": 129.03,
   "sid": 62,
   "location": 2,
   "content": "练枪与实战的一个交替式的集中训练",
   "music": 0.0
  },
  {
   "from": 129.03,
   "to": 131.3,
   "sid": 63,
   "location": 2,
   "content": "就比如说你这个周啊就啥都不干",
   "music": 0.0
  },
  {
   "from": 131.3,
   "to": 132.29,
   "sid": 64,
   "location": 2,
   "content": "就集中练枪",
   "music": 0.0
  },
  {
   "from": 132.29,
   "to": 134.78,
   "sid": 65,
   "location": 2,
   "content": "每天把游戏实战的大部分都分给这个练枪",
   "music": 0.0
  },
  {
   "from": 134.78,
   "to": 136.2,
   "sid": 66,
   "location": 2,
   "content": "那实战就少打打",
   "music": 0.0
  },
  {
   "from": 136.2,
   "to": 138.6,
   "sid": 67,
   "location": 2,
   "content": "也就打打匹配休闲的5万减的模型",
   "music": 0.0
  },
  {
   "from": 138.6,
   "to": 139.8,
   "sid": 68,
   "location": 2,
   "content": "那么在到了下个周",
   "music": 0.0
  },
  {
   "from": 139.8,
   "to": 142.23,
   "sid": 69,
   "location": 2,
   "content": "你再去这个集中注意力去打实战",
   "music": 0.0
  },
  {
   "from": 142.23,
   "to": 144.03,
   "sid": 70,
   "location": 2,
   "content": "那么在实战开始前20分钟",
   "music": 0.0
  },
  {
   "from": 144.03,
   "to": 145.17,
   "sid": 71,
   "location": 2,
   "content": "这个去练练枪啊",
   "music": 0.0
  },
  {
   "from": 145.17,
   "to": 145.71,
   "sid": 72,
   "location": 2,
   "content": "热身啊",
   "music": 0.0
  },
  {
   "from": 145.71,
   "to": 147.09,
   "sid": 73,
   "location": 2,
   "content": "去维持一下瞄准水平就可以了",
   "music": 0.0
  },
  {
   "from": 147.09,
   "to": 149.2,
   "sid": 74,
   "location": 2,
   "content": "就不需要花太多精力在练枪上了",
   "music": 0.0
  },
  {
   "from": 149.2,
   "to": 150.58,
   "sid": 75,
   "location": 2,
   "content": "然后再到下周的时候",
   "music": 0.0
  },
  {
   "from": 150.58,
   "to": 152.98,
   "sid": 76,
   "location": 2,
   "content": "你再把这个精力就集中在练枪里啊",
   "music": 0.0
  },
  {
   "from": 152.98,
   "to": 155.75,
   "sid": 77,
   "location": 2,
   "content": "就这样子这个交替循环的一个安排训练",
   "music": 0.0
  },
  {
   "from": 155.75,
   "to": 157.43,
   "sid": 78,
   "location": 2,
   "content": "那么只有同种方式练枪",
   "music": 0.0
  },
  {
   "from": 157.43,
   "to": 158.87,
   "sid": 79,
   "location": 2,
   "content": "对于你实战的提升在于小",
   "music": 0.0
  },
  {
   "from": 158.87,
   "to": 160.41,
   "sid": 80,
   "location": 2,
   "content": "这个比较明显啊",
   "music": 0.0
  },
  {
   "from": 160.41,
   "to": 161.46,
   "sid": 81,
   "location": 2,
   "content": "不然你就会发现啊",
   "music": 0.0
  },
  {
   "from": 161.46,
   "to": 162.81,
   "sid": 82,
   "location": 2,
   "content": "哦我练枪练了好久",
