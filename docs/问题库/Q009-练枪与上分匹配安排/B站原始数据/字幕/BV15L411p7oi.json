   "from": 164.19,
   "to": 165.56,
   "sid": 84,
   "location": 2,
   "content": "但为什么到了实战",
   "music": 0.0
  },
  {
   "from": 165.56,
   "to": 167.06,
   "sid": 85,
   "location": 2,
   "content": "你们感觉自己很拉胯",
   "music": 0.0
  },
  {
   "from": 167.06,
   "to": 168.32,
   "sid": 86,
   "location": 2,
   "content": "感觉我练了个寂寞啊",
   "music": 0.0
  },
  {
   "from": 168.32,
   "to": 169.46,
   "sid": 87,
   "location": 2,
   "content": "这种情况啊",
   "music": 0.0
  },
  {
   "from": 169.46,
   "to": 171.47,
   "sid": 88,
   "location": 2,
   "content": "我发现是很多朋友都会遇到的",
   "music": 0.0
  },
  {
   "from": 171.47,
   "to": 174.34,
   "sid": 89,
   "location": 2,
   "content": "很多小孩都是因为你在这打实战之前",
   "music": 0.0
  },
  {
   "from": 174.34,
   "to": 175.84,
   "sid": 90,
   "location": 2,
   "content": "花费太多精力在练枪上",
   "music": 0.0
  },
  {
   "from": 175.84,
   "to": 176.8,
   "sid": 91,
   "location": 2,
   "content": "然后到实战的时候",
   "music": 0.0
  },
  {
   "from": 176.8,
   "to": 179.62,
   "sid": 92,
   "location": 2,
   "content": "你反而就没有精力去好好瞄准了",
