  },
  {
   "from": 9.7,
   "to": 11.96,
   "sid": 6,
   "location": 2,
   "content": "大家长时间都在练习自己的手部肌肉",
   "music": 0.0
  },
  {
   "from": 11.96,
   "to": 14.26,
   "sid": 7,
   "location": 2,
   "content": "而忽视的眼睛也是瞄准的重要一部分",
   "music": 0.0
  },
  {
   "from": 14.26,
   "to": 16.65,
   "sid": 8,
   "location": 2,
   "content": "大家也可以把这个当成练习眼睛的项目",
   "music": 0.0
  },
  {
   "from": 16.65,
   "to": 17.73,
   "sid": 9,
   "location": 2,
   "content": "然后多做几组",
   "music": 0.0
  },
  {
   "from": 17.73,
   "to": 18.51,
   "sid": 10,
   "location": 2,
   "content": "这里是热身",
   "music": 0.0
  },
  {
   "from": 18.51,
   "to": 19.95,
   "sid": 11,
   "location": 2,
   "content": "只需要做一组就OK",
   "music": 0.0
  },
  {
   "from": 19.95,
   "to": 23.17,
   "sid": 12,
   "location": 2,
   "content": "保持着打游戏时你的眼睛与屏幕的距离",
   "music": 0.0
  },
  {
   "from": 23.17,
   "to": 25.37,
   "sid": 13,
   "location": 2,
   "content": "然后持续捕捉小球的运动轨迹",
   "music": 0.0
  },
  {
   "from": 25.37,
   "to": 26.33,
   "sid": 14,
   "location": 2,
   "content": "看完一个片段",
   "music": 0.0
  },
  {
   "from": 26.33,
   "to": 27.59,
   "sid": 15,
   "location": 2,
   "content": "休息10~15秒",
   "music": 0.0
  },
  {
   "from": 27.59,
   "to": 30.51,
   "sid": 16,
   "location": 2,
   "content": "眼睛向远处眺望或者闭上眼都可以",
   "music": 0.0
  },
  {
   "from": 30.51,
   "to": 31.58,
   "sid": 17,
   "location": 2,
   "content": "坚持几天",
   "music": 0.0
  },
  {
   "from": 31.58,
   "to": 35.26,
   "sid": 18,
   "location": 2,
   "content": "你会发现这个练习眼镜项目给你瞄准上的提升",
