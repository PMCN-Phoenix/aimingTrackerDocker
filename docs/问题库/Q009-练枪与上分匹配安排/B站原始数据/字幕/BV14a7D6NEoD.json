 "body": [
  {
   "from": 0.04,
   "to": 3.12,
   "sid": 1,
   "location": 2,
   "content": "这是你看到过最高效科学细致的FPS s热身",
   "music": 0.0
  },
  {
   "from": 3.12,
   "to": 4.4,
   "sid": 2,
   "location": 2,
   "content": "不论你是玩什么射击游戏",
   "music": 0.0
  },
  {
   "from": 4.4,
   "to": 6.15,
   "sid": 3,
   "location": 2,
   "content": "都能帮你找到最佳竞技状态",
   "music": 0.0
  },
  {
   "from": 6.15,
   "to": 7.89,
   "sid": 4,
   "location": 2,
   "content": "首先是最重要的眼部激活",
   "music": 0.0
