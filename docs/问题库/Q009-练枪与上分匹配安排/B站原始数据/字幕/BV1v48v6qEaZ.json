{
 "font_size": 0.4,
 "font_color": "#FFFFFF",
 "background_alpha": 0.5,
 "background_color": "#9C27B0",
 "Stroke": "none",
 "type": "AIsubtitle",
 "lang": "zh",
 "version": "v1.7.0.4",
 "body": [
  {
   "from": 0.0,
   "to": 2.15,
   "sid": 1,
   "location": 2,
   "content": "你是不是每次上线都在打死斗",
   "music": 0.0
  },
  {
   "from": 2.15,
   "to": 3.01,
   "sid": 2,
   "location": 2,
   "content": "排位前打",
   "music": 0.0
  },
  {
   "from": 3.01,
   "to": 3.81,
   "sid": 3,
   "location": 2,
   "content": "排位后打",
   "music": 0.0
  },
  {
   "from": 3.81,
   "to": 5.41,
   "sid": 4,
   "location": 2,
   "content": "有时甚至干脆不排位",
   "music": 0.0
  },
  {
   "from": 5.41,
   "to": 6.31,
   "sid": 5,
   "location": 2,
   "content": "只打死斗",
   "music": 0.0
  },
  {
   "from": 6.31,
   "to": 7.39,
   "sid": 6,
   "location": 2,
   "content": "可练了这么久",
   "music": 0.0
  },
  {
   "from": 7.39,
   "to": 8.95,
   "sid": 7,
   "location": 2,
   "content": "枪法好像没什么变化",
   "music": 0.0
  },
  {
   "from": 8.95,
   "to": 10.4,
   "sid": 8,
   "location": 2,
   "content": "段位也一直没动",
   "music": 0.0
  },
  {
   "from": 10.4,
   "to": 12.34,
   "sid": 9,
   "location": 2,
   "content": "你心里可能已经开始怀疑",
   "music": 0.0
  },
  {
   "from": 12.34,
   "to": 14.43,
   "sid": 10,
   "location": 2,
   "content": "我这样练到底有没有用",
   "music": 0.0
  },
  {
   "from": 14.43,
   "to": 16.71,
   "sid": 11,
   "location": 2,
   "content": "答案可能是真没什么用",
   "music": 0.0
  },
  {
   "from": 16.71,
   "to": 17.99,
   "sid": 12,
   "location": 2,
   "content": "现在我来告诉你",
   "music": 0.0
  },
  {
   "from": 17.99,
   "to": 20.88,
   "sid": 13,
   "location": 2,
   "content": "为什么很多职业选手根本不练枪",
   "music": 0.0
  },
  {
   "from": 20.88,
   "to": 22.54,
   "sid": 14,
   "location": 2,
   "content": "他们就是一直打排位",
   "music": 0.0
  },
  {
   "from": 22.54,
   "to": 24.54,
   "sid": 15,
   "location": 2,
   "content": "靠游戏时长堆上去的",
   "music": 0.0
  },
  {
   "from": 24.54,
   "to": 27.08,
   "sid": 16,
   "location": 2,
   "content": "这对不少选手来说确实是真的",
   "music": 0.0
  },
  {
   "from": 27.08,
   "to": 29.16,
   "sid": 17,
   "location": 2,
   "content": "有些人几乎不用练枪软件",
   "music": 0.0
  },
  {
   "from": 29.16,
   "to": 30.62,
   "sid": 18,
   "location": 2,
   "content": "甚至很少打死斗",
   "music": 0.0
  },
  {
   "from": 30.62,
   "to": 32.2,
   "sid": 19,
   "location": 2,
   "content": "他们就是一直打比赛",
   "music": 0.0
  },
  {
   "from": 32.2,
   "to": 34.72,
   "sid": 20,
   "location": 2,
   "content": "打排位能力自然就练出来了",
   "music": 0.0
  },
  {
   "from": 34.72,
   "to": 37.03,
   "sid": 21,
   "location": 2,
   "content": "但这种说法忽略了一件事",
   "music": 0.0
  },
  {
   "from": 37.03,
   "to": 39.33,
   "sid": 22,
   "location": 2,
   "content": "这些选手能达到现在的水平",
   "music": 0.0
  },
  {
   "from": 39.33,
   "to": 41.83,
   "sid": 23,
   "location": 2,
   "content": "靠的是极其庞大的游戏量",
   "music": 0.0
  },
  {
   "from": 41.83,
   "to": 44.51,
   "sid": 24,
   "location": 2,
   "content": "他们从很早就开始玩不同的游戏",
   "music": 0.0
  },
  {
   "from": 44.51,
   "to": 47.05,
   "sid": 25,
   "location": 2,
   "content": "累计了几千甚至上万小时",
   "music": 0.0
  },
  {
   "from": 47.05,
   "to": 50.56,
   "sid": 26,
   "location": 2,
   "content": "而且长期处在高强度的对抗环境中",
   "music": 0.0
  },
  {
   "from": 50.56,
   "to": 51.68,
   "sid": 27,
   "location": 2,
   "content": "他们的枪法",
   "music": 0.0
  },
  {
   "from": 51.68,
   "to": 53.78,
   "sid": 28,
   "location": 2,
   "content": "移动判断和临场反应",
   "music": 0.0
  },
  {
   "from": 57.23,
   "to": 59.61,
   "sid": 29,
   "location": 2,
   "content": "这个过程往往需要很多年",
   "music": 0.0
  },
  {
   "from": 59.61,
   "to": 63.18,
   "sid": 30,
   "location": 2,
   "content": "而绝大多数普通玩家并没有这么多时间",
   "music": 0.0
  },
  {
   "from": 63.18,
   "to": 66.44,
   "sid": 31,
   "location": 2,
   "content": "如果你现在就想让自己的枪法真正进步",
   "music": 0.0
  },
  {
   "from": 66.44,
   "to": 68.82,
   "sid": 32,
   "location": 2,
   "content": "那就不能直接照搬职业选手",
   "music": 0.0
  },
  {
   "from": 68.82,
   "to": 70.69,
   "sid": 33,
   "location": 2,
   "content": "用来维持状态的方法",
   "music": 0.0
  },
  {
   "from": 70.69,
   "to": 74.27,
   "sid": 34,
   "location": 2,
   "content": "因为维持现有水平和突破自己的短板",
   "music": 0.0
  },
  {
   "from": 74.27,
   "to": 76.57,
   "sid": 35,
   "location": 2,
   "content": "本来就是两件不同的事",
   "music": 0.0
  },
  {
   "from": 76.57,
   "to": 79.53,
   "sid": 36,
   "location": 2,
   "content": "那么为什么死斗达到一定程度以后",
   "music": 0.0
  },
  {
   "from": 79.53,
   "to": 81.63,
   "sid": 37,
   "location": 2,
   "content": "就很难继续带来提升",
   "music": 0.0
  },
  {
   "from": 81.63,
   "to": 85.6,
   "sid": 38,
   "location": 2,
   "content": "这正是专项练枪相比死斗最大的优势",
   "music": 0.0
  },
  {
   "from": 85.6,
   "to": 88.32,
   "sid": 39,
   "location": 2,
   "content": "你可以单独选出一种瞄准能力",
   "music": 0.0
  },
  {
   "from": 88.32,
   "to": 90.46,
   "sid": 40,
   "location": 2,
   "content": "直接进行针对性训练",
   "music": 0.0
  },
  {
   "from": 90.46,
   "to": 95.03,
   "sid": 41,
   "location": 2,
   "content": "甩枪跟枪微调或者其他真正薄弱的部分",
   "music": 0.0
  },
  {
   "from": 95.03,
   "to": 97.61,
   "sid": 42,
   "location": 2,
   "content": "你不需要同时处理所有问题",
   "music": 0.0
  },
  {
   "from": 97.61,
   "to": 99.87,
   "sid": 43,
   "location": 2,
   "content": "只需要专注练习这一项",
   "music": 0.0
  },
  {
   "from": 99.87,
   "to": 102.23,
   "sid": 44,
   "location": 2,
   "content": "直到它真正得到改善",
   "music": 0.0
  },
  {
   "from": 102.23,
   "to": 104.83,
   "sid": 45,
   "location": 2,
   "content": "但很多人换到练枪软件以后",
   "music": 0.0
  },
  {
   "from": 104.83,
   "to": 106.949,
   "sid": 46,
   "location": 2,
   "content": "仍然犯了同样的错误",
   "music": 0.0
  },
  {
   "from": 106.949,
   "to": 110.109,
   "sid": 47,
   "location": 2,
   "content": "随便挑一个项目反复冲击分数",
   "music": 0.0
  },
  {
   "from": 110.109,
   "to": 113.69,
   "sid": 48,
   "location": 2,
   "content": "然后期待它自动转化成游戏里的枪法",
   "music": 0.0
  },
  {
   "from": 113.69,
   "to": 117.05,
   "sid": 49,
   "location": 2,
   "content": "这样一来你只是换了一套更专业的工具",
   "music": 0.0
  },
  {
   "from": 117.05,
   "to": 120.93,
   "sid": 50,
   "location": 2,
   "content": "却依然不知道究竟是什么在拖你的后腿",
   "music": 0.0
  },
  {
   "from": 120.93,
   "to": 123.67,
   "sid": 51,
   "location": 2,
   "content": "如果连自己的短板是什么都不知道",
   "music": 0.0
  },
  {
   "from": 123.67,
   "to": 126.71,
   "sid": 52,
   "location": 2,
   "content": "练再多次也很难真正有效",
   "music": 0.0
  },
  {
   "from": 126.71,
   "to": 128.71,
   "sid": 53,
   "location": 2,
   "content": "所以在开始训练以前",
   "music": 0.0
  },
  {
   "from": 128.71,
   "to": 131.67,
   "sid": 54,
   "location": 2,
   "content": "你需要先找出应该重点练什么",
   "music": 0.0
  },
  {
   "from": 131.67,
   "to": 134.92,
   "sid": 55,
   "location": 2,
   "content": "这就是基准测试benchmark的作用",
   "music": 0.0
  },
  {
   "from": 134.92,
   "to": 137.56,
   "sid": 56,
   "location": 2,
   "content": "它更像是一套枪法诊断工具",
   "music": 0.0
  },
  {
   "from": 137.56,
   "to": 139.58,
   "sid": 57,
   "location": 2,
   "content": "会分别测试你的点射",
   "music": 0.0
  },
  {
   "from": 139.58,
   "to": 143.99,
   "sid": 58,
   "location": 2,
   "content": "瞄准跟枪目标切换以及其他核心能力",
   "music": 0.0
  },
  {
   "from": 143.99,
   "to": 147.11,
   "sid": 59,
   "location": 2,
   "content": "然后告诉你以你目前的水平来看",
   "music": 0.0
  },
  {
   "from": 147.11,
   "to": 149.97,
   "sid": 60,
   "location": 2,
   "content": "究竟是哪些能力明显落后",
   "music": 0.0
  },
  {
   "from": 149.97,
   "to": 151.29,
   "sid": 61,
   "location": 2,
   "content": "知道短板以后",
   "music": 0.0
  },
  {
   "from": 151.29,
   "to": 153.11,
   "sid": 62,
   "location": 2,
   "content": "你就不需要再靠猜了",
   "music": 0.0
  },
  {
   "from": 153.11,
   "to": 155.85,
   "sid": 63,
   "location": 2,
   "content": "简单来说就是先完成测试",
   "music": 0.0
  },
  {
   "from": 155.85,
   "to": 158.18,
   "sid": 64,
   "location": 2,
   "content": "再决定接下来练什么",
   "music": 0.0
  },
  {
   "from": 158.18,
   "to": 161.22,
   "sid": 65,
   "location": 2,
   "content": "当你把同一种练法重复到一定程度",
   "music": 0.0
  },
  {
   "from": 161.22,
   "to": 163.02,
   "sid": 66,
   "location": 2,
   "content": "单纯增加训练量",
   "music": 0.0
  },
  {
   "from": 163.02,
   "to": 165.19,
   "sid": 67,
   "location": 2,
   "content": "就很难继续带来进步",
   "music": 0.0
  },
  {
   "from": 165.19,
   "to": 168.17,
   "sid": 68,
   "location": 2,
   "content": "如果你已经用同样的方式打了很久",
   "music": 0.0
  },
  {
   "from": 168.17,
   "to": 170.39,
   "sid": 69,
   "location": 2,
   "content": "死斗枪法却没有变化",
   "music": 0.0
  },
  {
   "from": 170.39,
   "to": 172.09,
   "sid": 70,
   "location": 2,
   "content": "那么再多打几局",
   "music": 0.0
  },
  {
   "from": 172.09,
   "to": 174.24,
   "sid": 71,
   "location": 2,
   "content": "通常也解决不了问题",
   "music": 0.0
  },
  {
   "from": 174.24,
   "to": 178.95,
   "sid": 72,
   "location": 2,
   "content": "你只是在重复那些让自己陷入瓶颈的动作模式",
   "music": 0.0
  },
  {
   "from": 178.95,
   "to": 181.79,
   "sid": 73,
   "location": 2,
   "content": "用错误的方式重复更多次",
   "music": 0.0
  },
  {
   "from": 181.79,
   "to": 183.07,
   "sid": 74,
   "location": 2,
   "content": "不叫练习",
   "music": 0.0
  },
  {
   "from": 183.07,
   "to": 186.47,
   "sid": 75,
   "location": 2,
   "content": "那只是在不断强化原来的习惯",
   "music": 0.0
  },
  {
   "from": 186.47,
   "to": 188.37,
   "sid": 76,
   "location": 2,
   "content": "如果你输掉对枪",
   "music": 0.0
  },
  {
   "from": 188.37,
   "to": 191.29,
   "sid": 77,
   "location": 2,
   "content": "真正的原因就是枪法跟不上",
   "music": 0.0
  },
  {
   "from": 191.29,
   "to": 195.829,
   "sid": 78,
   "location": 2,
   "content": "那你需要做的就是直接训练对应的瞄准能力",
   "music": 0.0
  },
  {
   "from": 195.829,
   "to": 198.189,
   "sid": 79,
   "location": 2,
   "content": "把不同能力拆开一次",
   "music": 0.0
  },
  {
   "from": 198.189,
   "to": 199.229,
   "sid": 80,
   "location": 2,
   "content": "只练一项",
   "music": 0.0
  },
  {
   "from": 199.229,
   "to": 202.57,
   "sid": 81,
   "location": 2,
   "content": "同时通过成绩和反馈不断调整",
   "music": 0.0
  },
  {
   "from": 202.57,
   "to": 205.25,
   "sid": 82,
   "location": 2,
   "content": "这才是真正的刻意练习",
   "music": 0.0
  },
  {
   "from": 205.25,
   "to": 208.85,
   "sid": 83,
   "location": 2,
   "content": "不过这并不是一期反对死斗的视频",
   "music": 0.0
  },
  {
   "from": 208.85,
   "to": 210.45,
   "sid": 84,
   "location": 2,
   "content": "死斗当然有用",
   "music": 0.0
  },
  {
   "from": 210.45,
   "to": 212.51,
   "sid": 85,
   "location": 2,
   "content": "你会经历真实的交火",
   "music": 0.0
  },
  {
   "from": 212.51,
   "to": 215.45,
   "sid": 86,
   "location": 2,
   "content": "移动后坐力和对抗压力",
   "music": 0.0
  },
  {
   "from": 215.45,
   "to": 217.65,
   "sid": 87,
   "location": 2,
   "content": "它可以帮你活动开手感",
   "music": 0.0
  },
  {
   "from": 217.65,
   "to": 220.75,
   "sid": 88,
   "location": 2,
   "content": "也能积累枪战中的实战直觉",
   "music": 0.0
  },
  {
   "from": 220.75,
   "to": 222.99,
   "sid": 89,
   "location": 2,
   "content": "例如常见的交火角度",
   "music": 0.0
  },
  {
   "from": 222.99,
   "to": 226.94,
   "sid": 90,
   "location": 2,
   "content": "对枪距离以及对手通常会怎样移动",
   "music": 0.0
  },
  {
   "from": 226.94,
   "to": 228.96,
   "sid": 91,
   "location": 2,
   "content": "如果你玩无畏契约",
   "music": 0.0
  },
  {
   "from": 228.96,
   "to": 233.61,
   "sid": 92,
   "location": 2,
   "content": "cs2或者任何带有死斗模式的FPS游戏",
   "music": 0.0
  },
  {
   "from": 233.61,
   "to": 236.75,
   "sid": 93,
   "location": 2,
   "content": "把死斗当作热身完全合理",
   "music": 0.0
  },
  {
   "from": 236.75,
   "to": 239.55,
   "sid": 94,
   "location": 2,
   "content": "很多玩家这样做已经很多年了",
   "music": 0.0
  },
  {
   "from": 239.55,
   "to": 241.29,
   "sid": 95,
   "location": 2,
   "content": "自然有它的道理",
   "music": 0.0
  },
  {
   "from": 241.29,
   "to": 243.71,
   "sid": 96,
   "location": 2,
   "content": "问题不在于死斗本身",
   "music": 0.0
  },
  {
   "from": 243.71,
   "to": 248.39,
   "sid": 97,
   "location": 2,
   "content": "而在于你想让死斗完成他并不擅长的任务",
   "music": 0.0
  },
  {
   "from": 248.39,
   "to": 250.63,
   "sid": 98,
   "location": 2,
   "content": "死斗依然有自己的作用",
   "music": 0.0
  },
  {
   "from": 250.63,
   "to": 252.29,
   "sid": 99,
   "location": 2,
   "content": "你可以用它热身",
   "music": 0.0
  },
  {
   "from": 252.29,
   "to": 253.45,
   "sid": 100,
   "location": 2,
   "content": "保持状态",
   "music": 0.0
  },
  {
   "from": 253.45,
   "to": 256.55,
   "sid": 101,
   "location": 2,
   "content": "让双手尽快进入对枪节奏",
   "music": 0.0
  },
  {
   "from": 256.55,
   "to": 258.899,
   "sid": 102,
   "location": 2,
   "content": "它当然是一种有效的工具",
   "music": 0.0
  },
  {
   "from": 258.899,
   "to": 263.219,
   "sid": 103,
   "location": 2,
   "content": "但如果你一直靠刷死斗来突破枪法瓶颈",
   "music": 0.0
  },
  {
   "from": 263.219,
   "to": 265.88,
   "sid": 104,
   "location": 2,
   "content": "那它大概率解决不了问题",
   "music": 0.0
  },
  {
   "from": 265.88,
   "to": 268.12,
   "sid": 105,
   "location": 2,
   "content": "因为你只是在不断重复",
   "music": 0.0
  },
  {
   "from": 268.12,
   "to": 270.76,
   "sid": 106,
   "location": 2,
   "content": "那些已经让你卡住的动作",
   "music": 0.0
  },
  {
   "from": 270.76,
   "to": 272.42,
   "sid": 107,
   "location": 2,
   "content": "找出自己的短板",
   "music": 0.0
  },
