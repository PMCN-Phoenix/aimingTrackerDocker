  },
  {
   "from": 126.54,
   "to": 127.44,
   "sid": 64,
   "location": 2,
   "content": "只会自我感动",
   "music": 0.0
  },
  {
   "from": 127.44,
   "to": 129.28,
   "sid": 65,
   "location": 2,
   "content": "分数再高也无法转换为胜率",
   "music": 0.0
  },
  {
   "from": 129.28,
   "to": 131.26,
   "sid": 66,
   "location": 2,
   "content": "而短时长高效率贴合实战",
