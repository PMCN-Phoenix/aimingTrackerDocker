   "from": 118.84,
   "to": 120.32,
   "sid": 59,
   "location": 2,
   "content": "最可怕的视窗效应",
   "music": 0.0
  },
  {
   "from": 120.32,
   "to": 122.66,
   "sid": 60,
   "location": 2,
   "content": "也就是几乎没有余光观察和思维能力",
