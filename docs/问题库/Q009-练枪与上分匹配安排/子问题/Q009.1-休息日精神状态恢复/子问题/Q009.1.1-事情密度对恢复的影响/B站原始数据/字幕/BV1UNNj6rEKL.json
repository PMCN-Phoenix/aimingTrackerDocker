{
 "bvid": "BV1UNNj6rEKL",
 "title": "【效率科学】你同时做三件事 等于把每件事都搞砸｜注意力残留",
 "owner": "心哲底片",
 "aid": 116893557984140,
 "cid": 39808994997,
 "duration": 84,
 "body": [
  {
   "from": 0.08,
   "to": 3.68,
   "sid": 1,
   "location": 2,
   "content": "今天我们讲注意力残留",
   "music": 0.0
  },
  {
   "from": 3.68,
   "to": 5.46,
   "sid": 2,
   "location": 2,
   "content": "你有没有过这样的经历",
   "music": 0.0
  },
  {
   "from": 5.46,
   "to": 6.46,
   "sid": 3,
   "location": 2,
   "content": "一边回微信",
   "music": 0.0
  },
  {
   "from": 6.46,
   "to": 7.44,
   "sid": 4,
   "location": 2,
   "content": "一边写报告",
   "music": 0.0
  },
  {
   "from": 7.44,
   "to": 9.76,
   "sid": 5,
   "location": 2,
   "content": "偶尔还切出去刷一下短视频",
   "music": 0.0
  },
  {
   "from": 9.76,
   "to": 11.38,
   "sid": 6,
   "location": 2,
   "content": "三个小时过去了",
   "music": 0.0
  },
  {
   "from": 11.38,
   "to": 13.16,
   "sid": 7,
   "location": 2,
   "content": "你感觉自己忙了一晚上",
   "music": 0.0
  },
  {
   "from": 13.16,
   "to": 14.9,
   "sid": 8,
   "location": 2,
   "content": "但报告只写了两行",
   "music": 0.0
  },
  {
   "from": 14.9,
   "to": 17.0,
   "sid": 9,
   "location": 2,
   "content": "你以为是自己效率低",
   "music": 0.0
  },
  {
   "from": 17.0,
   "to": 21.24,
   "sid": 10,
   "location": 2,
   "content": "其实你是被一种叫做注意力残留的东西拖垮了",
   "music": 0.0
  },
  {
   "from": 21.24,
   "to": 23.4,
   "sid": 11,
   "location": 2,
   "content": "心理学家索菲勒罗瓦发现",
   "music": 0.0
  },
  {
   "from": 23.4,
   "to": 26.97,
   "sid": 12,
   "location": 2,
   "content": "当你从一项任务切换到另一项任务时",
   "music": 0.0
  },
  {
   "from": 26.97,
   "to": 29.27,
   "sid": 13,
   "location": 2,
   "content": "你的注意力不会立刻跟着你走",
   "music": 0.0
  },
  {
   "from": 29.27,
   "to": 33.25,
   "sid": 14,
   "location": 2,
   "content": "会有一部分像残影一样滞留在上一个任务里",
   "music": 0.0
  },
  {
   "from": 33.25,
   "to": 35.07,
   "sid": 15,
   "location": 2,
   "content": "你人已经到了新任务",
   "music": 0.0
  },
  {
   "from": 35.07,
   "to": 36.43,
   "sid": 16,
   "location": 2,
   "content": "魂还在上一个任务",
   "music": 0.0
  },
  {
   "from": 36.43,
   "to": 38.11,
   "sid": 17,
   "location": 2,
   "content": "那切换越频繁",
   "music": 0.0
  },
  {
   "from": 38.11,
   "to": 39.27,
   "sid": 18,
   "location": 2,
   "content": "残留就越多",
   "music": 0.0
  },
  {
   "from": 39.27,
   "to": 41.49,
   "sid": 19,
   "location": 2,
   "content": "你的大脑就像一台铜石",
   "music": 0.0
  },
  {
   "from": 41.49,
   "to": 43.51,
   "sid": 20,
   "location": 2,
   "content": "开了十几个程序的电脑",
   "music": 0.0
  },
  {
   "from": 43.51,
   "to": 46.09,
   "sid": 21,
   "location": 2,
   "content": "每个程序都在后台占用资源",
   "music": 0.0
  },
  {
   "from": 46.09,
   "to": 47.8,
   "sid": 22,
   "location": 2,
   "content": "整体速度越来越慢",
   "music": 0.0
  },
  {
   "from": 47.8,
   "to": 51.24,
   "sid": 23,
   "location": 2,
   "content": "这就是为什么多任务处理是一个陷阱",
   "music": 0.0
  },
  {
   "from": 51.24,
   "to": 53.24,
   "sid": 24,
   "location": 2,
   "content": "你以为你在同时做三件事",
   "music": 0.0
  },
  {
   "from": 53.24,
   "to": 57.08,
   "sid": 25,
   "location": 2,
   "content": "其实你是在把每件事都做得更慢更差",
   "music": 0.0
  },
  {
   "from": 57.08,
   "to": 60.04,
   "sid": 26,
   "location": 2,
   "content": "真正的效率不是同时做很多事",
   "music": 0.0
  },
  {
   "from": 60.04,
   "to": 61.66,
   "sid": 27,
   "location": 2,
   "content": "而是像激光一样",
   "music": 0.0
  },
  {
   "from": 61.66,
   "to": 63.46,
   "sid": 28,
   "location": 2,
   "content": "一次只烧穿一个点",
   "music": 0.0
  },
  {
   "from": 63.46,
   "to": 67.07,
   "sid": 29,
   "location": 2,
   "content": "你可以尝试给每件事一块完整的时间",
   "music": 0.0
  },
  {
   "from": 67.07,
   "to": 70.05,
   "sid": 30,
   "location": 2,
   "content": "在这段时间里关掉所有通知",
   "music": 0.0
  },
  {
   "from": 70.05,
   "to": 72.09,
   "sid": 31,
   "location": 2,
   "content": "把手机放在另一个房间",
   "music": 0.0
  },
  {
   "from": 72.09,
   "to": 73.61,
   "sid": 32,
   "location": 2,
   "content": "只做这一件事",
   "music": 0.0
  },
  {
   "from": 73.61,
   "to": 75.33,
   "sid": 33,
   "location": 2,
   "content": "做完再切到下一件",
   "music": 0.0
  },
  {
   "from": 75.33,
   "to": 77.37,
   "sid": 34,
   "location": 2,
   "content": "把你的注意力完整的带过去",
   "music": 0.0
  },
  {
   "from": 77.37,
   "to": 79.71,
   "sid": 35,
   "location": 2,
   "content": "而不是带着一堆残留的碎片",
   "music": 0.0
  },
  {
   "from": 79.71,
   "to": 80.79,
   "sid": 36,
   "location": 2,
   "content": "请记住",
   "music": 0.0
  },
  {
   "from": 80.79,
   "to": 83.66,
   "sid": 37,
   "location": 2,
   "content": "一次只凿一个洞才能凿穿",
   "music": 0.0
  }
 ]
}