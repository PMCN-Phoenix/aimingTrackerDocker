{
 "bvid": "BV1x5DTB9ERU",
 "title": "五个让『大脑恢复清晰』的休息方式！",
 "owner": "范不慌",
 "aid": 116346335598350,
 "cid": 37237360218,
 "duration": 591,
 "body": [
  {
   "from": 0.0,
   "to": 2.04,
   "sid": 1,
   "location": 2,
   "content": "如果一个拥有100分实力的人",
   "music": 0.0
  },
  {
   "from": 2.04,
   "to": 4.4,
   "sid": 2,
   "location": 2,
   "content": "平时却只能发挥出50分甚至是更低的话",
   "music": 0.0
  },
  {
   "from": 4.4,
   "to": 7.299,
   "sid": 3,
   "location": 2,
   "content": "就意味着他的大脑没有得到过真正的修游戏",
   "music": 0.0
  },
  {
   "from": 7.299,
   "to": 8.379,
   "sid": 4,
   "location": 2,
   "content": "大脑一旦混乱",
   "music": 0.0
  },
  {
   "from": 8.379,
   "to": 9.419,
   "sid": 5,
   "location": 2,
   "content": "他的状态就会变差",
   "music": 0.0
  },
  {
   "from": 9.419,
   "to": 11.099,
   "sid": 6,
   "location": 2,
   "content": "而能力是状态的产物",
   "music": 0.0
  },
  {
   "from": 11.099,
   "to": 13.1,
   "sid": 7,
   "location": 2,
   "content": "所以想要体验自己完整版的前提",
   "music": 0.0
  },
  {
   "from": 13.1,
   "to": 16.219,
   "sid": 8,
   "location": 2,
   "content": "就是学会让大脑呢用他喜欢的方式去休息去排",
   "music": 0.0
  },
  {
   "from": 16.219,
   "to": 18.519,
   "sid": 9,
   "location": 2,
   "content": "这是一种大多数人都没有学习过的能力",
   "music": 0.0
  },
  {
   "from": 18.519,
   "to": 21.83,
   "sid": 10,
   "location": 2,
   "content": "所以今天我们就来聊聊大脑喜欢的五种休息方式",
   "music": 0.0
  },
  {
   "from": 21.83,
   "to": 22.95,
   "sid": 11,
   "location": 2,
   "content": "我先问你个问题啊",
   "music": 0.0
  },
  {
   "from": 22.95,
   "to": 23.83,
   "sid": 12,
   "location": 2,
   "content": "你有没有这种体验",
   "music": 0.0
  },
  {
   "from": 23.83,
   "to": 25.11,
   "sid": 13,
   "location": 2,
   "content": "就是你明明什么都没有做",
   "music": 0.0
  },
  {
   "from": 25.11,
   "to": 25.83,
   "sid": 14,
   "location": 2,
   "content": "你在放空",
   "music": 0.0
  },
  {
   "from": 25.83,
   "to": 26.69,
   "sid": 15,
   "location": 2,
   "content": "但是你还是很累",
   "music": 0.0
  },
  {
   "from": 26.69,
   "to": 27.86,
   "sid": 16,
   "location": 2,
   "content": "有就这种累呢",
   "music": 0.0
  },
  {
   "from": 27.86,
   "to": 29.02,
   "sid": 17,
   "location": 2,
   "content": "它是一种精神的疲惫",
   "music": 0.0
  },
  {
   "from": 29.02,
   "to": 30.1,
   "sid": 18,
   "location": 2,
   "content": "它不是肉体的疲惫",
   "music": 0.0
  },
  {
   "from": 30.1,
   "to": 31.74,
   "sid": 19,
   "location": 2,
   "content": "他不是说你睡一觉就可以补回来的",
   "music": 0.0
  },
  {
   "from": 31.74,
   "to": 33.46,
   "sid": 20,
   "location": 2,
   "content": "那这个呢就是我们要说的第一个点",
   "music": 0.0
  },
  {
   "from": 33.46,
   "to": 34.56,
   "sid": 21,
   "location": 2,
   "content": "清晰指令",
   "music": 0.0
  },
  {
   "from": 34.56,
   "to": 35.4,
   "sid": 22,
   "location": 2,
   "content": "什么意思呢",
   "music": 0.0
  },
  {
   "from": 35.4,
   "to": 36.68,
   "sid": 23,
   "location": 2,
   "content": "其实从脑科学角度来看呢",
   "music": 0.0
  },
  {
   "from": 36.68,
   "to": 37.84,
   "sid": 24,
   "location": 2,
   "content": "你什么都不想的时候",
   "music": 0.0
  },
  {
   "from": 37.84,
   "to": 39.72,
   "sid": 25,
   "location": 2,
   "content": "反而可能是在不断消耗能量",
   "music": 0.0
  },
  {
   "from": 39.72,
   "to": 40.28,
   "sid": 26,
   "location": 2,
   "content": "为什么呢",
   "music": 0.0
  },
  {
   "from": 40.28,
   "to": 42.24,
   "sid": 27,
   "location": 2,
   "content": "因为这个时候你的大脑它处在一个模式里面",
   "music": 0.0
  },
  {
   "from": 42.24,
   "to": 43.64,
   "sid": 28,
   "location": 2,
   "content": "叫做默认神经网络",
   "music": 0.0
  },
  {
   "from": 43.64,
   "to": 44.46,
   "sid": 29,
   "location": 2,
   "content": "也叫DMN",
   "music": 0.0
  },
  {
   "from": 44.46,
   "to": 46.9,
   "sid": 30,
   "location": 2,
   "content": "简单去理解这个DMN呢就是你待机模式",
   "music": 0.0
  },
  {
   "from": 46.9,
   "to": 48.2,
   "sid": 31,
   "location": 2,
   "content": "但是这个待机模式呢",
   "music": 0.0
  },
  {
   "from": 48.2,
   "to": 51.4,
   "sid": 32,
   "location": 2,
   "content": "它的消耗居然占大脑总能量的60%到80%",
   "music": 0.0
  },
  {
   "from": 51.4,
   "to": 51.96,
   "sid": 33,
   "location": 2,
   "content": "也就是说",
   "music": 0.0
  },
  {
   "from": 51.96,
   "to": 53.84,
   "sid": 34,
   "location": 2,
   "content": "即使你不集中注意力于任何事",
   "music": 0.0
  },
  {
   "from": 53.84,
   "to": 55.2,
   "sid": 35,
   "location": 2,
   "content": "你的大脑还是没有得到休息",
   "music": 0.0
  },
  {
   "from": 55.2,
   "to": 57.6,
   "sid": 36,
   "location": 2,
   "content": "这是因为大脑积存了大量没有消极的思考",
   "music": 0.0
  },
  {
   "from": 57.6,
   "to": 58.76,
   "sid": 37,
   "location": 2,
   "content": "大量没有解决的问题",
   "music": 0.0
  },
  {
   "from": 58.76,
   "to": 60.12,
   "sid": 38,
   "location": 2,
   "content": "所以说呢它会持续的思考",
   "music": 0.0
  },
  {
   "from": 60.12,
   "to": 61.08,
   "sid": 39,
   "location": 2,
   "content": "持续的跳频",
   "music": 0.0
  },
  {
   "from": 61.08,
   "to": 62.8,
   "sid": 40,
   "location": 2,
   "content": "跳频就是你明明做这个事儿",
   "music": 0.0
  },
  {
   "from": 62.8,
   "to": 64.0,
   "sid": 41,
   "location": 2,
   "content": "但是你老是想下一件事",
   "music": 0.0
  },
  {
   "from": 64.0,
   "to": 65.04,
   "sid": 42,
   "location": 2,
   "content": "其实你也可以去想一下",
   "music": 0.0
  },
  {
   "from": 65.04,
   "to": 66.32,
   "sid": 43,
   "location": 2,
   "content": "很多时候呢你很疲惫",
   "music": 0.0
  },
  {
   "from": 66.32,
   "to": 67.24,
   "sid": 44,
   "location": 2,
   "content": "然后你在那放空",
   "music": 0.0
  },
  {
   "from": 67.24,
   "to": 68.48,
   "sid": 45,
   "location": 2,
   "content": "你真的能做到放空吗",
   "music": 0.0
  },
  {
   "from": 68.48,
   "to": 69.24,
   "sid": 46,
   "location": 2,
   "content": "你很难做到",
   "music": 0.0
  },
  {
   "from": 69.24,
   "to": 70.52,
   "sid": 47,
   "location": 2,
   "content": "你老是想着还有这个事没干",
   "music": 0.0
  },
  {
   "from": 70.52,
   "to": 71.32,
   "sid": 48,
   "location": 2,
   "content": "还有那个事没处理",
   "music": 0.0
  },
  {
   "from": 71.32,
   "to": 72.88,
   "sid": 49,
   "location": 2,
   "content": "所以说让大脑舒服的方式呢",
   "music": 0.0
  },
  {
   "from": 72.88,
   "to": 73.98,
   "sid": 50,
   "location": 2,
   "content": "他不是什么都不干",
   "music": 0.0
  },
  {
   "from": 73.98,
   "to": 76.2,
   "sid": 51,
   "location": 2,
   "content": "反倒是你要让他知道你在干什么",
   "music": 0.0
  },
  {
   "from": 76.2,
   "to": 77.0,
   "sid": 52,
   "location": 2,
   "content": "你要干什么",
   "music": 0.0
  },
  {
   "from": 77.0,
   "to": 78.6,
   "sid": 53,
   "location": 2,
   "content": "它都有一个可以聚焦的点",
   "music": 0.0
  },
  {
   "from": 78.6,
   "to": 79.92,
   "sid": 54,
   "location": 2,
   "content": "它才能让这个功耗变小",
   "music": 0.0
  },
  {
   "from": 79.92,
   "to": 81.76,
   "sid": 55,
   "location": 2,
   "content": "也就是说你一定要给自己定两个东西",
   "music": 0.0
  },
  {
   "from": 81.76,
   "to": 82.44,
   "sid": 56,
   "location": 2,
   "content": "一个是什么呢",
   "music": 0.0
  },
  {
   "from": 82.44,
   "to": 83.8,
   "sid": 57,
   "location": 2,
   "content": "就是说我现在在做什么",
   "music": 0.0
  },
  {
   "from": 83.8,
   "to": 84.48,
   "sid": 58,
   "location": 2,
   "content": "你要非常清楚",
   "music": 0.0
  },
  {
   "from": 84.48,
   "to": 87.2,
   "sid": 59,
   "location": 2,
   "content": "你要告诉大脑说我这个时间我就是要做这件事",
   "music": 0.0
  },
  {
   "from": 87.2,
   "to": 89.52,
   "sid": 60,
   "location": 2,
   "content": "那么第二个就是我花多长时间做这个事情",
   "music": 0.0
  },
  {
   "from": 89.52,
   "to": 91.16,
   "sid": 61,
   "location": 2,
   "content": "你要让自己的大脑呢非常清楚",
   "music": 0.0
  },
  {
   "from": 91.16,
   "to": 92.8,
   "sid": 62,
   "location": 2,
   "content": "你现在做这个事的空间",
   "music": 0.0
  },
  {
   "from": 92.8,
   "to": 93.62,
   "sid": 63,
   "location": 2,
   "content": "时间的限制",
   "music": 0.0
  },
  {
   "from": 93.62,
   "to": 96.38,
   "sid": 64,
   "location": 2,
   "content": "这样的话你的大脑就找到方向去释放力量了",
   "music": 0.0
  },
  {
   "from": 96.38,
   "to": 97.42,
   "sid": 65,
   "location": 2,
   "content": "就比如说我健身啊",
   "music": 0.0
  },
  {
   "from": 97.42,
   "to": 98.46,
   "sid": 66,
   "location": 2,
   "content": "我知道上哪发力",
   "music": 0.0
  },
  {
   "from": 98.46,
   "to": 99.8,
   "sid": 67,
   "location": 2,
   "content": "我做一组做几次",
   "music": 0.0
  },
  {
   "from": 99.8,
   "to": 101.1,
   "sid": 68,
   "location": 2,
   "content": "我这个肌肉才能集中起来",
   "music": 0.0
  },
  {
   "from": 101.1,
   "to": 102.06,
   "sid": 69,
   "location": 2,
   "content": "帮你达成目的",
   "music": 0.0
  },
  {
   "from": 102.06,
   "to": 102.94,
   "sid": 70,
   "location": 2,
   "content": "我举个简单例子啊",
   "music": 0.0
  },
  {
   "from": 102.94,
   "to": 104.22,
   "sid": 71,
   "location": 2,
   "content": "比如说你现在就是要放空",
   "music": 0.0
  },
  {
   "from": 104.22,
   "to": 104.94,
   "sid": 72,
   "location": 2,
   "content": "你要休息",
   "music": 0.0
  },
  {
   "from": 104.94,
   "to": 106.38,
   "sid": 73,
   "location": 2,
   "content": "那你就明确告诉自己说",
   "music": 0.0
  },
  {
   "from": 106.38,
   "to": 108.28,
   "sid": 74,
   "location": 2,
   "content": "我现在这个时间呢我就是用来放空的",
   "music": 0.0
  },
  {
   "from": 108.28,
   "to": 110.2,
   "sid": 75,
   "location": 2,
   "content": "或者说我现在这个时间我就是用来玩的",
   "music": 0.0
  },
  {
   "from": 110.2,
   "to": 111.44,
   "sid": 76,
   "location": 2,
   "content": "我不会去做别的事情",
   "music": 0.0
  },
  {
   "from": 111.44,
   "to": 112.56,
   "sid": 77,
   "location": 2,
   "content": "我也不会管别的事情",
   "music": 0.0
  },
  {
   "from": 112.56,
   "to": 113.16,
   "sid": 78,
   "location": 2,
   "content": "有电话来了",
   "music": 0.0
  },
  {
   "from": 113.16,
   "to": 113.66,
   "sid": 79,
   "location": 2,
   "content": "我也不接",
   "music": 0.0
  },
  {
   "from": 113.66,
   "to": 115.4,
   "sid": 80,
   "location": 2,
   "content": "这个时候呢你反倒就一扫明白",
   "music": 0.0
  },
  {
   "from": 115.4,
   "to": 116.46,
   "sid": 81,
   "location": 2,
   "content": "你反倒非常舒服",
   "music": 0.0
  },
  {
   "from": 116.46,
   "to": 118.0,
   "sid": 82,
   "location": 2,
   "content": "同样是放空你的大脑",
   "music": 0.0
  },
  {
   "from": 118.0,
   "to": 119.28,
   "sid": 83,
   "location": 2,
   "content": "它不会处于待机的状态了",
   "music": 0.0
  },
  {
   "from": 119.28,
   "to": 120.36,
   "sid": 84,
   "location": 2,
   "content": "他是聚焦的状态",
   "music": 0.0
  },
  {
   "from": 120.36,
   "to": 122.44,
   "sid": 85,
   "location": 2,
   "content": "这个聚焦状态它而要耗能少一些",
   "music": 0.0
  },
  {
   "from": 122.44,
   "to": 123.16,
   "sid": 86,
   "location": 2,
   "content": "那除此以外呢",
   "music": 0.0
  },
  {
   "from": 123.16,
   "to": 126.52,
   "sid": 87,
   "location": 2,
   "content": "还有很多人有一种情况就是你的放空不是心安理得的",
   "music": 0.0
  },
  {
   "from": 126.52,
   "to": 128.12,
   "sid": 88,
   "location": 2,
   "content": "你还是因为担心有这个事",
   "music": 0.0
  },
  {
   "from": 128.12,
   "to": 129.36,
   "sid": 89,
   "location": 2,
   "content": "那个事还有很多事要做",
   "music": 0.0
  },
  {
   "from": 129.36,
   "to": 130.68,
   "sid": 90,
   "location": 2,
   "content": "当你有很多事的时候呢",
   "music": 0.0
  },
  {
   "from": 130.68,
   "to": 132.2,
   "sid": 91,
   "location": 2,
   "content": "每个事情都需要启动的时候呢",
   "music": 0.0
  },
  {
   "from": 132.2,
   "to": 133.36,
   "sid": 92,
   "location": 2,
   "content": "你的大脑就停摆",
   "music": 0.0
  },
  {
   "from": 133.36,
   "to": 136.6,
   "sid": 93,
   "location": 2,
   "content": "这个时候不管是信息处理的速度还是专注力都非常的差",
   "music": 0.0
  },
  {
   "from": 136.6,
   "to": 138.24,
   "sid": 94,
   "location": 2,
   "content": "那这个时候呢你需要给自己一个排序",
   "music": 0.0
  },
  {
   "from": 138.24,
   "to": 139.48,
   "sid": 95,
   "location": 2,
   "content": "就是按重要程度",
   "music": 0.0
  },
  {
   "from": 139.48,
   "to": 140.94,
   "sid": 96,
   "location": 2,
   "content": "你应该先做这个再做那个",
   "music": 0.0
  },
  {
   "from": 140.94,
   "to": 143.26,
   "sid": 97,
   "location": 2,
   "content": "然后呢每做完一件或者两件事的时候呢",
   "music": 0.0
  },
  {
   "from": 143.26,
   "to": 145.42,
   "sid": 98,
   "location": 2,
   "content": "你就给自己一天的时间就完全放松",
   "music": 0.0
  },
  {
   "from": 145.42,
   "to": 146.5,
   "sid": 99,
   "location": 2,
   "content": "这样的话你就不会多想了",
   "music": 0.0
  },
  {
   "from": 146.5,
   "to": 148.22,
   "sid": 100,
   "location": 2,
   "content": "你的效率和质量就会高很多",
   "music": 0.0
  },
  {
   "from": 148.22,
   "to": 150.1,
   "sid": 101,
   "location": 2,
   "content": "那么第二个点呢叫做回归当下",
   "music": 0.0
  },
  {
   "from": 150.1,
   "to": 151.42,
   "sid": 102,
   "location": 2,
   "content": "就你有没有这种感觉啊",
   "music": 0.0
  },
  {
   "from": 151.42,
   "to": 153.42,
   "sid": 103,
   "location": 2,
   "content": "就是有的时候你的神就像不在了一样",
   "music": 0.0
  },
  {
   "from": 153.42,
   "to": 154.7,
   "sid": 104,
   "location": 2,
   "content": "你走路感觉不到自己",
   "music": 0.0
  },
  {
   "from": 154.7,
   "to": 156.14,
   "sid": 105,
   "location": 2,
   "content": "你的视线不是聚焦的",
   "music": 0.0
  },
  {
   "from": 156.14,
   "to": 157.54,
   "sid": 106,
   "location": 2,
   "content": "但是你依然正常去生活",
   "music": 0.0
  },
  {
   "from": 157.54,
   "to": 159.3,
   "sid": 107,
   "location": 2,
   "content": "就是吃饭喝水工作都正常",
   "music": 0.0
  },
  {
   "from": 159.3,
   "to": 161.26,
   "sid": 108,
   "location": 2,
   "content": "只不过它是一个自动驾驶的模式",
   "music": 0.0
  },
  {
   "from": 161.26,
   "to": 162.8,
