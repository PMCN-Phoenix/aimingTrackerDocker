{
 "bvid": "BV1Yk5y6pE5v",
 "title": "哈佛大学教授：人需要学会感受无聊，原因就在这里",
 "owner": "Englisher养成计划",
 "aid": 116567106916213,
 "cid": 38306382691,
 "duration": 345,
 "body": [
  {
   "content": "你需要感到无聊",
   "from": 0.04,
   "location": 2,
   "music": 0.0,
   "sid": 1,
   "to": 1.22
  },
  {
   "content": "你会失去意义感",
   "from": 1.22,
   "location": 2,
   "music": 0.0,
   "sid": 2,
   "to": 2.96
  },
  {
   "content": "如果你从未感到无聊会更加抑郁",
   "from": 2.96,
   "location": 2,
   "music": 0.0,
   "sid": 3,
   "to": 6.0
  },
  {
   "content": "我的意思是",
   "from": 6.0,
   "location": 2,
   "music": 0.0,
   "sid": 4,
   "to": 6.16
  },
  {
   "content": "这再清楚不过了",
   "from": 6.16,
   "location": 2,
   "music": 0.0,
   "sid": 5,
   "to": 8.32
  },
  {
   "content": "让我告诉你无聊的好处",
   "from": 9.92,
   "location": 2,
   "music": 0.0,
   "sid": 6,
   "to": 13.16
  },
  {
   "content": "一般来说",
   "from": 13.16,
   "location": 2,
   "music": 0.0,
   "sid": 7,
   "to": 14.379
  },
  {
   "content": "无聊是让我们暂时停止认知活动的状态",
   "from": 14.499,
   "location": 2,
   "music": 0.0,
   "sid": 8,
   "to": 20.5
  },
  {
   "content": "这会切换我们的思维系统使用大脑的某个区域",
   "from": 20.5,
   "location": 2,
   "music": 0.0,
   "sid": 9,
   "to": 24.84
  },
  {
   "content": "这被称为默认模式网络听起来很高大上",
   "from": 24.84,
   "location": 2,
   "music": 0.0,
   "sid": 10,
   "to": 27.76
  },
  {
   "content": "其实并非默认模式网络",
   "from": 27.76,
   "location": 2,
   "music": 0.0,
   "sid": 11,
   "to": 29.56
  },
  {
   "content": "是大脑中一组激活的结构",
   "from": 29.56,
   "location": 2,
   "music": 0.0,
   "sid": 12,
   "to": 32.659
  },
  {
   "content": "当你无事可想时就会启动",
   "from": 32.659,
   "location": 2,
   "music": 0.0,
   "sid": 13,
   "to": 35.219
  },
  {
   "content": "你忘带手机了",
   "from": 35.219,
   "location": 2,
   "music": 0.0,
   "sid": 14,
   "to": 36.899
  },
  {
   "content": "你坐在阳光下",
   "from": 36.899,
   "location": 2,
   "music": 0.0,
   "sid": 15,
   "to": 38.16
  },
  {
   "content": "例如",
   "from": 38.16,
   "location": 2,
   "music": 0.0,
   "sid": 16,
   "to": 39.28
  },
  {
   "content": "这时默认模式网络就会激活",
   "from": 39.28,
   "location": 2,
   "music": 0.0,
   "sid": 17,
   "to": 42.1
  },
  {
   "content": "我们并不喜欢",
   "from": 42.1,
   "location": 2,
   "music": 0.0,
   "sid": 18,
   "to": 43.44
  },
  {
   "content": "哈佛心理学系的同事丹·吉尔伯特",
   "from": 43.44,
   "location": 2,
   "music": 0.0,
   "sid": 19,
   "to": 46.95
  },
  {
   "content": "他做过实验让参与者在房间坐十五分钟",
   "from": 46.95,
   "location": 2,
   "music": 0.0,
   "sid": 20,
   "to": 51.2
  },
  {
   "content": "必须完全不做任何事情",
   "from": 51.2,
   "location": 2,
   "music": 0.0,
   "sid": 21,
   "to": 52.92
  },
  {
   "content": "房间里没有任何可做的事",
   "from": 52.92,
   "location": 2,
   "music": 0.0,
   "sid": 22,
   "to": 55.1
  },
  {
   "content": "除了面前有一个按钮",
   "from": 55.1,
   "location": 2,
   "music": 0.0,
   "sid": 23,
   "to": 57.77
  },
  {
   "content": "可以按下",
   "from": 57.77,
   "location": 2,
   "music": 0.0,
   "sid": 24,
   "to": 58.37
  },
  {
   "content": "按下后会给自己电击",
   "from": 58.37,
   "location": 2,
   "music": 0.0,
   "sid": 25,
   "to": 61.71
  },
  {
   "content": "坐在这里",
   "from": 61.71,
   "location": 2,
   "music": 0.0,
   "sid": 26,
   "to": 62.39
  },
  {
   "content": "无聊还是电击",
   "from": 62.39,
   "location": 2,
   "music": 0.0,
   "sid": 27,
   "to": 63.99
  },
  {
   "content": "大多数参与者选择电击",
   "from": 63.99,
   "location": 2,
   "music": 0.0,
   "sid": 28,
   "to": 66.97
  },
  {
   "content": "而非思考空白",
   "from": 66.97,
   "location": 2,
   "music": 0.0,
   "sid": 29,
   "to": 68.29
  },
  {
   "content": "我们讨厌无聊",
   "from": 68.29,
   "location": 2,
   "music": 0.0,
   "sid": 30,
   "to": 69.71
  },
  {
   "content": "无聊很可怕",
   "from": 69.71,
   "location": 2,
   "music": 0.0,
   "sid": 31,
   "to": 70.89
  },
  {
   "content": "为什么无聊这么糟糕呢",
   "from": 70.89,
   "location": 2,
   "music": 0.0,
   "sid": 32,
   "to": 72.73
  },
  {
   "content": "因为默认模式网络会让我们思考可能不适的内容",
   "from": 72.73,
   "location": 2,
   "music": 0.0,
   "sid": 33,
   "to": 77.99
  },
  {
   "content": "当你什么都不想时",
   "from": 77.99,
   "location": 2,
   "music": 0.0,
   "sid": 34,
   "to": 79.49
  },
  {
   "content": "思绪会漫游并思考",
   "from": 79.49,
   "location": 2,
   "music": 0.0,
   "sid": 35,
   "to": 81.41
  },
  {
   "content": "例如",
   "from": 81.41,
   "location": 2,
   "music": 0.0,
   "sid": 36,
   "to": 81.97
  },
  {
   "content": "人生意义的重大问题",
   "from": 81.97,
   "location": 2,
   "music": 0.0,
   "sid": 37,
   "to": 84.09
  },
  {
   "content": "我的人生有何意义会让人感到不适",
   "from": 84.09,
   "location": 2,
   "music": 0.0,
   "sid": 38,
   "to": 86.83
  },
  {
   "content": "存在性问题",
   "from": 86.83,
   "location": 2,
   "music": 0.0,
   "sid": 39,
   "to": 88.23
  },
  {
   "content": "当你无聊时",
   "from": 88.23,
   "location": 2,
   "music": 0.0,
   "sid": 40,
   "to": 89.53
  },
  {
   "content": "这其实非常重要",
   "from": 89.53,
   "location": 2,
   "music": 0.0,
   "sid": 41,
   "to": 91.63
  },
  {
   "content": "极其有益",
   "from": 91.63,
   "location": 2,
   "music": 0.0,
   "sid": 42,
   "to": 92.61
  },
  {
   "content": "我们社会抑郁症和焦虑症激增的原因之一",
   "from": 92.61,
   "location": 2,
   "music": 0.0,
   "sid": 43,
   "to": 95.77
  },
  {
   "content": "在于人们不了解生命的意义",
   "from": 95.77,
   "location": 2,
   "music": 0.0,
   "sid": 44,
   "to": 100.38
  },
  {
   "content": "远不如前几代人",
   "from": 100.38,
   "location": 2,
   "music": 0.0,
   "sid": 45,
   "to": 102.12
  },
  {
   "content": "大量数据证明这一点",
   "from": 102.12,
   "location": 2,
   "music": 0.0,
   "sid": 46,
   "to": 103.52
  },
  {
   "content": "而且我们从未正视",
   "from": 103.52,
   "location": 2,
   "music": 0.0,
   "sid": 47,
   "to": 106.49
  },
  {
   "content": "为什么",
   "from": 106.49,
   "location": 2,
   "music": 0.0,
   "sid": 48,
   "to": 107.61
  },
  {
   "content": "我告诉你",
   "from": 107.61,
   "location": 2,
   "music": 0.0,
   "sid": 49,
   "to": 108.53
  },
  {
   "content": "为什么",
   "from": 108.53,
   "location": 2,
   "music": 0.0,
   "sid": 50,
   "to": 109.07
  },
  {
   "content": "我们找到了消除无聊的方法",
   "from": 109.07,
   "location": 2,
   "music": 0.0,
   "sid": 51,
   "to": 112.62
  },
  {
   "content": "我们几乎完全关闭了大脑的默认模式网络",
   "from": 112.74,
   "location": 2,
   "music": 0.0,
   "sid": 52,
   "to": 119.22
  },
  {
   "content": "答案就是你口袋里的那个带屏幕的设备",
   "from": 119.46,
   "location": 2,
   "music": 0.0,
   "sid": 53,
   "to": 123.16
  },
  {
   "content": "你把它拿出来",
   "from": 123.16,
   "location": 2,
   "music": 0.0,
   "sid": 54,
   "to": 124.34
  },
  {
   "content": "即使你站在街角",
   "from": 124.34,
   "location": 2,
   "music": 0.0,
   "sid": 55,
   "to": 126.5
  },
  {
   "content": "等待红绿灯变灯",
   "from": 126.5,
   "location": 2,
   "music": 0.0,
   "sid": 56,
   "to": 127.72
  },
  {
   "content": "就像",
   "from": 127.72,
   "location": 2,
   "music": 0.0,
   "sid": 57,
   "to": 128.32
  },
  {
   "content": "我可能得在这里等十五秒",
   "from": 128.32,
   "location": 2,
   "music": 0.0,
   "sid": 58,
   "to": 131.36
  },
  {
   "content": "你在做什么",
   "from": 131.92,
   "location": 2,
   "music": 0.0,
   "sid": 59,
   "to": 132.7
  },
  {
   "content": "你其实是在努力不无聊",
   "from": 132.7,
   "location": 2,
   "music": 0.0,
   "sid": 60,
   "to": 134.56
  },
  {
   "content": "因为默认模式网络有些令人不适",
   "from": 134.56,
   "location": 2,
   "music": 0.0,
   "sid": 61,
   "to": 137.3
  },
  {
   "content": "因为它会引出你难以理解的问题",
   "from": 137.3,
   "location": 2,
   "music": 0.0,
   "sid": 62,
   "to": 140.5
  },
  {
   "content": "你根本无法完全把握",
   "from": 140.5,
   "location": 2,
   "music": 0.0,
   "sid": 63,
   "to": 142.14
  },
  {
   "content": "这可是个大问题",
   "from": 142.14,
   "location": 2,
   "music": 0.0,
   "sid": 64,
   "to": 143.54
  },
  {
   "content": "这",
   "from": 143.54,
   "location": 2,
   "music": 0.0,
   "sid": 65,
   "to": 144.1
  },
  {
   "content": "这是意义的恶性循环",
   "from": 144.1,
   "location": 2,
   "music": 0.0,
   "sid": 66,
   "to": 145.99
  },
  {
   "content": "每次你感到轻微无聊",
   "from": 145.99,
   "location": 2,
   "music": 0.0,
   "sid": 67,
   "to": 148.19
  },
  {
   "content": "就掏出手机",
   "from": 148.19,
   "location": 2,
   "music": 0.0,
   "sid": 68,
   "to": 149.29
  },
  {
   "content": "你会越来越难找到人生意义",
   "from": 149.29,
   "location": 2,
   "music": 0.0,
   "sid": 69,
   "to": 151.77
  },
  {
   "content": "这就是抑郁和焦虑的配方",
   "from": 151.77,
   "location": 2,
   "music": 0.0,
   "sid": 70,
   "to": 155.9
  },
  {
   "content": "以及空虚感",
   "from": 155.9,
   "location": 2,
   "music": 0.0,
   "sid": 71,
   "to": 158.06
  },
  {
   "content": "顺便说一句这些症状都很严重",
   "from": 158.06,
   "location": 2,
   "music": 0.0,
   "sid": 72,
   "to": 161.28
  },
  {
   "content": "我懂了",
   "from": 162.549,
   "location": 2,
   "music": 0.0,
   "sid": 73,
   "to": 163.389
  },
  {
   "content": "你不想无聊",
   "from": 163.389,
   "location": 2,
   "music": 0.0,
   "sid": 74,
   "to": 164.569
  },
  {
   "content": "你需要体验无聊",
   "from": 164.569,
   "location": 2,
   "music": 0.0,
   "sid": 75,
   "to": 165.959
  },
  {
   "content": "明天去健身房时多感受些无聊",
   "from": 165.959,
   "location": 2,
   "music": 0.0,
   "sid": 76,
   "to": 169.159
  },
  {
   "content": "早晨醒来后",
   "from": 169.159,
   "location": 2,
   "music": 0.0,
   "sid": 77,
   "to": 170.319
  },
  {
   "content": "别带手机",
   "from": 170.319,
   "location": 2,
   "music": 0.0,
   "sid": 78,
   "to": 171.559
  },
  {
   "content": "你能忍受不听播客吗",
   "from": 171.559,
   "location": 2,
   "music": 0.0,
   "sid": 79,
   "to": 174.78
  },
  {
   "content": "健身时只在脑子里活动",
   "from": 174.78,
   "location": 2,
   "music": 0.0,
   "sid": 80,
   "to": 177.44
  },
  {
   "content": "我保证你会有最有趣的灵感",
   "from": 177.44,
   "location": 2,
   "music": 0.0,
   "sid": 81,
   "to": 180.1
  },
  {
   "content": "健身时不带设备",
   "from": 180.1,
   "location": 2,
   "music": 0.0,
   "sid": 82,
   "to": 181.88
  },
  {
   "content": "你很久没做过完全静默的通勤了",
   "from": 181.88,
   "location": 2,
   "music": 0.0,
   "sid": 83,
   "to": 185.32
  },
  {
   "content": "甚至不开收音机",
   "from": 185.32,
   "location": 2,
   "music": 0.0,
   "sid": 84,
   "to": 186.64
  },
  {
   "content": "能否开始练习十五分钟以上的耐无聊能力",
   "from": 186.64,
   "location": 2,
   "music": 0.0,
   "sid": 85,
   "to": 193.66
  },
  {
   "content": "然后你会看到生活发生改变第一点",
   "from": 193.66,
   "location": 2,
   "music": 0.0,
   "sid": 86,
   "to": 196.54
  },
  {
   "content": "你会对生活中的普通事物更不无聊",
   "from": 196.54,
   "location": 2,
   "music": 0.0,
   "sid": 87,
   "to": 199.02
  },
  {
   "content": "若提升耐无聊的技能",
   "from": 199.02,
   "location": 2,
   "music": 0.0,
   "sid": 88,
   "to": 200.96
  },
  {
   "content": "你会对工作更不无聊",
   "from": 200.96,
   "location": 2,
   "music": 0.0,
   "sid": 89,
   "to": 202.26
  },
  {
   "content": "你会对人际关系更不无聊",
   "from": 202.26,
   "location": 2,
   "music": 0.0,
   "sid": 90,
   "to": 203.88
  },
  {
   "content": "你会对周围发生的事更不无聊",
   "from": 203.88,
   "location": 2,
   "music": 0.0,
   "sid": 91,
   "to": 206.75
  },
  {
   "content": "但更重要的是",
   "from": 206.75,
   "location": 2,
   "music": 0.0,
   "sid": 92,
   "to": 208.07
  },
  {
   "content": "你会开始探索人生的重大问题",
   "from": 208.07,
   "location": 2,
   "music": 0.0,
   "sid": 93,
   "to": 211.11
  },
  {
   "content": "人生目标",
   "from": 211.11,
   "location": 2,
   "music": 0.0,
   "sid": 94,
   "to": 212.29
  },
  {
   "content": "生命意义",
   "from": 212.29,
   "location": 2,
   "music": 0.0,
   "sid": 95,
   "to": 213.13
  },
  {
   "content": "内在连贯性",
   "from": 213.13,
   "location": 2,
   "music": 0.0,
   "sid": 96,
   "to": 214.01
  },
  {
   "content": "重要性",
   "from": 215.09,
   "location": 2,
   "music": 0.0,
   "sid": 97,
   "to": 216.32
  },
  {
   "content": "说不定你真的会更快乐",
   "from": 216.72,
   "location": 2,
   "music": 0.0,
   "sid": 98,
   "to": 220.44
  },
  {
   "content": "人们常问我医生是否在给自己开药",
   "from": 220.8,
   "location": 2,
   "music": 0.0,
   "sid": 99,
   "to": 224.26
  },
  {
   "content": "答案是肯定的",
   "from": 224.26,
   "location": 2,
   "music": 0.0,
   "sid": 100,
   "to": 225.65
  },
  {
   "content": "是的",
   "from": 225.65,
   "location": 2,
   "music": 0.0,
   "sid": 101,
   "to": 226.15
  },
  {
   "content": "我容易患上和他人相同的病理问题",
   "from": 226.15,
   "location": 2,
   "music": 0.0,
   "sid": 102,
   "to": 229.25
  },
  {
   "content": "因为我和其他人拥有相同的脑化学机制",
   "from": 229.25,
   "location": 2,
   "music": 0.0,
   "sid": 103,
   "to": 231.37
  },
  {
   "content": "所以我该怎么做才能对抗这一点",
   "from": 231.37,
   "location": 2,
   "music": 0.0,
   "sid": 104,
   "to": 232.61
  },
  {
   "content": "答案是",
   "from": 232.61,
   "location": 2,
   "music": 0.0,
   "sid": 105,
   "to": 233.49
  },
  {
   "content": "我做了很多事情",
   "from": 233.49,
   "location": 2,
   "music": 0.0,
   "sid": 106,
   "to": 234.47
  },
  {
   "content": "晚上七点后实行无设备政策",
   "from": 234.47,
   "location": 2,
   "music": 0.0,
   "sid": 107,
   "to": 239.57
  },
  {
   "content": "我不在睡前使用手机",
   "from": 239.57,
   "location": 2,
   "music": 0.0,
   "sid": 108,
   "to": 241.21
  },
  {
   "content": "我们家里没有设备",
   "from": 241.21,
   "location": 2,
   "music": 0.0,
   "sid": 109,
   "to": 242.67
  },
  {
   "content": "在我家用餐时",
   "from": 242.67,
   "location": 2,
   "music": 0.0,
   "sid": 110,
   "to": 245.82
  },
  {
   "content": "因为我们彼此陪伴",
   "from": 245.82,
   "location": 2,
   "music": 0.0,
   "sid": 111,
   "to": 247.62
  },
  {
