{
 "bvid": "BV1u6Pgz6EMb",
 "title": "【中英+文稿】像士兵一样快速从倦怠中恢复 | 一套简单流程把状态拉回来",
 "owner": "思维火种",
 "aid": 116156283227939,
 "cid": 36385260643,
 "duration": 935,
 "body": [
  {
   "content": "士兵不会等待和平来休息",
   "from": 0.12,
   "location": 2,
   "music": 0.0,
   "sid": 1,
   "to": 1.98
  },
  {
   "content": "他们在战争中休整",
   "from": 1.98,
   "location": 2,
   "music": 0.0,
   "sid": 2,
   "to": 3.83
  },
  {
   "content": "部署中的士兵",
   "from": 3.83,
   "location": 2,
   "music": 0.0,
   "sid": 3,
   "to": 5.09
  },
  {
   "content": "无法说",
   "from": 5.09,
   "location": 2,
   "music": 0.0,
   "sid": 4,
   "to": 6.11
  },
  {
   "content": "等这一切结束我再休息",
