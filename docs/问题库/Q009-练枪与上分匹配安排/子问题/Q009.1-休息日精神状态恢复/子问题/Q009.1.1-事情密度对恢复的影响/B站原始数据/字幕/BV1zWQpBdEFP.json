   "sid": 14,
   "location": 2,
   "content": "我是觉得他不像在工作中",
   "music": 0.0
  },
  {
   "from": 28.6,
   "to": 31.04,
   "sid": 15,
   "location": 2,
   "content": "人与人交交流起来有压力呀",
