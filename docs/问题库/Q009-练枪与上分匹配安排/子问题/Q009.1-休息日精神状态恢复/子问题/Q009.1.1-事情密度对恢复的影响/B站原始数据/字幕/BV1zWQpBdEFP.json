  },
  {
   "from": 31.04,
   "to": 32.879,
   "sid": 16,
   "location": 2,
   "content": "不是一种太好的学习方法",
   "music": 0.0
  },
  {
   "from": 32.879,
   "to": 33.859,
   "sid": 17,
   "location": 2,
   "content": "可以这样做",
   "music": 0.0
  },
  {
   "from": 33.859,
   "to": 34.819,
   "sid": 18,
   "location": 2,
   "content": "阶段性有效",
   "music": 0.0
  },
  {
   "from": 34.819,
   "to": 35.999,
   "sid": 19,
   "location": 2,
   "content": "但是在我的评估里边",
   "music": 0.0
  },
  {
   "from": 35.999,
   "to": 37.639,
   "sid": 20,
   "location": 2,
   "content": "它不算是一种太有效的休息方法",
