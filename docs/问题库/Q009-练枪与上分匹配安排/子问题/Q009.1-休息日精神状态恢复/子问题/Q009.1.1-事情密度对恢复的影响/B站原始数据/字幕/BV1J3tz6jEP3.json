{
 "bvid": "BV1J3tz6jEP3",
 "title": "完成一个任务后，不应该安排休息，应该在任务中间安排休息；最有效的休息模式是：提前休息，高频休息，短时休息，大脑放空休息；玩手机不是休息【高频问题004】",
 "owner": "奥德修斯的绳索",
 "aid": 117211922504212,
 "cid": 41576040361,
 "duration": 846,
 "body": [
  {
   "from": 0.2,
   "to": 0.64,
   "sid": 1,
   "location": 2,
   "content": "大家好",
   "music": 0.0
  },
  {
   "from": 0.64,
   "to": 2.52,
   "sid": 2,
   "location": 2,
   "content": "在咨询的时候遇到这样一个经典问题",
   "music": 0.0
  },
  {
   "from": 2.52,
   "to": 5.26,
   "sid": 3,
   "location": 2,
   "content": "就是有很多朋友在完成一个任务之后",
   "music": 0.0
  },
  {
   "from": 5.26,
   "to": 6.3,
   "sid": 4,
   "location": 2,
   "content": "就进行休息",
   "music": 0.0
  },
  {
   "from": 6.3,
   "to": 8.5,
   "sid": 5,
   "location": 2,
   "content": "但是休息的时候就一直想休息",
   "music": 0.0
  },
  {
   "from": 8.5,
   "to": 10.129,
   "sid": 6,
   "location": 2,
   "content": "不想再继续做任务了",
   "music": 0.0
  },
  {
   "from": 10.129,
   "to": 13.169,
   "sid": 7,
   "location": 2,
   "content": "尤其是休息的时候还很容易直接进行娱乐",
   "music": 0.0
  },
  {
   "from": 13.169,
   "to": 14.249,
   "sid": 8,
   "location": 2,
   "content": "比如说玩手机",
   "music": 0.0
  },
  {
   "from": 14.249,
   "to": 16.329,
   "sid": 9,
   "location": 2,
   "content": "这样就更愿意一直休息",
   "music": 0.0
  },
  {
   "from": 16.329,
   "to": 17.409,
   "sid": 10,
   "location": 2,
   "content": "不想再继续",
   "music": 0.0
  },
  {
   "from": 17.409,
   "to": 18.85,
   "sid": 11,
   "location": 2,
   "content": "那么针对这个问题",
   "music": 0.0
  },
  {
   "from": 18.85,
   "to": 20.31,
   "sid": 12,
   "location": 2,
   "content": "直接说结论",
   "music": 0.0
  },
  {
   "from": 20.31,
   "to": 21.53,
   "sid": 13,
   "location": 2,
   "content": "第一个结论就是说",
   "music": 0.0
  },
  {
   "from": 21.53,
   "to": 25.23,
   "sid": 14,
   "location": 2,
   "content": "人其实不应该在两个任务中间去安排休息",
   "music": 0.0
  },
  {
   "from": 25.23,
   "to": 25.65,
   "sid": 15,
   "location": 2,
   "content": "也就是说",
   "music": 0.0
  },
  {
   "from": 25.65,
   "to": 29.63,
   "sid": 16,
   "location": 2,
   "content": "人不应该在完成一个任务之后去安排休息",
   "music": 0.0
  },
  {
   "from": 29.63,
   "to": 32.49,
   "sid": 17,
   "location": 2,
   "content": "人应该是在完成一个任务之后",
   "music": 0.0
  },
  {
   "from": 32.49,
   "to": 33.93,
   "sid": 18,
   "location": 2,
   "content": "直接就无缝切换",
   "music": 0.0
  },
  {
   "from": 33.93,
   "to": 35.879,
   "sid": 19,
   "location": 2,
   "content": "直接切换到第二个任务",
   "music": 0.0
  },
  {
   "from": 35.879,
   "to": 38.159,
   "sid": 20,
   "location": 2,
   "content": "那么人应该在什么时候安排休息",
   "music": 0.0
  },
  {
   "from": 38.159,
   "to": 40.619,
   "sid": 21,
   "location": 2,
   "content": "人应该在一个任务进行当中",
   "music": 0.0
  },
  {
   "from": 40.619,
   "to": 43.72,
   "sid": 22,
   "location": 2,
   "content": "没完成的时候来去中断这个任务",
   "music": 0.0
  },
  {
   "from": 43.72,
   "to": 46.0,
   "sid": 23,
   "location": 2,
   "content": "暂停这个任务进行休息",
   "music": 0.0
  },
  {
   "from": 46.0,
   "to": 47.3,
   "sid": 24,
   "location": 2,
   "content": "这是第一个结论",
   "music": 0.0
  },
  {
   "from": 47.3,
   "to": 48.59,
   "sid": 25,
   "location": 2,
   "content": "第二个结论是",
   "music": 0.0
  },
  {
   "from": 48.59,
   "to": 52.69,
   "sid": 26,
   "location": 2,
   "content": "玩手机等高强度用脑的活动不是休息",
   "music": 0.0
  },
  {
   "from": 52.69,
   "to": 55.41,
   "sid": 27,
   "location": 2,
   "content": "最有效的休息模式是提前休息",
   "music": 0.0
  },
  {
   "from": 55.41,
   "to": 56.17,
   "sid": 28,
   "location": 2,
   "content": "高频休息",
   "music": 0.0
  },
  {
   "from": 56.17,
   "to": 57.26,
   "sid": 29,
   "location": 2,
   "content": "短时休息",
   "music": 0.0
  },
  {
   "from": 57.26,
   "to": 59.12,
   "sid": 30,
   "location": 2,
   "content": "让大脑放空的休息",
   "music": 0.0
  },
  {
   "from": 59.12,
   "to": 62.52,
   "sid": 31,
   "location": 2,
   "content": "这期视频会详细地解释结论一",
   "music": 0.0
  },
  {
   "from": 62.52,
   "to": 65.009,
   "sid": 32,
   "location": 2,
   "content": "简单的带过结论二",
   "music": 0.0
  },
  {
   "from": 65.009,
   "to": 68.869,
   "sid": 33,
   "location": 2,
   "content": "那现在就来看一下这两个结论的论证和原理",
   "music": 0.0
  },
  {
   "from": 68.869,
   "to": 71.369,
   "sid": 34,
   "location": 2,
   "content": "原理我一再强调是非常重要的",
   "music": 0.0
  },
  {
   "from": 71.369,
   "to": 73.3,
   "sid": 35,
   "location": 2,
   "content": "因为只有我们认识的原理",
   "music": 0.0
  },
  {
   "from": 73.3,
   "to": 75.86,
   "sid": 36,
   "location": 2,
   "content": "我们才能够对各种事情有系统的认识",
   "music": 0.0
  },
  {
   "from": 75.86,
   "to": 76.58,
   "sid": 37,
   "location": 2,
   "content": "认识了原理",
   "music": 0.0
  },
  {
   "from": 76.58,
   "to": 78.38,
   "sid": 38,
   "location": 2,
   "content": "我们才能对方法增加信心",
   "music": 0.0
  },
  {
   "from": 78.38,
   "to": 80.4,
   "sid": 39,
   "location": 2,
   "content": "才能明确方法的应用情景",
   "music": 0.0
  },
  {
   "from": 80.4,
   "to": 83.48,
   "sid": 40,
   "location": 2,
   "content": "才能在方法失败的时候进行诊断",
   "music": 0.0
  },
  {
   "from": 83.48,
   "to": 85.37,
   "sid": 41,
   "location": 2,
   "content": "能了解失败的原因",
   "music": 0.0
  },
  {
   "from": 85.37,
   "to": 86.65,
   "sid": 42,
   "location": 2,
   "content": "并且做出改进",
   "music": 0.0
  },
  {
   "from": 86.65,
   "to": 88.81,
   "sid": 43,
   "location": 2,
   "content": "以及我们才能够灵活的应用",
   "music": 0.0
  },
  {
   "from": 88.81,
   "to": 89.77,
   "sid": 44,
   "location": 2,
   "content": "比如举一反三",
   "music": 0.0
  },
  {
   "from": 89.77,
   "to": 92.33,
   "sid": 45,
   "location": 2,
   "content": "或者说在同一个事上进行更好效果",
   "music": 0.0
  },
  {
   "from": 92.33,
   "to": 93.37,
   "sid": 46,
   "location": 2,
   "content": "更个性化的应用",
   "music": 0.0
  },
  {
   "from": 93.37,
   "to": 95.29,
   "sid": 47,
   "location": 2,
   "content": "这个是原理的作用",
   "music": 0.0
  },
  {
   "from": 95.29,
   "to": 98.359,
   "sid": 48,
   "location": 2,
   "content": "那现在就来看一下休息的时机",
   "music": 0.0
  },
  {
   "from": 98.359,
   "to": 101.799,
   "sid": 49,
   "location": 2,
   "content": "为什么不应该安排在两个任务之间",
   "music": 0.0
  },
  {
   "from": 101.799,
   "to": 105.45,
   "sid": 50,
   "location": 2,
   "content": "就为什么任务切换最应该是直接切换",
   "music": 0.0
  },
  {
   "from": 105.45,
   "to": 106.59,
   "sid": 51,
   "location": 2,
   "content": "有三个原理",
   "music": 0.0
  },
  {
   "from": 106.59,
   "to": 108.41,
   "sid": 52,
   "location": 2,
   "content": "第一个原理是行为惯性",
   "music": 0.0
  },
  {
   "from": 108.41,
   "to": 109.91,
   "sid": 53,
   "location": 2,
   "content": "行为是有惯性的",
   "music": 0.0
  },
  {
   "from": 109.91,
   "to": 112.03,
   "sid": 54,
   "location": 2,
   "content": "因为人的各种状态",
   "music": 0.0
  },
  {
   "from": 112.03,
   "to": 113.09,
   "sid": 55,
   "location": 2,
   "content": "比如说动力状态",
   "music": 0.0
  },
  {
   "from": 113.09,
   "to": 113.77,
   "sid": 56,
   "location": 2,
   "content": "认知模式",
   "music": 0.0
  },
  {
   "from": 113.77,
   "to": 116.58,
   "sid": 57,
   "location": 2,
   "content": "唤醒水平等各种这些属性状态",
   "music": 0.0
  },
  {
   "from": 116.58,
   "to": 120.18,
   "sid": 58,
   "location": 2,
   "content": "全都是倾向于在一段时间之内去保持连续",
   "music": 0.0
  },
  {
   "from": 120.18,
   "to": 121.32,
   "sid": 59,
   "location": 2,
   "content": "保持相同的",
   "music": 0.0
  },
  {
   "from": 121.32,
   "to": 122.66,
   "sid": 60,
   "location": 2,
   "content": "就是不愿意变化",
   "music": 0.0
  },
  {
   "from": 122.66,
   "to": 123.4,
   "sid": 61,
   "location": 2,
   "content": "愿意相同",
   "music": 0.0
  },
  {
   "from": 123.4,
   "to": 124.44,
   "sid": 62,
   "location": 2,
   "content": "愿意连续",
   "music": 0.0
  },
  {
   "from": 124.44,
   "to": 128.14,
   "sid": 63,
   "location": 2,
   "content": "那么如果在前一个任务的结尾的时候",
   "music": 0.0
  },
  {
   "from": 128.14,
   "to": 131.3,
   "sid": 64,
   "location": 2,
   "content": "直接去接上下一个任务的开始",
   "music": 0.0
  },
  {
   "from": 131.3,
   "to": 133.78,
   "sid": 65,
   "location": 2,
   "content": "这个时候就相当于人保持了一种惯性",
   "music": 0.0
  },
  {
   "from": 133.78,
   "to": 134.94,
   "sid": 66,
   "location": 2,
   "content": "保持着行为的惯性",
   "music": 0.0
  },
  {
   "from": 134.94,
   "to": 137.33,
   "sid": 67,
   "location": 2,
   "content": "这些属性全都能保证连续",
   "music": 0.0
  },
  {
   "from": 137.33,
   "to": 140.83,
   "sid": 68,
   "location": 2,
   "content": "但是如果说人完成一个任务去进入休息",
   "music": 0.0
  },
  {
   "from": 140.83,
   "to": 142.35,
   "sid": 69,
   "location": 2,
   "content": "那么在休息结束的时候",
   "music": 0.0
  },
  {
   "from": 142.35,
   "to": 144.11,
   "sid": 70,
   "location": 2,
   "content": "人想去做下一个任务的时候",
   "music": 0.0
  },
  {
   "from": 144.11,
   "to": 146.21,
   "sid": 71,
   "location": 2,
   "content": "人还需要重新去制造状态",
   "music": 0.0
  },
  {
   "from": 146.21,
   "to": 148.73,
   "sid": 72,
   "location": 2,
   "content": "重新去制造一个做事的状态",
   "music": 0.0
  },
  {
   "from": 148.73,
   "to": 151.57,
   "sid": 73,
   "location": 2,
   "content": "因为前一个任务的结束也是做事状态",
   "music": 0.0
  },
  {
   "from": 151.57,
   "to": 153.94,
   "sid": 74,
   "location": 2,
   "content": "下一个任务的开始也是做事状态",
   "music": 0.0
  },
  {
   "from": 153.94,
   "to": 155.66,
   "sid": 75,
   "location": 2,
   "content": "两个状态有很多共性",
   "music": 0.0
  },
  {
   "from": 155.66,
   "to": 157.49,
   "sid": 76,
   "location": 2,
   "content": "更容易去改变",
   "music": 0.0
  },
  {
   "from": 157.49,
   "to": 160.61,
   "sid": 77,
   "location": 2,
   "content": "但是做事状态和休息状态区别就很大",
   "music": 0.0
  },
  {
   "from": 160.61,
   "to": 162.31,
   "sid": 78,
   "location": 2,
   "content": "更不容易去改变",
   "music": 0.0
  },
  {
   "from": 162.31,
   "to": 163.43,
   "sid": 79,
   "location": 2,
   "content": "更不容易去制造",
   "music": 0.0
  },
  {
   "from": 163.43,
   "to": 164.61,
   "sid": 80,
   "location": 2,
   "content": "就制造会更困难",
   "music": 0.0
  },
  {
   "from": 164.61,
   "to": 166.08,
   "sid": 81,
   "location": 2,
   "content": "有可能制造不出来",
   "music": 0.0
  },
  {
   "from": 166.08,
   "to": 168.02,
   "sid": 82,
   "location": 2,
   "content": "所以这个就是很可能休息的时候",
   "music": 0.0
  },
  {
   "from": 168.02,
   "to": 171.06,
   "sid": 83,
   "location": 2,
   "content": "如果说没有一些方法能够制造出做事状态",
   "music": 0.0
  },
  {
   "from": 171.06,
   "to": 173.34,
   "sid": 84,
   "location": 2,
   "content": "那人就会倾向于一直休息",
   "music": 0.0
  },
  {
   "from": 173.34,
   "to": 175.78,
   "sid": 85,
   "location": 2,
   "content": "所以说如果利用人的行为惯性",
   "music": 0.0
  },
  {
   "from": 175.78,
   "to": 179.13,
   "sid": 86,
   "location": 2,
   "content": "那就是人应该在前一个任务没结束的时候",
   "music": 0.0
  },
  {
   "from": 179.13,
   "to": 182.0,
   "sid": 87,
   "location": 2,
   "content": "直接连上下一个任务",
   "music": 0.0
  },
  {
   "from": 182.0,
   "to": 184.88,
   "sid": 88,
   "location": 2,
   "content": "或者说就是结束之后直接连上下一个任务",
   "music": 0.0
  },
  {
   "from": 184.88,
   "to": 186.62,
   "sid": 89,
   "location": 2,
   "content": "这是第一个原理",
   "music": 0.0
  },
  {
   "from": 186.62,
   "to": 189.14,
   "sid": 90,
   "location": 2,
   "content": "第二个原理是人在休息的时候",
   "music": 0.0
  },
  {
   "from": 189.14,
   "to": 190.78,
   "sid": 91,
   "location": 2,
   "content": "因为有时间思考",
   "music": 0.0
  },
  {
   "from": 190.78,
   "to": 192.46,
   "sid": 92,
   "location": 2,
   "content": "就会想到各种信息",
   "music": 0.0
  },
  {
   "from": 192.46,
   "to": 194.06,
   "sid": 93,
   "location": 2,
   "content": "就可能会动摇",
   "music": 0.0
  },
  {
   "from": 194.06,
   "to": 196.75,
   "sid": 94,
   "location": 2,
   "content": "人已经做出的决策是什么",
   "music": 0.0
  },
  {
   "from": 196.75,
   "to": 199.93,
   "sid": 95,
   "location": 2,
   "content": "决策就是关于下一个任务做什么",
   "music": 0.0
  },
  {
   "from": 199.93,
   "to": 202.55,
   "sid": 96,
   "location": 2,
   "content": "下一个任务什么时候做的这个决策",
   "music": 0.0
  },
  {
   "from": 202.55,
   "to": 203.81,
   "sid": 97,
   "location": 2,
   "content": "但是反过来",
   "music": 0.0
  },
  {
   "from": 203.81,
   "to": 206.17,
   "sid": 98,
   "location": 2,
   "content": "如果说人直接进行任务切换",
   "music": 0.0
  },
  {
   "from": 206.17,
   "to": 207.97,
   "sid": 99,
   "location": 2,
   "content": "那这个时候直接就是执行",
   "music": 0.0
  },
  {
   "from": 207.97,
   "to": 209.61,
   "sid": 100,
   "location": 2,
   "content": "直接一瞬间就是执行",
   "music": 0.0
  },
  {
   "from": 209.61,
   "to": 211.73,
   "sid": 101,
   "location": 2,
   "content": "没有给人反思的空间",
   "music": 0.0
  },
  {
   "from": 211.73,
   "to": 214.17,
   "sid": 102,
   "location": 2,
   "content": "人就会按照提前定好的计划",
   "music": 0.0
  },
  {
   "from": 214.17,
   "to": 216.25,
   "sid": 103,
   "location": 2,
   "content": "直接去执行前一个任务结束了",
   "music": 0.0
  },
  {
   "from": 216.25,
   "to": 217.32,
   "sid": 104,
   "location": 2,
   "content": "这个时候人意识到",
   "music": 0.0
  },
  {
   "from": 217.32,
   "to": 219.52,
   "sid": 105,
   "location": 2,
   "content": "那直接就要执行下一个任务",
   "music": 0.0
  },
  {
   "from": 219.52,
   "to": 222.84,
   "sid": 106,
   "location": 2,
   "content": "那这个时候就是等于直接执行前边定好的角色",
   "music": 0.0
  },
  {
   "from": 222.84,
   "to": 224.49,
   "sid": 107,
   "location": 2,
   "content": "或者说前边定好的计划",
   "music": 0.0
  },
  {
   "from": 224.49,
   "to": 226.92,
   "sid": 108,
   "location": 2,
   "content": "就是人前边需要提前规定好",
   "music": 0.0
  },
  {
   "from": 226.92,
   "to": 228.68,
