{
 "bvid": "BV1kj41177nn",
 "title": "【TED演讲】生活不只是快乐，怎样的人生更有意义？",
 "owner": "ABC英语乐园",
 "aid": 451341011,
 "cid": 1340952126,
 "duration": 725,
 "body": [
  {
   "from": 0.32,
   "to": 5.54,
   "sid": 1,
   "location": 2,
   "content": "我以前认为生活的全部目的就是追求幸福"
  },
  {
   "from": 6.22,
   "to": 9.28,
   "sid": 2,
   "location": 2,
   "content": "每个人都说通往幸福的道路是成功"
  },
  {
   "from": 9.28,
   "to": 11.94,
   "sid": 3,
   "location": 2,
   "content": "所以我寻找理想的工作"
  },
  {
   "from": 11.94,
   "to": 13.54,
   "sid": 4,
   "location": 2,
   "content": "完美的男朋友"
  },
  {
   "from": 13.54,
   "to": 15.26,
   "sid": 5,
   "location": 2,
   "content": "那间漂亮的公寓"
  },
  {
   "from": 16.219,
   "to": 19.219,
   "sid": 6,
   "location": 2,
   "content": "但却从未感到满足"
  },
  {
   "from": 19.219,
   "to": 22.1,
   "sid": 7,
   "location": 2,
   "content": "我感到焦虑和漂泊"
  },
  {
   "from": 22.34,
   "to": 23.72,
   "sid": 8,
   "location": 2,
   "content": "我并不孤单"
  },
  {
   "from": 23.72,
   "to": 24.52,
   "sid": 9,
   "location": 2,
   "content": "我的朋友们"
  },
  {
   "from": 24.52,
   "to": 26.6,
   "sid": 10,
   "location": 2,
   "content": "他们也在为此挣扎"
  },
  {
   "from": 28.08,
   "to": 32.18,
   "sid": 11,
   "location": 2,
   "content": "最后我决定去研究生院学习积极心理学"
  },
  {
   "from": 32.18,
   "to": 35.599,
   "sid": 12,
   "location": 2,
   "content": "去了解真正让人快乐的东西"
  },
  {
   "from": 36.16,
   "to": 39.12,
   "sid": 13,
   "location": 2,
   "content": "但我在那里的发现改变了我的生活"
  },
  {
   "from": 39.64,
   "to": 44.559,
   "sid": 14,
   "location": 2,
   "content": "数据显示追求幸福会让人不开心"
  },
  {
   "from": 45.16,
   "to": 47.459,
   "sid": 15,
   "location": 2,
   "content": "真正打动我的是"
  },
  {
   "from": 48.28,
   "to": 51.08,
   "sid": 16,
   "location": 2,
   "content": "世界各地的自杀率一直在上升"
  },
  {
   "from": 51.08,
   "to": 54.58,
   "sid": 17,
   "location": 2,
   "content": "最近在美国达到了30年来的最高水平"
  },
  {
   "from": 55.06,
   "to": 60.32,
   "sid": 18,
   "location": 2,
   "content": "尽管从几乎所有可以想象的标准来看，生活客观上正在变得更好"
  },
  {
   "from": 60.32,
   "to": 62.44,
   "sid": 19,
   "location": 2,
   "content": "更多的人感到绝望"
  },
  {
   "from": 62.44,
   "to": 64.899,
   "sid": 20,
   "location": 2,
   "content": "抑郁孤独"
  },
  {
   "from": 65.44,
   "to": 68.06,
   "sid": 21,
   "location": 2,
   "content": "有一种空虚折磨着人们"
  },
  {
   "from": 68.06,
   "to": 69.96,
   "sid": 22,
   "location": 2,
   "content": "你不必有临床上的抑郁症"
  },
  {
   "from": 69.96,
   "to": 72.74,
   "sid": 23,
   "location": 2,
   "content": "去感受它"
  },
  {
   "from": 72.74,
   "to": 77.179,
   "sid": 24,
   "location": 2,
   "content": "我想我们都想知道"
  },
  {
   "from": 78.34,
   "to": 79.86,
   "sid": 25,
   "location": 2,
   "content": "根据研究"
  },
  {
   "from": 79.86,
   "to": 80.72,
   "sid": 26,
   "location": 2,
   "content": "什么预测"
  },
  {
   "from": 80.72,
   "to": 83.22,
   "sid": 27,
   "location": 2,
   "content": "这种绝望并不是缺乏幸福"
  },
  {
   "from": 83.22,
   "to": 85.42,
   "sid": 28,
   "location": 2,
   "content": "是缺乏其他东西"
  },
  {
   "from": 86.04,
   "to": 89.039,
   "sid": 29,
   "location": 2,
   "content": "生活缺乏意义"
  },
  {
   "from": 90.16,
   "to": 92.86,
   "sid": 30,
   "location": 2,
   "content": "但这给我带来了一些问题"
  },
  {
   "from": 92.86,
   "to": 95.88,
   "sid": 31,
   "location": 2,
   "content": "生活中还有比快乐更重要的吗"
  },
  {
   "from": 96.44,
   "to": 100.98,
   "sid": 32,
   "location": 2,
   "content": "快乐和人生有意义有什么区别呢？"
  },
  {
   "from": 102.14,
   "to": 106.62,
   "sid": 33,
   "location": 2,
   "content": "许多心理学家将幸福定义为一种舒适和安逸的状态"
  },
  {
   "from": 106.62,
   "to": 108.899,
   "sid": 34,
   "location": 2,
   "content": "此刻感觉很好"
  },
  {
   "from": 109.44,
   "to": 110.64,
   "sid": 35,
   "location": 2,
   "content": "不过，意义更深"
  },
  {
   "from": 111.68,
   "to": 114.2,
   "sid": 36,
   "location": 2,
   "content": "著名心理学家马丁塞利格曼说"
  },
  {
   "from": 114.2,
   "to": 116.04,
   "sid": 37,
   "location": 2,
   "content": "意义来自于属于"
  },
  {
   "from": 116.04,
   "to": 118.6,
   "sid": 38,
   "location": 2,
   "content": "为超越自己的事情服务"
  },
  {
   "from": 118.68,
   "to": 121.72,
   "sid": 39,
   "location": 2,
   "content": "从发展你最好的一面"
  },
  {
   "from": 122.9,
   "to": 125.38,
   "sid": 40,
   "location": 2,
   "content": "我们的文化痴迷于幸福"
  },
  {
   "from": 125.38,
   "to": 129.24,
   "sid": 41,
   "location": 2,
   "content": "但我发现寻找意义是更有成就感的道路"
  },
  {
   "from": 129.5,
   "to": 132.56,
   "sid": 42,
   "location": 2,
   "content": "研究表明，在生活中有意义的人"
  },
  {
   "from": 132.56,
   "to": 133.94,
   "sid": 43,
   "location": 2,
   "content": "他们更有弹性"
  },
  {
   "from": 133.94,
   "to": 136.4,
   "sid": 44,
   "location": 2,
   "content": "他们在学校和工作中都做得更好"
  },
  {
   "from": 136.4,
   "to": 138.42,
   "sid": 45,
   "location": 2,
   "content": "它们甚至活得更长"
  },
  {
   "from": 139.18,
   "to": 141.06,
   "sid": 46,
   "location": 2,
   "content": "所以这一切都让我想知道"
  },
  {
   "from": 141.06,
   "to": 146.06,
   "sid": 47,
   "location": 2,
   "content": "我们每个人怎样才能活得更有意义"
  },
  {
   "from": 146.06,
   "to": 148.86,
   "sid": 48,
   "location": 2,
   "content": "我花了五年时间采访了数百人"
  },
  {
   "from": 148.86,
   "to": 151.7,
   "sid": 49,
   "location": 2,
   "content": "阅读数千页的心理学"
  },
  {
   "from": 151.7,
   "to": 154.16,
   "sid": 50,
   "location": 2,
   "content": "神经科学与哲学"
  },
  {
   "from": 154.66,
   "to": 156.22,
   "sid": 51,
   "location": 2,
   "content": "把一切都聚集在一起"
  },
  {
   "from": 156.22,
   "to": 161.64,
   "sid": 52,
   "location": 2,
   "content": "我发现有我所说的有意义的生活的四大支柱"
  },
  {
   "from": 161.679,
   "to": 164.119,
   "sid": 53,
   "location": 2,
   "content": "我们每个人都可以创造有意义的生活"
  },
  {
   "from": 164.119,
   "to": 167.52,
   "sid": 54,
   "location": 2,
   "content": "通过在我们的生活中建立一些或所有这些支柱"
  },
  {
   "from": 168.62,
   "to": 171.16,
   "sid": 55,
   "location": 2,
   "content": "第一支柱是归属"
  },
  {
   "from": 171.78,
   "to": 174.04,
   "sid": 56,
   "location": 2,
   "content": "归属感来自于人际关系"
  },
  {
   "from": 174.04,
   "to": 174.9,
   "sid": 57,
   "location": 2,
   "content": "你被重视的地方"
  },
  {
   "from": 174.9,
   "to": 176.56,
   "sid": 58,
   "location": 2,
   "content": "因为你本质上是谁"
  },
  {
   "from": 176.56,
   "to": 178.88,
   "sid": 59,
   "location": 2,
   "content": "你也重视别人的地方"
  },
  {
   "from": 179.419,
   "to": 184.119,
   "sid": 60,
   "location": 2,
   "content": "但有些群体和关系提供了一种廉价的归属感"
  },
  {
   "from": 184.119,
   "to": 187.32,
   "sid": 61,
   "location": 2,
   "content": "你的价值在于你的信仰和你恨的人"
  },
  {
   "from": 187.32,
   "to": 187.82,
   "sid": 62,
   "location": 2,
   "content": "不是"
  },
  {
   "from": 187.82,
   "to": 190.24,
   "sid": 63,
   "location": 2,
   "content": "因为你是真实的"
  },
  {
   "from": 190.24,
   "to": 192.36,
   "sid": 64,
   "location": 2,
   "content": "归属感源于爱"
  },
  {
   "from": 192.36,
   "to": 195.34,
   "sid": 65,
   "location": 2,
   "content": "它生活在个体之间的瞬间"
  },
  {
   "from": 195.34,
   "to": 199.22,
   "sid": 66,
   "location": 2,
   "content": "你可以选择培养与他人的归属感"
  },
  {
   "from": 199.86,
   "to": 201.3,
   "sid": 67,
   "location": 2,
   "content": "这里有一个例子"
  },
  {
   "from": 201.58,
   "to": 206.16,
   "sid": 68,
   "location": 2,
   "content": "每天早上我的朋友乔纳森都从同一条街上买一份报纸"
  },
  {
   "from": 206.16,
   "to": 207.56,
   "sid": 69,
   "location": 2,
   "content": "纽约的供应商"
  },
  {
   "from": 207.64,
   "to": 209.72,
   "sid": 70,
   "location": 2,
   "content": "他们不只是进行交易"
  },
  {
   "from": 209.72,
   "to": 211.9,
   "sid": 71,
   "location": 2,
   "content": "尽管他们需要一点时间来放慢速度"
  },
  {
   "from": 211.9,
   "to": 214.84,
   "sid": 72,
   "location": 2,
   "content": "像人类一样交谈和对待对方"
  },
  {
   "from": 215.24,
   "to": 218.44,
   "sid": 73,
   "location": 2,
   "content": "但是有一次乔纳森没有找对零钱"
  },
  {
   "from": 218.44,
   "to": 219.9,
   "sid": 74,
   "location": 2,
   "content": "小贩说"
  },
  {
   "from": 219.9,
   "to": 221.38,
   "sid": 75,
   "location": 2,
   "content": "别担心"
  },
  {
   "from": 221.38,
   "to": 223.82,
   "sid": 76,
   "location": 2,
   "content": "但乔纳森坚持要付钱"
  },
  {
   "from": 223.82,
   "to": 226.3,
   "sid": 77,
   "location": 2,
   "content": "所以他去商店买了些东西"
  },
  {
   "from": 226.3,
   "to": 228.68,
   "sid": 78,
   "location": 2,
   "content": "他不需要改变"
  },
  {
   "from": 229.18,
   "to": 231.76,
   "sid": 79,
   "location": 2,
   "content": "但当他把钱给小贩时"
  },
  {
   "from": 231.76,
   "to": 233.06,
   "sid": 80,
   "location": 2,
   "content": "小贩后退了一步"
  },
  {
   "from": 234.22,
   "to": 235.22,
   "sid": 81,
   "location": 2,
   "content": "他受伤了"
  },
  {
   "from": 235.939,
   "to": 237.879,
   "sid": 82,
   "location": 2,
   "content": "他想做些好事"
  },
  {
   "from": 241.34,
   "to": 244.46,
   "sid": 83,
   "location": 2,
   "content": "我想我们都以这样的小方式拒绝别人"
  },
  {
   "from": 244.46,
   "to": 245.62,
   "sid": 84,
   "location": 2,
   "content": "却没有意识到"
  },
  {
   "from": 245.62,
   "to": 246.61,
   "sid": 85,
   "location": 2,
   "content": "我有"
  },
  {
   "from": 246.61,
   "to": 247.97,
   "sid": 86,
   "location": 2,
   "content": "我会从某人身边走过"
  },
  {
   "from": 247.97,
   "to": 249.95,
   "sid": 87,
   "location": 2,
   "content": "我知道，但几乎不承认他们"
  },
  {
   "from": 249.95,
   "to": 250.89,
   "sid": 88,
   "location": 2,
   "content": "我去看看我的手机"
  },
  {
   "from": 250.89,
   "to": 252.56,
   "sid": 89,
   "location": 2,
   "content": "当有人跟我说话"
  },
  {
   "from": 252.82,
   "to": 254.92,
   "sid": 90,
   "location": 2,
   "content": "这些行为贬低了他人的价值"
  },
  {
   "from": 254.92,
   "to": 257.779,
   "sid": 91,
   "location": 2,
   "content": "他们让他们觉得自己是隐形的，不配"
  },
  {
   "from": 258.32,
   "to": 259.959,
   "sid": 92,
   "location": 2,
   "content": "但当你用爱引领"
  },
  {
   "from": 259.959,
   "to": 263.04,
   "sid": 93,
   "location": 2,
   "content": "你创造了一种纽带，让你们每个人都振作起来"
  },
  {
   "from": 264.26,
   "to": 265.2,
   "sid": 94,
   "location": 2,
   "content": "对很多人来说"
  },
  {
   "from": 265.2,
   "to": 267.9,
   "sid": 95,
   "location": 2,
   "content": "归属感是最本质的意义源泉"
  },
  {
   "from": 267.9,
   "to": 271.09,
   "sid": 96,
   "location": 2,
   "content": "那些与家人和朋友的纽带"
  },
  {
   "from": 271.09,
   "to": 273.49,
   "sid": 97,
   "location": 2,
   "content": "意义的关键是第二支柱"
  },
  {
   "from": 273.49,
   "to": 279.999,
   "sid": 98,
   "location": 2,
   "content": "目标现在找到你的目标和找到让你快乐的工作是不一样的"
  },
  {
   "from": 280.999,
   "to": 283.9,
   "sid": 99,
   "location": 2,
   "content": "目标与其说是你想要什么，不如说是你给予什么"
  },
  {
   "from": 284.099,
   "to": 288.579,
   "sid": 100,
   "location": 2,
   "content": "一个医院管理员告诉我她的目的是治愈病人"
  },
  {
   "from": 288.579,
   "to": 292.64,
   "sid": 101,
   "location": 2,
   "content": "许多父母告诉我，我的目的是抚养我的孩子"
  },
  {
   "from": 292.7,
   "to": 296.76,
   "sid": 102,
   "location": 2,
   "content": "目标的关键是利用你的优势为他人服务"
  },
  {
   "from": 297.58,
   "to": 299.02,
   "sid": 103,
   "location": 2,
   "content": "当然对我们很多人来说"
  },
  {
   "from": 299.02,
   "to": 301.0,
   "sid": 104,
   "location": 2,
   "content": "这是在工作中发生的"
  },
  {
   "from": 301.06,
   "to": 304.07,
   "sid": 105,
   "location": 2,
   "content": "这就是我们如何做出贡献，并感到被需要"
  },
  {
   "from": 304.07,
   "to": 307.93,
   "sid": 106,
   "location": 2,
   "content": "但这也意味着像工作中的脱离这样的问题"
  },
  {
   "from": 307.93,
   "to": 309.98,
   "sid": 107,
   "location": 2,
   "content": "失业率低"
  },
  {
   "from": 309.98,
   "to": 311.62,
   "sid": 108,
   "location": 2,
   "content": "劳动力参与率"
  },
  {
   "from": 311.62,
   "to": 313.5,
   "sid": 109,
   "location": 2,
   "content": "这些不仅仅是经济问题"
  },
  {
   "from": 313.5,
   "to": 315.66,
   "sid": 110,
   "location": 2,
   "content": "他们也是存在主义的"
  },
  {
   "from": 316.24,
   "to": 319.66,
   "sid": 111,
   "location": 2,
   "content": "没有值得做的事情，人们举步维艰"
  },
  {
   "from": 320.699,
   "to": 323.319,
   "sid": 112,
   "location": 2,
   "content": "当然，你不必在工作中找到目标"
  },
  {
   "from": 323.319,
   "to": 326.819,
   "sid": 113,
   "location": 2,
   "content": "但目标给了你一些生活的东西"
  },
  {
   "from": 326.819,
   "to": 328.48,
   "sid": 114,
   "location": 2,
   "content": "推动你前进"
  },
  {
   "from": 330.38,
   "to": 333.56,
   "sid": 115,
   "location": 2,
   "content": "意义的第三个支柱也是关于超越自己"
  },
  {
   "from": 333.56,
   "to": 335.36,
   "sid": 116,
   "location": 2,
   "content": "但以一种完全不同的方式"
  },
  {
   "from": 337.24,
   "to": 339.66,
   "sid": 117,
   "location": 2,
   "content": "超然状态是那些难得的时刻"
  },
  {
   "from": 339.66,
   "to": 343.0,
   "sid": 118,
   "location": 2,
   "content": "当你摆脱了日常生活的喧嚣"
  },
  {
   "from": 343.0,
   "to": 344.8,
   "sid": 119,
   "location": 2,
   "content": "你的自我意识消失了"
  },
  {
   "from": 344.8,
   "to": 347.7,
   "sid": 120,
   "location": 2,
   "content": "你感觉到与更高的现实相连"
  },
  {
   "from": 348.44,
   "to": 349.2,
   "sid": 121,
   "location": 2,
   "content": "对于一个人来说"
  },
  {
   "from": 349.2,
   "to": 350.52,
   "sid": 122,
   "location": 2,
   "content": "我和超越谈过了"
  },
  {
   "from": 350.52,
   "to": 352.09,
   "sid": 123,
   "location": 2,
   "content": "来自于看艺术"
  },
  {
   "from": 352.09,
   "to": 353.19,
   "sid": 124,
   "location": 2,
   "content": "为了另一个人"
  },
  {
   "from": 353.19,
   "to": 355.53,
   "sid": 125,
   "location": 2,
   "content": "对我来说是在教堂"
  },
  {
   "from": 355.53,
   "to": 356.39,
   "sid": 126,
   "location": 2,
   "content": "我是个作家"
  },
  {
   "from": 356.39,
   "to": 358.32,
   "sid": 127,
   "location": 2,
   "content": "它是通过写作发生的"
  },
  {
   "from": 358.32,
   "to": 363.42,
   "sid": 128,
   "location": 2,
   "content": "有时我太投入了，以至于失去了时间和地点的感觉"
  },
  {
   "from": 363.94,
   "to": 367.06,
   "sid": 129,
   "location": 2,
   "content": "这些超然的经历可以改变你"
  },
  {
   "from": 367.06,
   "to": 368.74,
   "sid": 130,
   "location": 2,
   "content": "一项研究有学生"
  },
  {
   "from": 368.74,
   "to": 373.06,
   "sid": 131,
   "location": 2,
   "content": "抬头看两百英尺高的桉树一分钟"
  },
  {
   "from": 373.46,
   "to": 375.62,
   "sid": 132,
   "location": 2,
   "content": "但之后他们就不那么以自我为中心了"
  },
  {
   "from": 375.62,
   "to": 379.76,
   "sid": 133,
   "location": 2,
   "content": "当他们有机会帮助别人时，他们甚至表现得更慷慨"
  },
  {
   "from": 385.599,
   "to": 387.479,
   "sid": 134,
   "location": 2,
   "content": "现在第四个意义支柱"
  },
  {
   "from": 387.479,
   "to": 390.44,
   "sid": 135,
   "location": 2,
   "content": "我发现往往会让人惊讶"
  },
  {
   "from": 390.52,
   "to": 393.22,
   "sid": 136,
   "location": 2,
   "content": "第四个支柱是讲故事"
  },
  {
   "from": 393.22,
   "to": 396.46,
   "sid": 137,
   "location": 2,
   "content": "你给自己讲的关于自己的故事"
  },
  {
   "from": 397.0,
   "to": 401.04,
   "sid": 138,
   "location": 2,
   "content": "从你生活中的事件中创造一个故事会让你变得清晰"
  },
  {
   "from": 401.04,
   "to": 404.32,
   "sid": 139,
   "location": 2,
   "content": "它帮助你理解你是如何成为你自己的"
  },
  {
   "from": 404.9,
   "to": 407.92,
   "sid": 140,
   "location": 2,
   "content": "但我们并不总是意识到我们是自己故事的作者"
  },
  {
   "from": 407.92,
   "to": 409.06,
   "sid": 141,
   "location": 2,
   "content": "并能改变方式"
  },
  {
   "from": 409.06,
   "to": 412.619,
   "sid": 142,
   "location": 2,
   "content": "我们告诉他们你的生活不仅仅是一系列事件"
  },
  {
   "from": 412.619,
   "to": 413.879,
   "sid": 143,
   "location": 2,
   "content": "您可以编辑"
  },
  {
   "from": 413.879,
   "to": 415.979,
   "sid": 144,
   "location": 2,
   "content": "解释和复述你的故事"
  },
  {
   "from": 415.979,
   "to": 418.18,
   "sid": 145,
   "location": 2,
   "content": "即使你被事实所束缚"
  },
  {
   "from": 418.9,
   "to": 421.28,
   "sid": 146,
   "location": 2,
   "content": "我遇到了一个叫伊玛的年轻人"
  },
  {
   "from": 421.28,
   "to": 425.36,
   "sid": 147,
   "location": 2,
   "content": "他受伤后踢足球瘫痪了"
  },
  {
   "from": 425.36,
   "to": 428.32,
   "sid": 148,
   "location": 2,
   "content": "Emeka告诉自己我的生活很棒"
  },
  {
   "from": 428.32,
   "to": 429.32,
   "sid": 149,
   "location": 2,
   "content": "踢足球"
  },
  {
   "from": 429.32,
   "to": 431.74,
   "sid": 150,
   "location": 2,
   "content": "但现在看看我"
  },
  {
   "from": 433.24,
   "to": 435.34,
   "sid": 151,
   "location": 2,
   "content": "像这样讲故事的人"
  },
  {
   "from": 435.34,
   "to": 436.74,
   "sid": 152,
   "location": 2,
   "content": "我的生活很美好"
  },
  {
   "from": 436.74,
   "to": 437.16,
   "sid": 153,
   "location": 2,
   "content": "现在呢"
  },
  {
   "from": 437.16,
   "to": 438.0,
   "sid": 154,
   "location": 2,
   "content": "很糟糕"
  },
  {
   "from": 438.0,
   "to": 440.62,
   "sid": 155,
   "location": 2,
   "content": "他们往往更焦虑和沮丧"
  },
  {
   "from": 440.62,
   "to": 443.6,
   "sid": 156,
   "location": 2,
   "content": "有一段时间是EMEA"
  },
  {
   "from": 443.719,
   "to": 447.44,
   "sid": 157,
   "location": 2,
   "content": "但随着时间的推移，他开始编织一个不同的故事"
  },
  {
   "from": 447.56,
   "to": 450.7,
   "sid": 158,
   "location": 2,
   "content": "他的新故事是在我受伤之前"
  },
  {
   "from": 450.7,
   "to": 452.58,
   "sid": 159,
   "location": 2,
   "content": "我的生活毫无目的"
  },
  {
   "from": 452.58,
   "to": 455.6,
   "sid": 160,
   "location": 2,
   "content": "我经常参加派对，是个很自私的人"
  },
  {
   "from": 455.88,
   "to": 457.94,
   "sid": 161,
   "location": 2,
   "content": "但我的伤让我意识到"
  },
  {
   "from": 457.94,
   "to": 462.3,
   "sid": 162,
   "location": 2,
   "content": "我可以成为一个更好的人编辑他的故事"
  },
  {
   "from": 462.3,
   "to": 464.04,
   "sid": 163,
   "location": 2,
   "content": "改变了艾卡的生活"
  },
  {
   "from": 464.159,
   "to": 466.699,
   "sid": 164,
   "location": 2,
   "content": "在给自己讲了新故事后"
  },
  {
   "from": 466.699,
   "to": 468.559,
   "sid": 165,
   "location": 2,
   "content": "Emeka开始指导孩子们"
  },
  {
   "from": 468.559,
   "to": 472.66,
   "sid": 166,
   "location": 2,
   "content": "他发现他的目的是为别人服务"
  },
  {
   "from": 473.28,
   "to": 476.78,
   "sid": 167,
   "location": 2,
   "content": "心理学家dan mcadams称这是一个救赎的故事。"
  },
  {
   "from": 476.78,
   "to": 481.46,
   "sid": 168,
   "location": 2,
   "content": "在那里，坏人被过着有意义生活的好人所救赎"
  },
  {
   "from": 481.46,
   "to": 482.02,
   "sid": 169,
   "location": 2,
   "content": "他找到了"
  },
  {
   "from": 482.02,
   "to": 483.96,
   "sid": 170,
   "location": 2,
   "content": "他们倾向于讲述他们的生活故事"
  },
  {
   "from": 483.96,
   "to": 485.44,
   "sid": 171,
   "location": 2,
   "content": "由赎回定义"
  },
  {
   "from": 485.44,
   "to": 487.06,
   "sid": 172,
   "location": 2,
   "content": "成长与爱情"
  },
  {
   "from": 487.94,
   "to": 490.58,
   "sid": 173,
   "location": 2,
   "content": "但是是什么让人们改变他们的故事"
  },
  {
   "from": 491.0,
   "to": 492.9,
   "sid": 174,
   "location": 2,
   "content": "有些人从治疗师那里得到帮助"
  },
  {
   "from": 492.9,
   "to": 494.92,
   "sid": 175,
   "location": 2,
   "content": "但你也可以自己做"
  },
  {
   "from": 494.92,
   "to": 497.46,
   "sid": 176,
   "location": 2,
   "content": "好好反省你的人生"
  },
  {
   "from": 497.46,
   "to": 499.74,
   "sid": 177,
   "location": 2,
   "content": "你的决定性经历如何塑造了你"
  },
  {
   "from": 499.74,
   "to": 500.42,
   "sid": 178,
   "location": 2,
   "content": "你失去的"
  },
  {
   "from": 500.42,
   "to": 501.58,
   "sid": 179,
   "location": 2,
   "content": "你得到的"
  },
  {
   "from": 501.58,
   "to": 503.44,
   "sid": 180,
   "location": 2,
   "content": "艺电就是这么做的"
  },
  {
   "from": 504.24,
   "to": 506.24,
   "sid": 181,
   "location": 2,
   "content": "你不会一夜之间改变你的故事"
  },
  {
   "from": 506.24,
   "to": 508.48,
   "sid": 182,
   "location": 2,
   "content": "这可能需要数年的时间和痛苦"
  },
  {
   "from": 508.48,
   "to": 509.44,
   "sid": 183,
   "location": 2,
   "content": "毕竟"
  },
  {
   "from": 509.44,
   "to": 511.86,
   "sid": 184,
   "location": 2,
   "content": "我们都受过苦，我们都在挣扎"
  },
  {
   "from": 512.059,
   "to": 516.419,
   "sid": 185,
   "location": 2,
   "content": "但是拥抱那些痛苦的记忆可以带来新的见解和智慧"
  },
  {
   "from": 516.419,
   "to": 519.818,
   "sid": 186,
   "location": 2,
   "content": "找到支撑你的好东西"
  },
  {
   "from": 527.12,
   "to": 530.06,
   "sid": 187,
   "location": 2,
   "content": "这是意义的四大支柱"
  },
  {
   "from": 530.84,
   "to": 532.2,
   "sid": 188,
   "location": 2,
   "content": "当我年轻的时候"
  },
  {
   "from": 532.2,
   "to": 536.38,
   "sid": 189,
   "location": 2,
   "content": "我很幸运被所有的柱子包围着"
  },
  {
   "from": 536.52,
   "to": 540.02,
   "sid": 190,
   "location": 2,
   "content": "我父母在我们家开了一个苏菲派聚会所"
  },
  {
   "from": 540.02,
   "to": 541.24,
   "sid": 191,
   "location": 2,
   "content": "在蒙特利尔"
  },
  {
   "from": 541.96,
   "to": 546.5,
   "sid": 192,
   "location": 2,
   "content": "苏菲主义是一种与旋转托钵僧有关的精神实践"
  },
  {
   "from": 546.5,
   "to": 549.56,
   "sid": 193,
   "location": 2,
   "content": "诗人鲁米每周两次"
  },
  {
   "from": 549.56,
   "to": 552.3,
   "sid": 194,
   "location": 2,
   "content": "苏菲派会来我们家冥想"
  },
  {
   "from": 552.3,
   "to": 555.28,
   "sid": 195,
   "location": 2,
   "content": "喝波斯茶分享故事"
  },
  {
   "from": 555.5,
   "to": 558.4,
   "sid": 196,
   "location": 2,
   "content": "他们的修行也包括为所有的造物服务"
  },
  {
   "from": 558.4,
   "to": 560.18,
   "sid": 197,
   "location": 2,
   "content": "通过爱的小行为"
  },
  {
   "from": 560.18,
   "to": 561.68,
   "sid": 198,
   "location": 2,
   "content": "这意味着要善良"
  },
  {
   "from": 561.68,
   "to": 563.52,
   "sid": 199,
   "location": 2,
   "content": "即使别人冤枉你"
  },
  {
   "from": 563.52,
   "to": 567.04,
   "sid": 200,
   "location": 2,
   "content": "但这给了他们一个控制自我的目的"
  },
  {
   "from": 568.22,
   "to": 570.78,
   "sid": 201,
   "location": 2,
   "content": "最后我离开家去上大学"
  },
  {
   "from": 570.78,
   "to": 574.56,
   "sid": 202,
   "location": 2,
   "content": "如果没有苏菲派在我生活中的日常基础"
  },
  {
   "from": 574.56,
   "to": 576.06,
   "sid": 203,
   "location": 2,
   "content": "我觉得没有停泊"
  },
  {
   "from": 576.06,
   "to": 579.66,
   "sid": 204,
   "location": 2,
   "content": "我开始寻找那些让生活有价值的东西"
  },
  {
   "from": 579.66,
   "to": 581.979,
   "sid": 205,
   "location": 2,
   "content": "这就是我踏上这段旅程的原因"
  },
  {
   "from": 582.3,
   "to": 583.18,
   "sid": 206,
   "location": 2,
   "content": "回首"
  },
  {
   "from": 583.18,
   "to": 587.33,
   "sid": 207,
   "location": 2,
   "content": "我现在意识到苏菲派的房子有一个真正的意义文化"
  },
  {
   "from": 587.33,
   "to": 589.71,
   "sid": 208,
   "location": 2,
   "content": "柱子是建筑的一部分"
  },
  {
   "from": 589.71,
   "to": 593.14,
   "sid": 209,
   "location": 2,
   "content": "柱子的存在帮助我们都活得更深"
  },
  {
   "from": 593.64,
   "to": 594.12,
   "sid": 210,
   "location": 2,
   "content": "当然啦"
  },
  {
   "from": 594.12,
   "to": 598.2,
   "sid": 211,
   "location": 2,
   "content": "同样的原则也适用于其他强大的社区"
  },
  {
   "from": 598.2,
   "to": 599.96,
   "sid": 212,
   "location": 2,
   "content": "好的和坏的"
  },
  {
   "from": 601.04,
   "to": 601.76,
   "sid": 213,
   "location": 2,
   "content": "帮派"
  },
  {
   "from": 601.76,
   "to": 602.62,
   "sid": 214,
   "location": 2,
   "content": "邪教"
  },
  {
   "from": 602.78,
   "to": 604.78,
   "sid": 215,
   "location": 2,
   "content": "这些都是有意义的文化"
  },
  {
   "from": 604.78,
   "to": 608.959,
   "sid": 216,
   "location": 2,
   "content": "使用柱子，给人们一些生与死的东西"
  },
  {
   "from": 609.08,
   "to": 614.31,
   "sid": 217,
   "location": 2,
   "content": "但这正是为什么我们作为一个社会必须提供更好的选择"
  },
  {
   "from": 614.31,
   "to": 617.97,
   "sid": 218,
   "location": 2,
   "content": "我们需要在我们的家庭和机构中建立这些支柱"
  },
  {
   "from": 617.97,
   "to": 620.54,
   "sid": 219,
   "location": 2,
   "content": "帮助人们成为最好的自己"
  },
  {
   "from": 621.74,
   "to": 624.18,
   "sid": 220,
   "location": 2,
   "content": "但过有意义的生活需要工作"
  },
  {
   "from": 624.18,
   "to": 626.2,
   "sid": 221,
   "location": 2,
   "content": "这是一个持续的过程"
  },
  {
   "from": 626.2,
   "to": 627.78,
   "sid": 222,
   "location": 2,
   "content": "一天天过去"
  },
  {
   "from": 627.78,
   "to": 629.96,
   "sid": 223,
   "location": 2,
   "content": "我们不断地创造我们的生活"
  },
  {
   "from": 629.96,
   "to": 631.78,
   "sid": 224,
   "location": 2,
   "content": "为我们的故事添砖加瓦"
  },
  {
   "from": 632.06,
   "to": 637.38,
   "sid": 225,
   "location": 2,
   "content": "有时我们会偏离轨道，每当这种情况发生在我身上"
  },
  {
   "from": 637.38,
   "to": 641.02,
   "sid": 226,
   "location": 2,
   "content": "我记得我和父亲的一次强有力的经历"
  },
  {
   "from": 643.06,
   "to": 645.76,
   "sid": 227,
   "location": 2,
   "content": "我大学毕业几个月后"
  },
  {
   "from": 645.76,
   "to": 649.64,
   "sid": 228,
   "location": 2,
   "content": "我爸爸得了严重的心脏病，应该要了他的命"
  },
  {
   "from": 650.26,
   "to": 651.26,
   "sid": 229,
   "location": 2,
   "content": "他活了下来"
  },
  {
   "from": 651.26,
   "to": 653.66,
   "sid": 230,
   "location": 2,
   "content": "当我问他在想什么"
  },
  {
   "from": 653.66,
   "to": 655.06,
   "sid": 231,
   "location": 2,
   "content": "当他面对死亡"
  },
  {
   "from": 655.06,
   "to": 657.94,
   "sid": 232,
   "location": 2,
   "content": "他说他满脑子想的都是活下去"
  },
  {
   "from": 657.94,
   "to": 659.94,
   "sid": 233,
   "location": 2,
   "content": "所以他可以陪在我哥哥和我身边"
  },
  {
   "from": 659.94,
   "to": 662.699,
   "sid": 234,
   "location": 2,
   "content": "这给了他为生命而战的意志"
  },
  {
   "from": 663.28,
   "to": 666.42,
   "sid": 235,
   "location": 2,
   "content": "当他在麻醉下接受紧急手术时"
  },
  {
   "from": 666.42,
   "to": 668.92,
   "sid": 236,
   "location": 2,
   "content": "而不是从10开始倒数"
  },
  {
   "from": 668.92,
   "to": 672.24,
   "sid": 237,
   "location": 2,
   "content": "他像咒语一样重复着我们的名字"
  },
  {
   "from": 672.98,
   "to": 676.8,
   "sid": 238,
   "location": 2,
   "content": "他想让我们的名字成为他在地球上说的最后一句话"
  },
  {
   "from": 676.8,
   "to": 678.359,
   "sid": 239,
   "location": 2,
   "content": "如果他死了"
  },
  {
   "from": 680.3,
   "to": 684.02,
   "sid": 240,
   "location": 2,
   "content": "我爸爸是个木匠，也是个苏菲派教徒"
  },
  {
   "from": 684.3,
   "to": 685.84,
   "sid": 241,
   "location": 2,
   "content": "这是一种卑微的生活"
  },
  {
   "from": 685.84,
   "to": 687.339,
   "sid": 242,
   "location": 2,
   "content": "但美好的生活"
  },
  {
   "from": 687.9,
   "to": 688.82,
   "sid": 243,
   "location": 2,
   "content": "躺在那里"
  },
  {
   "from": 688.82,
   "to": 689.64,
   "sid": 244,
   "location": 2,
   "content": "面对死亡"
  },
  {
   "from": 689.64,
   "to": 691.54,
   "sid": 245,
   "location": 2,
   "content": "他有活下去的理由"
  },
  {
