{
 "bvid": "BV1oK4y1h7X3",
 "title": "每天只要10分钟即可恢复大脑疲劳",
 "owner": "泡麵時間看本書",
 "aid": 884501534,
 "cid": 236443956,
 "duration": 360,
 "body": [
  {
   "from": 6.18,
   "to": 8.6,
   "sid": 1,
   "location": 2,
   "content": "请问大家有没有以下这些症状呢",
   "music": 0.0
  },
  {
   "from": 8.6,
   "to": 10.53,
   "sid": 2,
   "location": 2,
   "content": "一不论是否很忙",
   "music": 0.0
  },
  {
   "from": 10.53,
   "to": 11.67,
   "sid": 3,
   "location": 2,
   "content": "都会觉得很累",
   "music": 0.0
  },
  {
   "from": 11.67,
   "to": 13.68,
   "sid": 4,
   "location": 2,
   "content": "二不论休息多久",
   "music": 0.0
  },
  {
   "from": 13.68,
   "to": 15.03,
   "sid": 5,
   "location": 2,
   "content": "都会有倦怠感",
   "music": 0.0
  },
  {
   "from": 15.03,
   "to": 17.18,
   "sid": 6,
   "location": 2,
   "content": "三无法集中注意力",
   "music": 0.0
  },
  {
   "from": 17.18,
   "to": 19.52,
   "sid": 7,
   "location": 2,
   "content": "总会不由自主地思考各种问题",
   "music": 0.0
  },
  {
   "from": 19.52,
   "to": 21.02,
   "sid": 8,
   "location": 2,
   "content": "如果你有以上症状",
   "music": 0.0
  },
  {
   "from": 21.02,
   "to": 24.17,
   "sid": 9,
   "location": 2,
   "content": "就说明你的大脑已经处于疲劳状态了",
   "music": 0.0
  },
  {
   "from": 24.17,
   "to": 25.49,
   "sid": 10,
   "location": 2,
   "content": "通过这些动画",
   "music": 0.0
  },
  {
   "from": 25.49,
   "to": 27.26,
   "sid": 11,
   "location": 2,
   "content": "你可以学习和为脑疲劳",
   "music": 0.0
  },
  {
   "from": 27.26,
   "to": 30.04,
   "sid": 12,
   "location": 2,
   "content": "即如何恢复脑疲劳的相关知识及方法",
   "music": 0.0
  },
  {
   "from": 30.04,
   "to": 32.74,
   "sid": 13,
   "location": 2,
   "content": "它将有效帮助你构造不易疲劳的大脑",
   "music": 0.0
  },
  {
   "from": 32.74,
   "to": 34.42,
   "sid": 14,
   "location": 2,
   "content": "使你每天能充满活力",
   "music": 0.0
  },
  {
   "from": 34.42,
   "to": 37.42,
   "sid": 15,
   "location": 2,
   "content": "以万全的状态来迎接各种挑战",
   "music": 0.0
  },
  {
   "from": 37.7,
   "to": 40.87,
   "sid": 16,
   "location": 2,
   "content": "这次为大家介绍的是由日本久贺谷亮著",
   "music": 0.0
  },
  {
   "from": 40.87,
   "to": 44.72,
   "sid": 17,
   "location": 2,
   "content": "专门介绍如何有效恢复脑疲劳的高效休息法",
   "music": 0.0
  },
  {
   "from": 44.72,
   "to": 46.64,
   "sid": 18,
   "location": 2,
   "content": "世界精英队要放松大脑",
   "music": 0.0
  },
  {
   "from": 46.64,
   "to": 48.02,
   "sid": 19,
   "location": 2,
   "content": "该书的主旨是",
   "music": 0.0
  },
  {
   "from": 54.16,
   "to": 55.0,
   "sid": 20,
   "location": 2,
   "content": "心存疑问",
   "music": 0.0
  },
  {
   "from": 55.0,
   "to": 57.85,
   "sid": 21,
   "location": 2,
   "content": "但在你还在怀疑其科学性的同时",
   "music": 0.0
  },
  {
   "from": 57.85,
   "to": 59.14,
   "sid": 22,
   "location": 2,
   "content": "谷歌脸书",
   "music": 0.0
  },
  {
   "from": 59.14,
   "to": 62.32,
   "sid": 23,
   "location": 2,
   "content": "思科等世界著名企业已经相继让员工",
   "music": 0.0
  },
  {
   "from": 64.98,
   "to": 66.96,
   "sid": 24,
   "location": 2,
   "content": "那么究竟是什么原因",
   "music": 0.0
  },
  {
   "from": 66.96,
   "to": 68.7,
   "sid": 25,
   "location": 2,
   "content": "让这些世界级的大企业",
   "music": 0.0
  },
  {
   "from": 71.88,
   "to": 73.32,
   "sid": 26,
   "location": 2,
   "content": "答案是肯定的",
   "music": 0.0
  },
  {
   "from": 75.0,
   "to": 77.46,
   "sid": 27,
   "location": 2,
   "content": "有着其他休息法无法企及的优势",
   "music": 0.0
  },
  {
   "from": 77.46,
   "to": 80.32,
   "sid": 28,
   "location": 2,
   "content": "同时也变相证实了大脑休息的重要性",
   "music": 0.0
  },
  {
   "from": 83.65,
   "to": 85.86,
   "sid": 29,
   "location": 2,
   "content": "为什么是大脑最好的休息方法",
   "music": 0.0
  },
  {
   "from": 88.23,
   "to": 90.18,
   "sid": 30,
   "location": 2,
   "content": "优点和方法三部分来讲解",
   "music": 0.0
  },
  {
   "from": 91.26,
   "to": 92.66,
   "sid": 31,
   "location": 2,
   "content": "一和未正念",
   "music": 0.0
  },
  {
   "from": 92.66,
   "to": 94.94,
   "sid": 32,
   "location": 2,
   "content": "正念这个概念最初源于佛教",
   "music": 0.0
  },
  {
   "from": 94.94,
   "to": 95.51,
   "sid": 33,
   "location": 2,
   "content": "禅修",
   "music": 0.0
  },
  {
   "from": 95.51,
   "to": 98.54,
   "sid": 34,
   "location": 2,
   "content": "是从坐禅冥想参悟等发展而来",
   "music": 0.0
  },
  {
   "from": 98.54,
   "to": 100.58,
   "sid": 35,
   "location": 2,
   "content": "是一种自我调节的方法",
   "music": 0.0
  },
  {
   "from": 100.58,
   "to": 104.06,
   "sid": 36,
   "location": 2,
   "content": "卡巴金将其定义为是一种精神训练的方法",
   "music": 0.0
  },
  {
   "from": 104.06,
   "to": 107.53,
   "sid": 37,
   "location": 2,
   "content": "在这种精神训练中强调的是有意识的觉察",
   "music": 0.0
  },
  {
   "from": 107.53,
   "to": 109.39,
   "sid": 38,
   "location": 2,
   "content": "将注意力集中于当下",
   "music": 0.0
  },
  {
   "from": 109.39,
   "to": 112.02,
   "sid": 39,
   "location": 2,
   "content": "以及对当下的一切观念都不做评判",
   "music": 0.0
  },
  {
   "from": 112.02,
   "to": 114.06,
   "sid": 40,
   "location": 2,
   "content": "因此正念就是有目的的",
   "music": 0.0
  },
  {
   "from": 114.06,
   "to": 116.64,
   "sid": 41,
   "location": 2,
   "content": "有意识地关注觉察当下的一切",
   "music": 0.0
  },
  {
   "from": 116.64,
   "to": 119.07,
   "sid": 42,
   "location": 2,
   "content": "而对当下的一切又都不做任何判断",
   "music": 0.0
  },
  {
   "from": 119.07,
   "to": 119.97,
   "sid": 43,
   "location": 2,
   "content": "任何分析",
   "music": 0.0
  },
  {
   "from": 119.97,
   "to": 120.78,
   "sid": 44,
   "location": 2,
   "content": "任何反应",
   "music": 0.0
  },
  {
   "from": 120.78,
   "to": 121.92,
   "sid": 45,
   "location": 2,
   "content": "只是单纯的觉察",
   "music": 0.0
  },
  {
   "from": 121.92,
   "to": 122.98,
   "sid": 46,
   "location": 2,
   "content": "他注意他",
   "music": 0.0
  },
  {
   "from": 127.34,
   "to": 130.88,
   "sid": 47,
   "location": 2,
   "content": "他把达到头脑平和镇定的状态作为主要目标",
   "music": 0.0
  },
  {
   "from": 130.88,
   "to": 133.28,
   "sid": 48,
   "location": 2,
   "content": "学会在内在明晰的状态中放松",
   "music": 0.0
  },
  {
   "from": 133.28,
   "to": 135.38,
   "sid": 49,
   "location": 2,
   "content": "同时保持意识的完全清醒",
   "music": 0.0
  },
  {
   "from": 135.38,
   "to": 138.48,
   "sid": 50,
   "location": 2,
   "content": "在训练能精确地意识当前时刻的过程中",
   "music": 0.0
  },
  {
   "from": 141.12,
   "to": 142.95,
   "sid": 51,
   "location": 2,
   "content": "这可以是任何美好的物体",
   "music": 0.0
  },
  {
   "from": 142.95,
   "to": 143.7,
   "sid": 52,
   "location": 2,
   "content": "如石头",
   "music": 0.0
  },
  {
   "from": 143.7,
   "to": 144.75,
   "sid": 53,
   "location": 2,
   "content": "雕像或水晶",
   "music": 0.0
  },
  {
   "from": 144.75,
   "to": 146.96,
   "sid": 54,
   "location": 2,
   "content": "也可以集中在咒语或呼吸上",
   "music": 0.0
  },
  {
   "from": 146.96,
   "to": 150.17,
   "sid": 55,
   "location": 2,
   "content": "基本来说辅助有助于集中注意力",
   "music": 0.0
  },
  {
   "from": 150.17,
   "to": 152.3,
   "sid": 56,
   "location": 2,
   "content": "此外它还有助于放松",
   "music": 0.0
  },
  {
   "from": 153.98,
   "to": 155.69,
   "sid": 57,
   "location": 2,
   "content": "呼吸比平时更深入",
   "music": 0.0
  },
  {
   "from": 155.69,
   "to": 158.18,
   "sid": 58,
   "location": 2,
   "content": "也有助于培养出平静的状态",
   "music": 0.0
  },
  {
   "from": 163.48,
   "to": 165.22,
   "sid": 59,
   "location": 2,
   "content": "塑造不会疲劳的大脑",
   "music": 0.0
  },
  {
   "from": 165.22,
   "to": 167.47,
   "sid": 60,
   "location": 2,
   "content": "那么DM又是什么呢",
   "music": 0.0
  },
  {
   "from": 167.47,
   "to": 170.8,
   "sid": 61,
   "location": 2,
   "content": "所谓的DMN是指由内侧前额叶皮质",
   "music": 0.0
  },
  {
   "from": 170.8,
   "to": 172.12,
   "sid": 62,
   "location": 2,
   "content": "后扣带皮层楔",
   "music": 0.0
  },
  {
   "from": 172.12,
   "to": 175.18,
   "sid": 63,
   "location": 2,
   "content": "前叶顶叶顶下液等构成的大脑网络",
   "music": 0.0
  },
  {
   "from": 175.18,
   "to": 177.67,
   "sid": 64,
   "location": 2,
   "content": "它会在大脑未执行有意识活动时",
   "music": 0.0
  },
  {
   "from": 177.67,
   "to": 179.35,
   "sid": 65,
   "location": 2,
   "content": "自动进行基本操作",
   "music": 0.0
  },
  {
   "from": 179.35,
   "to": 182.2,
   "sid": 66,
   "location": 2,
   "content": "BMN就犹如一辆自动驾驶的汽车",
   "music": 0.0
  },
  {
   "from": 182.2,
   "to": 183.64,
   "sid": 67,
   "location": 2,
   "content": "就算我们平时发呆",
   "music": 0.0
  },
  {
   "from": 183.64,
   "to": 184.45,
   "sid": 68,
   "location": 2,
   "content": "什么都不干",
   "music": 0.0
  },
  {
   "from": 184.45,
   "to": 186.64,
   "sid": 69,
   "location": 2,
   "content": "脑内总会浮现出各种景象",
   "music": 0.0
  },
  {
   "from": 186.64,
   "to": 188.18,
   "sid": 70,
   "location": 2,
   "content": "处于这种状态下",
   "music": 0.0
  },
  {
   "from": 188.18,
   "to": 190.94,
   "sid": 71,
   "location": 2,
   "content": "它消耗的能量竟然占据脑能量总量的",
   "music": 0.0
  },
  {
   "from": 190.94,
   "to": 193.16,
   "sid": 72,
   "location": 2,
   "content": "60%至80%",
   "music": 0.0
  },
  {
   "from": 193.16,
   "to": 194.12,
   "sid": 73,
   "location": 2,
   "content": "以此可见",
   "music": 0.0
  },
  {
   "from": 194.12,
   "to": 197.4,
   "sid": 74,
   "location": 2,
   "content": "DMM无疑是脑能量最大的消耗者",
   "music": 0.0
  },
  {
   "from": 197.4,
   "to": 200.01,
   "sid": 75,
   "location": 2,
   "content": "而当我们在有意识地去从事某件事时",
   "music": 0.0
  },
  {
   "from": 200.01,
   "to": 202.2,
   "sid": 76,
   "location": 2,
   "content": "其所占的能量仅为5%",
   "music": 0.0
  },
  {
   "from": 202.2,
   "to": 204.74,
   "sid": 77,
   "location": 2,
   "content": "远远不及无故消耗的DM",
   "music": 0.0
  },
  {
   "from": 207.35,
   "to": 209.3,
   "sid": 78,
   "location": 2,
   "content": "将是大脑休息的一个关键",
   "music": 0.0
  },
  {
   "from": 209.3,
   "to": 211.94,
   "sid": 79,
   "location": 2,
   "content": "而正念减压法的创造人卡巴金",
   "music": 0.0
  },
  {
   "from": 211.94,
   "to": 213.9,
   "sid": 80,
   "location": 2,
   "content": "在2005及2010年",
   "music": 0.0
  },
  {
   "from": 213.9,
   "to": 217.34,
   "sid": 81,
   "location": 2,
   "content": "经过连续八周NBS2疗法实践后",
   "music": 0.0
  },
  {
   "from": 217.34,
   "to": 219.74,
   "sid": 82,
   "location": 2,
   "content": "得出了大脑皮层厚度增加的结果",
   "music": 0.0
  },
  {
   "from": 219.74,
   "to": 222.77,
   "sid": 83,
   "location": 2,
   "content": "表明了该疗法不但对大脑机能提升有帮助",
   "music": 0.0
  },
  {
   "from": 222.77,
   "to": 225.14,
   "sid": 84,
   "location": 2,
   "content": "还能用于治疗大脑萎缩等疾病",
   "music": 0.0
  },
  {
   "from": 225.14,
   "to": 227.39,
   "sid": 85,
   "location": 2,
   "content": "同时正念还具有提高注意力",
   "music": 0.0
  },
  {
   "from": 227.39,
   "to": 228.92,
   "sid": 86,
   "location": 2,
   "content": "提高情绪调节能力",
   "music": 0.0
  },
  {
   "from": 228.92,
   "to": 230.12,
   "sid": 87,
   "location": 2,
   "content": "改变自我认知",
   "music": 0.0
  },
  {
   "from": 230.12,
   "to": 231.92,
   "sid": 88,
   "location": 2,
   "content": "改变免疫力的神奇功效",
   "music": 0.0
  },
  {
   "from": 233.06,
   "to": 235.06,
   "sid": 89,
   "location": 2,
   "content": "四具体的冥想方法",
   "music": 0.0
  },
  {
   "from": 235.06,
   "to": 236.74,
   "sid": 90,
   "location": 2,
   "content": "一正念呼吸法",
   "music": 0.0
  },
  {
   "from": 236.74,
   "to": 239.44,
   "sid": 91,
   "location": 2,
   "content": "正念呼吸法作为最基本的冥想方法",
   "music": 0.0
  },
  {
   "from": 239.44,
   "to": 242.62,
   "sid": 92,
   "location": 2,
   "content": "适用于脑袋昏昏沉沉并且易怒的人群",
   "music": 0.0
  },
  {
   "from": 242.62,
   "to": 243.82,
   "sid": 93,
   "location": 2,
   "content": "该人群的病因",
   "music": 0.0
  },
  {
   "from": 243.82,
   "to": 247.06,
   "sid": 94,
   "location": 2,
   "content": "主要因为过度的把意识集中在了过去或者未来",
   "music": 0.0
  },
  {
   "from": 247.06,
   "to": 249.7,
   "sid": 95,
   "location": 2,
   "content": "而没有把意识集中到现在所造成的",
   "music": 0.0
  },
  {
   "from": 249.7,
   "to": 251.41,
   "sid": 96,
   "location": 2,
   "content": "通过正念呼吸法锻炼",
   "music": 0.0
  },
  {
   "from": 251.41,
   "to": 253.18,
   "sid": 97,
   "location": 2,
   "content": "把人的意识集中到现在",
   "music": 0.0
  },
  {
   "from": 253.18,
   "to": 255.25,
   "sid": 98,
   "location": 2,
   "content": "来达到消除脑疲劳的目的",
   "music": 0.0
  },
  {
   "from": 255.25,
   "to": 257.65,
   "sid": 99,
   "location": 2,
   "content": "正念呼吸法的具体步骤如下",
   "music": 0.0
  },
  {
   "from": 257.65,
   "to": 259.92,
   "sid": 100,
   "location": 2,
   "content": "一采取基本姿势",
   "music": 0.0
  },
  {
   "from": 259.92,
   "to": 261.72,
   "sid": 101,
   "location": 2,
   "content": "一坐在椅子上",
   "music": 0.0
  },
  {
   "from": 261.72,
   "to": 263.84,
   "sid": 102,
   "location": 2,
   "content": "稍微挺直背部离开椅背",
   "music": 0.0
  },
  {
   "from": 263.84,
   "to": 265.55,
   "sid": 103,
   "location": 2,
   "content": "二腹部放松",
   "music": 0.0
  },
  {
   "from": 265.55,
   "to": 266.84,
   "sid": 104,
   "location": 2,
   "content": "手放在大腿上",
   "music": 0.0
  },
  {
   "from": 266.84,
   "to": 268.18,
   "sid": 105,
   "location": 2,
   "content": "双腿部交叉",
   "music": 0.0
  },
  {
   "from": 268.18,
   "to": 270.02,
   "sid": 106,
   "location": 2,
   "content": "三闭上眼睛",
   "music": 0.0
  },
  {
   "from": 270.02,
   "to": 272.0,
   "sid": 107,
   "location": 2,
   "content": "如果采用睁开眼睛的方式",
   "music": 0.0
  },
  {
   "from": 272.0,
   "to": 274.73,
