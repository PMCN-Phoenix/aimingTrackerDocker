    },
    {
      "from": 284.69,
      "to": 286.49,
      "sid": 117,
      "location": 2,
      "content": "主动的队友去贴着他",
      "music": 0.0
    },
    {
      "from": 286.49,
      "to": 287.59,
      "sid": 118,
      "location": 2,
      "content": "跟他一起打",
      "music": 0.0
    },
    {
      "from": 287.59,
      "to": 289.09,
      "sid": 119,
      "location": 2,
      "content": "遇到不主动的队友",
      "music": 0.0
    },
    {
      "from": 289.09,
      "to": 291.05,
      "sid": 120,
      "location": 2,
      "content": "等他跟上来后再一起打",
      "music": 0.0
    },
    {
      "from": 291.05,
      "to": 291.9,
      "sid": 121,
      "location": 2,
      "content": "相信我",
      "music": 0.0
    },
    {
      "from": 291.9,
      "to": 294.67,
      "sid": 122,
      "location": 2,
      "content": "你的回合胜率会高很多",
