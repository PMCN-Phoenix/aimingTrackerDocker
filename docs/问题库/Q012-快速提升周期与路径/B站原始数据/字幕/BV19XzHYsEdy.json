    },
    {
      "from": 263.36,
      "to": 264.88,
      "sid": 107,
      "location": 2,
      "content": "形成人数优势",
      "music": 0.0
    },
    {
      "from": 264.88,
      "to": 267.32,
      "sid": 108,
      "location": 2,
      "content": "或者是在己方人头被打掉时",
