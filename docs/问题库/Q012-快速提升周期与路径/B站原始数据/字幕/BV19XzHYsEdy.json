  "status": "ok",
  "segment_count": 328,
  "body": [
    {
      "from": 0.68,
      "to": 3.88,
      "sid": 1,
      "location": 2,
      "content": "再告诉大家到达神话需要哪些能力",
      "music": 0.0
    },
    {
      "from": 3.88,
      "to": 6.119,
      "sid": 2,
      "location": 2,
      "content": "之前先分享一个例子",
      "music": 0.0
    },
    {
      "from": 6.119,
      "to": 7.299,
      "sid": 3,
      "location": 2,
      "content": "我的一个水友",
      "music": 0.0
    },
    {
      "from": 7.299,
      "to": 10.519,
      "sid": 4,
      "location": 2,
      "content": "他在钻石打侧面靶场能打80多秒",
      "music": 0.0
    },
    {
      "from": 10.519,
      "to": 13.4,
      "sid": 5,
      "location": 2,
      "content": "但他依然卡在钻石快一年了",
      "music": 0.0
    },
    {
      "from": 13.4,
      "to": 17.36,
      "sid": 6,
      "location": 2,
      "content": "而且他总觉得只要哪天自己能打进80秒",
      "music": 0.0
    },
    {
      "from": 17.36,
      "to": 18.6,
      "sid": 7,
      "location": 2,
      "content": "就能上超凡",
      "music": 0.0
    },
    {
      "from": 18.6,
      "to": 21.36,
      "sid": 8,
      "location": 2,
      "content": "所以他一直不停的泡在靶场练",
      "music": 0.0
    },
    {
      "from": 21.36,
      "to": 23.02,
      "sid": 9,
      "location": 2,
      "content": "然而我想说的是",
      "music": 0.0
    },
    {
      "from": 23.02,
      "to": 27.86,
      "sid": 10,
      "location": 2,
      "content": "事实上80多秒的侧面上神话都完全足够了",
      "music": 0.0
    },
    {
      "from": 27.86,
      "to": 31.54,
      "sid": 11,
      "location": 2,
      "content": "在你的瞄准已经到了不会太差劲的阶段时",
      "music": 0.0
    },
    {
      "from": 31.54,
      "to": 34.36,
      "sid": 12,
      "location": 2,
      "content": "你就该多想想实际对局内的东西",
      "music": 0.0
    },
    {
      "from": 34.36,
      "to": 37.82,
      "sid": 13,
      "location": 2,
      "content": "而不是一味的只知道练习纯粹的瞄准",
      "music": 0.0
    },
    {
      "from": 37.82,
      "to": 39.769,
      "sid": 14,
      "location": 2,
      "content": "而且这里有一个误区",
      "music": 0.0
    },
    {
      "from": 39.769,
      "to": 42.569,
      "sid": 15,
      "location": 2,
      "content": "如果你只是想要触碰到神话的水平",
      "music": 0.0
    },
    {
      "from": 42.569,
      "to": 45.469,
      "sid": 16,
      "location": 2,
      "content": "是完全没必要追求一些极致的发挥",
      "music": 0.0
    },
    {
      "from": 45.469,
      "to": 46.8,
      "sid": 17,
      "location": 2,
      "content": "和夸张的瞄准",
      "music": 0.0
    },
    {
      "from": 46.8,
      "to": 48.32,
      "sid": 18,
      "location": 2,
      "content": "而是只需要平稳的",
      "music": 0.0
    },
    {
      "from": 48.32,
      "to": 51.57,
      "sid": 19,
      "location": 2,
      "content": "平静地做好最基本最基础的事情就可以",
      "music": 0.0
    },
    {
      "from": 51.57,
      "to": 53.43,
      "sid": 20,
      "location": 2,
      "content": "这也许有点反直觉",
      "music": 0.0
    },
    {
      "from": 53.43,
      "to": 56.03,
      "sid": 21,
      "location": 2,
      "content": "但这正是很多玩家在不断追求",
      "music": 0.0
    },
    {
      "from": 56.03,
      "to": 58.17,
      "sid": 22,
      "location": 2,
      "content": "更高水平时的一个误区",
      "music": 0.0
    },
    {
      "from": 58.17,
      "to": 62.33,
      "sid": 23,
      "location": 2,
      "content": "事实上你并不需要去极力追求自己的高上限",
      "music": 0.0
    },
    {
      "from": 62.33,
      "to": 65.009,
      "sid": 24,
      "location": 2,
      "content": "比起追求极致的高上限发挥",
      "music": 0.0
    },
    {
      "from": 65.009,
      "to": 67.8,
      "sid": 25,
      "location": 2,
      "content": "你更需要的是去保住下限",
      "music": 0.0
    },
    {
      "from": 67.8,
      "to": 70.92,
      "sid": 26,
      "location": 2,
      "content": "比如说你可以接受自己在面对一个摆设",
      "music": 0.0
    },
    {
      "from": 70.92,
      "to": 72.2,
      "sid": 27,
      "location": 2,
      "content": "很厉害的对手时",
      "music": 0.0
    },
    {
      "from": 72.2,
      "to": 73.34,
      "sid": 28,
      "location": 2,
      "content": "一枪没中",
      "music": 0.0
    },
    {
      "from": 73.34,
      "to": 74.8,
      "sid": 29,
      "location": 2,
      "content": "但绝对不能接受",
      "music": 0.0
    },
    {
      "from": 74.8,
      "to": 77.36,
      "sid": 30,
      "location": 2,
      "content": "面对一个侧身站着不动的对手时",
      "music": 0.0
    },
    {
      "from": 77.36,
      "to": 81.08,
      "sid": 31,
      "location": 2,
      "content": "因为追求快速定位甩枪而不好好瞄准",
      "music": 0.0
    },
    {
      "from": 81.08,
      "to": 82.87,
      "sid": 32,
      "location": 2,
      "content": "导致马枪被反杀",
      "music": 0.0
    },
    {
      "from": 82.87,
      "to": 85.09,
      "sid": 33,
      "location": 2,
      "content": "你可以接受第一枪没打中时",
      "music": 0.0
    },
    {
      "from": 85.09,
      "to": 86.19,
      "sid": 34,
      "location": 2,
      "content": "没来得及调整",
      "music": 0.0
    },
    {
      "from": 86.19,
      "to": 86.97,
      "sid": 35,
      "location": 2,
      "content": "二次开火",
      "music": 0.0
    },
    {
      "from": 86.97,
      "to": 88.8,
      "sid": 36,
      "location": 2,
      "content": "就被人反手一发带走",
      "music": 0.0
    },
    {
      "from": 88.8,
      "to": 91.8,
      "sid": 37,
      "location": 2,
      "content": "但不能接受自己由于着急的二次瞄准",
      "music": 0.0
    },
    {
      "from": 91.8,
      "to": 93.12,
      "sid": 38,
      "location": 2,
      "content": "导致依然没中",
      "music": 0.0
    },
    {
      "from": 93.12,
      "to": 94.94,
      "sid": 39,
      "location": 2,
      "content": "然后连续慌张地开枪",
      "music": 0.0
    },
    {
      "from": 94.94,
      "to": 96.98,
      "sid": 40,
      "location": 2,
      "content": "导致弹道飘到天上去",
      "music": 0.0
    },
    {
      "from": 96.98,
      "to": 99.42,
      "sid": 41,
      "location": 2,
      "content": "所以我接下来想强调的",
      "music": 0.0
    },
    {
      "from": 99.42,
      "to": 102.06,
      "sid": 42,
      "location": 2,
      "content": "所有能让你上神话的必要条件",
      "music": 0.0
    },
    {
      "from": 102.06,
      "to": 105.26,
      "sid": 43,
      "location": 2,
      "content": "都是基于以上这个保底的思维之上的",
      "music": 0.0
    },
    {
      "from": 105.26,
      "to": 107.9,
      "sid": 44,
      "location": 2,
      "content": "我将要讲的这些点看似基础",
      "music": 0.0
    },
    {
      "from": 107.9,
      "to": 110.18,
      "sid": 45,
      "location": 2,
      "content": "但是陷阱正好都是藏在",
      "music": 0.0
    },
    {
      "from": 110.18,
      "to": 113.16,
      "sid": 46,
      "location": 2,
      "content": "似乎人尽皆知的基础里出来",
      "music": 0.0
    },
    {
      "from": 113.16,
      "to": 115.76,
      "sid": 47,
      "location": 2,
      "content": "所以如果你想找到自己的问题",
      "music": 0.0
    },
    {
      "from": 115.76,
      "to": 116.52,
      "sid": 48,
      "location": 2,
      "content": "请听好",
      "music": 0.0
    },
    {
      "from": 116.52,
      "to": 119.12,
      "sid": 49,
      "location": 2,
      "content": "接下来我要强调的每一个点",
      "music": 0.0
    },
    {
      "from": 119.32,
      "to": 120.18,
      "sid": 50,
      "location": 2,
      "content": "第一点",
      "music": 0.0
    },
    {
      "from": 120.18,
      "to": 122.46,
      "sid": 51,
      "location": 2,
      "content": "认真做好基本的预瞄",
      "music": 0.0
    },
    {
      "from": 122.46,
      "to": 124.02,
      "sid": 52,
      "location": 2,
      "content": "不要小看这一点",
      "music": 0.0
    },
    {
      "from": 124.02,
      "to": 124.92,
      "sid": 53,
      "location": 2,
      "content": "这是很多",
      "music": 0.0
    },
    {
      "from": 124.92,
      "to": 128.18,
      "sid": 54,
      "location": 2,
      "content": "包括高段位玩家也会有失误的地方",
      "music": 0.0
    },
    {
      "from": 128.18,
      "to": 130.74,
      "sid": 55,
      "location": 2,
      "content": "育苗最容易出错误的地方",
      "music": 0.0
    },
    {
      "from": 130.74,
      "to": 133.4,
      "sid": 56,
      "location": 2,
      "content": "就是做表面性的懒散育苗",
      "music": 0.0
    },
    {
      "from": 133.4,
      "to": 136.42,
      "sid": 57,
      "location": 2,
      "content": "懒散的育苗的意思是在",
      "music": 0.0
    },
    {
      "from": 136.42,
      "to": 138.7,
      "sid": 58,
      "location": 2,
      "content": "当你拉出去预瞄一个枪位时",
      "music": 0.0
    },
    {
      "from": 138.7,
      "to": 141.38,
      "sid": 59,
      "location": 2,
      "content": "你只是在无意识地执行这个动作",
      "music": 0.0
    },
    {
      "from": 141.38,
      "to": 143.7,
      "sid": 60,
      "location": 2,
      "content": "然而没有做你所描的这个枪位",
      "music": 0.0
    },
    {
      "from": 143.7,
      "to": 145.73,
      "sid": 61,
      "location": 2,
      "content": "有一个敌人的心理预设",
      "music": 0.0
    },
    {
      "from": 145.73,
      "to": 149.87,
      "sid": 62,
      "location": 2,
      "content": "预瞄最重要的不是追求准星摆放完美到极致",
      "music": 0.0
    },
    {
      "from": 149.87,
      "to": 153.81,
      "sid": 63,
      "location": 2,
      "content": "你的预瞄准星是否偏差了敌人头部几个像素点",
      "music": 0.0
    },
    {
      "from": 153.81,
      "to": 154.829,
      "sid": 64,
      "location": 2,
      "content": "无关紧要",
      "music": 0.0
    },
    {
      "from": 154.829,
      "to": 158.569,
      "sid": 65,
      "location": 2,
      "content": "最重要的是保持疫苗专注和你所预瞄位置",
      "music": 0.0
    },
    {
      "from": 158.569,
      "to": 160.39,
      "sid": 66,
      "location": 2,
      "content": "敌人存在的确信感",
      "music": 0.0
    },
    {
      "from": 160.39,
      "to": 161.43,
      "sid": 67,
      "location": 2,
      "content": "关于育苗",
      "music": 0.0
    },
    {
      "from": 161.43,
      "to": 162.75,
      "sid": 68,
      "location": 2,
      "content": "还有一个重要的点",
      "music": 0.0
    },
    {
      "from": 162.75,
      "to": 166.11,
      "sid": 69,
      "location": 2,
      "content": "就是在面对没有任何信息的静默场景",
      "music": 0.0
    },
    {
      "from": 166.11,
      "to": 169.06,
      "sid": 70,
      "location": 2,
      "content": "敌人架点位置的不确定性很强的时候",
      "music": 0.0
    },
    {
      "from": 169.06,
      "to": 170.86,
      "sid": 71,
      "location": 2,
      "content": "不能懒散的跳过枪位",
      "music": 0.0
    },
    {
      "from": 170.86,
      "to": 174.47,
      "sid": 72,
      "location": 2,
      "content": "你需要认真的去挨个排查每一个枪位",
      "music": 0.0
    },
    {
      "from": 174.67,
      "to": 175.49,
      "sid": 73,
      "location": 2,
      "content": "第二点",
      "music": 0.0
    },
    {
      "from": 175.49,
      "to": 179.15,
      "sid": 74,
      "location": 2,
      "content": "队友在对枪时赶紧过去跟他一起对枪",
      "music": 0.0
    },
    {
      "from": 179.15,
      "to": 181.03,
      "sid": 75,
      "location": 2,
      "content": "千万不要小看这一点",
      "music": 0.0
    },
    {
      "from": 181.03,
      "to": 184.47,
      "sid": 76,
      "location": 2,
      "content": "贴着队友尝试去形成一个二打一的局面",
      "music": 0.0
    },
    {
      "from": 184.47,
      "to": 187.94,
      "sid": 77,
      "location": 2,
      "content": "对于每一局回合的胜率有着质的影响",
      "music": 0.0
    },
    {
      "from": 187.94,
      "to": 190.24,
      "sid": 78,
      "location": 2,
      "content": "如果在队友跟敌人对枪的时候",
      "music": 0.0
    },
    {
      "from": 190.24,
      "to": 193.84,
      "sid": 79,
      "location": 2,
      "content": "你也快速拉出来跟队友一起对或者出来补枪",
      "music": 0.0
    },
    {
      "from": 193.84,
      "to": 196.46,
      "sid": 80,
      "location": 2,
      "content": "那么正在跟你队友对枪的这个敌人",
      "music": 0.0
    },
    {
      "from": 196.46,
      "to": 198.9,
      "sid": 81,
      "location": 2,
      "content": "就是活脱脱一个免费人头",
      "music": 0.0
    },
    {
      "from": 198.9,
      "to": 201.62,
      "sid": 82,
      "location": 2,
      "content": "哎我举一个例子",
      "music": 0.32499997968749106
    },
    {
      "from": 201.62,
      "to": 203.52,
      "sid": 83,
      "location": 2,
      "content": "在员工重镇这张图",
      "music": 0.0
    },
    {
      "from": 203.52,
      "to": 206.91,
      "sid": 84,
      "location": 2,
      "content": "天梯里防守A时会有这么一种站位",
      "music": 0.0
    },
    {
      "from": 206.91,
      "to": 209.45,
      "sid": 85,
      "location": 2,
      "content": "一个队友在浴室里顶住浴室",
      "music": 0.0
    },
    {
      "from": 209.45,
      "to": 213.1,
      "sid": 86,
      "location": 2,
      "content": "而你在浴室门口和绿箱这块架一小",
      "music": 0.0
    },
    {
      "from": 213.1,
      "to": 216.7,
      "sid": 87,
      "location": 2,
      "content": "像这种你驾这我嫁那的分配看似合理",
      "music": 0.0
    },
    {
      "from": 216.7,
      "to": 217.48,
      "sid": 88,
      "location": 2,
      "content": "没有问题",
      "music": 0.0
    },
    {
      "from": 217.48,
      "to": 220.76,
      "sid": 89,
      "location": 2,
      "content": "事实上这正是很多人的思维误区",
      "music": 0.0
    },
    {
      "from": 220.76,
      "to": 223.24,
      "sid": 90,
      "location": 2,
      "content": "我们防守面对对面五个人的进攻",
      "music": 0.0
    },
    {
      "from": 223.24,
      "to": 225.18,
      "sid": 91,
      "location": 2,
      "content": "本来就是人少打人多",
      "music": 0.0
    },
    {
      "from": 225.18,
      "to": 227.14,
      "sid": 92,
      "location": 2,
      "content": "这种一人架一个点的手法",
      "music": 0.0
    },
    {
      "from": 227.14,
      "to": 229.9,
      "sid": 93,
      "location": 2,
      "content": "对于对面来说就是A小何浴室",
      "music": 0.0
    },
    {
      "from": 229.9,
      "to": 232.99,
      "sid": 94,
      "location": 2,
      "content": "两个进攻方向全部都是防守方弱侧",
      "music": 0.0
    },
    {
      "from": 232.99,
      "to": 234.85,
      "sid": 95,
      "location": 2,
      "content": "而我们作为防守方",
      "music": 0.0
    },
    {
      "from": 234.85,
      "to": 238.47,
      "sid": 96,
      "location": 2,
      "content": "胜算最大的打法就是两个人一起去抱团",
      "music": 0.0
    },
    {
      "from": 238.47,
      "to": 239.38,
      "sid": 97,
      "location": 2,
      "content": "顶住浴室",
      "music": 0.0
    },
    {
      "from": 239.38,
      "to": 241.32,
      "sid": 98,
      "location": 2,
      "content": "让我们的一边成为强侧",
      "music": 0.0
    },
    {
      "from": 241.32,
      "to": 245.65,
      "sid": 99,
      "location": 2,
      "content": "这样才能最大限度的保证包点一部分的控制权",
      "music": 0.0
    },
    {
      "from": 245.89,
      "to": 248.31,
      "sid": 100,
      "location": 2,
      "content": "选择五五开的去跟别人对枪",
      "music": 0.0
    },
    {
      "from": 248.31,
      "to": 249.53,
      "sid": 101,
      "location": 2,
      "content": "是一个下签",
