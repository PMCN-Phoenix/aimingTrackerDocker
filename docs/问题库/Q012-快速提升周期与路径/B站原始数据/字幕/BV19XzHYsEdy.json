    },
    {
      "from": 323.29,
      "to": 324.9,
      "sid": 134,
      "location": 2,
      "content": "漏身位的敏感性",
      "music": 0.0
    },
    {
      "from": 324.9,
      "to": 328.919,
      "sid": 135,
      "location": 2,
      "content": "你要清楚怎么样才能在pk小的时候不漏给浴室",
      "music": 0.0
    },
    {
      "from": 328.919,
      "to": 330.759,
      "sid": 136,
      "location": 2,
      "content": "而在跟浴室对枪的时候",
      "music": 0.0
    },
    {
      "from": 330.759,
      "to": 333.46,
      "sid": 137,
      "location": 2,
      "content": "拉出多少身位才不会暴露给A小",
      "music": 0.0
    },
    {
      "from": 333.46,
      "to": 336.26,
      "sid": 138,
      "location": 2,
      "content": "每次全神贯注于你拉出位置的对枪",
