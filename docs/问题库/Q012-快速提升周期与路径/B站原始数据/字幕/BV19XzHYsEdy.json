    },
    {
      "from": 314.97,
      "to": 316.33,
      "sid": 130,
      "location": 2,
      "content": "比如洁净之地",
      "music": 0.0
    },
    {
      "from": 316.33,
      "to": 317.83,
      "sid": 131,
      "location": 2,
      "content": "A包点的这个位置",
      "music": 0.0
    },
    {
      "from": 317.83,
      "to": 320.49,
      "sid": 132,
      "location": 2,
      "content": "是很多高手都会选择站的位置",
