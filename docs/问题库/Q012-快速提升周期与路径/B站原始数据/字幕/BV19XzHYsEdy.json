    },
    {
      "from": 369.14,
      "to": 372.81,
      "sid": 152,
      "location": 2,
      "content": "就能够把全部注意力都放在唯一一个方向",
      "music": 0.0
    },
    {
      "from": 372.81,
      "to": 375.39,
      "sid": 153,
      "location": 2,
      "content": "而我们做身位控制的最终目的",
      "music": 0.0
    },
    {
      "from": 375.39,
      "to": 378.59,
      "sid": 154,
      "location": 2,
      "content": "正是把全部注意力都放在单一一个方向",
