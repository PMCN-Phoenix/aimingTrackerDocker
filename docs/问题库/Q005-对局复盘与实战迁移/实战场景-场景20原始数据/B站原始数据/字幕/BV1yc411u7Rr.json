[
 {
  "from": 0.24,
  "to": 1.02,
  "sid": 1,
  "location": 2,
  "content": "各位朋友大家好",
  "music": 0.0
 },
 {
  "from": 1.02,
  "to": 1.92,
  "sid": 2,
  "location": 2,
  "content": "我是东彦亲家",
  "music": 0.0
 },
 {
  "from": 1.92,
  "to": 3.08,
  "sid": 3,
  "location": 2,
  "content": "带来全英雄教学",
  "music": 0.0
 },
 {
  "from": 3.08,
  "to": 4.85,
  "sid": 4,
  "location": 2,
  "content": "那些使用我们的主角呢是捷风",
  "music": 0.0
 },
 {
  "from": 4.85,
  "to": 6.42,
  "sid": 5,
  "location": 2,
  "content": "很多玩家也想叫他风女",
  "music": 0.0
 },
 {
  "from": 6.42,
  "to": 8.1,
  "sid": 6,
  "location": 2,
  "content": "那捷风按照职责划分",
  "music": 0.0
 },
 {
  "from": 8.1,
  "to": 11.01,
  "sid": 7,
  "location": 2,
  "content": "应当属于我们之前在群英雄盖伦中讲到一突",
  "music": 0.0
 },
 {
  "from": 11.01,
  "to": 12.84,
  "sid": 8,
  "location": 2,
  "content": "也就是和雷兹霓虹一样",
  "music": 0.0
 },
 {
  "from": 12.84,
  "to": 14.87,
  "sid": 9,
  "location": 2,
  "content": "是利用强薇技能进行突破的职责",
  "music": 0.0
 },
 {
  "from": 14.87,
  "to": 16.61,
  "sid": 10,
  "location": 2,
  "content": "通俗来讲就是第一个冲进去",
  "music": 0.0
 },
 {
  "from": 16.61,
  "to": 19.18,
  "sid": 11,
  "location": 2,
  "content": "用自己的位移技能给团队拉开空间的角色",
  "music": 0.0
 },
 {
  "from": 19.18,
  "to": 22.0,
  "sid": 12,
  "location": 2,
  "content": "那捷风呢是瓦伦特中非常具有代表性的",
  "music": 0.0
 },
 {
  "from": 22.0,
  "to": 23.08,
  "sid": 13,
  "location": 2,
  "content": "一号突破英雄",
  "music": 0.0
 },
 {
  "from": 23.08,
  "to": 24.76,
  "sid": 14,
  "location": 2,
  "content": "从20年游戏初期至今",
  "music": 0.0
 },
 {
  "from": 24.76,
  "to": 26.74,
  "sid": 15,
  "location": 2,
  "content": "一直可以说是稳定T级的强度",
  "music": 0.0
 },
 {
  "from": 26.74,
  "to": 28.75,
  "sid": 16,
  "location": 2,
  "content": "在职业比赛选取率也非常高",
  "music": 0.0
 },
 {
  "from": 28.75,
  "to": 31.12,
  "sid": 17,
  "location": 2,
  "content": "首先我们先讲捷风的大致使用思路",
  "music": 0.0
 },
 {
  "from": 31.12,
  "to": 32.26,
  "sid": 18,
  "location": 2,
  "content": "在进攻场景下",
  "music": 0.0
 },
 {
  "from": 32.26,
  "to": 33.4,
  "sid": 19,
  "location": 2,
  "content": "捷风的强力之处在于",
  "music": 0.0
 },
 {
  "from": 33.4,
  "to": 35.68,
  "sid": 20,
  "location": 2,
  "content": "他的强尾技能和烟雾弹类型的自爆技能",
  "music": 0.0
 },
 {
  "from": 35.68,
  "to": 36.82,
  "sid": 21,
  "location": 2,
  "content": "形成了自循环",
  "music": 0.0
 },
 {
  "from": 36.82,
  "to": 37.6,
  "sid": 22,
  "location": 2,
  "content": "自己封个烟",
  "music": 0.0
 },
 {
  "from": 37.6,
  "to": 39.52,
  "sid": 23,
  "location": 2,
  "content": "然后顺道烟里既可以保持存活",
  "music": 0.0
 },
 {
  "from": 39.52,
  "to": 41.66,
  "sid": 24,
  "location": 2,
  "content": "还可以为团队冲撞出新的进攻角度",
  "music": 0.0
 },
 {
  "from": 41.66,
  "to": 43.37,
  "sid": 25,
  "location": 2,
  "content": "瞬间撕开点个防线",
  "music": 0.0
 },
 {
  "from": 43.37,
  "to": 44.3,
  "sid": 26,
  "location": 2,
  "content": "在中低分段",
  "music": 0.0
 },
 {
  "from": 44.3,
  "to": 46.4,
  "sid": 27,
  "location": 2,
  "content": "捷风甚至可以一个人就能完成突破",
  "music": 0.0
 },
 {
  "from": 46.4,
  "to": 47.3,
  "sid": 28,
  "location": 2,
  "content": "而在防守方",
  "music": 0.0
 },
 {
  "from": 47.3,
  "to": 48.38,
  "sid": 29,
  "location": 2,
  "content": "捷风也只能逐风",
  "music": 0.0
 },
 {
  "from": 48.38,
  "to": 50.99,
  "sid": 30,
  "location": 2,
  "content": "使得他拥有了毋庸置疑的最强首杀能力",
  "music": 0.0
 },
 {
  "from": 50.99,
  "to": 53.18,
  "sid": 31,
  "location": 2,
  "content": "他可以站在防守阵线的最前端",
  "music": 0.0
 },
 {
  "from": 53.18,
  "to": 54.24,
  "sid": 32,
  "location": 2,
  "content": "杀一个立马顺走",
  "music": 0.0
 },
 {
  "from": 54.24,
  "to": 55.32,
  "sid": 33,
  "location": 2,
  "content": "体验人数再多",
  "music": 0.0
 },
 {
  "from": 55.32,
  "to": 56.4,
  "sid": 34,
  "location": 2,
  "content": "很多时候也补不到枪",
  "music": 0.0
 },
 {
  "from": 56.4,
  "to": 58.41,
  "sid": 35,
  "location": 2,
  "content": "零换多毒是完全可以实现的",
  "music": 0.0
 },
 {
  "from": 58.41,
  "to": 60.0,
  "sid": 36,
  "location": 2,
  "content": "可以说捷风就是无畏契约",
  "music": 0.0
 },
 {
  "from": 60.0,
  "to": 61.6,
  "sid": 37,
  "location": 2,
  "content": "个人英雄主义的极致表现",
  "music": 0.0
 },
 {
  "from": 61.6,
  "to": 64.81,
  "sid": 38,
  "location": 2,
  "content": "接下来我们讲捷风的基础技能与进阶使用技巧",
  "music": 0.0
 },
 {
  "from": 64.81,
  "to": 67.12,
  "sid": 39,
  "location": 2,
  "content": "捷风C技能瞬移呢是一颗持续存在sir",
  "music": 0.0
 },
 {
  "from": 67.12,
  "to": 67.96,
  "sid": 40,
  "location": 2,
  "content": "我们的烟雾弹",
  "music": 0.0
 },
 {
  "from": 67.96,
  "to": 69.94,
  "sid": 41,
  "location": 2,
  "content": "长按C技能同时移动鼠标",
  "music": 0.0
 },
 {
  "from": 69.94,
  "to": 71.26,
  "sid": 42,
  "location": 2,
  "content": "可以控制烟弹的落点",
  "music": 0.0
 },
 {
  "from": 71.26,
  "to": 72.58,
  "sid": 43,
  "location": 2,
  "content": "触碰任何障碍物后",
  "music": 0.0
 },
 {
  "from": 72.58,
  "to": 74.669,
  "sid": 44,
  "location": 2,
  "content": "顺云会扩散成球形的烟雾",
  "music": 0.0
 },
 {
  "from": 74.669,
  "to": 76.349,
  "sid": 45,
  "location": 2,
  "content": "那顺丰的价格是200元",
  "music": 0.0
 },
 {
  "from": 76.349,
  "to": 78.58,
  "sid": 46,
  "location": 2,
  "content": "最多可以购买两个捷风的C技能",
  "music": 0.0
 },
 {
  "from": 78.58,
  "to": 78.94,
  "sid": 47,
  "location": 2,
  "content": "烟雾弹",
  "music": 0.0
 },
 {
  "from": 78.94,
  "to": 81.52,
  "sid": 48,
  "location": 2,
  "content": "最简单的使用方式就是随手封颗烟架枪了",
  "music": 0.0
 },
 {
  "from": 81.52,
  "to": 82.96,
  "sid": 49,
  "location": 2,
  "content": "那另外捷风的烟雾弹",
  "music": 0.0
 },
 {
  "from": 82.96,
  "to": 84.62,
  "sid": 50,
  "location": 2,
  "content": "是非常容易创造出单向烟的",
  "music": 0.0
 },
 {
  "from": 84.62,
  "to": 86.06,
  "sid": 51,
  "location": 2,
  "content": "比如说一诺经济的进攻方",
  "music": 0.0
 },
 {
  "from": 86.06,
  "to": 87.38,
  "sid": 52,
  "location": 2,
  "content": "在双射门位置开局",
  "music": 0.0
 },
 {
  "from": 87.38,
  "to": 89.27,
  "sid": 53,
  "location": 2,
  "content": "如果你想防止敌人前进偷人",
  "music": 0.0
 },
 {
  "from": 89.27,
  "to": 90.94,
  "sid": 54,
  "location": 2,
  "content": "直接我们上塞颗单向烟",
  "music": 0.0
 },
 {
  "from": 90.94,
  "to": 91.96,
  "sid": 55,
  "location": 2,
  "content": "别人就想浅点",
  "music": 0.0
 },
 {
  "from": 91.96,
  "to": 93.64,
  "sid": 56,
  "location": 2,
  "content": "一般看到这颗烟也不干了",
  "music": 0.0
 },
 {
  "from": 93.64,
  "to": 95.54,
  "sid": 57,
  "location": 2,
  "content": "那更接近一点捷风的烟控制好",
  "music": 0.0
 },
 {
  "from": 95.54,
  "to": 96.26,
  "sid": 58,
  "location": 2,
  "content": "而配合地形",
  "music": 0.0
 },
 {
  "from": 96.26,
  "to": 97.88,
  "sid": 59,
  "location": 2,
  "content": "还能做出一些奇怪的头皮位",
  "music": 0.0
 },
 {
  "from": 97.88,
  "to": 99.2,
  "sid": 60,
  "location": 2,
  "content": "从而获得对枪优势",
  "music": 0.0
 },
 {
  "from": 99.2,
  "to": 101.3,
  "sid": 61,
  "location": 2,
  "content": "比如说在源工重镇的臂长位置",
  "music": 0.0
 },
 {
  "from": 101.3,
  "to": 104.0,
  "sid": 62,
  "location": 2,
  "content": "防守方狙击手经常会在这里起去偷首杀",
  "music": 0.0
 },
 {
  "from": 104.0,
  "to": 105.32,
  "sid": 63,
  "location": 2,
  "content": "如果你要单走必长",
  "music": 0.0
 },
 {
  "from": 105.32,
  "to": 106.46,
  "sid": 64,
  "location": 2,
  "content": "开局往这里塞颗烟",
  "music": 0.0
 },
 {
  "from": 106.46,
  "to": 107.74,
  "sid": 65,
  "location": 2,
  "content": "就可以创造出一个头皮位",
  "music": 0.0
 },
 {
  "from": 107.74,
  "to": 110.71,
  "sid": 66,
  "location": 2,
  "content": "最大程度的减少步枪和狙击枪之间对枪劣势",
  "music": 0.0
 },
 {
  "from": 110.71,
  "to": 112.48,
  "sid": 67,
  "location": 2,
  "content": "首次大狙是不在话下的",
  "music": 0.0
 },
 {
  "from": 112.48,
  "to": 115.14,
  "sid": 68,
  "location": 2,
  "content": "同理在亚哈悬城进攻方占领了A包点之后",
  "music": 0.0
 },
 {
  "from": 115.14,
  "to": 117.09,
  "sid": 69,
  "location": 2,
  "content": "如果直接跳上二楼将是白给",
  "music": 0.0
 },
 {
  "from": 117.09,
  "to": 119.04,
  "sid": 70,
  "location": 2,
  "content": "但如果我们在二楼下这样封一颗烟",
  "music": 0.0
 },
 {
  "from": 119.04,
  "to": 120.3,
  "sid": 71,
  "location": 2,
  "content": "跳上二楼台阶站起来",
  "music": 0.0
 },
 {
  "from": 120.3,
  "to": 122.46,
  "sid": 72,
  "location": 2,
  "content": "那就是给我们创造了一个单向头皮位",
  "music": 0.0
 },
 {
  "from": 122.46,
  "to": 124.02,
  "sid": 73,
  "location": 2,
  "content": "另外捷风的烟雾弹",
  "music": 0.0
 },
 {
  "from": 124.02,
  "to": 127.58,
  "sid": 74,
  "location": 2,
  "content": "还可以盖住闪光以及探测键等技能",
  "music": 0.0
 },
 {
  "from": 127.62,
  "to": 128.54,
  "sid": 75,
  "location": 2,
  "content": "捷风的E技能",
  "music": 0.0
 },
 {
  "from": 128.54,
  "to": 130.01,
  "sid": 76,
  "location": 2,
  "content": "逐风是他最核心的技能",
  "music": 0.0
 },
 {
  "from": 130.01,
  "to": 132.78,
  "sid": 77,
  "location": 2,
  "content": "按第一次E在经过半秒钟的短暂前摇之后",
  "music": 0.0
 },
 {
  "from": 132.78,
  "to": 134.52,
  "sid": 78,
  "location": 2,
  "content": "会激活顺风准备阶段",
  "music": 0.0
 },
 {
  "from": 134.52,
  "to": 136.2,
  "sid": 79,
  "location": 2,
  "content": "准备阶段将持续12秒",
  "music": 0.0
 },
 {
  "from": 136.2,
  "to": 137.16,
  "sid": 80,
  "location": 2,
  "content": "进入准备阶段后",
  "music": 0.0
 },
 {
  "from": 137.16,
  "to": 139.54,
  "sid": 81,
  "location": 2,
  "content": "再按一次E将进行一次瞬间的位移",
  "music": 0.0
 },
 {
  "from": 139.54,
  "to": 140.8,
  "sid": 82,
  "location": 2,
  "content": "若使用逐风的过程中",
  "music": 0.0
 },
 {
  "from": 140.8,
  "to": 141.88,
  "sid": 83,
  "location": 2,
  "content": "未按下任何方向键",
  "music": 0.0
 },
 {
  "from": 141.88,
  "to": 143.46,
  "sid": 84,
  "location": 2,
  "content": "默认是向前进位移的",
  "music": 0.0
 },
 {
  "from": 143.46,
  "to": 144.6,
  "sid": 85,
  "location": 2,
  "content": "按住任何方向键",
  "music": 0.0
 },
 {
  "from": 144.6,
  "to": 146.46,
  "sid": 86,
  "location": 2,
  "content": "将会对指定方向进行位移",
  "music": 0.0
 },
 {
  "from": 146.46,
  "to": 148.68,
  "sid": 87,
  "location": 2,
  "content": "例如说在按住SA键的同时",
  "music": 0.0
 },
 {
  "from": 148.68,
  "to": 150.84,
  "sid": 88,
  "location": 2,
  "content": "使用逐风3号位移至左后方",
  "music": 0.0
 },
 {
  "from": 150.84,
  "to": 152.28,
  "sid": 89,
  "location": 2,
  "content": "按空格跳起来",
  "music": 0.0
 },
 {
  "from": 152.28,
  "to": 154.22,
  "sid": 90,
  "location": 2,
  "content": "同时使用逐风会位移的更远",
  "music": 0.0
 },
 {
  "from": 154.22,
  "to": 156.56,
  "sid": 91,
  "location": 2,
  "content": "捷风E技能是每次重生自带的技能",
  "music": 0.0
 },
 {
  "from": 156.56,
  "to": 157.28,
  "sid": 92,
  "location": 2,
  "content": "无需购买",
  "music": 0.0
 },
 {
  "from": 157.28,
  "to": 159.2,
  "sid": 93,
  "location": 2,
  "content": "第一次按E激活逐风后被击杀",
  "music": 0.0
 },
 {
  "from": 159.2,
  "to": 160.44,
  "sid": 94,
  "location": 2,
  "content": "两个人刷新一次",
  "music": 0.0
 },
 {
  "from": 160.44,
  "to": 161.46,
  "sid": 95,
  "location": 2,
  "content": "一般来讲",
  "music": 0.0
 },
 {
  "from": 161.46,
  "to": 162.48,
  "sid": 96,
  "location": 2,
  "content": "我们的进攻场景下",
  "music": 0.0
 },
 {
  "from": 162.48,
  "to": 164.58,
  "sid": 97,
  "location": 2,
  "content": "都是配合C技能顺利进行逐风的",
  "music": 0.0
 },
 {
  "from": 164.58,
  "to": 165.97,
  "sid": 98,
  "location": 2,
  "content": "这也是他强度保证",
  "music": 0.0
 },
 {
  "from": 165.97,
  "to": 166.69,
  "sid": 99,
  "location": 2,
  "content": "举个例子",
  "music": 0.0
 },
 {
  "from": 166.69,
  "to": 167.71,
  "sid": 100,
  "location": 2,
  "content": "在霓虹军的A点",
  "music": 0.0
 },
 {
  "from": 167.71,
  "to": 169.51,
  "sid": 101,
  "location": 2,
  "content": "假如你是主A的防守方队友",
  "music": 0.0
 },
 {
  "from": 169.51,
  "to": 171.31,
  "sid": 102,
  "location": 2,
  "content": "敌人没有A2的控制权前提下",
  "music": 0.0
 },
 {
  "from": 171.31,
  "to": 173.93,
  "sid": 103,
  "location": 2,
  "content": "就只能从A1这个狭窄的通道进入包点",
  "music": 0.0
 },
 {
  "from": 173.93,
  "to": 175.43,
  "sid": 104,
  "location": 2,
  "content": "防守方配合自己的道具",
  "music": 0.0
 },
 {
  "from": 175.43,
  "to": 177.61,
  "sid": 105,
  "location": 2,
  "content": "打出1万多的连杀是完全有可能的",
  "music": 0.0
 },
 {
  "from": 177.61,
  "to": 179.23,
  "sid": 106,
  "location": 2,
  "content": "但假如敌人有一个捷风",
  "music": 0.0
 },
 {
  "from": 179.23,
  "to": 180.43,
  "sid": 107,
  "location": 2,
  "content": "先扔出一颗烟雾弹",
  "music": 0.0
 },
 {
  "from": 180.43,
  "to": 181.81,
  "sid": 108,
  "location": 2,
  "content": "再用一技能顺风瞬间自走",
  "music": 0.0
 },
 {
  "from": 181.81,
  "to": 182.5,
  "sid": 109,
  "location": 2,
  "content": "烟雾弹里",
  "music": 0.0
 },
 {
  "from": 182.5,
  "to": 184.94,
  "sid": 110,
  "location": 2,
  "content": "那进攻方瞬间就产生了两个进攻角度",
  "music": 0.0
 },
 {
  "from": 184.94,
