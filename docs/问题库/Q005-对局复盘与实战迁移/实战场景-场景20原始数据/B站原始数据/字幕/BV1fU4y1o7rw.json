 },
 {
  "from": 18.079,
  "to": 20.44,
  "sid": 12,
  "location": 2,
  "content": "那么在职业比赛选取率也非常高",
  "music": 0.0
 },
 {
  "from": 20.62,
  "to": 23.2,
  "sid": 13,
  "location": 2,
  "content": "那我们先讲JETT最基本的四个技能",
