 },
 {
  "from": 76.3,
  "to": 78.64,
  "sid": 44,
  "location": 2,
  "content": "大家自己在靶场视野里都能搞明白",
  "music": 0.0
 },
 {
  "from": 78.64,
  "to": 79.3,
  "sid": 45,
  "location": 2,
  "content": "更重要的是",
  "music": 0.0
 },
 {
  "from": 79.3,
  "to": 80.44,
  "sid": 46,
  "location": 2,
  "content": "大家对于JETT这个英雄",
  "music": 0.0
 },
 {
  "from": 80.44,
  "to": 82.16,
  "sid": 47,
  "location": 2,
  "content": "一定要产生一个正确的理解",
  "music": 0.0
 },
 {
  "from": 82.16,
  "to": 84.56,
  "sid": 48,
  "location": 2,
  "content": "那这样这个英雄最核心的技能就是E技能",
