  "location": 2,
  "content": "一镖的伤害为50",
  "music": 0.0
 },
 {
  "from": 57.82,
  "to": 59.98,
  "sid": 33,
  "location": 2,
  "content": "爆头可以一刀死雷击杀一名敌人",
