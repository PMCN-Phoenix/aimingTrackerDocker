 },
 {
  "from": 84.56,
  "to": 85.18,
  "sid": 49,
  "location": 2,
  "content": "顺风",
  "music": 0.0
 },
 {
  "from": 85.18,
  "to": 86.44,
  "sid": 50,
  "location": 2,
  "content": "从警方的角度来讲",
  "music": 0.0
 },
 {
  "from": 86.44,
  "to": 88.42,
  "sid": 51,
  "location": 2,
  "content": "这赛顺风可以创造出更多精英角度",
  "music": 0.0
 },
 {
  "from": 88.42,
  "to": 89.5,
  "sid": 52,
  "location": 2,
  "content": "而对于防守方来说",
  "music": 0.0
 },
 {
  "from": 89.5,
  "to": 91.0,
  "sid": 53,
  "location": 2,
  "content": "这下的顺风可以让他拿下首杀",
