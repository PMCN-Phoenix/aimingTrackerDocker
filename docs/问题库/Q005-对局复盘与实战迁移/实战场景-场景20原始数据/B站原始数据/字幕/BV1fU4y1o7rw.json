 },
 {
  "from": 59.98,
  "to": 61.58,
  "sid": 34,
  "location": 2,
  "content": "都会刷新飞镖的数量",
  "music": 0.0
 },
 {
  "from": 61.58,
  "to": 63.92,
  "sid": 35,
  "location": 2,
  "content": "那右键的攻击则是以类似霰弹枪的方式",
  "music": 0.0
 },
 {
  "from": 63.92,
  "to": 65.18,
  "sid": 36,
  "location": 2,
  "content": "一次性射出五发飞镖",
  "music": 0.0
 },
 {
  "from": 65.18,
  "to": 66.02,
  "sid": 37,
  "location": 2,
  "content": "版本更新后",
  "music": 0.0
 },
 {
  "from": 66.02,
  "to": 67.4,
  "sid": 38,
  "location": 2,
  "content": "右键击杀敌人则不再刷新",
