 },
 {
  "from": 120.04,
  "to": 122.4,
  "sid": 70,
  "location": 2,
  "content": "那自己的这个位置就暴露了",
  "music": 0.0
 },
 {
  "from": 122.4,
  "to": 124.92,
  "sid": 71,
  "location": 2,
  "content": "这次可以顺势再放一块钱来扩大活动空间",
