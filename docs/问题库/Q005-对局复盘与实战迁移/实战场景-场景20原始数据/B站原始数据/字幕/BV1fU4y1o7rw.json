 },
 {
  "from": 157.1,
  "to": 159.04,
  "sid": 89,
  "location": 2,
  "content": "T0英雄的最重要原因所在了",
  "music": 0.0
 },
 {
  "from": 159.04,
  "to": 160.18,
  "sid": 90,
  "location": 2,
  "content": "那么除此之外呢",
  "music": 0.0
 },
 {
  "from": 160.18,
  "to": 162.46,
  "sid": 91,
  "location": 2,
  "content": "这次顺风也使得他成为最好的狙击手",
