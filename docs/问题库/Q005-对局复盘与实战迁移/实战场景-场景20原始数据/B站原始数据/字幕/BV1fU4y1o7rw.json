 },
 {
  "from": 33.14,
  "to": 35.93,
  "sid": 19,
  "location": 2,
  "content": "那么开赋能成功飞跃是一个向上垂直位移技能",
  "music": 0.0
 },
 {
  "from": 35.93,
  "to": 37.37,
  "sid": 20,
  "location": 2,
  "content": "我们价格是150块钱一个",
  "music": 0.0
 },
 {
  "from": 37.37,
  "to": 39.12,
  "sid": 21,
  "location": 2,
  "content": "最多可以购买一两个",
  "music": 0.0
 },
 {
  "from": 39.12,
  "to": 41.13,
  "sid": 22,
  "location": 2,
  "content": "而一技能顺风呢是平面的位移技能",
  "music": 0.0
 },
 {
  "from": 41.13,
  "to": 42.78,
  "sid": 23,
  "location": 2,
  "content": "按住特定发挥下同时来释放",
  "music": 0.0
 },
 {
  "from": 42.78,
  "to": 44.56,
  "sid": 24,
  "location": 2,
  "content": "技能呢可以指定方向进行位移",
