  "lan": "ai-zh",
  "body": [
    {
      "from": 0.72,
      "to": 1.7,
      "sid": 1,
      "location": 2,
      "content": "各位朋友们大家好",
      "music": 0.0
    },
    {
      "from": 1.7,
      "to": 2.18,
      "sid": 2,
      "location": 2,
      "content": "我是东彦",
      "music": 0.0
    },
    {
      "from": 2.18,
      "to": 4.16,
      "sid": 3,
      "location": 2,
      "content": "那么先给大家带来的是瓦罗兰特系列教学",
      "music": 0.0
    },
    {
      "from": 4.16,
      "to": 4.76,
      "sid": 4,
      "location": 2,
      "content": "第二期",
      "music": 0.0
    },
    {
      "from": 4.76,
      "to": 5.9,
      "sid": 5,
      "location": 2,
      "content": "那么正常标题所说",
      "music": 0.0
    },
    {
      "from": 5.9,
      "to": 7.4,
      "sid": 6,
      "location": 2,
      "content": "本期视频的主题是预瞄",
      "music": 0.0
    },
    {
      "from": 7.4,
      "to": 8.36,
      "sid": 7,
      "location": 2,
      "content": "众所周知的",
      "music": 0.0
    },
    {
      "from": 8.36,
      "to": 11.3,
      "sid": 8,
      "location": 2,
      "content": "瓦罗兰特作为一个传统的5V5战术竞技游戏",
      "music": 0.0
    },
    {
      "from": 11.3,
      "to": 13.1,
      "sid": 9,
      "location": 2,
      "content": "爆头一枪死TTK时的预瞄",
      "music": 0.0
    },
    {
      "from": 13.1,
      "to": 14.84,
      "sid": 10,
      "location": 2,
      "content": "成为了一种非常重要的技巧",
      "music": 0.0
    },
    {
      "from": 14.84,
      "to": 16.28,
      "sid": 11,
      "location": 2,
      "content": "即使你不玩瓦罗兰特",
      "music": 0.0
    },
    {
      "from": 16.28,
      "to": 19.4,
      "sid": 12,
      "location": 2,
      "content": "而是cs go cfg d材料等其他同类游戏",
      "music": 0.0
    },
    {
      "from": 19.4,
      "to": 21.3,
      "sid": 13,
      "location": 2,
      "content": "玩家想起看了视频之后",
      "music": 0.0
    },
    {
      "from": 21.3,
      "to": 23.3,
      "sid": 14,
      "location": 2,
      "content": "也会有类似触类旁通的效果",
      "music": 0.0
    },
    {
      "from": 23.3,
      "to": 24.62,
      "sid": 15,
      "location": 2,
      "content": "那预瞄顾名思义",
      "music": 0.0
    },
    {
      "from": 24.62,
      "to": 25.7,
      "sid": 16,
      "location": 2,
      "content": "就是通过预期的瞄准",
      "music": 0.0
    },
    {
      "from": 25.7,
      "to": 27.35,
      "sid": 17,
      "location": 2,
      "content": "让敌人主动撞上我们的准星",
      "music": 0.0
    },
    {
      "from": 27.35,
      "to": 30.32,
      "sid": 18,
      "location": 2,
      "content": "目的是通过减少我们用右手瞄准的频率与强度",
      "music": 0.0
    },
    {
      "from": 30.32,
      "to": 31.92,
      "sid": 19,
      "location": 2,
      "content": "从而提高击杀稳定性",
      "music": 0.0
    },
    {
      "from": 31.92,
      "to": 33.18,
      "sid": 20,
      "location": 2,
      "content": "那预瞄呢分为两种",
      "music": 0.0
    },
    {
      "from": 33.18,
      "to": 34.62,
      "sid": 21,
      "location": 2,
      "content": "一种是行进中的预瞄",
      "music": 0.0
    },
    {
      "from": 34.62,
      "to": 36.38,
      "sid": 22,
      "location": 2,
      "content": "另外一种是提前式的预瞄",
      "music": 0.0
    },
    {
      "from": 36.38,
      "to": 37.76,
      "sid": 23,
      "location": 2,
      "content": "那行进中的预瞄",
      "music": 0.0
    },
    {
      "from": 37.76,
      "to": 39.68,
      "sid": 24,
      "location": 2,
      "content": "过名思义就是指我们在行进过程中的预瞄",
      "music": 0.0
    },
    {
      "from": 39.68,
      "to": 42.24,
      "sid": 25,
      "location": 2,
      "content": "那么准星呢会放在掩体附近的敌人",
      "music": 0.0
    },
    {
      "from": 42.24,
      "to": 43.42,
      "sid": 26,
      "location": 2,
      "content": "可能会拉丝的位置",
      "music": 0.0
    },
    {
      "from": 43.42,
      "to": 44.56,
      "sid": 27,
      "location": 2,
      "content": "而提前时的预瞄",
      "music": 0.0
    },
    {
      "from": 44.56,
      "to": 46.12,
      "sid": 28,
      "location": 2,
      "content": "就是在对常规位置相匹配的时候",
      "music": 0.0
    },
    {
      "from": 46.12,
      "to": 48.58,
      "sid": 29,
      "location": 2,
      "content": "我们会预先在掩体后将准星对好",
      "music": 0.0
    },
    {
      "from": 48.58,
      "to": 50.54,
      "sid": 30,
      "location": 2,
      "content": "那么这个时候你的准星预瞄是强的",
      "music": 0.0
    },
    {
      "from": 50.54,
      "to": 51.68,
      "sid": 31,
      "location": 2,
      "content": "这样你在拉出去的时候",
      "music": 0.0
    },
    {
      "from": 51.68,
      "to": 53.6,
      "sid": 32,
      "location": 2,
      "content": "就基本上不需要动这个右手的鼠标",
      "music": 0.0
    },
    {
      "from": 53.6,
      "to": 55.88,
      "sid": 33,
      "location": 2,
      "content": "只需要按住这个键盘的方向键",
      "music": 0.0
    },
    {
      "from": 55.88,
      "to": 57.76,
      "sid": 34,
      "location": 2,
      "content": "就能让准星撞向敌人投",
      "music": 0.0
    },
    {
      "from": 57.79,
      "to": 60.1,
      "sid": 35,
      "location": 2,
      "content": "那么从新手到职业水平呢",
      "music": 0.0
    },
    {
      "from": 60.1,
      "to": 62.81,
      "sid": 36,
      "location": 2,
      "content": "预瞄这个水平啊又可以分为四个阶段",
      "music": 0.0
    },
    {
      "from": 62.81,
      "to": 64.43,
      "sid": 37,
      "location": 2,
      "content": "第一个阶段非常简单",
      "music": 0.0
    },
    {
      "from": 64.43,
      "to": 65.45,
      "sid": 38,
      "location": 2,
      "content": "就是在平地上",
      "music": 0.0
    },
    {
      "from": 65.45,
      "to": 66.35,
      "sid": 39,
      "location": 2,
      "content": "也能将准星",
      "music": 0.0
    },
    {
      "from": 66.35,
      "to": 69.35,
      "sid": 40,
      "location": 2,
      "content": "稳定的保持在人物模型头部的水平线上移动",
      "music": 0.0
    },
    {
      "from": 69.35,
      "to": 72.16,
      "sid": 41,
      "location": 2,
      "content": "那么第二个阶段就是能结合地图来进预瞄",
      "music": 0.0
    },
    {
      "from": 72.16,
      "to": 74.74,
      "sid": 42,
      "location": 2,
      "content": "那么即使地图上这个地势有一定的起伏",
      "music": 0.0
    },
    {
      "from": 74.74,
      "to": 76.6,
      "sid": 43,
      "location": 2,
      "content": "你也要做到最基本的同步预瞄",
      "music": 0.0
    },
    {
      "from": 76.6,
      "to": 78.76,
      "sid": 44,
      "location": 2,
      "content": "那么达到前两个阶段是非常简单的",
      "music": 0.0
    },
    {
      "from": 78.76,
      "to": 80.08,
      "sid": 45,
      "location": 2,
      "content": "只要你有一点基础",
      "music": 0.0
    },
    {
      "from": 80.08,
      "to": 82.51,
      "sid": 46,
      "location": 2,
      "content": "即使是一个全新的游戏和全新的地图",
      "music": 0.0
    },
    {
      "from": 82.51,
      "to": 84.88,
      "sid": 47,
      "location": 2,
      "content": "基本上都不用花半个小时就能做好",
      "music": 0.0
    },
    {
      "from": 84.88,
      "to": 87.28,
      "sid": 48,
      "location": 2,
      "content": "所以我们就重点讲后面的两个阶段",
      "music": 0.0
    },
    {
      "from": 87.28,
      "to": 89.2,
      "sid": 49,
      "location": 2,
      "content": "那么第三个阶段就是你的预瞄",
      "music": 0.0
    },
    {
      "from": 89.2,
      "to": 91.86,
      "sid": 50,
      "location": 2,
      "content": "不仅仅是将准星预先瞄准敌人的头部",
      "music": 0.0
    },
    {
      "from": 91.86,
      "to": 94.86,
      "sid": 51,
      "location": 2,
      "content": "你还需要考虑怎么将pg和预瞄结合在一起",
      "music": 0.0
    },
    {
      "from": 94.86,
      "to": 97.0,
      "sid": 52,
      "location": 2,
      "content": "从而创造出优势对象条件",
      "music": 0.0
    },
    {
      "from": 97.0,
      "to": 98.98,
      "sid": 53,
      "location": 2,
      "content": "所以我们在这个阶段要做的就是",
      "music": 0.0
    },
    {
      "from": 98.98,
      "to": 100.48,
      "sid": 54,
      "location": 2,
      "content": "在每次pk的时候",
      "music": 0.0
    },
    {
      "from": 100.48,
      "to": 102.31,
      "sid": 55,
      "location": 2,
      "content": "身位只有给一个角度",
      "music": 0.26190474631519345
    },
    {
      "from": 102.31,
      "to": 103.48,
      "sid": 56,
      "location": 2,
      "content": "每次拉出掩体呢",
      "music": 0.0
    },
    {
      "from": 103.48,
      "to": 105.58,
      "sid": 57,
      "location": 2,
      "content": "同时还要结合这个角度的优劣势",
      "music": 0.0
    },
    {
      "from": 105.58,
      "to": 107.48,
      "sid": 58,
      "location": 2,
      "content": "来选择一个恰当的peek方式",
      "music": 0.0
    },
    {
      "from": 107.48,
      "to": 108.68,
      "sid": 59,
      "location": 2,
      "content": "我此前的出过一期",
      "music": 0.0
    },
    {
      "from": 108.68,
      "to": 110.72,
      "sid": 60,
      "location": 2,
      "content": "有关于选位pk下乡的一个视频",
      "music": 0.0
    },
    {
      "from": 110.72,
      "to": 113.36,
      "sid": 61,
      "location": 2,
      "content": "那么其中讲到了优劣势对强相关的原理",
      "music": 0.0
    },
    {
      "from": 113.36,
      "to": 114.47,
      "sid": 62,
      "location": 2,
      "content": "结论和应用场景",
      "music": 0.0
    },
    {
      "from": 114.47,
      "to": 116.42,
      "sid": 63,
      "location": 2,
      "content": "大家一定要去看一下本期视频",
      "music": 0.0
    },
    {
      "from": 116.42,
      "to": 117.26,
      "sid": 64,
      "location": 2,
      "content": "我们先跳过原理",
      "music": 0.0
    },
    {
      "from": 117.26,
      "to": 119.08,
      "sid": 65,
      "location": 2,
      "content": "直接将当时的结论提取出来",
      "music": 0.0
    },
    {
      "from": 119.08,
      "to": 121.9,
      "sid": 66,
      "location": 2,
      "content": "那么离同一掩体越远或者斜角架上的人",
      "music": 0.0
    },
    {
      "from": 121.9,
      "to": 123.49,
      "sid": 67,
      "location": 2,
      "content": "是处在优势对枪位置",
      "music": 0.0
    },
    {
      "from": 123.49,
      "to": 124.66,
      "sid": 68,
      "location": 2,
      "content": "离同一掩体越近",
      "music": 0.0
    },
    {
      "from": 124.66,
      "to": 127.0,
      "sid": 69,
      "location": 2,
      "content": "或者直角架枪的人是处在劣势对枪位置",
      "music": 0.0
    },
    {
      "from": 127.0,
      "to": 129.04,
      "sid": 70,
      "location": 2,
      "content": "那么劣势的位置的人要避免支架",
      "music": 0.0
    },
    {
      "from": 129.04,
      "to": 130.96,
      "sid": 71,
      "location": 2,
      "content": "pk时候要选择满速大拉",
      "music": 0.0
    },
    {
      "from": 130.96,
      "to": 132.04,
      "sid": 72,
      "location": 2,
      "content": "用速度来搬回角度",
      "music": 0.0
    },
    {
      "from": 132.04,
      "to": 135.04,
      "sid": 73,
      "location": 2,
      "content": "劣势相反的优势意识的人选择一对大很多",
      "music": 0.0
    },
    {
      "from": 135.04,
      "to": 136.3,
      "sid": 74,
      "location": 2,
      "content": "怎样玩都可以",
      "music": 0.0
    },
    {
      "from": 136.3,
      "to": 138.82,
      "sid": 75,
      "location": 2,
      "content": "那么大家在第三阶段完全理解这些内容之后",
      "music": 0.0
    },
    {
      "from": 138.82,
      "to": 140.62,
      "sid": 76,
      "location": 2,
      "content": "就需要打开自定义来跑图",
      "music": 0.0
    },
    {
      "from": 140.62,
      "to": 142.72,
      "sid": 77,
      "location": 2,
      "content": "结合地图的每个可能的进攻路线",
      "music": 0.0
    },
    {
      "from": 142.72,
      "to": 144.6,
      "sid": 78,
      "location": 2,
      "content": "来设计一个固定的预瞄流程",
      "music": 0.0
    },
    {
      "from": 144.6,
      "to": 147.0,
      "sid": 79,
      "location": 2,
      "content": "以瓦罗兰特的传送门的这个浴室为例",
      "music": 0.0
    },
    {
      "from": 147.0,
      "to": 147.66,
      "sid": 80,
      "location": 2,
      "content": "大家可以看一下",
      "music": 0.0
    },
    {
      "from": 147.66,
      "to": 150.52,
      "sid": 81,
      "location": 2,
      "content": "我自己设计的一个浴室干部的预瞄流程",
      "music": 0.0
    },
    {
      "from": 168.279,
      "to": 170.829,
      "sid": 82,
      "location": 2,
      "content": "那我们来具体讲解一下这个流程的细节",
      "music": 0.0
    },
    {
      "from": 170.829,
      "to": 172.029,
      "sid": 83,
      "location": 2,
      "content": "开局公布消失后",
      "music": 0.0
    },
    {
      "from": 172.029,
      "to": 173.589,
      "sid": 84,
      "location": 2,
      "content": "我是直接大脚步拉出去的",
      "music": 0.0
    },
    {
      "from": 173.589,
      "to": 176.349,
      "sid": 85,
      "location": 2,
      "content": "那这样拉是为了保证敌人第一时间躲不进浴室",
      "music": 0.0
    },
    {
      "from": 176.349,
      "to": 177.48,
      "sid": 86,
      "location": 2,
      "content": "右手的死角位置",
      "music": 0.0
    },
    {
      "from": 177.48,
      "to": 179.28,
      "sid": 87,
      "location": 2,
      "content": "那么在放脚步拉学的过程中",
      "music": 0.0
    },
    {
      "from": 179.28,
      "to": 180.42,
      "sid": 88,
      "location": 2,
      "content": "因为近大远小的原理",
      "music": 0.0
    },
    {
      "from": 180.42,
      "to": 181.78,
      "sid": 89,
      "location": 2,
      "content": "再加上我向右拉的",
      "music": 0.0
    },
    {
      "from": 181.78,
      "to": 183.88,
      "sid": 90,
      "location": 2,
      "content": "所以在开局或者绝对的优势角度",
      "music": 0.0
    },
    {
      "from": 183.88,
      "to": 184.9,
      "sid": 91,
      "location": 2,
      "content": "只要不马枪",
      "music": 0.0
    },
    {
      "from": 184.9,
      "to": 185.98,
      "sid": 92,
      "location": 2,
      "content": "而且敌人不是狙",
      "music": 0.0
    },
    {
      "from": 185.98,
      "to": 186.7,
      "sid": 93,
      "location": 2,
      "content": "那么对枪的话",
      "music": 0.0
    },
    {
      "from": 186.7,
      "to": 187.56,
      "sid": 94,
      "location": 2,
      "content": "我是必赢的",
      "music": 0.0
    },
    {
      "from": 187.56,
      "to": 189.84,
      "sid": 95,
      "location": 2,
      "content": "那么在确保的敌人抖个金鱼是死角后",
      "music": 0.0
    },
    {
      "from": 189.84,
      "to": 191.1,
      "sid": 96,
      "location": 2,
      "content": "我就开始以物一一秒",
      "music": 0.0
    },
    {
      "from": 191.1,
      "to": 193.83,
      "sid": 97,
      "location": 2,
      "content": "将浴室前点支架的枪位全部清理干净",
      "music": 0.0
    },
    {
      "from": 193.83,
      "to": 195.3,
      "sid": 98,
      "location": 2,
      "content": "然后我们就要贴着右边",
      "music": 0.0
    },
    {
      "from": 195.3,
      "to": 196.56,
      "sid": 99,
      "location": 2,
      "content": "然后蹲着进浴室",
      "music": 0.0
    },
    {
      "from": 196.56,
      "to": 199.26,
      "sid": 100,
      "location": 2,
      "content": "那虽然敌人从浴室的正面强拉不出来",
      "music": 0.0
    },
    {
      "from": 199.26,
      "to": 200.64,
      "sid": 101,
      "location": 2,
      "content": "是近大远小劣势角度",
      "music": 0.0
    },
    {
      "from": 200.64,
      "to": 202.2,
      "sid": 102,
      "location": 2,
      "content": "但因为浴室门口就这么大",
      "music": 0.0
    },
    {
      "from": 202.2,
      "to": 204.45,
      "sid": 103,
      "location": 2,
      "content": "他要是拉出去预瞄门口来打提前枪",
      "music": 0.0
    },
    {
      "from": 204.45,
      "to": 205.56,
      "sid": 104,
      "location": 2,
      "content": "我要正常走神了",
      "music": 0.0
    },
    {
      "from": 205.56,
      "to": 207.32,
      "sid": 105,
      "location": 2,
      "content": "他是有机会就将我秒掉的",
      "music": 0.0
    },
    {
      "from": 207.32,
