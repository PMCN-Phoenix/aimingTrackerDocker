{
  "bvid": "BV12DevesEtF",
  "title": "《又学到了！》大拉就是拉出去对枪吗？到底怎么出掩体才不会被秒呢？",
  "author": "斯米马赛z",
  "aid": 112849930162073,
  "cid": 500001627565506,
  "duration": 135,
  "lan": "ai-zh",
  "body": [
    {
      "from": 0.04,
      "to": 0.76,
      "sid": 1,
      "location": 2,
      "content": "上一期视频",
      "music": 0.0
    },
    {
      "from": 0.76,
      "to": 3.34,
      "sid": 2,
      "location": 2,
      "content": "有些老爷说黄金局拉出去就被可秒",
      "music": 0.0
    },
    {
      "from": 3.34,
      "to": 4.48,
      "sid": 3,
      "location": 2,
      "content": "你们说的是这种吗",
      "music": 0.0
    },
    {
      "from": 4.48,
      "to": 9.299,
      "sid": 4,
      "location": 2,
      "content": "华丽的地方在我疲倦的时候落在地角",
      "music": 0.387200850034933
    },
    {
      "from": 9.299,
      "to": 13.61,
      "sid": 5,
      "location": 2,
      "content": "我会想到它还剩一名敌人",
      "music": 0.4742069697466528
    },
    {
      "from": 13.61,
      "to": 16.11,
      "sid": 6,
      "location": 2,
      "content": "我想要有个家",
      "music": 0.9999999180327935
    },
    {
      "from": 17.56,
      "to": 19.84,
      "sid": 7,
      "location": 2,
      "content": "还有些说我玩奥丁的听不懂",
      "music": 0.0
    },
    {
      "from": 19.84,
      "to": 21.64,
      "sid": 8,
      "location": 2,
      "content": "首先无脑大拉肯定是不行",
      "music": 0.0
    },
    {
      "from": 21.64,
      "to": 24.04,
      "sid": 9,
      "location": 2,
      "content": "对面是奥丁的情况下就不要大拉了",
      "music": 0.0
    },
    {
      "from": 24.04,
      "to": 26.16,
      "sid": 10,
      "location": 2,
      "content": "其次大拉也是存在许多细节的",
      "music": 0.0
    },
    {
      "from": 26.16,
      "to": 28.85,
      "sid": 11,
      "location": 2,
      "content": "大家平时打游戏是不是经常打出这种操作",
      "music": 0.0
    },
    {
      "from": 28.85,
      "to": 31.62,
      "sid": 12,
      "location": 2,
      "content": "瑟瑟发抖吧",
      "music": 0.10344826694411301
    },
    {
      "from": 41.66,
      "to": 44.46,
      "sid": 13,
      "location": 2,
      "content": "一方面这个时候你特别集中",
      "music": 0.0
    },
    {
      "from": 44.46,
      "to": 45.26,
      "sid": 14,
      "location": 2,
      "content": "另外一方面",
      "music": 0.0
    },
    {
      "from": 45.26,
      "to": 47.54,
      "sid": 15,
      "location": 2,
      "content": "其实瓦的移动也是有一个加速过程",
      "music": 0.0
    },
    {
      "from": 47.54,
      "to": 50.0,
      "sid": 16,
      "location": 2,
      "content": "持续的大脚步虽然容易被预判位置",
      "music": 0.0
    },
    {
      "from": 50.0,
      "to": 51.54,
      "sid": 17,
      "location": 2,
      "content": "但是持续的峰值移速",
      "music": 0.0
    },
    {
      "from": 51.54,
      "to": 54.24,
      "sid": 18,
      "location": 2,
      "content": "也让准星管理不够好的对手难以瞄准",
      "music": 0.0
    },
    {
      "from": 54.24,
      "to": 55.72,
      "sid": 19,
      "location": 2,
      "content": "更何况你刚刷屏",
      "music": 0.0
    },
    {
      "from": 55.72,
      "to": 57.24,
      "sid": 20,
      "location": 2,
      "content": "对手的心理压力也很大",
      "music": 0.0
    },
    {
      "from": 57.24,
      "to": 59.88,
      "sid": 21,
      "location": 2,
      "content": "种种因素都提升了你赢下对枪的概率",
      "music": 0.0
    },
    {
      "from": 59.88,
      "to": 61.32,
      "sid": 22,
      "location": 2,
      "content": "我们不妨总结一下",
      "music": 0.0
    },
    {
      "from": 61.32,
      "to": 62.84,
      "sid": 23,
      "location": 2,
      "content": "首先一定要足够的集中",
      "music": 0.0
    },
    {
      "from": 62.84,
      "to": 64.38,
      "sid": 24,
      "location": 2,
      "content": "除了平时少奖励之外",
      "music": 0.0
    },
    {
      "from": 64.38,
      "to": 67.06,
      "sid": 25,
      "location": 2,
      "content": "在观战或者购买时间也可以稍微活动一下",
      "music": 0.0
    },
    {
      "from": 67.06,
      "to": 69.56,
      "sid": 26,
      "location": 2,
      "content": "第二点就是让移速能保持在峰值",
      "music": 0.0
    },
    {
      "from": 69.56,
      "to": 70.06,
      "sid": 27,
      "location": 2,
      "content": "划重点",
      "music": 0.0
    },
    {
      "from": 70.06,
      "to": 72.0,
      "sid": 28,
      "location": 2,
      "content": "这是许多人大拉什被柯秒的首因",
      "music": 0.0
    },
    {
      "from": 72.0,
      "to": 73.52,
      "sid": 29,
      "location": 2,
      "content": "大拉一定要预留一小段距离",
      "music": 0.0
    },
    {
      "from": 73.52,
      "to": 74.36,
      "sid": 30,
      "location": 2,
      "content": "方便移速拉满",
      "music": 0.0
    },
    {
      "from": 74.36,
      "to": 75.56,
      "sid": 31,
      "location": 2,
      "content": "还有不要背靠着强拉",
      "music": 0.0
    },
    {
      "from": 75.56,
      "to": 77.4,
      "sid": 32,
      "location": 2,
      "content": "因为碰到障碍物会大大减缓你的移",
      "music": 0.0
    },
    {
      "from": 77.4,
      "to": 78.96,
      "sid": 33,
      "location": 2,
      "content": "例如亚海悬城的A大",
      "music": 0.0
    },
    {
      "from": 78.96,
      "to": 80.16,
      "sid": 34,
      "location": 2,
      "content": "就有许多人会犯这个错误",
      "music": 0.0
    },
    {
      "from": 80.16,
      "to": 82.06,
      "sid": 35,
      "location": 2,
      "content": "第三点就是给足对手心理压力",
      "music": 0.0
    },
    {
      "from": 82.06,
      "to": 83.78,
      "sid": 36,
      "location": 2,
      "content": "这一点也是操控对手这个概念中",
      "music": 0.0
    },
    {
      "from": 83.78,
      "to": 84.64,
      "sid": 37,
      "location": 2,
      "content": "比较重要的一点",
      "music": 0.0
    },
    {
      "from": 84.64,
      "to": 86.06,
      "sid": 38,
      "location": 2,
      "content": "一方面不要无脑大拉",
      "music": 0.0
    },
    {
      "from": 86.06,
      "to": 86.34,
      "sid": 39,
      "location": 2,
      "content": "对手",
      "music": 0.0
    },
    {
      "from": 86.34,
      "to": 87.34,
      "sid": 40,
      "location": 2,
      "content": "很容易抓到你的习惯",
      "music": 0.0
    },
    {
      "from": 87.34,
      "to": 88.32,
      "sid": 41,
      "location": 2,
      "content": "例如机枪",
      "music": 0.0
    },
    {
      "from": 88.32,
      "to": 90.44,
      "sid": 42,
      "location": 2,
      "content": "多人架枪或是增强后的开火耐性",
      "music": 0.0
    },
    {
      "from": 90.44,
      "to": 91.08,
      "sid": 43,
      "location": 2,
      "content": "另一方面",
      "music": 0.0
    },
    {
      "from": 91.08,
      "to": 91.94,
      "sid": 44,
      "location": 2,
      "content": "多个身法结合",
      "music": 0.0
    },
    {
      "from": 91.94,
      "to": 92.96,
      "sid": 45,
      "location": 2,
      "content": "先跳pick几次",
      "music": 0.0
    },
    {
      "from": 92.96,
      "to": 94.84,
      "sid": 46,
      "location": 2,
      "content": "让对方的准星贴近掩体再拉",
      "music": 0.0
    },
    {
      "from": 94.84,
      "to": 95.76,
      "sid": 47,
      "location": 2,
      "content": "几乎是晃身",
      "music": 0.0
    },
    {
      "from": 95.76,
      "to": 96.48,
      "sid": 48,
      "location": 2,
      "content": "打提前枪",
      "music": 0.0
    },
    {
      "from": 96.48,
      "to": 97.8,
      "sid": 49,
      "location": 2,
      "content": "削弱对方的开火耐心",
      "music": 0.0
    },
    {
      "from": 97.8,
      "to": 98.44,
      "sid": 50,
      "location": 2,
      "content": "一般情况下",
      "music": 0.0
    },
    {
      "from": 98.44,
      "to": 99.6,
      "sid": 51,
      "location": 2,
      "content": "碰到不停晃身的对手",
      "music": 0.0
    },
    {
      "from": 99.6,
      "to": 101.28,
      "sid": 52,
      "location": 2,
      "content": "相信对面都会选择点射穿香",
      "music": 0.0
    },
    {
      "from": 101.28,
      "to": 102.02,
      "sid": 53,
      "location": 2,
      "content": "试图嫖血量",
      "music": 0.0
    },
    {
      "from": 102.02,
      "to": 103.8,
      "sid": 54,
      "location": 2,
      "content": "亦或是幻想自己能一颗空摘",
      "music": 0.0
    },
    {
      "from": 103.8,
      "to": 105.4,
      "sid": 55,
      "location": 2,
      "content": "你此时抓住时机大拉出去",
      "music": 0.0
    },
    {
      "from": 105.4,
      "to": 106.94,
      "sid": 56,
      "location": 2,
      "content": "对面也是应接不暇的",
      "music": 0.0
    },
    {
      "from": 108.58,
      "to": 111.1,
      "sid": 57,
      "location": 2,
      "content": "其实对枪也可以说是一个策略游戏",
      "music": 0.0
    },
    {
      "from": 111.1,
      "to": 113.48,
      "sid": 58,
      "location": 2,
      "content": "玩家的个人数值客观存在次",
      "music": 0.0
    },
    {
      "from": 113.48,
      "to": 115.84,
      "sid": 59,
      "location": 2,
      "content": "但是选对策略也可以帮助你赢下",
      "music": 0.0
    },
    {
      "from": 115.84,
      "to": 117.2,
      "sid": 60,
      "location": 2,
      "content": "数值比你高的对手",
      "music": 0.0
    },
    {
      "from": 117.2,
      "to": 118.38,
      "sid": 61,
      "location": 2,
      "content": "毫无铺垫的干拉",
      "music": 0.0
    },
    {
      "from": 118.38,
      "to": 119.94,
      "sid": 62,
      "location": 2,
      "content": "就是纯粹的数值比拼",
      "music": 0.0
    },
    {
      "from": 119.94,
      "to": 122.08,
      "sid": 63,
      "location": 2,
      "content": "而且你的对手很有可能是先手",
      "music": 0.0
    },
    {
      "from": 122.08,
      "to": 123.9,
      "sid": 64,
      "location": 2,
      "content": "因此被秒也完全可以理解",
      "music": 0.0
    },
    {
      "from": 123.9,
      "to": 126.92,
      "sid": 65,
      "location": 2,
      "content": "不要忘了技能和队友都是你强力的增益Buff",
      "music": 0.0
    },
    {
      "from": 126.92,
      "to": 127.84,
      "sid": 66,
      "location": 2,
      "content": "话又说回来",
      "music": 0.0
    },
    {
      "from": 127.84,
      "to": 130.38,
      "sid": 67,
      "location": 2,
      "content": "开头的铁臂你们能忍几秒呢",
      "music": 0.0
    },
    {
      "from": 130.38,
      "to": 131.98,
      "sid": 68,
      "location": 2,
      "content": "点点关注",
      "music": 0.0
    },
    {
      "from": 131.98,
      "to": 133.26,
      "sid": 69,
      "location": 2,
      "content": "点点赞",
      "music": 0.0
    }
  ]
}