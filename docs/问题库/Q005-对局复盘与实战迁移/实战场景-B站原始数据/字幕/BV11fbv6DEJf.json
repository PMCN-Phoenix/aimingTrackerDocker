  "body": [
    {
      "from": 11.16,
      "to": 12.98,
      "sid": 1,
      "location": 2,
      "content": "那你说要做到这样的拉枪",
      "music": 0.0
    },
    {
      "from": 12.98,
      "to": 13.92,
      "sid": 2,
      "location": 2,
      "content": "我要训练什么呢",
      "music": 0.0
    },
    {
      "from": 13.92,
      "to": 14.96,
      "sid": 3,
      "location": 2,
      "content": "我要训练两个东西啊",
      "music": 0.0
    },
    {
      "from": 14.96,
      "to": 15.56,
      "sid": 4,
      "location": 2,
      "content": "移动瞄准",
      "music": 0.0
    },
    {
      "from": 15.56,
      "to": 17.7,
      "sid": 5,
      "location": 2,
      "content": "我们先练一下同向的怎么去练啊",
      "music": 0.0
    },
    {
      "from": 17.7,
      "to": 19.62,
      "sid": 6,
      "location": 2,
      "content": "来比如说我打这边",
      "music": 0.0
    },
    {
      "from": 19.62,
      "to": 21.06,
      "sid": 7,
      "location": 2,
      "content": "我按A往左走的同时",
      "music": 0.0
    },
    {
      "from": 21.06,
      "to": 22.52,
      "sid": 8,
      "location": 2,
      "content": "我左左手也往左挪",
      "music": 0.0
    },
    {
      "from": 22.52,
      "to": 23.54,
      "sid": 9,
      "location": 2,
      "content": "然后走一步小的",
      "music": 0.0
    },
    {
      "from": 23.54,
      "to": 24.82,
      "sid": 10,
      "location": 2,
      "content": "然后贴过去走",
      "music": 0.0
    },
    {
      "from": 24.82,
      "to": 25.3,
      "sid": 11,
      "location": 2,
      "content": "停",
      "music": 0.0
    },
    {
      "from": 25.3,
      "to": 27.6,
      "sid": 12,
      "location": 2,
      "content": "一定要保证急停那一瞬间瞄中哦",
      "music": 0.0
    },
    {
      "from": 27.6,
      "to": 28.92,
      "sid": 13,
      "location": 2,
      "content": "你如果说停早了",
      "music": 0.0
    },
    {
      "from": 28.92,
      "to": 31.48,
      "sid": 14,
      "location": 2,
      "content": "或者你或者你那个啥停晚了都不行哦",
      "music": 0.0
    },
    {
      "from": 31.48,
      "to": 32.8,
      "sid": 15,
      "location": 2,
      "content": "一定是拉过去的一瞬间",
      "music": 0.0
    },
    {
      "from": 32.8,
      "to": 34.24,
      "sid": 16,
      "location": 2,
      "content": "然后停住哦",
      "music": 0.0
    },
    {
      "from": 35.8,
      "to": 36.88,
      "sid": 17,
      "location": 2,
      "content": "先拉视角啊",
      "music": 0.0
    },
    {
