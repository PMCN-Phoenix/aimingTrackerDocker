{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.1,
      "to": 1.48,
      "sid": 1,
      "location": 2,
      "content": "哈喽大家好啊",
      "music": 0.0
    },
    {
      "from": 1.48,
      "to": 3.32,
      "sid": 2,
      "location": 2,
      "content": "今天属于脑子一抽",
      "music": 0.0
    },
    {
      "from": 3.32,
      "to": 5.21,
      "sid": 3,
      "location": 2,
      "content": "带来一期教学视频",
      "music": 0.0
    },
    {
      "from": 5.21,
      "to": 8.99,
      "sid": 4,
      "location": 2,
      "content": "我之前呢是有连续上两年神话的经验",
      "music": 0.0
    },
    {
      "from": 8.99,
      "to": 11.42,
      "sid": 5,
      "location": 2,
      "content": "然后上赛季有定位到神话",
      "music": 0.0
    },
    {
      "from": 11.42,
      "to": 14.38,
      "sid": 6,
      "location": 2,
      "content": "所以对神话以下呢还是有一定的见解的",
      "music": 0.0
    },
    {
      "from": 14.38,
      "to": 16.35,
      "sid": 7,
      "location": 2,
      "content": "大家伙可以参考参考",
      "music": 0.0
    },
    {
      "from": 16.35,
      "to": 19.17,
      "sid": 8,
      "location": 2,
      "content": "我会通过五个大板块里面的",
      "music": 0.0
    },
    {
      "from": 19.17,
      "to": 21.34,
      "sid": 9,
      "location": 2,
      "content": "若干方面去讲解与模仿",
      "music": 0.0
    },
    {
      "from": 21.34,
      "to": 24.54,
      "sid": 10,
      "location": 2,
      "content": "如果需要详细的训练方式以及运用的话",
      "music": 0.0
    },
    {
      "from": 24.54,
      "to": 26.56,
      "sid": 11,
      "location": 2,
      "content": "就得要参考其他的up了",
      "music": 0.0
    },
    {
      "from": 26.56,
      "to": 27.84,
      "sid": 12,
      "location": 2,
      "content": "那我们废话不多说",
      "music": 0.0
    },
    {
      "from": 27.84,
      "to": 29.3,
      "sid": 13,
      "location": 2,
      "content": "开始",
      "music": 0.0
    },
    {
      "from": 30.84,
      "to": 31.42,
      "sid": 14,
      "location": 2,
      "content": "好的",
      "music": 0.0
    },
    {
      "from": 31.42,
      "to": 36.04,
      "sid": 15,
      "location": 2,
      "content": "第一个板块就是射击方式里面有三小个小方面",
      "music": 0.0
    },
    {
      "from": 36.04,
      "to": 37.38,
      "sid": 16,
      "location": 2,
      "content": "我们一个一个来讲",
      "music": 0.0
    },
    {
      "from": 37.38,
      "to": 42.3,
      "sid": 17,
      "location": 2,
      "content": "点射的优点呢是远距离对枪可以提高帧准确度",
      "music": 0.0
    },
    {
      "from": 42.3,
      "to": 44.14,
      "sid": 18,
      "location": 2,
      "content": "缺点呢就是容错率低",
      "music": 0.0
    },
    {
      "from": 44.14,
      "to": 45.45,
      "sid": 19,
      "location": 2,
      "content": "比较吃一次定位",
      "music": 0.0
    },
    {
      "from": 45.45,
      "to": 47.07,
      "sid": 20,
      "location": 2,
      "content": "然后像视频里面呢",
      "music": 0.0
    },
    {
      "from": 47.07,
      "to": 49.84,
      "sid": 21,
      "location": 2,
      "content": "我们点射就按照视频里面的节奏来点算",
      "music": 0.0
    },
    {
      "from": 49.84,
      "to": 51.02,
      "sid": 22,
      "location": 2,
      "content": "上身位移动的话",
      "music": 0.0
    },
    {
      "from": 51.02,
      "to": 52.96,
      "sid": 23,
      "location": 2,
      "content": "他的子弹是不容易飘的",
      "music": 0.0
    },
    {
      "from": 52.96,
      "to": 54.26,
      "sid": 24,
      "location": 2,
      "content": "然后这种距离啊",
      "music": 0.0
    },
    {
      "from": 54.26,
      "to": 55.66,
      "sid": 25,
      "location": 2,
      "content": "有些时候我打不中的话",
      "music": 0.0
    },
    {
      "from": 55.66,
      "to": 57.1,
      "sid": 26,
      "location": 2,
      "content": "我会选择开镜",
      "music": 0.0
    },
    {
      "from": 57.1,
      "to": 59.32,
      "sid": 27,
      "location": 2,
      "content": "然后准确率会提高一些",
      "music": 0.0
    },
    {
      "from": 59.32,
      "to": 63.03,
      "sid": 28,
      "location": 2,
      "content": "然后第二个射击方式呢就是研发它的",
      "music": 0.0
    },
    {
      "from": 63.03,
      "to": 66.27,
      "sid": 29,
      "location": 2,
      "content": "优点呢是中距离对枪会胜率比较高",
      "music": 0.0
    },
    {
      "from": 66.27,
      "to": 68.57,
      "sid": 30,
      "location": 2,
      "content": "缺点呢就是不容易接触跑打",
      "music": 0.0
    },
    {
      "from": 68.57,
      "to": 71.23,
      "sid": 31,
      "location": 2,
      "content": "像视频里面这种中距离对枪连发的话",
      "music": 0.0
    },
    {
      "from": 71.23,
      "to": 72.29,
      "sid": 32,
      "location": 2,
      "content": "会提高容错率",
      "music": 0.0
    },
    {
      "from": 72.29,
      "to": 75.25,
      "sid": 33,
      "location": 2,
      "content": "而且也容易中途有时间可以走位躲枪线",
      "music": 0.0
    },
    {
      "from": 75.25,
      "to": 78.41,
      "sid": 34,
      "location": 2,
      "content": "但是呢每次连发不好超过四发",
      "music": 0.0
    },
    {
      "from": 78.41,
      "to": 81.73,
      "sid": 35,
      "location": 2,
      "content": "然后鼠标稍微稍微可以向下来压枪",
      "music": 0.0
    },
    {
      "from": 81.73,
      "to": 83.9,
      "sid": 36,
      "location": 2,
      "content": "然后连发呢也有二次定位的好处",
      "music": 0.0
    },
    {
      "from": 83.9,
      "to": 86.3,
      "sid": 37,
      "location": 2,
      "content": "现在视频里面虽然我们一次定位没有命中",
      "music": 0.0
    },
    {
      "from": 86.3,
      "to": 88.38,
      "sid": 38,
      "location": 2,
      "content": "但是呢左键可以不用松开",
      "music": 0.0
    },
    {
      "from": 88.38,
      "to": 90.26,
      "sid": 39,
      "location": 2,
      "content": "可以继续移动那个准星",
      "music": 0.0
    },
    {
      "from": 90.26,
      "to": 93.08,
      "sid": 40,
      "location": 2,
      "content": "用剩下的2~3发来打爆头",
      "music": 0.0
    },
    {
      "from": 93.08,
      "to": 95.91,
      "sid": 41,
      "location": 2,
      "content": "第三点呢就是扫射优点",
      "music": 0.0
    },
    {
      "from": 95.91,
      "to": 98.19,
      "sid": 42,
      "location": 2,
      "content": "近距离可以提高击杀效率",
      "music": 0.0
    },
    {
      "from": 98.19,
      "to": 100.8,
      "sid": 43,
      "location": 2,
      "content": "但是缺点是因为不能动",
      "music": 0.0
    },
    {
      "from": 100.8,
      "to": 102.04,
      "sid": 44,
      "location": 2,
      "content": "导致变成活靶子",
      "music": 0.0
    },
    {
      "from": 102.04,
      "to": 105.06,
      "sid": 45,
      "location": 2,
      "content": "近距离的扫射呢可以命中更多的子弹",
      "music": 0.0
    },
    {
      "from": 105.06,
      "to": 106.66,
      "sid": 46,
      "location": 2,
      "content": "如果距离更近一点的话",
      "music": 0.0
    },
    {
      "from": 106.66,
      "to": 108.54,
      "sid": 47,
      "location": 2,
      "content": "也可以通过跑打来躲避枪线",
      "music": 0.0
    },
    {
      "from": 108.54,
      "to": 110.7,
      "sid": 48,
      "location": 2,
      "content": "然后这是最稳妥的收人方式",
      "music": 0.0
    },
    {
      "from": 110.7,
      "to": 112.02,
      "sid": 49,
      "location": 2,
      "content": "但是段位越高",
      "music": 0.0
    },
    {
      "from": 112.02,
      "to": 113.99,
      "sid": 50,
      "location": 2,
      "content": "给你打子弹的数就越少",
      "music": 0.0
    },
    {
      "from": 113.99,
      "to": 118.13,
      "sid": 51,
      "location": 2,
      "content": "所以高段位的话通常以连发或者是点射居多",
      "music": 0.0
    },
    {
      "from": 118.13,
      "to": 118.69,
      "sid": 52,
      "location": 2,
      "content": "好了",
      "music": 0.0
    },
    {
      "from": 118.69,
      "to": 120.09,
      "sid": 53,
      "location": 2,
      "content": "现在你已经会开枪了",
      "music": 0.0
    },
    {
      "from": 120.09,
      "to": 124.77,
      "sid": 54,
      "location": 2,
      "content": "我们就把这些射击方式混合运用在身位移动上",
      "music": 0.0
    },
    {
      "from": 126.98,
      "to": 130.74,
      "sid": 55,
      "location": 2,
      "content": "身位移动这个板块呢它有四个小方面",
      "music": 0.0
    },
    {
      "from": 130.74,
      "to": 133.0,
      "sid": 56,
      "location": 2,
      "content": "一共是调侃二闪身",
      "music": 0.0
    },
    {
      "from": 133.0,
      "to": 135.36,
      "sid": 57,
      "location": 2,
      "content": "三大拉4吨拉",
      "music": 0.0
    },
    {
      "from": 135.36,
      "to": 136.82,
      "sid": 58,
      "location": 2,
      "content": "我们一个一个来介绍",
      "music": 0.0
    },
    {
      "from": 136.82,
      "to": 140.27,
      "sid": 59,
      "location": 2,
      "content": "第一个跳看的优点呢就是探索敌情",
      "music": 0.0
    },
    {
      "from": 140.27,
      "to": 141.89,
      "sid": 60,
      "location": 2,
      "content": "而且不容易被击杀",
      "music": 0.0
    },
    {
      "from": 141.89,
      "to": 145.03,
      "sid": 61,
      "location": 2,
      "content": "但是缺点呢就是显而易见的无法开枪",
      "music": 0.0
    },
    {
      "from": 145.03,
      "to": 149.51,
      "sid": 62,
      "location": 2,
      "content": "然后第二个点闪身优点呢它是可以探索敌情",
      "music": 0.0
    },
    {
      "from": 149.51,
      "to": 150.61,
      "sid": 63,
      "location": 2,
      "content": "而且可以开枪的",
      "music": 0.0
    },
    {
      "from": 150.61,
      "to": 152.06,
      "sid": 64,
      "location": 2,
      "content": "如果你想象特别快的话",
      "music": 0.0
    },
    {
      "from": 152.06,
      "to": 155.7,
      "sid": 65,
      "location": 2,
      "content": "但是呢缺点的话呢就是无法稳定的击杀敌人",
      "music": 0.0
    },
    {
      "from": 155.7,
      "to": 157.5,
      "sid": 66,
      "location": 2,
      "content": "他有些时候子弹会飘",
      "music": 0.0
    },
    {
      "from": 157.5,
      "to": 160.3,
      "sid": 67,
      "location": 2,
      "content": "然后我们可以看一下这里成功的例子啊",
      "music": 0.0
    },
    {
      "from": 160.3,
      "to": 162.6,
      "sid": 68,
      "location": 2,
      "content": "我闪身看到齐了",
      "music": 0.0
    },
    {
      "from": 162.6,
      "to": 167.48,
      "sid": 69,
      "location": 2,
      "content": "然后撤回拆分和瑞纳1V1之后又拉出来",
      "music": 0.0
    },
    {
      "from": 167.48,
      "to": 168.46,
      "sid": 70,
      "location": 2,
      "content": "解决了起了",
      "music": 0.0
    },
    {
      "from": 168.46,
      "to": 172.19,
      "sid": 71,
      "location": 2,
      "content": "最后面呢响生排查点位拉低一速解决了目的",
      "music": 0.0
    },
    {
      "from": 172.19,
      "to": 175.73,
      "sid": 72,
      "location": 2,
      "content": "然后第三个点大拉优点就是近快远慢",
      "music": 0.0
    },
    {
      "from": 175.73,
      "to": 177.73,
      "sid": 73,
      "location": 2,
      "content": "在离掩体近的时候呢",
      "music": 0.0
    },
    {
      "from": 177.73,
      "to": 179.36,
      "sid": 74,
      "location": 2,
      "content": "可以以提高存活率",
      "music": 0.0
    },
    {
      "from": 179.36,
      "to": 181.96,
      "sid": 75,
      "location": 2,
      "content": "缺点呢就是容易被指甲比较厉害的",
      "music": 0.0
    },
    {
      "from": 181.96,
      "to": 183.61,
      "sid": 76,
      "location": 2,
      "content": "那些人也会带走",
      "music": 0.0
    },
    {
      "from": 183.61,
      "to": 186.25,
      "sid": 77,
      "location": 2,
      "content": "然后我们这里可以看一下达达成功的例子啊",
      "music": 0.0
    },
    {
      "from": 186.25,
      "to": 187.89,
      "sid": 78,
      "location": 2,
      "content": "我们离掩体近的话",
      "music": 0.0
    },
    {
      "from": 187.89,
      "to": 189.13,
      "sid": 79,
      "location": 2,
      "content": "会导致近大远小",
      "music": 0.0
    },
    {
      "from": 189.13,
      "to": 191.74,
      "sid": 80,
      "location": 2,
      "content": "所以说呢燕南会提前看到我们",
      "music": 0.0
    },
    {
      "from": 191.74,
      "to": 194.96,
      "sid": 81,
      "location": 2,
      "content": "那我们就得要运用尽快远慢这个基础",
      "music": 0.0
    },
    {
      "from": 194.96,
      "to": 196.699,
      "sid": 82,
      "location": 2,
      "content": "来使这个燕男架不住",
      "music": 0.0
    },
    {
      "from": 196.699,
      "to": 197.899,
      "sid": 83,
      "location": 2,
      "content": "我们拉出去之后呢",
      "music": 0.0
    },
    {
      "from": 197.899,
      "to": 199.239,
      "sid": 84,
      "location": 2,
      "content": "我们锁定奶妈的位置",
      "music": 0.0
    },
    {
      "from": 199.239,
      "to": 200.379,
      "sid": 85,
      "location": 2,
      "content": "然后提前预瞄",
      "music": 0.0
    },
    {
      "from": 200.379,
      "to": 201.77,
      "sid": 86,
      "location": 2,
      "content": "把他给收下了",
      "music": 0.0
    },
    {
      "from": 202.05,
      "to": 204.48,
      "sid": 87,
      "location": 2,
      "content": "第四个蹲拉优点",
      "music": 0.0
    },
    {
      "from": 204.48,
      "to": 206.94,
      "sid": 88,
      "location": 2,
      "content": "它就是可以稳定的规避爆头线",
      "music": 0.0
    },
    {
      "from": 206.94,
      "to": 208.86,
      "sid": 89,
      "location": 2,
      "content": "但是呢它地速不够的话",
      "music": 0.0
    },
    {
      "from": 208.86,
      "to": 210.02,
      "sid": 90,
      "location": 2,
      "content": "它调整不快的话",
      "music": 0.0
    },
    {
      "from": 210.02,
      "to": 211.46,
      "sid": 91,
      "location": 2,
      "content": "很容易变成靶子",
      "music": 0.0
    },
    {
      "from": 211.46,
      "to": 213.2,
      "sid": 92,
      "location": 2,
      "content": "我们先来看一下这个例子啊",
      "music": 0.0
    },
    {
      "from": 213.2,
      "to": 215.54,
      "sid": 93,
      "location": 2,
      "content": "因为杰特呢他属于在近距离",
      "music": 0.0
    },
    {
      "from": 215.54,
      "to": 218.25,
      "sid": 94,
      "location": 2,
      "content": "然后我们使用蹲扫帮队友补枪",
      "music": 0.0
    },
    {
      "from": 218.25,
      "to": 220.03,
      "sid": 95,
      "location": 2,
      "content": "而之后呢又看到瑞纳",
      "music": 0.0
    },
    {
      "from": 220.03,
      "to": 222.63,
      "sid": 96,
      "location": 2,
      "content": "然后使用了蹲草之后混到舔包的爆头",
      "music": 0.0
    },
    {
      "from": 222.63,
      "to": 224.21,
      "sid": 97,
      "location": 2,
      "content": "而随后面闪现解决了盖",
      "music": 0.0
    },
    {
      "from": 224.21,
      "to": 226.29,
      "sid": 98,
      "location": 2,
      "content": "可跟缺点说的一样啊",
      "music": 0.0
    },
    {
      "from": 226.29,
      "to": 227.53,
      "sid": 99,
      "location": 2,
      "content": "在扫瑞纳的时候呢",
      "music": 0.0
    },
    {
      "from": 227.53,
      "to": 228.35,
      "sid": 100,
      "location": 2,
      "content": "因为我们不能动",
      "music": 0.0
    },
    {
      "from": 228.35,
      "to": 229.93,
      "sid": 101,
      "location": 2,
      "content": "然后被钱包打了三枪",
      "music": 0.0
    },
    {
      "from": 229.93,
      "to": 231.55,
      "sid": 102,
      "location": 2,
      "content": "身子还好没有死啊",
      "music": 0.0
    },
    {
      "from": 231.55,
      "to": 232.15,
      "sid": 103,
      "location": 2,
      "content": "好了",
      "music": 0.0
    },
    {
      "from": 232.15,
      "to": 234.59,
      "sid": 104,
      "location": 2,
      "content": "现在你应该有一定的了解该怎么动了啊",
      "music": 0.0
    },
    {
      "from": 234.59,
      "to": 237.28,
      "sid": 105,
      "location": 2,
      "content": "有什么方式可以当主公番去pick了",
      "music": 0.0
    },
    {
      "from": 237.28,
      "to": 240.2,
      "sid": 106,
      "location": 2,
      "content": "所以说呢我们现在就得要到下一个方面",
      "music": 0.0
    },
    {
      "from": 240.2,
      "to": 241.96,
      "sid": 107,
