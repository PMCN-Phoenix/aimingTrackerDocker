{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "1.5.0",
  "body": [
    {
      "from": 0.18,
      "to": 1.22,
      "sid": 1,
      "location": 2,
      "content": "哈喽兄弟们",
      "music": 0.0
    },
    {
      "from": 1.22,
      "to": 2.06,
      "sid": 2,
      "location": 2,
      "content": "豆腐渣工程",
      "music": 0.0
    },
    {
      "from": 2.06,
      "to": 2.6,
      "sid": 3,
      "location": 2,
      "content": "瓦罗兰特",
      "music": 0.0
    },
    {
      "from": 2.6,
      "to": 3.32,
      "sid": 4,
      "location": 2,
      "content": "我们都知道",
      "music": 0.0
    },
    {
      "from": 3.32,
      "to": 5.68,
      "sid": 5,
      "location": 2,
      "content": "那究竟什么样的墙能被什么枪穿呢",
      "music": 0.0
    },
    {
      "from": 5.68,
      "to": 8.59,
      "sid": 6,
      "location": 2,
      "content": "今天我们就来深度剖析一下这个穿墙机制",
      "music": 0.0
    },
    {
      "from": 8.59,
      "to": 11.08,
      "sid": 7,
      "location": 2,
      "content": "首先根据枪本身具有的穿墙能力",
      "music": 0.0
    },
    {
      "from": 11.08,
      "to": 11.74,
      "sid": 8,
      "location": 2,
      "content": "由高到低",
      "music": 0.0
    },
    {
      "from": 11.74,
      "to": 13.08,
      "sid": 9,
      "location": 2,
      "content": "我们分为以下四类",
      "music": 0.0
    },
    {
      "from": 13.08,
      "to": 14.34,
      "sid": 10,
      "location": 2,
      "content": "第一类包括大狙",
      "music": 0.0
    },
    {
      "from": 14.34,
      "to": 17.22,
      "sid": 11,
      "location": 2,
      "content": "两把机枪以及神射这一类的枪械",
      "music": 0.0
    },
    {
      "from": 17.22,
      "to": 19.86,
      "sid": 12,
      "location": 2,
      "content": "可以轻松击穿地图上大部分的墙壁",
      "music": 0.0
    },
    {
      "from": 19.86,
      "to": 22.56,
      "sid": 13,
      "location": 2,
      "content": "第二类则是以警长以及全部的步枪",
      "music": 0.0
    },
    {
      "from": 22.56,
      "to": 24.58,
      "sid": 14,
      "location": 2,
      "content": "包括USP组成的",
      "music": 0.0
    },
    {
      "from": 24.58,
      "to": 27.64,
      "sid": 15,
      "location": 2,
      "content": "这类枪可以击穿地图上所有的木墙壁",
      "music": 0.0
    },
    {
      "from": 27.64,
      "to": 29.88,
      "sid": 16,
      "location": 2,
      "content": "包括一些比较薄的石墙",
      "music": 0.0
    },
    {
      "from": 32.1,
      "to": 33.96,
      "sid": 17,
      "location": 2,
      "content": "第三类则是全部的冲锋枪",
      "music": 0.0
    },
    {
      "from": 33.96,
      "to": 35.08,
      "sid": 18,
      "location": 2,
      "content": "包括散弹枪",
      "music": 0.0
    },
    {
      "from": 35.08,
      "to": 36.34,
      "sid": 19,
      "location": 2,
      "content": "到了这类的枪械",
      "music": 0.0
    },
    {
      "from": 36.34,
      "to": 38.08,
      "sid": 20,
      "location": 2,
      "content": "基本上穿墙能力就已经很弱了",
      "music": 0.0
    },
    {
      "from": 38.08,
      "to": 40.82,
      "sid": 21,
      "location": 2,
      "content": "你看到散弹枪是基本打不穿木墙壁的",
      "music": 0.0
    },
    {
      "from": 40.82,
      "to": 44.64,
      "sid": 22,
      "location": 2,
      "content": "第四类则是除了USP和左轮的其他三把手枪",
      "music": 0.0
    },
    {
      "from": 44.64,
      "to": 47.25,
      "sid": 23,
      "location": 2,
      "content": "这类武器基本上不具有穿墙能力",
      "music": 0.0
    },
    {
      "from": 47.25,
      "to": 48.12,
      "sid": 24,
      "location": 2,
      "content": "枪械的分类",
      "music": 0.0
    },
    {
      "from": 48.12,
      "to": 48.54,
      "sid": 25,
      "location": 2,
      "content": "看完了",
      "music": 0.0
    },
    {
      "from": 48.54,
      "to": 51.18,
      "sid": 26,
      "location": 2,
      "content": "那咱们再根据地图上主要的几种墙壁材质",
      "music": 0.0
    },
    {
      "from": 51.18,
      "to": 52.34,
      "sid": 27,
      "location": 2,
      "content": "进行了解一下",
      "music": 0.0
    },
    {
      "from": 52.34,
      "to": 53.54,
      "sid": 28,
      "location": 2,
      "content": "首先我们会注意到",
      "music": 0.0
    },
    {
      "from": 53.54,
      "to": 55.76,
      "sid": 29,
      "location": 2,
      "content": "地图上有很多这种绿色的能量块",
      "music": 0.0
    },
    {
      "from": 55.76,
      "to": 57.52,
      "sid": 30,
      "location": 2,
      "content": "其实本身就是玻璃材质",
      "music": 0.0
    },
    {
      "from": 57.52,
      "to": 61.2,
      "sid": 31,
      "location": 2,
      "content": "只要是第二类及以上的枪械都可以轻松击穿",
      "music": 0.0
    },
    {
      "from": 61.3,
      "to": 63.54,
      "sid": 32,
      "location": 2,
      "content": "然后我们可以看到第三类的枪械",
      "music": 0.0
    },
    {
      "from": 63.54,
      "to": 64.44,
      "sid": 33,
      "location": 2,
      "content": "包括冲锋枪",
      "music": 0.0
    },
    {
      "from": 64.44,
      "to": 68.86,
      "sid": 34,
      "location": 2,
      "content": "手枪都是打不穿的",
      "music": 0.0
    },
    {
      "from": 69.02,
      "to": 70.48,
      "sid": 35,
      "location": 2,
      "content": "当然你可以侧着去打",
      "music": 0.0
    },
    {
      "from": 70.48,
      "to": 71.32,
      "sid": 36,
      "location": 2,
      "content": "这样会比较薄",
      "music": 0.0
    },
    {
      "from": 71.32,
      "to": 71.98,
      "sid": 37,
      "location": 2,
      "content": "就能打穿",
      "music": 0.0
    },
    {
      "from": 71.98,
      "to": 74.6,
      "sid": 38,
      "location": 2,
      "content": "但是我们不把它作为穿墙的实力来看",
      "music": 0.0
    },
    {
      "from": 74.6,
      "to": 77.48,
      "sid": 39,
      "location": 2,
      "content": "地图上其他的能量块穿墙效果都是一样的",
      "music": 0.0
    },
    {
      "from": 77.48,
      "to": 80.42,
      "sid": 40,
      "location": 2,
      "content": "然后不用去管它上面显示的是金属还是玻璃",
      "music": 0.0
    },
    {
      "from": 80.42,
      "to": 83.3,
      "sid": 41,
      "location": 2,
      "content": "打在上面都是一样的",
      "music": 0.0
    },
    {
      "from": 84.66,
      "to": 86.96,
      "sid": 42,
      "location": 2,
      "content": "第二类材质则是以木质结构为主",
      "music": 0.0
    },
    {
      "from": 86.96,
      "to": 88.18,
      "sid": 43,
      "location": 2,
      "content": "咱们刚才也看到了",
      "music": 0.0
    },
    {
      "from": 88.18,
      "to": 89.44,
      "sid": 44,
      "location": 2,
      "content": "只要是等级二以上",
      "music": 0.0
    },
    {
      "from": 89.44,
      "to": 90.16,
      "sid": 45,
      "location": 2,
      "content": "包括步枪",
      "music": 0.0
    },
    {
      "from": 90.16,
      "to": 92.78,
      "sid": 46,
      "location": 2,
      "content": "包括狙击枪和机枪都是可以打穿的",
      "music": 0.0
    },
    {
      "from": 92.78,
      "to": 94.88,
      "sid": 47,
      "location": 2,
      "content": "手枪和散弹则是不行的",
      "music": 0.0
    },
    {
      "from": 94.88,
      "to": 97.37,
      "sid": 48,
      "location": 2,
      "content": "借着这个机会给大家分享一个穿墙点位",
      "music": 0.0
    },
    {
      "from": 97.37,
      "to": 99.8,
      "sid": 49,
      "location": 2,
      "content": "可以在空岛的中路小径位置",
      "music": 0.0
    },
    {
      "from": 99.8,
      "to": 101.6,
      "sid": 50,
      "location": 2,
      "content": "使用步枪及以上武器",
      "music": 0.0
    },
    {
      "from": 101.6,
      "to": 103.28,
      "sid": 51,
      "location": 2,
      "content": "对着这个门开枪",
      "music": 0.0
    },
    {
      "from": 103.28,
      "to": 105.14,
      "sid": 52,
      "location": 2,
      "content": "这是可以打穿的",
      "music": 0.0
    },
    {
      "from": 105.14,
      "to": 108.16,
      "sid": 53,
      "location": 2,
      "content": "通过这个点位我们可以穿到B门口手臂的人",
      "music": 0.0
    },
    {
      "from": 108.16,
      "to": 109.48,
      "sid": 54,
      "location": 2,
      "content": "我拿费德做个演示",
      "music": 0.0
    },
    {
      "from": 109.48,
      "to": 111.16,
      "sid": 55,
      "location": 2,
      "content": "我们可以直接往里面丢一技能",
      "music": 0.0
    },
    {
      "from": 111.16,
      "to": 112.78,
      "sid": 56,
      "location": 2,
      "content": "是可以看到里面的敌人的",
      "music": 0.0
    },
    {
      "from": 112.78,
      "to": 114.32,
      "sid": 57,
      "location": 2,
      "content": "然后直接穿就可以了",
      "music": 0.0
    },
    {
      "from": 114.32,
      "to": 116.3,
      "sid": 58,
      "location": 2,
      "content": "最后一种墙壁也是最常见的",
      "music": 0.0
    },
    {
      "from": 116.3,
      "to": 117.11,
      "sid": 59,
      "location": 2,
      "content": "就是石墙",
      "music": 0.0
    },
    {
      "from": 117.11,
      "to": 119.84,
      "sid": 60,
      "location": 2,
      "content": "石墙是可以有宝刀后分不同的等级的",
      "music": 0.0
    },
    {
      "from": 119.84,
      "to": 122.14,
      "sid": 61,
      "location": 2,
      "content": "每种等级会有不同的穿墙效果",
      "music": 0.0
    },
    {
      "from": 122.14,
      "to": 124.96,
      "sid": 62,
      "location": 2,
      "content": "我们在空岛B点看到石像就是最低等级的",
      "music": 0.0
    },
    {
      "from": 124.96,
      "to": 126.16,
      "sid": 63,
      "location": 2,
      "content": "所有武器都可以打穿",
      "music": 0.0
    },
    {
      "from": 126.16,
      "to": 127.18,
      "sid": 64,
      "location": 2,
      "content": "可以通过这个办法",
      "music": 0.0
    },
    {
      "from": 127.18,
      "to": 128.94,
      "sid": 65,
      "location": 2,
      "content": "直接达到埋伏在B点里的敌人",
      "music": 0.0
    },
    {
      "from": 128.94,
      "to": 132.69,
      "sid": 66,
      "location": 2,
      "content": "但是手枪和冲锋枪是无法侧着打穿墙壁的嗯",
      "music": 0.0
    },
    {
      "from": 132.69,
      "to": 134.9,
      "sid": 67,
      "location": 2,
      "content": "机枪和步枪就没有这种限制",
      "music": 0.0
    },
    {
      "from": 134.9,
      "to": 137.48,
      "sid": 68,
      "location": 2,
      "content": "第二类石墙也是地图中最多见的",
      "music": 0.0
    },
    {
      "from": 137.48,
      "to": 138.74,
      "sid": 69,
      "location": 2,
      "content": "中型厚度的石墙",
      "music": 0.0
    },
    {
      "from": 138.74,
      "to": 139.82,
      "sid": 70,
      "location": 2,
      "content": "这种类型的石墙",
      "music": 0.0
    },
    {
      "from": 139.82,
      "to": 142.34,
      "sid": 71,
      "location": 2,
      "content": "我们可以用等级二以上的所有枪械打穿",
      "music": 0.0
    },
    {
      "from": 142.34,
      "to": 143.3,
      "sid": 72,
      "location": 2,
      "content": "但是冲锋枪",
      "music": 0.0
    },
    {
      "from": 143.3,
      "to": 149.18,
      "sid": 73,
      "location": 2,
      "content": "手枪包括散弹枪都是打不穿的",
      "music": 0.0
    },
    {
      "from": 150.3,
      "to": 152.72,
      "sid": 74,
      "location": 2,
      "content": "然后我们可以看到地图上大部分墙壁",
      "music": 0.0
    },
    {
      "from": 152.72,
      "to": 154.12,
      "sid": 75,
      "location": 2,
      "content": "都是这种墙壁",
      "music": 0.0
    },
    {
      "from": 154.12,
      "to": 156.34,
      "sid": 76,
      "location": 2,
      "content": "如果我们看到墙壁的厚度差不多",
      "music": 0.0
    },
    {
      "from": 156.34,
      "to": 158.7,
      "sid": 77,
      "location": 2,
      "content": "那他们的穿墙特质也会差不多",
      "music": 0.0
    },
    {
      "from": 168.3,
      "to": 171.22,
      "sid": 78,
      "location": 2,
      "content": "第三类的石墙在视觉上也会更厚一些",
      "music": 0.0
    },
    {
      "from": 171.22,
      "to": 174.94,
      "sid": 79,
      "location": 2,
      "content": "比较多见的会出现在各个地图ab点的通道上",
      "music": 0.0
    },
    {
      "from": 174.94,
      "to": 179.2,
      "sid": 80,
      "location": 2,
      "content": "这类墙壁我们只能使用等级一的枪械才能打穿",
      "music": 0.0
    },
    {
      "from": 179.72,
      "to": 181.36,
      "sid": 81,
      "location": 2,
      "content": "比如像所有机枪",
      "music": 0.0
    },
    {
      "from": 181.36,
      "to": 186.1,
      "sid": 82,
      "location": 2,
      "content": "包括大狙和神射都是可以轻松打穿的",
      "music": 0.0
    },
    {
      "from": 203.02,
      "to": 205.88,
      "sid": 83,
      "location": 2,
      "content": "最后一个等级也就是地图中最后的四强",
      "music": 0.0
    },
    {
      "from": 205.88,
      "to": 206.48,
      "sid": 84,
      "location": 2,
      "content": "这类墙壁",
      "music": 0.0
    },
    {
      "from": 206.48,
      "to": 207.92,
      "sid": 85,
      "location": 2,
      "content": "因为在视觉上会让人们感觉",
      "music": 0.0
    },
    {
      "from": 207.92,
      "to": 209.45,
      "sid": 86,
      "location": 2,
      "content": "已经超过了一个人的厚度",
      "music": 0.0
    },
    {
      "from": 209.45,
      "to": 211.08,
      "sid": 87,
      "location": 2,
      "content": "这样的墙都是穿不了的",
      "music": 0.0
    },
    {
      "from": 211.08,
      "to": 211.56,
      "sid": 88,
      "location": 2,
      "content": "同样的",
      "music": 0.0
    },
    {
      "from": 211.56,
      "to": 213.96,
      "sid": 89,
      "location": 2,
      "content": "我们也可以通过从侧面设计来减小厚度",
      "music": 0.0
    },
    {
      "from": 213.96,
      "to": 215.26,
      "sid": 90,
      "location": 2,
      "content": "对穿墙效果的影响",
      "music": 0.0
    },
    {
      "from": 215.26,
      "to": 217.18,
      "sid": 91,
      "location": 2,
      "content": "那今天视频到这里就要结束了",
      "music": 0.0
    },
    {
      "from": 217.18,
      "to": 219.22,
      "sid": 92,
      "location": 2,
      "content": "不知道大家喜不喜欢看这类视频呢",
      "music": 0.0
    },
    {
      "from": 219.22,
      "to": 220.72,
      "sid": 93,
      "location": 2,
      "content": "如果觉得喜欢的话",
      "music": 0.0
    },
    {
      "from": 220.72,
      "to": 222.4,
      "sid": 94,
      "location": 2,
      "content": "记得三连支持一下up主",
      "music": 0.0
    },
    {
      "from": 222.4,
      "to": 224.59,
      "sid": 95,
      "location": 2,
      "content": "希望我的视频能给您带来收获",
      "music": 0.0
    },
    {
      "from": 224.59,
      "to": 226.06,
      "sid": 96,
      "location": 2,
      "content": "那我们今天就到这里",
      "music": 0.0
    },
    {
      "from": 226.06,
      "to": 228.64,
      "sid": 97,
      "location": 2,
      "content": "下期再见",
      "music": 0.0
    }
  ]
}