{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.0,
      "to": 1.0,
      "sid": 1,
      "location": 2,
      "content": "哈喽各位朋友大家好",
      "music": 0.0
    },
    {
      "from": 1.0,
      "to": 1.72,
      "sid": 2,
      "location": 2,
      "content": "我是东彦",
      "music": 0.0
    },
    {
      "from": 1.72,
      "to": 3.12,
      "sid": 3,
      "location": 2,
      "content": "那么今天给大家带来身位控制",
      "music": 0.0
    },
    {
      "from": 3.12,
      "to": 5.0,
      "sid": 4,
      "location": 2,
      "content": "教学的一些进阶点展边啊",
      "music": 0.0
    },
    {
      "from": 5.0,
      "to": 6.64,
      "sid": 5,
      "location": 2,
      "content": "那我此前给舰长复盘的时候",
      "music": 0.0
    },
    {
      "from": 6.64,
      "to": 6.92,
      "sid": 6,
      "location": 2,
      "content": "发现",
      "music": 0.0
    },
    {
      "from": 6.92,
      "to": 8.96,
      "sid": 7,
      "location": 2,
      "content": "有些朋友对于我们之前一直强调的",
      "music": 0.0
    },
    {
      "from": 8.96,
      "to": 11.64,
      "sid": 8,
      "location": 2,
      "content": "近大远小这个概念有着教条式的病态追求",
      "music": 0.0
    },
    {
      "from": 11.64,
      "to": 14.48,
      "sid": 9,
      "location": 2,
      "content": "但实际上近大远小绝对不是对枪的唯一准则",
      "music": 0.0
    },
    {
      "from": 14.48,
      "to": 15.48,
      "sid": 10,
      "location": 2,
      "content": "那么在视频的开头",
      "music": 0.0
    },
    {
      "from": 15.48,
      "to": 17.28,
      "sid": 11,
      "location": 2,
      "content": "我们先给一些新手朋友科普一下",
      "music": 0.0
    },
    {
      "from": 17.28,
      "to": 18.16,
      "sid": 12,
      "location": 2,
      "content": "近大远小的概念",
      "music": 0.0
    },
    {
      "from": 18.16,
      "to": 20.52,
      "sid": 13,
      "location": 2,
      "content": "所谓的近大远小呢就是老生常谈的",
      "music": 0.0
    },
    {
      "from": 20.52,
      "to": 22.18,
      "sid": 14,
      "location": 2,
      "content": "双方围绕同掩体进行博弈",
      "music": 0.0
    },
    {
      "from": 22.18,
      "to": 25.06,
      "sid": 15,
      "location": 2,
      "content": "离这个掩体越远的人就会率先看到对手优势",
      "music": 0.0
    },
    {
      "from": 25.06,
      "to": 27.74,
      "sid": 16,
      "location": 2,
      "content": "相反的离这个掩体越近的人则处于相对劣势",
      "music": 0.0
    },
    {
      "from": 27.74,
      "to": 30.18,
      "sid": 17,
      "location": 2,
      "content": "也就是说我们在围绕掩体进行peek的时候",
      "music": 0.0
    },
    {
      "from": 30.18,
      "to": 31.78,
      "sid": 18,
      "location": 2,
      "content": "应该尽量与掩体保持一段距离",
      "music": 0.0
    },
    {
      "from": 31.78,
      "to": 32.46,
      "sid": 19,
      "location": 2,
      "content": "再进行大浪",
      "music": 0.0
    },
    {
      "from": 32.46,
      "to": 34.86,
      "sid": 20,
      "location": 2,
      "content": "但假如你在我直播的时候看过我这奶",
      "music": 0.0
    },
    {
      "from": 34.86,
      "to": 35.64,
      "sid": 21,
      "location": 2,
      "content": "还有can比单挑",
      "music": 0.0
    },
    {
      "from": 35.64,
      "to": 37.5,
      "sid": 22,
      "location": 2,
      "content": "那你会发现我在于是这张图",
      "music": 0.0
    },
    {
      "from": 37.5,
      "to": 38.66,
      "sid": 23,
      "location": 2,
      "content": "PIK这个大箱的时候",
      "music": 0.0
    },
    {
      "from": 38.66,
      "to": 40.7,
      "sid": 24,
      "location": 2,
      "content": "更喜欢这样贴墙进行一个蹲浪啊",
      "music": 0.0
    },
    {
      "from": 40.7,
      "to": 42.0,
      "sid": 25,
      "location": 2,
      "content": "而且对枪胜率还不低",
      "music": 0.0
    },
    {
      "from": 42.0,
      "to": 43.48,
      "sid": 26,
      "location": 2,
      "content": "那么这样对枪的原理在于",
      "music": 0.0
    },
    {
      "from": 43.48,
      "to": 46.04,
      "sid": 27,
      "location": 2,
      "content": "当你在俯视角看鱼式大枪这个枪位",
      "music": 0.0
    },
    {
      "from": 46.04,
      "to": 48.72,
      "sid": 28,
      "location": 2,
      "content": "你会发现敌人只要站在广角进行直架",
      "music": 0.0
    },
    {
      "from": 48.72,
      "to": 50.2,
      "sid": 29,
      "location": 2,
      "content": "只要你是从复活点出发",
      "music": 0.0
    },
    {
      "from": 50.2,
      "to": 51.88,
      "sid": 30,
      "location": 2,
      "content": "无论你是尽可能远离大强",
      "music": 0.0
    },
    {
      "from": 51.88,
      "to": 53.72,
      "sid": 31,
      "location": 2,
      "content": "去皮还是贴近大将来的大佬",
      "music": 0.0
    },
    {
      "from": 53.72,
      "to": 55.84,
      "sid": 32,
      "location": 2,
      "content": "你都处在一个近大远小劣势枪位",
      "music": 0.0
    },
    {
      "from": 55.84,
      "to": 58.48,
      "sid": 33,
      "location": 2,
      "content": "那么大家在初中应该学过线速度一定的时候",
      "music": 0.0
    },
    {
      "from": 58.48,
      "to": 60.16,
      "sid": 34,
      "location": 2,
      "content": "角速度会与半径成反比的倒数",
      "music": 0.0
    },
    {
      "from": 60.16,
      "to": 61.32,
      "sid": 35,
      "location": 2,
      "content": "那么在无畏缺里面",
      "music": 0.0
    },
    {
      "from": 61.32,
      "to": 62.36,
      "sid": 36,
      "location": 2,
      "content": "这个道理也是一样的",
      "music": 0.0
    },
    {
      "from": 62.36,
      "to": 62.96,
      "sid": 37,
      "location": 2,
      "content": "也就是说",
      "music": 0.0
    },
    {
      "from": 62.96,
      "to": 65.04,
      "sid": 38,
      "location": 2,
      "content": "既然你已经处在了劣势枪位了",
      "music": 0.0
    },
    {
      "from": 65.04,
      "to": 67.8,
      "sid": 39,
      "location": 2,
      "content": "那不如贴近掩体来换取更大的角速度",
      "music": 0.0
    },
    {
      "from": 67.8,
      "to": 70.04,
      "sid": 40,
      "location": 2,
      "content": "那么有可能这段话理解起来会稍微有些抽象",
      "music": 0.0
    },
    {
      "from": 70.04,
      "to": 71.06,
      "sid": 41,
      "location": 2,
      "content": "我们展开来讲一下",
      "music": 0.0
    },
    {
      "from": 71.06,
      "to": 71.88,
      "sid": 42,
      "location": 2,
      "content": "如画面所示",
      "music": 0.0
    },
    {
      "from": 71.88,
      "to": 73.96,
      "sid": 43,
      "location": 2,
      "content": "我们站在距离敌人不同的位置出发",
      "music": 0.0
    },
    {
      "from": 73.96,
      "to": 76.42,
      "sid": 44,
      "location": 2,
      "content": "两次都同样以相同速度走一样的路程",
      "music": 0.0
    },
    {
      "from": 76.42,
      "to": 78.22,
      "sid": 45,
      "location": 2,
      "content": "你会发现当你离敌人更近的时候",
      "music": 0.0
    },
    {
      "from": 78.22,
      "to": 81.14,
      "sid": 46,
      "location": 2,
      "content": "相同时间内你在敌人视角下移动的角度会更大",
      "music": 0.0
    },
    {
      "from": 81.14,
      "to": 81.78,
      "sid": 47,
      "location": 2,
      "content": "这也就意味着",
      "music": 0.0
    },
    {
      "from": 81.78,
      "to": 84.06,
      "sid": 48,
      "location": 2,
      "content": "你在敌人的显示器上移动的会更快一些",
      "music": 0.0
    },
    {
      "from": 84.06,
      "to": 85.12,
      "sid": 49,
      "location": 2,
      "content": "也更不容易被架住",
      "music": 0.0
    },
    {
      "from": 85.12,
      "to": 86.0,
      "sid": 50,
      "location": 2,
      "content": "那我们要知道",
      "music": 0.0
    },
    {
      "from": 86.0,
      "to": 86.88,
      "sid": 51,
      "location": 2,
      "content": "你在V圈里",
      "music": 0.0
    },
    {
      "from": 86.88,
      "to": 89.32,
      "sid": 52,
      "location": 2,
      "content": "总不可能每次都站在视角差优势的情况下",
      "music": 0.0
    },
    {
      "from": 89.32,
      "to": 90.4,
      "sid": 53,
      "location": 2,
      "content": "对枪贴墙大拉",
      "music": 0.0
    },
    {
      "from": 90.4,
      "to": 91.52,
      "sid": 54,
      "location": 2,
      "content": "换取的较高角速度",
      "music": 0.0
    },
    {
      "from": 91.52,
      "to": 93.8,
      "sid": 55,
      "location": 2,
      "content": "配合蹲拉的这样一个规避头线的动作",
      "music": 0.0
    },
    {
      "from": 93.8,
      "to": 96.72,
      "sid": 56,
      "location": 2,
      "content": "能让你在视角差关系上已经处在劣势的情况下",
      "music": 0.0
    },
    {
      "from": 96.72,
      "to": 98.62,
      "sid": 57,
      "location": 2,
      "content": "尽可能换来更大对枪胜率",
      "music": 0.0
    },
    {
      "from": 98.62,
      "to": 100.32,
      "sid": 58,
      "location": 2,
      "content": "大家可以看一下单挑场景下",
      "music": 0.0
    },
    {
      "from": 100.32,
      "to": 102.34,
      "sid": 59,
      "location": 2,
      "content": "这样peek所带来的一个帅的视角",
      "music": 0.0
    },
    {
      "from": 102.34,
      "to": 104.26,
      "sid": 60,
      "location": 2,
      "content": "想架注确实还是很有难度的",
      "music": 0.0
    },
    {
      "from": 104.26,
      "to": 105.02,
      "sid": 61,
      "location": 2,
      "content": "那么在实战里",
      "music": 0.0
    },
    {
      "from": 105.02,
      "to": 106.7,
      "sid": 62,
      "location": 2,
      "content": "比如说员工注射的浴室枪位",
      "music": 0.0
    },
    {
      "from": 106.7,
      "to": 107.94,
      "sid": 63,
      "location": 2,
      "content": "这样的peek也还是蛮实用的",
      "music": 0.0
    },
    {
      "from": 107.94,
      "to": 109.6,
      "sid": 64,
      "location": 2,
      "content": "大家可以看后面上这波演示呃",
      "music": 0.0
    },
    {
      "from": 109.6,
      "to": 111.6,
      "sid": 65,
      "location": 2,
      "content": "但是呢贴墙大拉总不可能全是好处",
      "music": 0.0
    },
    {
      "from": 111.6,
      "to": 114.12,
      "sid": 66,
      "location": 2,
      "content": "不然我们每次对枪全都贴墙大拉就好了",
      "music": 0.0
    },
    {
      "from": 114.12,
      "to": 115.76,
      "sid": 67,
      "location": 2,
      "content": "那么贴墙大拉最大的坏处呢",
      "music": 0.0
    },
    {
      "from": 115.76,
      "to": 117.92,
      "sid": 68,
      "location": 2,
      "content": "就是你的身位控制是很难做到精细的",
      "music": 0.0
    },
    {
      "from": 117.92,
      "to": 120.08,
      "sid": 69,
      "location": 2,
      "content": "因为它本身就是一种孤注一掷",
      "music": 0.0
    },
    {
      "from": 120.08,
      "to": 121.38,
      "sid": 70,
      "location": 2,
      "content": "拉满角速度的大拉",
      "music": 0.0
    },
    {
      "from": 121.38,
      "to": 123.06,
      "sid": 71,
      "location": 2,
      "content": "但凡有多个敌人在架着你",
      "music": 0.0
    },
    {
      "from": 123.06,
      "to": 124.06,
      "sid": 72,
      "location": 2,
      "content": "那你也就该死了",
      "music": 0.0
    },
    {
      "from": 124.06,
      "to": 126.7,
      "sid": 73,
      "location": 2,
      "content": "所以呢贴墙大拉更多是确认敌人大概位置",
      "music": 0.0
    },
    {
      "from": 126.7,
      "to": 128.02,
      "sid": 74,
      "location": 2,
      "content": "在局部的一打一情况下",
      "music": 0.0
    },
    {
      "from": 128.02,
      "to": 129.419,
      "sid": 75,
      "location": 2,
      "content": "才会采取的一个对枪策略",
      "music": 0.0
    },
    {
      "from": 129.419,
      "to": 130.739,
      "sid": 76,
      "location": 2,
      "content": "可是这也并不意味着",
      "music": 0.0
    },
    {
      "from": 130.739,
      "to": 132.179,
      "sid": 77,
      "location": 2,
      "content": "在不确定敌人位置的时候",
      "music": 0.0
    },
    {
      "from": 132.179,
      "to": 133.64,
      "sid": 78,
      "location": 2,
      "content": "我们不能使用贴墙的技巧",
      "music": 0.0
    },
    {
      "from": 133.64,
      "to": 135.6,
      "sid": 79,
      "location": 2,
      "content": "贴墙大拉在特定情况下不好用",
      "music": 0.0
    },
    {
      "from": 135.6,
      "to": 137.52,
      "sid": 80,
      "location": 2,
      "content": "但贴墙晃身还是很好用的",
      "music": 0.0
    },
    {
      "from": 137.52,
      "to": 139.84,
      "sid": 81,
      "location": 2,
      "content": "因为贴墙的好处说白了就是角速度更快",
      "music": 0.0
    },
    {
      "from": 139.84,
      "to": 142.66,
      "sid": 82,
      "location": 2,
      "content": "那你在敌人视角下进出掩体的速度也会更快",
      "music": 0.0
    },
    {
      "from": 142.66,
      "to": 143.88,
      "sid": 83,
      "location": 2,
      "content": "如果你贴墙不大了",
      "music": 0.0
    },
    {
      "from": 143.88,
      "to": 145.74,
      "sid": 84,
      "location": 2,
      "content": "只露半个身位的晃身拿信息",
      "music": 0.0
    },
    {
      "from": 145.74,
      "to": 147.18,
      "sid": 85,
      "location": 2,
      "content": "那敌人也更难架住你",
      "music": 0.0
    },
    {
      "from": 147.18,
      "to": 147.92,
      "sid": 86,
      "location": 2,
      "content": "如画面所示",
      "music": 0.0
    },
    {
      "from": 147.92,
      "to": 149.6,
      "sid": 87,
      "location": 2,
      "content": "在老版弱之城这个素材里",
      "music": 0.0
    },
    {
      "from": 149.6,
      "to": 151.98,
      "sid": 88,
      "location": 2,
      "content": "我们在1V2残局中先拿到了一个击杀",
      "music": 0.0
    },
    {
      "from": 151.98,
      "to": 153.62,
      "sid": 89,
      "location": 2,
      "content": "在和第二个敌人博弈的时候",
      "music": 0.0
    },
    {
      "from": 153.62,
      "to": 154.78,
      "sid": 90,
      "location": 2,
      "content": "贴紧掩体晃身",
      "music": 0.0
    },
    {
      "from": 154.78,
      "to": 155.74,
      "sid": 91,
      "location": 2,
      "content": "提前枪拿信息",
      "music": 0.0
    },
    {
      "from": 155.74,
      "to": 158.5,
      "sid": 92,
      "location": 2,
      "content": "这样提前枪有机会以近乎跑歹的形态抽奖",
      "music": 0.0
    },
    {
      "from": 158.5,
      "to": 159.5,
      "sid": 93,
      "location": 2,
      "content": "抽到人头宝典",
      "music": 0.0
    },
    {
      "from": 159.5,
      "to": 160.29,
      "sid": 94,
      "location": 2,
      "content": "拿到信息",
      "music": 0.0
    },
    {
      "from": 160.29,
      "to": 161.75,
      "sid": 95,
      "location": 2,
      "content": "敌人不可能把你架死",
      "music": 0.0
    },
    {
      "from": 161.75,
      "to": 163.57,
      "sid": 96,
      "location": 2,
      "content": "那么拿到敌人的具体位置信息之后",
      "music": 0.0
    },
    {
      "from": 163.57,
      "to": 164.45,
      "sid": 97,
      "location": 2,
      "content": "我们远离掩体",
      "music": 0.0
    },
    {
      "from": 164.45,
      "to": 164.93,
      "sid": 98,
      "location": 2,
      "content": "往右拉",
      "music": 0.0
    },
    {
      "from": 164.93,
      "to": 167.53,
      "sid": 99,
      "location": 2,
      "content": "把自己的位置换到了一个在近大远小的关系上",
      "music": 0.0
    },
    {
      "from": 167.53,
      "to": 168.66,
      "sid": 100,
      "location": 2,
      "content": "更优势的一个枪位",
      "music": 0.0
    },
    {
      "from": 168.66,
      "to": 170.46,
      "sid": 101,
      "location": 2,
      "content": "架枪在获得了最后一个击杀",
      "music": 0.0
    },
    {
      "from": 170.46,
      "to": 172.66,
      "sid": 102,
      "location": 2,
      "content": "那么想要做到如此精妙的身位控制",
      "music": 0.0
    },
    {
      "from": 172.66,
      "to": 174.56,
      "sid": 103,
      "location": 2,
      "content": "那一款好的键盘是必不可少的",
      "music": 0.0
    },
    {
      "from": 174.56,
      "to": 176.0,
      "sid": 104,
      "location": 2,
      "content": "那么这就不得不给大家推荐一下",
      "music": 0.0
    },
    {
      "from": 176.0,
      "to": 178.86,
      "sid": 105,
      "location": 2,
      "content": "我目前在使用的这款铝厂的EZ63键盘",
      "music": 0.0
    },
    {
      "from": 178.86,
      "to": 180.9,
      "sid": 106,
