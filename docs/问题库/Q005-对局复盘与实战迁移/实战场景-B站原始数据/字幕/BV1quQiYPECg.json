    },
    {
      "from": 10.3,
      "to": 14.77,
      "sid": 4,
      "location": 2,
      "content": "今天就是每个人对都有",
      "music": 0.0
    },
    {
      "from": 14.77,
      "to": 17.6,
      "sid": 5,
      "location": 2,
      "content": "就是属于自己对于急停这个理解",
      "music": 0.0
    },
    {
      "from": 17.6,
      "to": 19.0,
      "sid": 6,
      "location": 2,
      "content": "然后我的理解就是",
      "music": 0.0
    },
    {
      "from": 19.0,
      "to": 19.6,
      "sid": 7,
      "location": 2,
      "content": "为什么",
      "music": 0.0
    },
    {
      "from": 19.6,
      "to": 23.08,
      "sid": 8,
      "location": 2,
      "content": "我觉得急停对于射击游戏来讲是非常重要的",
      "music": 0.0
    },
    {
      "from": 23.08,
      "to": 24.76,
      "sid": 9,
      "location": 2,
      "content": "因为在这个游戏的时候",
      "music": 0.0
    },
    {
      "from": 24.76,
      "to": 26.73,
      "sid": 10,
      "location": 2,
      "content": "你移动的时候",
      "music": 0.0
    },
    {
      "from": 27.63,
      "to": 32.25,
      "sid": 11,
      "location": 2,
      "content": "移动的时候开枪会大幅度的降低你的精准度",
      "music": 0.0
    },
    {
      "from": 32.25,
      "to": 35.11,
      "sid": 12,
      "location": 2,
      "content": "然后只有静止的时候才能保持准",
      "music": 0.0
    },
    {
      "from": 35.11,
      "to": 36.694,
      "sid": 13,
      "location": 2,
      "content": "保持那个精准度",
      "music": 0.0
    },
    {
      "from": 40.24,
      "to": 43.4,
      "sid": 14,
      "location": 2,
      "content": "然后的话部分高分玩家的核心技巧",
      "music": 0.0
    },
    {
      "from": 43.4,
      "to": 46.22,
      "sid": 15,
      "location": 2,
      "content": "就是通过急停瞬间静止并开枪",
      "music": 0.0
    },
    {
      "from": 46.22,
      "to": 48.989,
      "sid": 16,
      "location": 2,
      "content": "然后保持最大化的精确度",
      "music": 0.0
    },
    {
      "from": 49.529,
      "to": 52.16,
      "sid": 17,
      "location": 2,
      "content": "然后的话大家都会急停",
      "music": 0.0
    },
    {
      "from": 52.16,
      "to": 55.04,
      "sid": 18,
      "location": 2,
      "content": "但是的话正确是如何急停呢",
      "music": 0.0
    },
    {
      "from": 55.04,
      "to": 57.4,
      "sid": 19,
      "location": 2,
      "content": "当你就是当你按住一个方向键",
      "music": 0.0
    },
    {
      "from": 57.4,
      "to": 59.95,
      "sid": 20,
      "location": 2,
      "content": "比如A向左移动的时候",
      "music": 0.0
    },
    {
      "from": 59.95,
      "to": 61.67,
      "sid": 21,
      "location": 2,
      "content": "松开方向键的瞬间",
      "music": 0.0
    },
    {
      "from": 61.67,
      "to": 62.81,
      "sid": 22,
      "location": 2,
      "content": "按下反方向键",
      "music": 0.0
    },
    {
      "from": 62.81,
      "to": 64.67,
      "sid": 23,
      "location": 2,
      "content": "比如像这样",
      "music": 0.0
    },
