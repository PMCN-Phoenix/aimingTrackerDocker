      "music": 0.0
    },
    {
      "from": 66.21,
      "to": 70.69,
      "sid": 25,
      "location": 2,
      "content": "就是一个惯性去抵消惯性的同时去开枪",
      "music": 0.0
    },
    {
      "from": 70.69,
      "to": 71.43,
      "sid": 26,
      "location": 2,
      "content": "就这样",
      "music": 0.0
    },
    {
      "from": 71.43,
