  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.08,
      "to": 2.04,
      "sid": 1,
      "location": 2,
      "content": "你是否经常单挑死斗乱杀",
      "music": 0.0
    },
    {
      "from": 2.04,
      "to": 3.52,
      "sid": 2,
      "location": 2,
      "content": "但是排位中却经常垫底",
      "music": 0.0
    },
    {
      "from": 3.52,
      "to": 4.52,
      "sid": 3,
      "location": 2,
      "content": "或者神一把鬼一把",
      "music": 0.0
    },
    {
      "from": 4.52,
      "to": 5.64,
      "sid": 4,
      "location": 2,
      "content": "状态极其不稳定",
      "music": 0.0
    },
    {
      "from": 5.64,
      "to": 8.2,
      "sid": 5,
      "location": 2,
      "content": "如果我说有一种方法能在一对一对枪中",
      "music": 0.0
    },
    {
      "from": 8.2,
      "to": 9.2,
      "sid": 6,
      "location": 2,
      "content": "大大提高你的胜率",
      "music": 0.0
    },
    {
      "from": 9.2,
      "to": 10.38,
      "sid": 7,
      "location": 2,
      "content": "你学还是不学",
      "music": 0.0
    },
    {
      "from": 10.38,
      "to": 12.34,
      "sid": 8,
      "location": 2,
      "content": "在开始教学前先给自己打个广告",
      "music": 0.0
    },
    {
      "from": 12.34,
      "to": 13.98,
      "sid": 9,
      "location": 2,
      "content": "主播马上要作为东区冠军",
      "music": 0.0
    },
    {
      "from": 13.98,
      "to": 15.86,
      "sid": 10,
      "location": 2,
      "content": "参加今年的全国大赛线上突围赛",
      "music": 0.0
    },
    {
      "from": 15.86,
      "to": 19.559,
      "sid": 11,
      "location": 2,
      "content": "届时次轮会遇上航行所带领的航team比赛",
      "music": 0.0
    },
    {
      "from": 19.559,
      "to": 20.579,
      "sid": 12,
      "location": 2,
      "content": "全程官方直播",
      "music": 0.0
    },
    {
      "from": 20.579,
      "to": 21.379,
      "sid": 13,
      "location": 2,
      "content": "欢迎大家捧场",
      "music": 0.0
    },
    {
      "from": 22.499,
      "to": 23.619,
      "sid": 14,
      "location": 2,
      "content": "OK那现在开始教学",
      "music": 0.0
    },
    {
      "from": 23.619,
      "to": 25.84,
      "sid": 15,
      "location": 2,
      "content": "请大家先试想一下这样一个场景",
      "music": 0.0
    },
    {
      "from": 25.84,
      "to": 27.6,
      "sid": 16,
      "location": 2,
      "content": "我现在在我现在所在的位置",
      "music": 0.0
    },
    {
      "from": 27.6,
      "to": 30.079,
      "sid": 17,
      "location": 2,
      "content": "然后我的对手差不多在掩体后面",
      "music": 0.0
    },
    {
      "from": 30.079,
      "to": 31.639,
      "sid": 18,
      "location": 2,
      "content": "就是我正对着我的这个地方",
      "music": 0.0
    },
    {
      "from": 31.639,
      "to": 33.239,
      "sid": 19,
      "location": 2,
      "content": "然后这个时候我需要跟他",
      "music": 0.0
    },
    {
      "from": 33.239,
      "to": 36.53,
      "sid": 20,
      "location": 2,
      "content": "在短时间内去分出一个胜负啊",
      "music": 0.0
    },
    {
      "from": 36.53,
      "to": 38.93,
      "sid": 21,
      "location": 2,
      "content": "此时没有没有身边没有队友的辅助",
      "music": 0.0
    },
    {
      "from": 38.93,
      "to": 41.25,
      "sid": 22,
      "location": 2,
      "content": "然后也没有说就是道具的辅助",
      "music": 0.0
    },
    {
      "from": 41.25,
      "to": 44.379,
      "sid": 23,
      "location": 2,
      "content": "我们就是仅限于就是一对一的对枪",
      "music": 0.0
    },
    {
      "from": 44.379,
      "to": 45.499,
      "sid": 24,
      "location": 2,
      "content": "那我先来说一下",
      "music": 0.0
    },
    {
      "from": 45.499,
      "to": 47.239,
      "sid": 25,
      "location": 2,
      "content": "就是该如何操作",
      "music": 0.0
    },
    {
      "from": 47.239,
      "to": 49.279,
      "sid": 26,
      "location": 2,
      "content": "以这个绿色箱子为掩体呃",
      "music": 0.0
    },
    {
      "from": 49.279,
      "to": 51.059,
      "sid": 27,
      "location": 2,
      "content": "用分段式预瞄的方式",
      "music": 0.0
    },
    {
      "from": 51.059,
      "to": 52.739,
      "sid": 28,
      "location": 2,
      "content": "每两次往外拉",
      "music": 0.0
    },
    {
      "from": 52.739,
      "to": 55.29,
      "sid": 29,
      "location": 2,
      "content": "然后再每一次往里拉",
      "music": 0.0
    },
    {
      "from": 55.29,
      "to": 56.89,
      "sid": 30,
      "location": 2,
      "content": "就是两步往外拉",
      "music": 0.0
    },
    {
      "from": 56.89,
      "to": 57.73,
      "sid": 31,
      "location": 2,
      "content": "一步往里拉",
      "music": 0.0
    },
    {
      "from": 57.73,
      "to": 60.24,
      "sid": 32,
      "location": 2,
      "content": "然后这个为一组动作呃",
      "music": 0.0
    },
    {
      "from": 60.24,
      "to": 62.4,
      "sid": 33,
      "location": 2,
      "content": "我可以给大家解释一下具体的细节",
      "music": 0.0
    },
    {
      "from": 62.4,
      "to": 64.38,
      "sid": 34,
      "location": 2,
      "content": "假设我现在出生在这个位置",
      "music": 0.0
    },
    {
      "from": 64.38,
      "to": 67.28,
      "sid": 35,
      "location": 2,
      "content": "然后我的面前这个箱子后面肯定有个敌人",
      "music": 0.0
    },
    {
      "from": 67.28,
      "to": 68.08,
      "sid": 36,
      "location": 2,
      "content": "对不对",
      "music": 0.0
    },
    {
      "from": 68.08,
      "to": 69.52,
      "sid": 37,
      "location": 2,
      "content": "我没我第一步",
      "music": 0.0
    },
    {
      "from": 69.52,
      "to": 70.52,
      "sid": 38,
      "location": 2,
      "content": "然后我走第二步",
      "music": 0.0
    },
    {
      "from": 70.52,
      "to": 73.34,
      "sid": 39,
      "location": 2,
      "content": "我的第三步是走回到我的第一步所站的位置的",
      "music": 0.0
    },
    {
      "from": 73.34,
      "to": 75.0,
      "sid": 40,
      "location": 2,
      "content": "然后我一次往复",
      "music": 0.0
    },
    {
      "from": 75.0,
      "to": 76.76,
      "sid": 41,
      "location": 2,
      "content": "然后不停的去做这个动作",
      "music": 0.0
    },
    {
      "from": 76.76,
      "to": 78.32,
      "sid": 42,
      "location": 2,
      "content": "不停的去做这个动作",
      "music": 0.0
    },
    {
      "from": 78.32,
      "to": 80.92,
      "sid": 43,
      "location": 2,
      "content": "然后终有一次我会在",
      "music": 0.0
    },
    {
      "from": 81.48,
      "to": 86.02,
      "sid": 44,
      "location": 2,
      "content": "我会在做出我的踩出我的第二步的时候",
      "music": 0.0
    },
    {
      "from": 86.02,
      "to": 88.42,
      "sid": 45,
      "location": 2,
      "content": "因为因为我的第三步是回到我第一步",
      "music": 0.0
    },
    {
      "from": 88.42,
      "to": 89.14,
      "sid": 46,
      "location": 2,
      "content": "所站的位置",
      "music": 0.0
    },
    {
      "from": 89.14,
      "to": 89.78,
      "sid": 47,
      "location": 2,
      "content": "其实说白了",
      "music": 0.0
    },
    {
      "from": 89.78,
      "to": 92.06,
      "sid": 48,
      "location": 2,
      "content": "也就是我以极慢的速度",
      "music": 0.0
    },
    {
      "from": 92.06,
      "to": 94.46,
      "sid": 49,
      "location": 2,
      "content": "进行了一个往外的一个搜点",
      "music": 0.0
    },
    {
      "from": 94.46,
      "to": 96.59,
      "sid": 50,
      "location": 2,
      "content": "只是我在搜点的同时",
      "music": 0.0
    },
    {
      "from": 96.59,
      "to": 98.03,
      "sid": 51,
      "location": 2,
      "content": "就是正常情况下的搜点",
      "music": 0.0
    },
    {
      "from": 98.03,
      "to": 99.07,
      "sid": 52,
      "location": 2,
      "content": "我会这样子进步",
      "music": 0.0
    },
    {
      "from": 99.07,
      "to": 99.75,
      "sid": 53,
      "location": 2,
      "content": "慢慢搜出来",
      "music": 0.0
    },
    {
      "from": 99.75,
      "to": 101.53,
      "sid": 54,
      "location": 2,
      "content": "然后也许对手能看到我的手臂",
      "music": 0.0
    },
    {
      "from": 101.53,
      "to": 102.23,
      "sid": 55,
      "location": 2,
      "content": "看到我的头",
      "music": 0.0
    },
    {
      "from": 102.23,
      "to": 103.47,
      "sid": 56,
      "location": 2,
      "content": "而此时我没有反应过来",
      "music": 0.0
    },
    {
      "from": 103.47,
      "to": 104.77,
      "sid": 57,
      "location": 2,
      "content": "我就会被他先打掉",
      "music": 0.0
    },
    {
      "from": 104.77,
      "to": 108.13,
      "sid": 58,
      "location": 2,
      "content": "那我的这个操作就是规避了我所创造出来的",
      "music": 0.0
    },
    {
      "from": 108.13,
      "to": 109.01,
      "sid": 59,
      "location": 2,
      "content": "能让他打我的",
      "music": 0.0
    },
    {
      "from": 109.01,
      "to": 111.25,
      "sid": 60,
      "location": 2,
      "content": "就抓我timing的这个时机",
      "music": 0.0
    },
    {
      "from": 112.58,
      "to": 114.64,
      "sid": 61,
      "location": 2,
      "content": "然后当我每两步",
      "music": 0.0
    },
    {
      "from": 114.64,
      "to": 119.23,
      "sid": 62,
      "location": 2,
      "content": "我的第二步一定是比我原先所站的位置要远的",
      "music": 0.0
    },
    {
      "from": 119.23,
      "to": 121.71,
      "sid": 63,
      "location": 2,
      "content": "这个大家可以可以理解吧",
      "music": 0.0
    },
    {
      "from": 121.71,
      "to": 123.15,
      "sid": 64,
      "location": 2,
      "content": "所以说我的第二部",
      "music": 0.0
    },
    {
      "from": 123.15,
      "to": 127.02,
      "sid": 65,
      "location": 2,
      "content": "他是一定就是有几率会看到我的对手的",
      "music": 0.0
    },
    {
      "from": 127.02,
      "to": 129.22,
      "sid": 66,
      "location": 2,
      "content": "同时我我的对手也会看到我吧",
      "music": 0.0
    },
    {
      "from": 129.22,
      "to": 133.22,
      "sid": 67,
      "location": 2,
      "content": "啊那就是当我就是真的有一步我走出来",
      "music": 0.0
    },
    {
      "from": 133.22,
      "to": 134.24,
      "sid": 68,
      "location": 2,
      "content": "我看到他了",
      "music": 0.0
    },
    {
      "from": 134.24,
      "to": 136.78,
      "sid": 69,
      "location": 2,
      "content": "而此时我还在下意识的去做这个动作",
      "music": 0.0
    },
    {
      "from": 136.78,
      "to": 138.61,
      "sid": 70,
      "location": 2,
      "content": "也就是两步出一步回",
      "music": 0.0
    },
    {
      "from": 138.61,
      "to": 139.81,
      "sid": 71,
      "location": 2,
      "content": "当我看到他的时候",
      "music": 0.0
    },
    {
      "from": 139.81,
      "to": 141.899,
      "sid": 72,
      "location": 2,
      "content": "我是不是正好下意识地回来了",
      "music": 0.0
    },
    {
      "from": 141.899,
      "to": 143.099,
      "sid": 73,
      "location": 2,
      "content": "这是不是就规避了",
      "music": 0.0
    },
    {
      "from": 143.099,
      "to": 145.019,
      "sid": 74,
      "location": 2,
      "content": "就是我可能出来之后",
      "music": 0.0
    },
    {
      "from": 145.019,
      "to": 146.459,
      "sid": 75,
      "location": 2,
      "content": "然后我没有及时回去",
      "music": 0.0
    },
    {
      "from": 146.459,
      "to": 149.26,
      "sid": 76,
      "location": 2,
      "content": "然后就被对手给打头的一个timing",
      "music": 0.0
    },
    {
      "from": 149.62,
      "to": 151.92,
      "sid": 77,
      "location": 2,
      "content": "那在对面的视角里是什么样子",
      "music": 0.0
    },
    {
      "from": 151.92,
      "to": 153.5,
      "sid": 78,
      "location": 2,
      "content": "就是我走出来",
      "music": 0.0
    },
    {
      "from": 153.5,
      "to": 154.72,
      "sid": 79,
      "location": 2,
      "content": "我且露出了一个手臂",
      "music": 0.0
    },
    {
      "from": 154.72,
      "to": 156.2,
      "sid": 80,
      "location": 2,
      "content": "然后他马上就要打中",
      "music": 0.0
    },
    {
      "from": 156.2,
      "to": 157.76,
      "sid": 81,
      "location": 2,
      "content": "我将要打中我的这一瞬间",
      "music": 0.0
    },
    {
      "from": 157.76,
      "to": 158.85,
      "sid": 82,
      "location": 2,
      "content": "我立马回去了",
      "music": 0.0
    },
    {
      "from": 158.85,
      "to": 161.21,
      "sid": 83,
      "location": 2,
      "content": "而他肯定会就是因为看到我的手臂嘛",
      "music": 0.0
    },
    {
      "from": 161.21,
      "to": 162.43,
      "sid": 84,
      "location": 2,
      "content": "他肯定会开枪啊",
      "music": 0.0
    },
    {
      "from": 162.43,
      "to": 163.09,
      "sid": 85,
      "location": 2,
      "content": "开枪",
      "music": 0.0
    },
    {
      "from": 163.09,
      "to": 166.66,
      "sid": 86,
      "location": 2,
      "content": "当他看到我的手臂开枪这一瞬间他会怎么做",
      "music": 0.0
    },
    {
      "from": 166.66,
      "to": 169.2,
      "sid": 87,
      "location": 2,
      "content": "他会急于就是教我一举拿下",
      "music": 0.0
    },
    {
      "from": 169.2,
      "to": 172.18,
      "sid": 88,
      "location": 2,
      "content": "然后他会做一个拉拉出的一个动作啊",
      "music": 0.0
    },
    {
      "from": 172.18,
      "to": 174.16,
      "sid": 89,
      "location": 2,
      "content": "我给大家就是展示一下",
      "music": 0.0
    },
    {
      "from": 174.16,
      "to": 175.3,
      "sid": 90,
      "location": 2,
      "content": "看到我的手臂",
      "music": 0.0
    },
    {
      "from": 175.3,
      "to": 175.96,
      "sid": 91,
      "location": 2,
      "content": "OK开枪",
      "music": 0.0
    },
    {
      "from": 175.96,
      "to": 177.4,
      "sid": 92,
      "location": 2,
      "content": "然后看到我缩回去了",
      "music": 0.0
    },
    {
      "from": 177.4,
      "to": 178.4,
      "sid": 93,
      "location": 2,
      "content": "立马追出来",
      "music": 0.0
    },
    {
      "from": 178.4,
      "to": 180.98,
      "sid": 94,
      "location": 2,
      "content": "然后开枪呃",
      "music": 0.0
    },
    {
      "from": 180.98,
      "to": 182.22,
      "sid": 95,
      "location": 2,
      "content": "那大家是知道的",
      "music": 0.0
    },
    {
      "from": 182.22,
      "to": 184.64,
      "sid": 96,
      "location": 2,
      "content": "这个游戏它的对枪机制",
      "music": 0.0
    },
    {
      "from": 184.64,
      "to": 186.42,
      "sid": 97,
      "location": 2,
      "content": "也就是对枪的底层逻辑",
      "music": 0.0
    },
    {
      "from": 186.42,
      "to": 190.9,
      "sid": 98,
      "location": 2,
      "content": "一定是架枪的人优势大于拉枪的人",
      "music": 0.0
    },
    {
      "from": 191.26,
      "to": 192.18,
      "sid": 99,
      "location": 2,
      "content": "什么意思呢",
      "music": 0.0
    },
    {
      "from": 192.18,
      "to": 194.46,
      "sid": 100,
      "location": 2,
      "content": "就是大家最希望看到的一个结果",
      "music": 0.0
    },
    {
      "from": 194.46,
      "to": 196.12,
      "sid": 101,
      "location": 2,
      "content": "就是我现在站在这个位置",
      "music": 0.0
    },
    {
      "from": 196.12,
      "to": 198.2,
      "sid": 102,
      "location": 2,
      "content": "而我的敌人傻乎乎的走出来",
      "music": 0.0
    },
    {
      "from": 198.2,
      "to": 199.38,
      "sid": 103,
      "location": 2,
      "content": "走到我的准星里面",
      "music": 0.0
    },
    {
      "from": 199.38,
      "to": 200.77,
      "sid": 104,
      "location": 2,
      "content": "哎被我一颗头带走",
      "music": 0.0
    },
    {
      "from": 200.81,
      "to": 202.17,
      "sid": 105,
      "location": 2,
      "content": "对不对",
      "music": 0.0
    },
    {
      "from": 202.99,
      "to": 204.59,
      "sid": 106,
      "location": 2,
      "content": "而你的对手也是一样的",
      "music": 0.0
    },
    {
      "from": 204.59,
      "to": 206.33,
      "sid": 107,
      "location": 2,
      "content": "他最希望看到的是什么",
      "music": 0.0
    },
    {
      "from": 206.33,
      "to": 208.91,
      "sid": 108,
      "location": 2,
      "content": "我的敌人优先被我看到",
      "music": 0.0
    },
    {
      "from": 208.91,
      "to": 211.48,
      "sid": 109,
      "location": 2,
      "content": "我是最优先开枪的那一个",
      "music": 0.0
    },
    {
      "from": 211.48,
      "to": 213.68,
