{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.1,
      "to": 1.8,
      "sid": 1,
      "location": 2,
      "content": "粉丝投稿第42期",
      "music": 0.0
    },
    {
      "from": 1.8,
      "to": 2.76,
      "sid": 2,
      "location": 2,
      "content": "钻石三",
      "music": 0.0
    },
    {
      "from": 2.76,
      "to": 4.02,
      "sid": 3,
      "location": 2,
      "content": "感觉上过超凡以后",
      "music": 0.0
    },
    {
      "from": 4.02,
      "to": 5.68,
      "sid": 4,
      "location": 2,
      "content": "自己反而越来越没信心了",
      "music": 0.0
    },
    {
      "from": 5.68,
      "to": 6.86,
      "sid": 5,
      "location": 2,
      "content": "明明枪法没问题",
      "music": 0.0
    },
    {
      "from": 6.86,
      "to": 8.01,
      "sid": 6,
      "location": 2,
      "content": "却经常开不出枪",
      "music": 0.0
    },
    {
      "from": 8.01,
      "to": 10.05,
      "sid": 7,
      "location": 2,
      "content": "这好像是很多人都提过的问题",
      "music": 0.0
    },
    {
      "from": 10.05,
      "to": 12.31,
      "sid": 8,
      "location": 2,
      "content": "那么我们就直接来看看是什么情况吧",
      "music": 0.0
    },
    {
      "from": 12.31,
      "to": 13.91,
      "sid": 9,
      "location": 2,
      "content": "手枪局就不做讲解了",
      "music": 0.0
    },
    {
      "from": 13.91,
      "to": 15.54,
      "sid": 10,
      "location": 2,
      "content": "来看一下你的表现",
      "music": 0.0
    },
    {
      "from": 15.54,
      "to": 17.44,
      "sid": 11,
      "location": 2,
      "content": "Drop in a smoke",
      "music": 0.0
    },
    {
      "from": 22.18,
      "to": 26.94,
      "sid": 12,
      "location": 2,
      "content": "包点包点里边一个卧槽",
      "music": 0.0
    },
    {
      "from": 34.4,
      "to": 35.74,
      "sid": 13,
      "location": 2,
      "content": "唉残了他残了",
      "music": 0.0
    },
    {
      "from": 35.74,
      "to": 37.64,
      "sid": 14,
      "location": 2,
      "content": "等下我点我点吸一口",
      "music": 0.0
    },
    {
      "from": 37.64,
      "to": 38.92,
      "sid": 15,
      "location": 2,
      "content": "吸进一口",
      "music": 0.0
    },
    {
      "from": 39.83,
      "to": 41.09,
      "sid": 16,
      "location": 2,
      "content": "哎我操",
      "music": 0.0
    },
    {
      "from": 41.09,
      "to": 43.09,
      "sid": 17,
      "location": 2,
      "content": "我先直接来说重点吧",
      "music": 0.0
    },
    {
      "from": 43.09,
      "to": 44.15,
      "sid": 18,
      "location": 2,
      "content": "这里我是没明白",
      "music": 0.0
    },
    {
      "from": 44.15,
      "to": 44.79,
      "sid": 19,
      "location": 2,
      "content": "包点技能后",
      "music": 0.0
    },
    {
      "from": 44.79,
      "to": 46.23,
      "sid": 20,
      "location": 2,
      "content": "你会给一个这样的隔断",
      "music": 0.0
    },
    {
      "from": 46.23,
      "to": 48.25,
      "sid": 21,
      "location": 2,
      "content": "我们先来看看这个烟是什么样的",
      "music": 0.0
    },
    {
      "from": 48.25,
      "to": 50.43,
      "sid": 22,
      "location": 2,
      "content": "我能理解为你是想帮包点的RA吗",
      "music": 0.0
    },
    {
      "from": 50.43,
      "to": 53.37,
      "sid": 23,
      "location": 2,
      "content": "就是想防止RINA被双拉还是什么原因",
      "music": 0.0
    },
    {
      "from": 53.37,
      "to": 55.69,
      "sid": 24,
      "location": 2,
      "content": "但是RANA这里本身是有一个掩体在的",
      "music": 0.0
    },
    {
      "from": 55.69,
      "to": 56.49,
      "sid": 25,
      "location": 2,
      "content": "左侧的人",
      "music": 0.0
    },
    {
      "from": 56.49,
      "to": 58.51,
      "sid": 26,
      "location": 2,
      "content": "除非贴到近点或者RAINA给身位",
      "music": 0.0
    },
    {
      "from": 58.51,
      "to": 59.99,
      "sid": 27,
      "location": 2,
      "content": "不然是打不到瑞纳的",
      "music": 0.0
    },
    {
      "from": 59.99,
      "to": 61.83,
      "sid": 28,
      "location": 2,
      "content": "这里瑞娜本身就有拉扯空间",
      "music": 0.0
    },
    {
      "from": 61.83,
      "to": 63.47,
      "sid": 29,
      "location": 2,
      "content": "那如果你不是想给到瑞纳",
      "music": 0.0
    },
    {
      "from": 63.47,
      "to": 65.03,
      "sid": 30,
      "location": 2,
      "content": "也是想给自己回防用",
      "music": 0.0
    },
    {
      "from": 65.03,
      "to": 66.41,
      "sid": 31,
      "location": 2,
      "content": "我就更想不明白了",
      "music": 0.0
    },
    {
      "from": 66.41,
      "to": 68.29,
      "sid": 32,
      "location": 2,
      "content": "这是一颗左右两边都漏风的烟",
      "music": 0.0
    },
    {
      "from": 68.29,
      "to": 70.93,
      "sid": 33,
      "location": 2,
      "content": "也就是说你第一时间既不能补到包点的枪",
      "music": 0.0
    },
    {
      "from": 70.93,
      "to": 72.55,
      "sid": 34,
      "location": 2,
      "content": "也不能看到左侧的人",
      "music": 0.0
    },
    {
      "from": 72.55,
      "to": 74.21,
      "sid": 35,
      "location": 2,
      "content": "同时因为两边都有缝",
      "music": 0.0
    },
    {
      "from": 74.21,
      "to": 75.87,
      "sid": 36,
      "location": 2,
      "content": "看左看右都不利于发挥",
      "music": 0.0
    },
    {
      "from": 75.87,
      "to": 77.17,
      "sid": 37,
      "location": 2,
      "content": "我们要给包点的隔断",
      "music": 0.0
    },
    {
      "from": 77.17,
      "to": 79.82,
      "sid": 38,
      "location": 2,
      "content": "应该是给一颗能隔断包点左侧含B大的烟",
      "music": 0.0
    },
    {
      "from": 79.82,
      "to": 82.72,
      "sid": 39,
      "location": 2,
      "content": "这个烟不仅可以让la几乎不用担忧左边的敌人",
      "music": 0.0
    },
    {
      "from": 82.72,
      "to": 84.1,
      "sid": 40,
      "location": 2,
      "content": "同时在你回防的时候",
      "music": 0.0
    },
    {
      "from": 84.1,
      "to": 86.02,
      "sid": 41,
      "location": 2,
      "content": "你还可以和着你的队友形成双枪线",
      "music": 0.0
    },
    {
      "from": 86.02,
      "to": 87.08,
      "sid": 42,
      "location": 2,
      "content": "去打包点右侧",
      "music": 0.0
    },
    {
      "from": 87.08,
      "to": 88.08,
      "sid": 43,
      "location": 2,
      "content": "而你给的这颗烟",
      "music": 0.0
    },
    {
      "from": 88.08,
      "to": 90.52,
      "sid": 44,
      "location": 2,
      "content": "说实话我确实没想明白你的目的是什么",
      "music": 0.0
    },
    {
      "from": 90.52,
      "to": 92.23,
      "sid": 45,
      "location": 2,
      "content": "同时后面你也可以看到",
      "music": 0.0
    },
    {
      "from": 92.23,
      "to": 93.11,
      "sid": 46,
      "location": 2,
      "content": "因为这颗烟",
      "music": 0.0
    },
    {
      "from": 93.11,
      "to": 95.37,
      "sid": 47,
      "location": 2,
      "content": "直接导致你明明有一个信息上的优势",
      "music": 0.0
    },
    {
      "from": 95.37,
      "to": 96.65,
      "sid": 48,
      "location": 2,
      "content": "却因为软掩体的存在",
      "music": 0.0
    },
    {
      "from": 96.65,
      "to": 97.93,
      "sid": 49,
      "location": 2,
      "content": "根本没法达到解封",
      "music": 0.0
    },
    {
      "from": 97.93,
      "to": 99.85,
      "sid": 50,
      "location": 2,
      "content": "再者就是你说你瞄准没问题",
      "music": 0.0
    },
    {
      "from": 99.85,
      "to": 101.69,
      "sid": 51,
      "location": 2,
      "content": "关于这一点",
      "music": 0.0
    },
    {
      "from": 106.139,
      "to": 108.079,
      "sid": 52,
      "location": 2,
      "content": "唉残了他残了",
      "music": 0.0
    },
    {
      "from": 108.079,
      "to": 110.819,
      "sid": 53,
      "location": 2,
      "content": "包点包点吸一口吸吸一口",
      "music": 0.0
    },
    {
      "from": 111.5,
      "to": 112.62,
      "sid": 54,
      "location": 2,
      "content": "我实在没法认可",
      "music": 0.0
    },
    {
      "from": 112.62,
      "to": 113.94,
      "sid": 55,
      "location": 2,
      "content": "你说的瞄准没问题",
      "music": 0.0
    },
    {
      "from": 113.94,
      "to": 115.1,
      "sid": 56,
      "location": 2,
      "content": "你开枪非常急",
      "music": 0.0
    },
    {
      "from": 115.1,
      "to": 118.02,
      "sid": 57,
      "location": 2,
      "content": "的确你头线预瞄这些都没什么太大问题",
      "music": 0.0
    },
    {
      "from": 118.02,
      "to": 119.36,
      "sid": 58,
      "location": 2,
      "content": "但你知道有多急吗",
      "music": 0.0
    },
    {
      "from": 119.36,
      "to": 122.1,
      "sid": 59,
      "location": 2,
      "content": "就是几道生怕别人下一发就直接把你秒了",
      "music": 0.0
    },
    {
      "from": 122.1,
      "to": 123.06,
      "sid": 60,
      "location": 2,
      "content": "停也没停住",
      "music": 0.0
    },
    {
      "from": 123.06,
      "to": 124.52,
      "sid": 61,
      "location": 2,
      "content": "打几发就要上子弹",
      "music": 0.0
    },
    {
      "from": 124.52,
      "to": 126.26,
      "sid": 62,
      "location": 2,
      "content": "残局这种情况剩你一个",
      "music": 0.0
    },
    {
      "from": 126.26,
      "to": 127.58,
      "sid": 63,
      "location": 2,
      "content": "你边打边换子弹",
      "music": 0.0
    },
    {
      "from": 127.58,
      "to": 129.38,
      "sid": 64,
      "location": 2,
      "content": "你知道会漏多少胎命吗",
      "music": 0.0
    },
    {
      "from": 129.38,
      "to": 130.72,
      "sid": 65,
      "location": 2,
      "content": "你哪怕打的没子弹了",
      "music": 0.0
    },
    {
      "from": 130.72,
      "to": 131.54,
      "sid": 66,
      "location": 2,
      "content": "地上全是枪",
      "music": 0.0
    },
    {
      "from": 131.54,
      "to": 133.5,
      "sid": 67,
      "location": 2,
      "content": "直接换枪都比你这样玩要少很多",
      "music": 0.0
    },
    {
      "from": 133.5,
      "to": 134.02,
      "sid": 68,
      "location": 2,
      "content": "Timing",
      "music": 0.0
    },
    {
      "from": 134.02,
      "to": 136.6,
      "sid": 69,
      "location": 2,
      "content": "更别说这里你最终明明有三次开枪机会",
      "music": 0.0
    },
    {
      "from": 136.6,
      "to": 137.86,
      "sid": 70,
      "location": 2,
      "content": "结果只打了杰方一枪",
      "music": 0.0
    },
    {
      "from": 137.86,
      "to": 139.46,
      "sid": 71,
      "location": 2,
      "content": "身体目前第一分看下来",
      "music": 0.0
    },
    {
      "from": 139.46,
      "to": 141.759,
      "sid": 72,
      "location": 2,
      "content": "我的评价是对烟位的理解还不够",
      "music": 0.0
    },
    {
      "from": 141.759,
      "to": 142.779,
      "sid": 73,
      "location": 2,
      "content": "心态也不稳",
      "music": 0.0
    },
    {
      "from": 142.779,
      "to": 145.959,
      "sid": 74,
      "location": 2,
      "content": "我们再看后面现在怎么玩",
      "music": 0.0
    },
    {
      "from": 149.46,
      "to": 151.92,
      "sid": 75,
      "location": 2,
      "content": "啊这里我简单一句带过吧",
      "music": 0.0
    },
    {
      "from": 151.92,
      "to": 153.22,
      "sid": 76,
      "location": 2,
      "content": "毕竟是ECO局",
      "music": 0.0
    },
    {
      "from": 153.22,
      "to": 154.54,
      "sid": 77,
      "location": 2,
      "content": "像这种你还扔了两个人",
      "music": 0.0
    },
    {
      "from": 154.54,
      "to": 155.74,
      "sid": 78,
      "location": 2,
      "content": "180度站位",
      "music": 0.0
    },
    {
      "from": 155.74,
      "to": 157.1,
      "sid": 79,
      "location": 2,
      "content": "对方还给了烟的时候",
      "music": 0.0
    },
    {
      "from": 157.1,
      "to": 159.7,
      "sid": 80,
      "location": 2,
      "content": "你可以开麦喊他说一起钻烟里是标配",
      "music": 0.0
    },
    {
      "from": 159.7,
      "to": 161.079,
      "sid": 81,
      "location": 2,
      "content": "你直接跳烟三连发",
      "music": 0.0
    },
    {
      "from": 161.079,
      "to": 161.879,
      "sid": 82,
      "location": 2,
      "content": "他是标配",
      "music": 0.0
    },
    {
      "from": 161.879,
      "to": 163.579,
      "sid": 83,
      "location": 2,
      "content": "也可以和你一起跳烟三连发",
      "music": 0.0
    },
    {
      "from": 163.579,
      "to": 165.47,
      "sid": 84,
      "location": 2,
      "content": "这样也许不会说这一分能赢",
      "music": 0.0
    },
    {
      "from": 165.47,
      "to": 166.95,
      "sid": 85,
      "location": 2,
      "content": "但下一次遇到这种情况",
      "music": 0.0
    },
    {
      "from": 166.95,
      "to": 168.47,
      "sid": 86,
      "location": 2,
      "content": "你就不会疑惑该怎么办了",
      "music": 0.0
    },
    {
      "from": 168.47,
      "to": 171.31,
      "sid": 87,
      "location": 2,
      "content": "当然证明你的专研是没问题的",
      "music": 0.0
    },
    {
      "from": 173.58,
      "to": 174.38,
      "sid": 88,
      "location": 2,
      "content": "但也很明显",
      "music": 0.0
    },
    {
      "from": 174.38,
      "to": 174.9,
      "sid": 89,
      "location": 2,
      "content": "你能看到",
      "music": 0.0
    },
    {
      "from": 174.9,
      "to": 176.68,
      "sid": 90,
      "location": 2,
      "content": "即便你烟尊的也没什么问题",
      "music": 0.0
    },
    {
      "from": 176.68,
      "to": 177.9,
      "sid": 91,
      "location": 2,
      "content": "但是没有提前上浪",
      "music": 0.0
    },
    {
      "from": 177.9,
      "to": 179.26,
      "sid": 92,
      "location": 2,
      "content": "导致你白给了瑞纳",
      "music": 0.0
    },
    {
      "from": 179.26,
      "to": 181.67,
      "sid": 93,
      "location": 2,
      "content": "也去不了干嘛呢",
      "music": 0.0
    },
    {
      "from": 181.67,
      "to": 184.41,
      "sid": 94,
      "location": 2,
      "content": "这里客观评价你的动作没问题",
      "music": 0.0
    },
    {
      "from": 184.41,
      "to": 186.26,
      "sid": 95,
      "location": 2,
      "content": "但你少了点和队友的沟通",
      "music": 0.0
    },
    {
      "from": 186.26,
      "to": 188.0,
      "sid": 96,
      "location": 2,
      "content": "任何细节都关乎你的提升",
      "music": 0.0
    },
    {
      "from": 188.0,
      "to": 190.3,
      "sid": 97,
      "location": 2,
      "content": "因为下一次你的队友也许比你会玩",
      "music": 0.0
    },
    {
      "from": 190.3,
      "to": 191.79,
      "sid": 98,
      "location": 2,
      "content": "比你更懂应该怎么打",
      "music": 0.0
    },
    {
      "from": 191.79,
      "to": 193.11,
      "sid": 99,
      "location": 2,
      "content": "所以为什么不尝试一下",
      "music": 0.0
    },
    {
      "from": 193.11,
      "to": 195.42,
      "sid": 100,
      "location": 2,
      "content": "先成为那个更会玩的人",
      "music": 0.0
    },
    {
      "from": 196.02,
      "to": 197.66,
      "sid": 101,
      "location": 2,
      "content": "然后是离对方近的点",
      "music": 0.0
    },
    {
      "from": 197.66,
      "to": 199.34,
      "sid": 102,
      "location": 2,
      "content": "你还是给了这样一个隔断",
      "music": 0.0
    },
    {
      "from": 199.34,
      "to": 200.4,
      "sid": 103,
      "location": 2,
      "content": "我查了一下",
      "music": 0.0
    },
    {
      "from": 200.4,
      "to": 202.76,
      "sid": 104,
      "location": 2,
      "content": "有博主教学过B包点的防守隔断",
      "music": 0.0
    },
    {
      "from": 202.76,
      "to": 204.0,
      "sid": 105,
      "location": 2,
      "content": "但是经过确认",
      "music": 0.0
    },
    {
      "from": 204.0,
      "to": 205.68,
      "sid": 106,
      "location": 2,
      "content": "他们当时发的那个隔断烟",
      "music": 0.0
    },
    {
      "from": 205.68,
      "to": 207.4,
      "sid": 107,
      "location": 2,
      "content": "是由税的库改版之前的",
      "music": 0.0
    },
    {
      "from": 207.4,
      "to": 209.04,
      "sid": 108,
      "location": 2,
      "content": "然后是包点人都没了",
      "music": 0.0
    },
    {
      "from": 209.04,
      "to": 210.47,
      "sid": 109,
      "location": 2,
      "content": "你给的也还是这个烟",
      "music": 0.0
    },
    {
      "from": 210.47,
      "to": 211.07,
