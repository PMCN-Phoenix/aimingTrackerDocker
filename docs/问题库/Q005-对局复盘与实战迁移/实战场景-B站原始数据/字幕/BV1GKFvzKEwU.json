{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.08,
      "to": 2.98,
      "sid": 1,
      "location": 2,
      "content": "泡在训练场和练枪软件里的时间比所有人都长",
      "music": 0.0
    },
    {
      "from": 2.98,
      "to": 4.92,
      "sid": 2,
      "location": 2,
      "content": "但排位里却仍然力不从心",
      "music": 0.0
    },
    {
      "from": 4.92,
      "to": 6.92,
      "sid": 3,
      "location": 2,
      "content": "明明练枪的成绩一天比一天高",
      "music": 0.0
    },
    {
      "from": 6.92,
      "to": 9.24,
      "sid": 4,
      "location": 2,
      "content": "但实战里双方互相摆设的时候",
      "music": 0.0
    },
    {
      "from": 9.24,
      "to": 10.74,
      "sid": 5,
      "location": 2,
      "content": "输的人却一定是你",
      "music": 0.0
    },
    {
      "from": 10.74,
      "to": 11.8,
      "sid": 6,
      "location": 2,
      "content": "敌人拉出来柯秒",
      "music": 0.0
    },
    {
      "from": 11.8,
      "to": 12.72,
      "sid": 7,
      "location": 2,
      "content": "像是在跑打",
      "music": 0.0
    },
    {
      "from": 12.72,
      "to": 13.76,
      "sid": 8,
      "location": 2,
      "content": "开枪又快又准",
      "music": 0.0
    },
    {
      "from": 13.76,
      "to": 15.6,
      "sid": 9,
      "location": 2,
      "content": "而你却始终无法学会",
      "music": 0.0
    },
    {
      "from": 15.6,
      "to": 16.74,
      "sid": 10,
      "location": 2,
      "content": "别再苦练右手了",
      "music": 0.0
    },
    {
      "from": 16.74,
      "to": 19.64,
      "sid": 11,
      "location": 2,
      "content": "你的左右手协同或许才是你问题的根源",
      "music": 0.0
    },
    {
      "from": 19.64,
      "to": 22.08,
      "sid": 12,
      "location": 2,
      "content": "要知道你在练枪软件里的瞄准",
      "music": 0.0
    },
    {
      "from": 22.08,
      "to": 24.98,
      "sid": 13,
      "location": 2,
      "content": "你的自身是没有移动这个概念的",
      "music": 0.0
    },
    {
      "from": 24.98,
      "to": 28.38,
      "sid": 14,
      "location": 2,
      "content": "此时你准心的控制权完全交由你的右手",
      "music": 0.0
    },
    {
      "from": 28.38,
      "to": 29.42,
      "sid": 15,
      "location": 2,
      "content": "在实战中",
      "music": 0.0
    },
    {
      "from": 29.42,
      "to": 31.74,
      "sid": 16,
      "location": 2,
      "content": "我们的瞄准需要配合上自身的移动",
      "music": 0.0
    },
    {
      "from": 31.74,
      "to": 33.5,
      "sid": 17,
      "location": 2,
      "content": "所以盲目的苦练右手瞄准",
      "music": 0.0
    },
    {
      "from": 33.5,
      "to": 36.15,
      "sid": 18,
      "location": 2,
      "content": "会导致你忽略掉左手移动补偿的熟练度",
      "music": 0.0
    },
    {
      "from": 36.15,
      "to": 38.19,
      "sid": 19,
      "location": 2,
      "content": "最终左右手协同出现失衡",
      "music": 0.0
    },
    {
      "from": 38.19,
      "to": 41.98,
      "sid": 20,
      "location": 2,
      "content": "你在实战中的瞄准步骤会变为拉出急停",
      "music": 0.0
    },
    {
      "from": 41.98,
      "to": 43.56,
      "sid": 21,
      "location": 2,
      "content": "瞄准开枪",
      "music": 0.0
    },
    {
      "from": 43.56,
      "to": 46.6,
      "sid": 22,
      "location": 2,
      "content": "这会导致你在瞄准之前先几点",
      "music": 0.0
    },
    {
      "from": 46.6,
      "to": 49.43,
      "sid": 23,
      "location": 2,
      "content": "代表着你的头部是不移动的固定靶",
      "music": 0.0
    },
    {
      "from": 49.43,
      "to": 51.79,
      "sid": 24,
      "location": 2,
      "content": "而敌人在移动的同时瞄准",
      "music": 0.0
    },
    {
      "from": 51.79,
      "to": 52.09,
      "sid": 25,
      "location": 2,
      "content": "你",
      "music": 0.0
    },
    {
      "from": 52.09,
      "to": 55.21,
      "sid": 26,
      "location": 2,
      "content": "也就代表着他在给你增加瞄准难度的同时",
      "music": 0.0
    },
    {
      "from": 55.21,
      "to": 56.7,
      "sid": 27,
      "location": 2,
      "content": "瞄的还比你快",
      "music": 0.0
    },
    {
      "from": 56.7,
      "to": 59.28,
      "sid": 28,
      "location": 2,
      "content": "所以我们不难看出双方互相摆设",
      "music": 0.0
    },
    {
      "from": 59.28,
      "to": 60.96,
      "sid": 29,
      "location": 2,
      "content": "你却经常打不过敌人的原因",
      "music": 0.0
    },
    {
      "from": 60.96,
      "to": 62.74,
      "sid": 30,
      "location": 2,
      "content": "并不是因为你的右手不够准",
      "music": 0.0
    },
    {
      "from": 62.74,
      "to": 64.7,
      "sid": 31,
      "location": 2,
      "content": "而是因为你移动补偿的熟练度",
      "music": 0.0
    },
    {
      "from": 64.7,
      "to": 66.16,
      "sid": 32,
      "location": 2,
      "content": "和左右手的协调性不高",
      "music": 0.0
    },
    {
      "from": 66.16,
      "to": 67.54,
      "sid": 33,
      "location": 2,
      "content": "导致的对枪胜率低下",
      "music": 0.0
    },
    {
      "from": 67.54,
      "to": 70.26,
      "sid": 34,
      "location": 2,
      "content": "正确的步骤应该为拉出的同时瞄准",
      "music": 0.0
    },
    {
      "from": 70.26,
      "to": 71.48,
      "sid": 35,
      "location": 2,
      "content": "急停的瞬间开枪",
      "music": 0.0
    },
    {
      "from": 71.48,
      "to": 74.96,
      "sid": 36,
      "location": 2,
      "content": "也就是要做到在自身移动的同时进行瞄准",
      "music": 0.0
    },
    {
      "from": 74.96,
      "to": 77.87,
      "sid": 37,
      "location": 2,
      "content": "而你的急停只是为了开枪的那一瞬间服务",
      "music": 0.0
    },
    {
      "from": 77.87,
      "to": 81.11,
      "sid": 38,
      "location": 2,
      "content": "这也是很多人所说的此区射击的底层逻辑",
      "music": 0.0
    },
    {
      "from": 81.11,
      "to": 84.67,
      "sid": 39,
      "location": 2,
      "content": "记住这个游戏里所有的移动瞄准方式只有四种",
      "music": 0.0
    },
    {
      "from": 84.67,
      "to": 86.07,
      "sid": 40,
      "location": 2,
      "content": "左移动左拉枪",
      "music": 0.0
    },
    {
      "from": 86.07,
      "to": 86.83,
      "sid": 41,
      "location": 2,
      "content": "右移动",
      "music": 0.0
    },
    {
      "from": 86.83,
      "to": 87.57,
      "sid": 42,
      "location": 2,
      "content": "右拉枪",
      "music": 0.0
    },
    {
      "from": 87.57,
      "to": 88.33,
      "sid": 43,
      "location": 2,
      "content": "左移动",
      "music": 0.0
    },
    {
      "from": 88.33,
      "to": 89.29,
      "sid": 44,
      "location": 2,
      "content": "右拉枪",
      "music": 0.0
    },
    {
      "from": 89.29,
      "to": 90.33,
      "sid": 45,
      "location": 2,
      "content": "右移动",
      "music": 0.0
    },
    {
      "from": 90.33,
      "to": 91.41,
      "sid": 46,
      "location": 2,
      "content": "左拉枪",
      "music": 0.0
    },
    {
      "from": 91.41,
      "to": 92.29,
      "sid": 47,
      "location": 2,
      "content": "明白了原理",
      "music": 0.0
    },
    {
      "from": 92.29,
      "to": 93.84,
      "sid": 48,
      "location": 2,
      "content": "我们就可以开始练习了",
      "music": 0.0
    },
    {
      "from": 93.84,
      "to": 94.98,
      "sid": 49,
      "location": 2,
      "content": "不要急于求成",
      "music": 0.0
    },
    {
      "from": 94.98,
      "to": 97.86,
      "sid": 50,
      "location": 2,
      "content": "先用简单把确保我们的基本功没有问题",
      "music": 0.0
    },
    {
      "from": 97.86,
      "to": 99.18,
      "sid": 51,
      "location": 2,
      "content": "在简单把的场景下",
      "music": 0.0
    },
    {
      "from": 99.18,
      "to": 101.48,
      "sid": 52,
      "location": 2,
      "content": "你有充足的时间进行瞄准确认",
      "music": 0.0
    },
    {
      "from": 101.48,
      "to": 103.4,
      "sid": 53,
      "location": 2,
      "content": "所以当我们在AD移动的同时",
      "music": 0.0
    },
    {
      "from": 103.4,
      "to": 105.96,
      "sid": 54,
      "location": 2,
      "content": "瞄准靶子后移动不要停下",
      "music": 0.0
    },
    {
      "from": 105.96,
      "to": 108.24,
      "sid": 55,
      "location": 2,
      "content": "将准星保持在靶子的头部",
      "music": 0.0
    },
    {
      "from": 108.24,
      "to": 110.1,
      "sid": 56,
      "location": 2,
      "content": "持续一段时间后再开枪",
      "music": 0.0
    },
    {
      "from": 110.1,
      "to": 111.44,
      "sid": 57,
      "location": 2,
      "content": "静下心来慢慢练习",
      "music": 0.0
    },
    {
      "from": 111.44,
      "to": 112.22,
      "sid": 58,
      "location": 2,
      "content": "一段时间后",
      "music": 0.0
    },
    {
      "from": 112.22,
      "to": 114.68,
      "sid": 59,
      "location": 2,
      "content": "你一定会感觉到自己左右手协同的提高",
      "music": 0.0
    },
    {
      "from": 114.68,
      "to": 116.0,
      "sid": 60,
      "location": 2,
      "content": "如果觉得这样太简单",
      "music": 0.0
    },
    {
      "from": 116.0,
      "to": 117.88,
      "sid": 61,
      "location": 2,
      "content": "或者还想要更进一步的提升的话",
      "music": 0.0
    },
    {
      "from": 117.88,
      "to": 119.14,
      "sid": 62,
      "location": 2,
      "content": "就可以使用中等靶了",
      "music": 0.0
    },
    {
      "from": 119.14,
      "to": 121.66,
      "sid": 63,
      "location": 2,
      "content": "瞄准和移动的方式与简单码一致",
      "music": 0.0
    },
    {
      "from": 121.66,
      "to": 124.92,
      "sid": 64,
      "location": 2,
      "content": "不同的点在于中等马的速度稍微快了一些",
      "music": 0.0
    },
    {
      "from": 124.92,
      "to": 127.32,
      "sid": 65,
      "location": 2,
      "content": "会导致你无法将自己瞄准确认的过程",
      "music": 0.0
    },
    {
      "from": 127.32,
      "to": 128.8,
      "sid": 66,
      "location": 2,
      "content": "做的像简单把一样明显",
      "music": 0.0
    },
    {
      "from": 128.8,
      "to": 131.62,
      "sid": 67,
      "location": 2,
      "content": "所以我们可以加快瞄准确认的过程",
      "music": 0.0
    },
    {
      "from": 131.62,
      "to": 134.3,
      "sid": 68,
      "location": 2,
      "content": "其余练习步骤与简单版保持一致即可",
      "music": 0.0
    },
    {
      "from": 134.3,
      "to": 135.86,
      "sid": 69,
      "location": 2,
      "content": "中等靶的目标可以设定在",
      "music": 0.0
    },
    {
      "from": 135.86,
      "to": 137.74,
      "sid": 70,
      "location": 2,
      "content": "每天用这种方式打三组",
      "music": 0.0
    },
    {
      "from": 137.74,
      "to": 138.36,
      "sid": 71,
      "location": 2,
      "content": "30个",
      "music": 0.0
    },
    {
      "from": 138.36,
      "to": 140.04,
      "sid": 72,
      "location": 2,
      "content": "中途没打中也不要重来",
      "music": 0.0
    },
    {
      "from": 140.04,
      "to": 141.78,
      "sid": 73,
      "location": 2,
      "content": "随着你的熟练度越来越高",
      "music": 0.0
    },
    {
      "from": 141.78,
      "to": 144.58,
      "sid": 74,
      "location": 2,
      "content": "你的左右手协同能力也会提升的越来越明显",
      "music": 0.0
    },
    {
      "from": 144.58,
      "to": 145.44,
      "sid": 75,
      "location": 2,
      "content": "值得一提的是",
      "music": 0.0
    },
    {
      "from": 145.44,
      "to": 147.84,
      "sid": 76,
      "location": 2,
      "content": "很多人在练习简单靶和中等靶时",
      "music": 0.0
    },
    {
      "from": 147.84,
      "to": 149.84,
      "sid": 77,
      "location": 2,
      "content": "左手会下意识的AD移动",
      "music": 0.0
    },
    {
      "from": 149.84,
      "to": 151.14,
      "sid": 78,
      "location": 2,
      "content": "但当目标出现时",
      "music": 0.0
    },
    {
      "from": 151.14,
      "to": 153.04,
      "sid": 79,
      "location": 2,
      "content": "左手就不自觉的停下来了",
      "music": 0.0
    },
    {
      "from": 153.04,
      "to": 154.38,
      "sid": 80,
      "location": 2,
      "content": "我可以很负责任的告诉你",
      "music": 0.0
    },
    {
      "from": 154.38,
      "to": 155.88,
      "sid": 81,
      "location": 2,
      "content": "这样练没有任何效果",
      "music": 0.0
    },
    {
      "from": 155.88,
      "to": 158.38,
      "sid": 82,
      "location": 2,
      "content": "看似你是在配合自己的急停打靶子",
      "music": 0.0
    },
    {
      "from": 158.38,
      "to": 160.6,
      "sid": 83,
      "location": 2,
      "content": "实则你还是先急停后瞄准",
      "music": 0.0
    },
    {
      "from": 160.6,
      "to": 162.94,
      "sid": 84,
      "location": 2,
      "content": "那这样的练习方式跟你站在原地瞄",
      "music": 0.0
    },
    {
      "from": 162.94,
      "to": 164.64,
      "sid": 85,
      "location": 2,
      "content": "几乎可以说是没有任何区别",
      "music": 0.0
    },
    {
      "from": 164.64,
      "to": 166.46,
      "sid": 86,
      "location": 2,
      "content": "记住这种练习方式的五个要素",
      "music": 0.0
    },
    {
      "from": 166.46,
      "to": 167.82,
      "sid": 87,
      "location": 2,
      "content": "一瞄准好",
      "music": 0.0
    },
    {
      "from": 167.82,
      "to": 169.52,
      "sid": 88,
      "location": 2,
      "content": "感觉能中再停下来开枪",
      "music": 0.0
    },
    {
      "from": 169.52,
      "to": 172.71,
      "sid": 89,
      "location": 2,
      "content": "二禁止看到机器人以后停下瞄准",
      "music": 0.0
    },
    {
      "from": 172.71,
      "to": 175.81,
      "sid": 90,
      "location": 2,
      "content": "三禁止完全依靠移动补偿瞄准",
      "music": 0.0
    },
    {
      "from": 175.81,
      "to": 178.63,
      "sid": 91,
      "location": 2,
      "content": "四禁止在没有确认好之间开枪",
      "music": 0.0
    },
    {
      "from": 178.63,
      "to": 181.95,
      "sid": 92,
      "location": 2,
      "content": "五瞄准做确认的过程中不允许停下",
      "music": 0.0
    },
    {
      "from": 181.95,
      "to": 183.99,
      "sid": 93,
      "location": 2,
      "content": "以上就是很多人在练习的时候",
      "music": 0.0
    },
    {
      "from": 183.99,
      "to": 185.44,
      "sid": 94,
      "location": 2,
      "content": "都没有注意到的问题",
      "music": 0.0
    },
    {
      "from": 185.44,
      "to": 187.44,
      "sid": 95,
      "location": 2,
      "content": "希望看到这里的你可以规避掉这一点",
      "music": 0.0
    },
    {
      "from": 187.44,
      "to": 189.14,
      "sid": 96,
      "location": 2,
      "content": "那么本期视频的内容就到这里了",
      "music": 0.0
    },
    {
      "from": 189.14,
      "to": 190.3,
      "sid": 97,
      "location": 2,
      "content": "我们下期视频再见",
      "music": 0.0
    }
  ]
}