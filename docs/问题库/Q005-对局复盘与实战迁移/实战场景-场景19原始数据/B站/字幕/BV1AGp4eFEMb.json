{
  "bvid": "BV1AGp4eFEMb",
  "lan": "ai-zh",
  "title": "[无畏契约] 状态经常不好？心态总是消极？来帮你调整调整 -帮你突破瓶颈-第六期",
  "owner": "暗辰の薄明",
  "duration": 409,
  "body": [
    {
      "from": 1.46,
      "to": 3.78,
      "sid": 1,
      "location": 2,
      "content": "其实很多玩家在提升的过程中",
      "music": 0.0
    },
    {
      "from": 3.78,
      "to": 5.46,
      "sid": 2,
      "location": 2,
      "content": "很容易忽略这个问题",
      "music": 0.0
    },
    {
      "from": 5.46,
      "to": 7.54,
      "sid": 3,
      "location": 2,
      "content": "就是在无畏契约这个游戏里",
      "music": 0.0
    },
    {
      "from": 7.54,
      "to": 9.56,
      "sid": 4,
      "location": 2,
      "content": "你当前处于瓶颈期的原因",
      "music": 0.0
    },
    {
      "from": 9.56,
      "to": 12.42,
      "sid": 5,
      "location": 2,
      "content": "也许并不是意识或者枪法出了问题",
      "music": 0.0
    },
    {
      "from": 12.42,
      "to": 14.48,
      "sid": 6,
      "location": 2,
      "content": "而是出现了心态问题",
      "music": 0.0
    },
    {
      "from": 14.48,
      "to": 16.34,
      "sid": 7,
      "location": 2,
      "content": "就我自己的经历而言",
      "music": 0.0
    },
    {
      "from": 16.34,
      "to": 18.62,
      "sid": 8,
      "location": 2,
      "content": "我个人就是在游戏早期时",
      "music": 0.0
    },
    {
      "from": 18.62,
      "to": 22.36,
      "sid": 9,
      "location": 2,
      "content": "自从想通了该以什么样的心态进行游戏之后",
      "music": 0.0
    },
    {
      "from": 22.36,
      "to": 23.74,
      "sid": 10,
      "location": 2,
      "content": "才开始大幅提升",
      "music": 0.0
    },
    {
      "from": 23.74,
      "to": 26.68,
      "sid": 11,
      "location": 2,
      "content": "而且不再有过多的挣扎和坐牢感",
      "music": 0.0
    },
    {
      "from": 26.68,
      "to": 30.12,
      "sid": 12,
      "location": 2,
      "content": "我现在把我的个人经验和理念分享给大家",
      "music": 0.0
    },
    {
      "from": 30.12,
      "to": 32.299,
      "sid": 13,
      "location": 2,
      "content": "希望能给大家带来点启发",
      "music": 0.0
    },
    {
      "from": 32.299,
      "to": 35.539,
      "sid": 14,
      "location": 2,
      "content": "我把可能出现的心态问题归于两点",
      "music": 0.0
    },
    {
      "from": 35.539,
      "to": 39.28,
      "sid": 15,
      "location": 2,
      "content": "第一点我该以怎样的心态看待自己",
      "music": 0.0
    },
    {
      "from": 39.28,
      "to": 43.26,
      "sid": 16,
      "location": 2,
      "content": "第二点我该以怎样的心态对待队友和对手",
      "music": 0.0
    },
    {
      "from": 43.26,
      "to": 45.12,
      "sid": 17,
      "location": 2,
      "content": "其实对于第一个点来说",
      "music": 0.0
    },
    {
      "from": 45.12,
      "to": 48.56,
      "sid": 18,
      "location": 2,
      "content": "陷入自我怀疑和不自信是这个游戏的玩家",
      "music": 0.0
    },
    {
      "from": 48.56,
      "to": 50.769,
      "sid": 19,
      "location": 2,
      "content": "最容易出现的心态问题",
      "music": 0.0
    },
    {
      "from": 50.769,
      "to": 52.569,
      "sid": 20,
      "location": 2,
      "content": "如何让自己自信起来",
      "music": 0.0
    },
    {
      "from": 52.569,
      "to": 54.549,
      "sid": 21,
      "location": 2,
      "content": "你要记住最重要的一点",
      "music": 0.0
    },
    {
      "from": 54.549,
      "to": 57.029,
      "sid": 22,
      "location": 2,
      "content": "那就是不论你在玩什么角色",
      "music": 0.0
    },
    {
      "from": 57.029,
      "to": 59.9,
      "sid": 23,
      "location": 2,
      "content": "想象自己在玩的就是决斗者",
      "music": 0.0
    },
    {
      "from": 59.9,
      "to": 64.14,
      "sid": 24,
      "location": 2,
      "content": "这种思想是我观看nice的打法时所受到的启发",
      "music": 0.0
    },
    {
      "from": 64.14,
      "to": 67.7,
      "sid": 25,
      "location": 2,
      "content": "这个思想也是我自己突破一段瓶颈的契机",
      "music": 0.0
    },
    {
      "from": 67.7,
      "to": 71.31,
      "sid": 26,
      "location": 2,
      "content": "因为nice的角色使用基本都是保安和蝰蛇",
      "music": 0.0
    },
    {
      "from": 71.31,
      "to": 74.07,
      "sid": 27,
      "location": 2,
      "content": "而他的燕少尉打法侵略性很强",
      "music": 0.0
    },
    {
      "from": 74.07,
      "to": 77.61,
      "sid": 28,
      "location": 2,
      "content": "完全不是躲在后面的怯战蜥蜴的那种类型",
      "music": 0.0
    },
    {
      "from": 77.61,
      "to": 80.53,
      "sid": 29,
      "location": 2,
      "content": "其实真正的瓦罗兰特就应当是这样",
      "music": 0.0
    },
    {
      "from": 80.53,
      "to": 83.89,
      "sid": 30,
      "location": 2,
      "content": "技能道具是为了创造有利于对枪的环境",
      "music": 0.0
    },
    {
      "from": 83.89,
      "to": 85.57,
      "sid": 31,
      "location": 2,
      "content": "而不是用来代替对枪",
      "music": 0.0
    },
    {
      "from": 85.57,
      "to": 87.21,
      "sid": 32,
      "location": 2,
      "content": "甚至是用来逃避对枪",
      "music": 0.0
    },
    {
      "from": 88.29,
      "to": 88.87,
      "sid": 33,
      "location": 2,
      "content": "第二点",
      "music": 0.0
    },
    {
      "from": 88.87,
      "to": 90.17,
      "sid": 34,
      "location": 2,
      "content": "我想说的是",
      "music": 0.0
    },
    {
      "from": 90.17,
      "to": 92.05,
      "sid": 35,
      "location": 2,
      "content": "在这个游戏的对局中",
      "music": 0.0
    },
    {
      "from": 92.05,
      "to": 94.95,
      "sid": 36,
      "location": 2,
      "content": "你需要始终保持着冲劲和势头",
      "music": 0.0
    },
    {
      "from": 94.95,
      "to": 98.54,
      "sid": 37,
      "location": 2,
      "content": "甚至是需要一种想碾压对面的胆魄",
      "music": 0.0
    },
    {
      "from": 98.54,
      "to": 100.72,
      "sid": 38,
      "location": 2,
      "content": "其实这几乎是任何形式",
      "music": 0.0
    },
    {
      "from": 100.72,
      "to": 103.08,
      "sid": 39,
      "location": 2,
      "content": "体育运动强者的心理共性",
      "music": 0.0
    },
    {
      "from": 103.08,
      "to": 104.68,
      "sid": 40,
      "location": 2,
      "content": "这里需要强调的是",
      "music": 0.0
    },
    {
      "from": 104.68,
      "to": 105.66,
      "sid": 41,
      "location": 2,
      "content": "这种冲劲",
      "music": 0.0
    },
    {
      "from": 105.66,
      "to": 109.5,
      "sid": 42,
      "location": 2,
      "content": "指的不是你需要用心理暗示去强行push自己",
      "music": 0.0
    },
    {
      "from": 109.5,
      "to": 110.84,
      "sid": 43,
      "location": 2,
      "content": "逼着自己去PEK",
      "music": 0.0
    },
    {
      "from": 110.84,
      "to": 111.64,
      "sid": 44,
      "location": 2,
      "content": "去对枪",
      "music": 0.0
    },
    {
      "from": 111.64,
      "to": 113.46,
      "sid": 45,
      "location": 2,
      "content": "给对面送掉人头",
      "music": 0.0
    },
    {
      "from": 113.46,
      "to": 115.28,
      "sid": 46,
      "location": 2,
      "content": "这不是真正的自信",
      "music": 0.0
    },
    {
      "from": 115.28,
      "to": 117.57,
      "sid": 47,
      "location": 2,
      "content": "这只是在假装自己有自信",
      "music": 0.0
    },
    {
      "from": 117.57,
      "to": 119.41,
      "sid": 48,
      "location": 2,
      "content": "你要做的是胆大心细",
      "music": 0.0
    },
    {
      "from": 119.41,
      "to": 123.34,
      "sid": 49,
      "location": 2,
      "content": "在能够操作的空间和时间窗口中去大胆操作",
      "music": 0.0
    },
    {
      "from": 123.34,
      "to": 124.62,
      "sid": 50,
      "location": 2,
      "content": "不要消极避战",
      "music": 0.0
    },
    {
      "from": 124.62,
      "to": 125.98,
      "sid": 51,
      "location": 2,
      "content": "也不要忽略细节",
      "music": 0.0
    },
    {
      "from": 125.98,
      "to": 127.68,
      "sid": 52,
      "location": 2,
      "content": "鲁莽行动",
      "music": 0.0
    },
    {
      "from": 127.84,
      "to": 129.94,
      "sid": 53,
      "location": 2,
      "content": "而当你面对对手时的心态",
      "music": 0.0
    },
    {
      "from": 129.94,
      "to": 132.96,
      "sid": 54,
      "location": 2,
      "content": "最重要的一点就是不要尊重对面",
      "music": 0.0
    },
    {
      "from": 132.96,
      "to": 135.78,
      "sid": 55,
      "location": 2,
      "content": "这里的意思不是说你可以乱冲乱打",
      "music": 0.0
    },
    {
      "from": 135.78,
      "to": 138.48,
      "sid": 56,
      "location": 2,
      "content": "把对面当人机来体现你的不尊重",
      "music": 0.0
    },
    {
      "from": 138.48,
      "to": 140.62,
      "sid": 57,
      "location": 2,
      "content": "这里所说的不要尊重对面",
      "music": 0.0
    },
    {
      "from": 140.62,
      "to": 143.22,
      "sid": 58,
      "location": 2,
      "content": "是指不要太高估了对面的水平",
      "music": 0.0
    },
    {
      "from": 143.22,
      "to": 145.5,
      "sid": 59,
      "location": 2,
      "content": "更不要对他们产生畏惧感",
      "music": 0.0
    },
    {
      "from": 145.5,
      "to": 146.92,
      "sid": 60,
      "location": 2,
      "content": "他们不值得你尊重",
      "music": 0.0
    },
    {
      "from": 146.92,
      "to": 148.44,
      "sid": 61,
      "location": 2,
      "content": "更不值得你畏惧",
      "music": 0.0
    },
    {
      "from": 148.44,
      "to": 150.48,
      "sid": 62,
      "location": 2,
      "content": "我知道在这个游戏里",
      "music": 0.0
    },
    {
      "from": 150.48,
      "to": 152.14,
      "sid": 63,
      "location": 2,
      "content": "这种畏惧感的通常来源",
      "music": 0.0
    },
    {
      "from": 152.14,
      "to": 154.79,
      "sid": 64,
      "location": 2,
      "content": "是感觉自己总是被对面一枪头",
      "music": 0.0
    },
    {
      "from": 154.79,
      "to": 157.46,
      "sid": 65,
      "location": 2,
      "content": "尤其是一些钻石以下的中低端玩家",
      "music": 0.0
    },
    {
      "from": 157.46,
      "to": 159.86,
      "sid": 66,
      "location": 2,
      "content": "很容易产生这种对枪畏惧感",
      "music": 0.0
    },
    {
      "from": 159.86,
      "to": 162.38,
      "sid": 67,
      "location": 2,
      "content": "而且有很多玩家很喜欢强调",
      "music": 0.0
    },
    {
      "from": 162.38,
      "to": 166.23,
      "sid": 68,
      "location": 2,
      "content": "说我的白银对手总是能拉出来把我一枪头",
      "music": 0.0
    },
    {
      "from": 166.23,
      "to": 168.49,
      "sid": 69,
      "location": 2,
      "content": "事实上即便是神话玩家",
      "music": 0.0
    },
    {
      "from": 168.49,
      "to": 170.43,
      "sid": 70,
      "location": 2,
      "content": "也不能保持这种秒杀能力",
      "music": 0.0
    },
    {
      "from": 170.43,
      "to": 174.01,
      "sid": 71,
      "location": 2,
      "content": "你的这种感觉大概率是对偶发事件的过度臆想",
      "music": 0.0
    },
    {
      "from": 174.01,
      "to": 175.41,
      "sid": 72,
      "location": 2,
      "content": "你越害怕被一发",
      "music": 0.0
    },
    {
      "from": 175.41,
      "to": 178.13,
      "sid": 73,
      "location": 2,
      "content": "就越是相信对面会把你一发带走",
      "music": 0.0
    },
    {
      "from": 178.13,
      "to": 180.01,
      "sid": 74,
      "location": 2,
      "content": "当你被偶尔一发带走后",
      "music": 0.0
    },
    {
      "from": 180.01,
      "to": 183.13,
      "sid": 75,
      "location": 2,
      "content": "你的猜想就像是得到了佐证似的之后",
      "music": 0.0
    },
    {
      "from": 183.13,
      "to": 185.21,
      "sid": 76,
      "location": 2,
      "content": "你就会更加畏惧去对枪",
      "music": 0.0
    },
    {
      "from": 185.21,
      "to": 186.45,
      "sid": 77,
      "location": 2,
      "content": "然而事实上",
      "music": 0.0
    },
    {
      "from": 186.45,
      "to": 188.01,
      "sid": 78,
      "location": 2,
      "content": "只要你肯复盘回放",
      "music": 0.0
    },
    {
      "from": 188.01,
      "to": 191.8,
      "sid": 79,
      "location": 2,
      "content": "会发现这种被一发的情况并没有想象的那么多",
      "music": 0.0
    },
    {
      "from": 191.8,
      "to": 194.24,
      "sid": 80,
      "location": 2,
      "content": "而且对面打中你头部的速度",
      "music": 0.0
    },
    {
      "from": 194.24,
      "to": 196.34,
      "sid": 81,
      "location": 2,
      "content": "也不像你当时感受中那么快",
      "music": 0.0
    },
    {
      "from": 196.34,
      "to": 198.5,
      "sid": 82,
      "location": 2,
      "content": "其实大部分时候有这种感觉",
      "music": 0.0
    },
    {
      "from": 198.5,
      "to": 201.42,
      "sid": 83,
      "location": 2,
      "content": "只是因为你和他双方的注意力不对等",
      "music": 0.0
    },
    {
      "from": 201.42,
      "to": 203.81,
      "sid": 84,
      "location": 2,
      "content": "和位置信息不对等造成的",
      "music": 0.0
    },
    {
      "from": 203.81,
      "to": 206.11,
      "sid": 85,
      "location": 2,
      "content": "如果你真的是连枪也没开出来",
      "music": 0.0
    },
    {
      "from": 206.11,
      "to": 207.28,
      "sid": 86,
      "location": 2,
      "content": "就被一发带走",
      "music": 0.0
    },
    {
      "from": 207.28,
      "to": 208.76,
      "sid": 87,
      "location": 2,
      "content": "其实也不必沮丧",
      "music": 0.0
    },
    {
      "from": 208.76,
      "to": 211.8,
      "sid": 88,
      "location": 2,
      "content": "这种小概率事件可以归咎于运气问题",
      "music": 0.0
    },
    {
      "from": 211.8,
      "to": 215.07,
      "sid": 89,
      "location": 2,
      "content": "只要保证你自己的育苗架枪不出问题就行",
      "music": 0.0
    },
    {
      "from": 215.07,
      "to": 218.839,
      "sid": 90,
      "location": 2,
      "content": "因为你自己也会有把对面一发带走的时候",
      "music": 0.0
    },
    {
      "from": 218.839,
      "to": 221.719,
      "sid": 91,
      "location": 2,
      "content": "我最想强调的是接下来的这一点",
      "music": 0.0
    },
    {
      "from": 221.719,
      "to": 223.559,
      "sid": 92,
      "location": 2,
      "content": "你该如何看待队友",
      "music": 0.0
    },
    {
      "from": 223.559,
      "to": 226.37,
      "sid": 93,
      "location": 2,
      "content": "首先为了先保持好自己的心态",
      "music": 0.0
    },
    {
      "from": 226.37,
      "to": 228.71,
      "sid": 94,
      "location": 2,
      "content": "最好能做到和队友保持交流",
      "music": 0.0
    },
    {
      "from": 228.71,
      "to": 230.58,
      "sid": 95,
      "location": 2,
      "content": "不断询问信息和道具",
      "music": 0.0
    },
    {
      "from": 230.58,
      "to": 233.06,
      "sid": 96,
      "location": 2,
      "content": "因为爆点交流不仅能带动队友",
      "music": 0.0
    },
    {
      "from": 233.06,
      "to": 236.06,
      "sid": 97,
      "location": 2,
      "content": "更重要的是防止自己大脑思路僵化",
      "music": 0.0
    },
    {
      "from": 236.06,
      "to": 237.7,
      "sid": 98,
      "location": 2,
      "content": "你只需要多问信息",
      "music": 0.0
    },
    {
      "from": 237.7,
      "to": 239.98,
      "sid": 99,
      "location": 2,
      "content": "比如像询问有动静吗",
      "music": 0.0
    },
    {
      "from": 239.98,
      "to": 241.48,
      "sid": 100,
      "location": 2,
      "content": "必有动静吗",
      "music": 0.0
    },
    {
      "from": 241.48,
      "to": 243.74,
      "sid": 101,
      "location": 2,
      "content": "中路有动静吗这种",
      "music": 0.0
    },
    {
      "from": 243.74,
      "to": 245.84,
      "sid": 102,
      "location": 2,
      "content": "或者是问队友要烟要闪",
      "music": 0.0
    },
    {
      "from": 245.84,
      "to": 249.51,
      "sid": 103,
      "location": 2,
      "content": "请求队友过来帮忙帮你打掉探测箭等等",
      "music": 0.0
    },
    {
      "from": 249.51,
      "to": 251.53,
      "sid": 104,
      "location": 2,
      "content": "像这样频繁有效沟通",
      "music": 0.0
    },
    {
      "from": 251.53,
      "to": 253.59,
      "sid": 105,
      "location": 2,
      "content": "不仅是防止心态出问题",
      "music": 0.0
    },
    {
      "from": 253.59,
      "to": 257.01,
      "sid": 106,
      "location": 2,
      "content": "更重要的是能够让自己大脑活跃起来",
      "music": 0.0
    },
    {
      "from": 257.01,
      "to": 259.93,
      "sid": 107,
      "location": 2,
      "content": "当你察觉到自己逐渐自闭的时候",
      "music": 0.0
    },
    {
      "from": 259.93,
      "to": 262.65,
      "sid": 108,
      "location": 2,
      "content": "记得调动起来自己有想法就说",
      "music": 0.0
    },
    {
      "from": 262.65,
      "to": 263.73,
      "sid": 109,
      "location": 2,
      "content": "有疑问就问",
      "music": 0.0
    },
    {
      "from": 263.73,
      "to": 265.18,
      "sid": 110,
      "location": 2,
      "content": "有信息就报",
      "music": 0.0
    },
    {
      "from": 265.18,
      "to": 268.18,
      "sid": 111,
      "location": 2,
      "content": "不过如果你认为某些队友确实搞心态",
      "music": 0.0
    },
    {
      "from": 268.18,
      "to": 269.9,
      "sid": 112,
      "location": 2,
      "content": "该报点时候从不开麦",
      "music": 0.0
    },
    {
      "from": 269.9,
      "to": 272.1,
      "sid": 113,
      "location": 2,
      "content": "一旦开麦就是抱怨和责怪",
      "music": 0.0
    },
    {
      "from": 272.1,
      "to": 273.72,
      "sid": 114,
      "location": 2,
      "content": "那么速速将其屏蔽",
      "music": 0.0
    },
    {
      "from": 273.72,
      "to": 274.58,
      "sid": 115,
      "location": 2,
      "content": "屏蔽之后",
      "music": 0.0
    },
    {
      "from": 274.58,
      "to": 277.54,
      "sid": 116,
      "location": 2,
      "content": "这局游戏胜率立刻提高10%",
      "music": 0.0
    },
    {
      "from": 277.54,
      "to": 281.77,
      "sid": 117,
      "location": 2,
      "content": "还有一点就是如果你遇到水平明显不行的队友",
      "music": 0.0
    },
    {
      "from": 281.77,
      "to": 283.61,
      "sid": 118,
      "location": 2,
      "content": "那么抱怨将会是大忌",
      "music": 0.0
    },
    {
      "from": 283.61,
      "to": 286.62,
      "sid": 119,
      "location": 2,
      "content": "这里的抱怨指的不只是嘴上抱怨",
      "music": 0.0
    },
    {
      "from": 286.62,
      "to": 288.62,
      "sid": 120,
      "location": 2,
      "content": "你的心里也切记不要抱怨",
      "music": 0.0
    },
    {
      "from": 288.62,
      "to": 289.6,
      "sid": 121,
      "location": 2,
      "content": "更多的抱怨",
      "music": 0.0
    },
    {
      "from": 289.6,
      "to": 291.7,
      "sid": 122,
      "location": 2,
      "content": "不会让自己水平更快增长",
      "music": 0.0
    },
    {
      "from": 291.7,
      "to": 293.84,
      "sid": 123,
      "location": 2,
      "content": "更不会让游戏胜率变高",
      "music": 0.0
    },
    {
      "from": 293.84,
      "to": 295.54,
      "sid": 124,
      "location": 2,
      "content": "因为这里有一个事实",
      "music": 0.0
    },
    {
      "from": 295.54,
      "to": 298.38,
      "sid": 125,
      "location": 2,
      "content": "就是只要你玩的游戏局数足够多",
      "music": 0.0
    },
    {
      "from": 298.38,
      "to": 301.62,
      "sid": 126,
      "location": 2,
      "content": "你就一定会遇到水平参差不齐的队友",
      "music": 0.0
    },
    {
      "from": 301.62,
      "to": 303.08,
      "sid": 127,
      "location": 2,
      "content": "你玩的场次越多",
      "music": 0.0
    },
    {
      "from": 303.08,
      "to": 304.84,
      "sid": 128,
      "location": 2,
      "content": "你遇到的就一定越多",
      "music": 0.0
    },
    {
      "from": 304.84,
      "to": 306.32,
      "sid": 129,
      "location": 2,
      "content": "再加上匹配机制",
      "music": 0.0
    },
    {
      "from": 306.32,
      "to": 308.64,
      "sid": 130,
      "location": 2,
      "content": "这种情况就更加无法避免",
      "music": 0.0
    },
    {
      "from": 308.64,
      "to": 309.97,
      "sid": 131,
      "location": 2,
      "content": "抱怨无济于事",
      "music": 0.0
    },
    {
      "from": 309.97,
      "to": 312.23,
      "sid": 132,
      "location": 2,
      "content": "而唯一可能把这一手烂牌打好",
      "music": 0.0
    },
    {
      "from": 312.23,
      "to": 314.8,
      "sid": 133,
      "location": 2,
      "content": "能够逆转局势的就只有自己",
      "music": 0.0
    },
    {
      "from": 314.8,
      "to": 315.68,
      "sid": 134,
      "location": 2,
      "content": "实在不行",
      "music": 0.0
    },
    {
      "from": 315.68,
      "to": 318.8,
      "sid": 135,
      "location": 2,
      "content": "就把队友当成会随机移动的奇乐小鸡",
      "music": 0.0
    },
    {
      "from": 318.8,
      "to": 320.87,
      "sid": 136,
      "location": 2,
      "content": "帮你控图和探信息",
      "music": 0.0
    },
    {
      "from": 320.87,
      "to": 324.63,
      "sid": 137,
      "location": 2,
      "content": "所以其实我想讨论的不是你的抱怨行为",
      "music": 0.0
    },
    {
      "from": 324.63,
      "to": 326.409,
      "sid": 138,
      "location": 2,
      "content": "是否是在压力队友",
      "music": 0.0
    },
    {
      "from": 326.409,
      "to": 329.689,
      "sid": 139,
      "location": 2,
      "content": "我想说的是抱怨这种心理一旦出现",
      "music": 0.0
    },
    {
      "from": 329.689,
      "to": 331.88,
      "sid": 140,
      "location": 2,
      "content": "事实上影响的是你自己",
      "music": 0.0
    },
    {
      "from": 331.88,
      "to": 332.98,
      "sid": 141,
      "location": 2,
      "content": "抱怨的本质",
      "music": 0.0
    },
    {
      "from": 332.98,
      "to": 335.75,
      "sid": 142,
      "location": 2,
      "content": "大概是由于你对别人有所期待",
      "music": 0.0
    },
    {
      "from": 335.75,
      "to": 338.35,
      "sid": 143,
      "location": 2,
      "content": "这种想法一旦产生就是错误",
      "music": 0.0
    },
    {
      "from": 338.35,
      "to": 340.87,
      "sid": 144,
      "location": 2,
      "content": "不要把属于自己的这场对局的胜利",
      "music": 0.0
    },
    {
      "from": 340.87,
      "to": 342.94,
      "sid": 145,
      "location": 2,
      "content": "期待寄托在别人身上",
      "music": 0.0
    },
    {
      "from": 342.94,
      "to": 344.58,
      "sid": 146,
      "location": 2,
      "content": "单排是自己的游戏",
      "music": 0.0
    },
    {
      "from": 344.58,
      "to": 347.06,
      "sid": 147,
      "location": 2,
      "content": "把注意力和期待放在自己身上",
      "music": 0.0
    },
    {
      "from": 347.06,
      "to": 348.57,
      "sid": 148,
      "location": 2,
      "content": "你的队友也许是坑",
      "music": 0.0
    },
    {
      "from": 348.57,
      "to": 350.73,
      "sid": 149,
      "location": 2,
      "content": "但对手也不一定比他们更强",
      "music": 0.0
    },
    {
      "from": 350.73,
      "to": 353.03,
      "sid": 150,
      "location": 2,
      "content": "如果能够确保自己不会有失误",
      "music": 0.0
    },
    {
      "from": 353.03,
      "to": 355.03,
      "sid": 151,
      "location": 2,
      "content": "那么其实输了也无所谓",
      "music": 0.0
    },
    {
      "from": 355.03,
      "to": 356.97,
      "sid": 152,
      "location": 2,
      "content": "因为只要你的水平够强",
      "music": 0.0
    },
    {
      "from": 356.97,
      "to": 358.81,
      "sid": 153,
      "location": 2,
      "content": "你的分就自然会上",
      "music": 0.0
    },
    {
      "from": 358.81,
      "to": 361.77,
      "sid": 154,
      "location": 2,
      "content": "你若是超凡实力把你放到白银局",
      "music": 0.0
    },
    {
      "from": 361.77,
      "to": 363.39,
      "sid": 155,
      "location": 2,
      "content": "你会很自然的上分",
      "music": 0.0
    },
    {
      "from": 363.39,
      "to": 366.77,
      "sid": 156,
      "location": 2,
      "content": "你也根本不会抱怨你的白银队友打的不够好",
      "music": 0.0
    },
    {
      "from": 366.77,
      "to": 369.01,
      "sid": 157,
      "location": 2,
      "content": "因为你自己也知道他们是白银",
      "music": 0.0
    },
    {
      "from": 369.01,
      "to": 372.25,
      "sid": 158,
      "location": 2,
      "content": "你自然而然不会把期待放在他们身上",
      "music": 0.0
    },
    {
      "from": 372.25,
      "to": 374.46,
      "sid": 159,
      "location": 2,
      "content": "而到了你自己的超凡局",
      "music": 0.0
    },
    {
      "from": 374.46,
      "to": 376.64,
      "sid": 160,
      "location": 2,
      "content": "你也应当抱有同样的心态",
      "music": 0.0
    },
    {
      "from": 376.64,
      "to": 378.38,
      "sid": 161,
      "location": 2,
      "content": "想象自己本应是神话",
      "music": 0.0
    },
    {
      "from": 378.38,
      "to": 380.56,
      "sid": 162,
      "location": 2,
      "content": "要在意自己哪里做的不好",
      "music": 0.0
    },
    {
      "from": 380.56,
      "to": 381.84,
      "sid": 163,
      "location": 2,
      "content": "做的不像神话",
      "music": 0.0
    },
    {
      "from": 381.84,
      "to": 384.54,
      "sid": 164,
      "location": 2,
      "content": "而不必在意超凡队友打得怎么样",
      "music": 0.0
    },
    {
      "from": 384.54,
      "to": 388.1,
      "sid": 165,
      "location": 2,
      "content": "就像你根本不在意白银队友打得怎么样一样",
      "music": 0.0
    },
    {
      "from": 388.1,
      "to": 389.26,
      "sid": 166,
      "location": 2,
      "content": "我想说的是",
      "music": 0.0
    },
    {
      "from": 389.26,
      "to": 390.66,
      "sid": 167,
      "location": 2,
      "content": "上分的底层心态",
      "music": 0.0
    },
    {
      "from": 390.66,
      "to": 393.309,
      "sid": 168,
      "location": 2,
      "content": "不应该是贪图每一场比赛都能赢",
      "music": 0.0
    },
    {
      "from": 393.309,
      "to": 396.92,
      "sid": 169,
      "location": 2,
      "content": "而是每一场比赛都能克服一些自己之前的不足",
      "music": 0.0
    },
    {
      "from": 396.92,
      "to": 399.68,
      "sid": 170,
      "location": 2,
      "content": "并且贪婪地寻找自己新的不足之处",
      "music": 0.0
    },
    {
      "from": 399.68,
      "to": 403.36,
      "sid": 171,
      "location": 2,
      "content": "过硬的自身实力才是上分的终极密码",
      "music": 0.0
    }
  ]
}