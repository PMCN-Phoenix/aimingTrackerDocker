  "body": [
    {
      "from": 0.5,
      "to": 3.26,
      "sid": 1,
      "location": 2,
      "content": "在你感觉对面进攻意图不明显的时候",
      "music": 0.0
    },
    {
      "from": 3.26,
      "to": 5.22,
      "sid": 2,
      "location": 2,
      "content": "通常是需要信息的时候",
      "music": 0.0
    },
    {
      "from": 5.22,
      "to": 7.93,
      "sid": 3,
      "location": 2,
      "content": "可以看到这波必是有人有信息的",
      "music": 0.0
    },
    {
      "from": 7.93,
      "to": 10.03,
      "sid": 4,
      "location": 2,
      "content": "然后中路队友架了狙也没有出",
      "music": 0.0
    },
    {
      "from": 10.03,
      "to": 12.86,
      "sid": 5,
      "location": 2,
      "content": "第二时间开回溯来中路吃一下信息",
      "music": 0.0
    },
    {
      "from": 12.86,
      "to": 14.78,
      "sid": 6,
      "location": 2,
      "content": "这个时候可以看到A是有一个人",
      "music": 0.0
    },
    {
      "from": 14.78,
      "to": 16.32,
      "sid": 7,
      "location": 2,
      "content": "但是中路迟迟没有动静",
      "music": 0.0
    },
    {
      "from": 16.32,
      "to": 17.78,
      "sid": 8,
      "location": 2,
      "content": "且结合B有人的情况",
      "music": 0.0
    },
    {
      "from": 17.78,
      "to": 19.82,
      "sid": 9,
      "location": 2,
      "content": "对面这把大概率是B是大部队",
      "music": 0.0
    },
    {
      "from": 19.82,
      "to": 21.92,
      "sid": 10,
      "location": 2,
      "content": "然后A是在骗的好",
      "music": 0.0
    },
    {
      "from": 21.92,
      "to": 23.52,
      "sid": 11,
      "location": 2,
      "content": "先去逮一下A这个人",
      "music": 0.0
    },
    {
      "from": 23.52,
      "to": 27.55,
      "sid": 12,
      "location": 2,
      "content": "就是说A只有一个踢进了B进了给双烟了",
      "music": 0.0
    },
    {
      "from": 27.55,
      "to": 28.19,
      "sid": 13,
      "location": 2,
      "content": "好兵进去了",
      "music": 0.0
    },
    {
      "from": 28.19,
      "to": 29.51,
      "sid": 14,
      "location": 2,
      "content": "哎发现二一冠军三个洞",
      "music": 0.0
    },
    {
      "from": 29.51,
      "to": 30.23,
      "sid": 15,
      "location": 2,
      "content": "3B没见",
      "music": 0.0
    },
    {
      "from": 30.23,
      "to": 31.39,
      "sid": 16,
      "location": 2,
      "content": "别急",
      "music": 0.0
    },
    {
      "from": 31.86,
      "to": 34.78,
      "sid": 17,
      "location": 2,
      "content": "好队友爆三个B说没见你下包就要小心一下",
      "music": 0.0
    },
    {
      "from": 34.78,
      "to": 37.0,
      "sid": 18,
      "location": 2,
      "content": "中路下包了啊",
      "music": 0.0
    },
    {
      "from": 37.0,
      "to": 38.8,
      "sid": 19,
      "location": 2,
      "content": "走了再看一眼烟雾哦",
      "music": 0.0
    },
    {
      "from": 38.8,
      "to": 39.16,
      "sid": 20,
      "location": 2,
      "content": "没有人",
      "music": 0.0
    },
    {
      "from": 39.16,
      "to": 40.61,
      "sid": 21,
      "location": 2,
      "content": "我们直接过去",
      "music": 0.0
    },
    {
      "from": 40.61,
      "to": 42.09,
      "sid": 22,
      "location": 2,
      "content": "回防的时候没什么事干",
      "music": 0.0
    },
    {
      "from": 42.09,
      "to": 44.91,
      "sid": 23,
      "location": 2,
      "content": "眼睛盯紧小地图可以看到蝴蝶站的位置",
      "music": 0.0
    },
    {
      "from": 44.91,
      "to": 47.07,
      "sid": 24,
      "location": 2,
      "content": "可以看到有没有人从右边出去",
      "music": 0.0
    },
    {
      "from": 47.07,
      "to": 47.39,
      "sid": 25,
      "location": 2,
      "content": "好",
      "music": 0.0
    },
    {
      "from": 47.39,
      "to": 48.23,
      "sid": 26,
      "location": 2,
      "content": "左边一个杰特",
      "music": 0.0
    },
    {
      "from": 48.23,
      "to": 49.15,
      "sid": 27,
      "location": 2,
      "content": "他带出过来捡枪了",
      "music": 0.0
    },
    {
      "from": 49.15,
      "to": 50.55,
      "sid": 28,
      "location": 2,
      "content": "咱们这个回溯虽然没打到也",
      "music": 0.0
    },
    {
      "from": 50.55,
      "to": 51.51,
      "sid": 29,
      "location": 2,
      "content": "但他位置卡住了",
      "music": 0.0
    },
    {
      "from": 51.51,
      "to": 52.63,
      "sid": 30,
      "location": 2,
      "content": "所以直接拉出去标记",
      "music": 0.0
    },
    {
      "from": 52.63,
      "to": 54.8,
      "sid": 31,
      "location": 2,
      "content": "这里稍微看一眼右边就可以直接看左边了",
      "music": 0.0
    },
    {
      "from": 54.8,
      "to": 56.32,
      "sid": 32,
      "location": 2,
      "content": "哎他果然拉了",
      "music": 0.0
    },
    {
      "from": 56.32,
      "to": 58.16,
      "sid": 33,
      "location": 2,
      "content": "往这里龙树看一眼位置好",
      "music": 0.0
    },
    {
      "from": 58.16,
      "to": 59.24,
      "sid": 34,
      "location": 2,
      "content": "两个位置都确定了嘛",
      "music": 0.0
    },
    {
      "from": 59.24,
      "to": 60.06,
      "sid": 35,
      "location": 2,
      "content": "哎大招一推",
      "music": 0.0
    },
    {
      "from": 60.06,
      "to": 61.12,
      "sid": 36,
      "location": 2,
      "content": "这里卡他的位置",
      "music": 0.0
    },
    {
      "from": 61.12,
      "to": 62.36,
      "sid": 37,
      "location": 2,
      "content": "另一个也被我的大招推到",
      "music": 0.0
    },
    {
      "from": 62.36,
      "to": 64.45,
      "sid": 38,
      "location": 2,
      "content": "直接过去打就行哦",
      "music": 0.0
    },
    {
      "from": 64.45,
      "to": 66.29,
      "sid": 39,
      "location": 2,
      "content": "哦好香",
      "music": 0.0
    },
    {
      "from": 67.01,
      "to": 67.93,
      "sid": 40,
      "location": 2,
      "content": "丢睡地库",
      "music": 0.0
    },
    {
      "from": 67.93,
      "to": 68.77,
      "sid": 41,
      "location": 2,
      "content": "有大招的时候",
      "music": 0.0
    },
    {
      "from": 68.77,
      "to": 70.09,
      "sid": 42,
      "location": 2,
      "content": "一定要经常来B点看",
      "music": 0.0
    },
    {
      "from": 70.09,
      "to": 70.98,
      "sid": 43,
      "location": 2,
      "content": "不等到对面来",
      "music": 0.0
    },
    {
      "from": 70.98,
      "to": 72.18,
      "sid": 44,
      "location": 2,
      "content": "就算这里B没有打",
      "music": 0.0
    },
    {
      "from": 72.18,
      "to": 73.34,
      "sid": 45,
      "location": 2,
      "content": "我们也可以直接压出去",
      "music": 0.0
    },
    {
      "from": 73.34,
      "to": 74.4,
      "sid": 46,
      "location": 2,
      "content": "好这里二楼没见人",
      "music": 0.0
    },
    {
      "from": 74.4,
      "to": 77.12,
      "sid": 47,
      "location": 2,
      "content": "就再一配合队友的道具截掉",
      "music": 0.0
    },
    {
      "from": 77.12,
      "to": 79.64,
      "sid": 48,
      "location": 2,
      "content": "最后一个人在中路露头了",
      "music": 0.0
    },
    {
      "from": 79.64,
      "to": 80.84,
      "sid": 49,
      "location": 2,
      "content": "哎准备好跳起来",
      "music": 0.0
    },
    {
      "from": 80.84,
      "to": 81.449,
      "sid": 50,
      "location": 2,
      "content": "不要跳",
      "music": 0.0
    },
    {
      "from": 81.449,
      "to": 82.929,
      "sid": 51,
      "location": 2,
      "content": "带标甩掉",
      "music": 0.0
    },
    {
      "from": 82.929,
      "to": 85.169,
      "sid": 52,
      "location": 2,
      "content": "哎我跑我跑好",
      "music": 0.0
    },
    {
      "from": 85.169,
      "to": 87.88,
      "sid": 53,
      "location": 2,
      "content": "这一分我们单A作为单A的角色",
      "music": 0.0
    },
    {
      "from": 87.88,
      "to": 89.72,
      "sid": 54,
      "location": 2,
      "content": "就只用在包点里保护就行了",
      "music": 0.0
    },
    {
      "from": 89.72,
      "to": 90.56,
      "sid": 55,
      "location": 2,
      "content": "在这里等待哎",
      "music": 0.0
    },
    {
      "from": 90.56,
      "to": 91.4,
      "sid": 56,
      "location": 2,
      "content": "对面已经RUA进来了",
      "music": 0.0
    },
    {
      "from": 91.4,
      "to": 91.9,
      "sid": 57,
      "location": 2,
      "content": "不着急",
      "music": 0.0
    },
    {
      "from": 91.9,
      "to": 92.88,
      "sid": 58,
      "location": 2,
      "content": "队友给隔断烟了",
      "music": 0.0
    },
    {
      "from": 92.88,
      "to": 94.67,
      "sid": 59,
      "location": 2,
      "content": "第一时间先钻一下烟",
      "music": 0.0
    },
    {
      "from": 94.67,
      "to": 96.15,
      "sid": 60,
      "location": 2,
      "content": "哎右边是进来一个",
      "music": 0.0
    },
    {
      "from": 96.15,
      "to": 98.25,
      "sid": 61,
      "location": 2,
      "content": "我们看能不能找机会跟他1V1把他打掉",
      "music": 0.0
    },
    {
      "from": 98.25,
      "to": 98.71,
      "sid": 62,
      "location": 2,
      "content": "自己打掉",
      "music": 0.0
    },
    {
      "from": 98.71,
      "to": 100.44,
      "sid": 63,
      "location": 2,
      "content": "抓一下包",
      "music": 0.0
    },
    {
      "from": 100.44,
      "to": 101.02,
      "sid": 64,
      "location": 2,
      "content": "骗他一下",
      "music": 0.0
    },
    {
      "from": 101.02,
      "to": 102.32,
      "sid": 65,
      "location": 2,
      "content": "下他包了来点根烟",
      "music": 0.0
    },
    {
      "from": 102.32,
      "to": 105.13,
      "sid": 66,
      "location": 2,
      "content": "拉出去再抓一好",
      "music": 0.0
    },
    {
      "from": 105.13,
      "to": 105.89,
      "sid": 67,
      "location": 2,
      "content": "藏在烟里面",
      "music": 0.0
    },
    {
      "from": 105.89,
      "to": 108.59,
      "sid": 68,
      "location": 2,
      "content": "跟队友夹击他好成功击掉",
      "music": 0.0
    },
    {
      "from": 108.59,
      "to": 109.45,
      "sid": 69,
      "location": 2,
      "content": "感谢大家观看",
      "music": 0.0
    },
    {
      "from": 109.45,
      "to": 111.0,
      "sid": 70,
      "location": 2,
      "content": "我们下期再见",
      "music": 0.0
    }
  ]
}