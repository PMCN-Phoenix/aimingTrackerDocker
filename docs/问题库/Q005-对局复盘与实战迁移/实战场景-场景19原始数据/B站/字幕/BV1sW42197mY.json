{
  "bvid": "BV1sW42197mY",
  "lan": "ai-zh",
  "title": "【无畏契约】艾跃进教授教你消除紧张和不自信",
  "owner": "百醇pejoy-无畏契约",
  "duration": 216,
  "body": [
    {
      "from": 0.0,
      "to": 1.6,
      "sid": 1,
      "location": 2,
      "content": "15个小技巧教你上大分",
      "music": 0.0
    },
    {
      "from": 1.6,
      "to": 2.8,
      "sid": 2,
      "location": 2,
      "content": "你看我今天讲课啊",
      "music": 0.0
    },
    {
      "from": 2.8,
      "to": 3.2,
      "sid": 3,
      "location": 2,
      "content": "这么溜",
      "music": 0.0
    },
    {
      "from": 3.2,
      "to": 5.24,
      "sid": 4,
      "location": 2,
      "content": "我我曾经紧张的厉害",
      "music": 0.0
    },
    {
      "from": 5.24,
      "to": 7.36,
      "sid": 5,
      "location": 2,
      "content": "这是因为心里有私心",
      "music": 0.0
    },
    {
      "from": 7.36,
      "to": 8.66,
      "sid": 6,
      "location": 2,
      "content": "因此我要问你们",
      "music": 0.0
    },
    {
      "from": 8.66,
      "to": 10.14,
      "sid": 7,
      "location": 2,
      "content": "你们有没有这种私心",
      "music": 0.0
    },
    {
      "from": 10.14,
      "to": 11.32,
      "sid": 8,
      "location": 2,
      "content": "请真实的回答我",
      "music": 0.0
    },
    {
      "from": 11.32,
      "to": 13.88,
      "sid": 9,
      "location": 2,
      "content": "请问当众露脸的请举手",
      "music": 0.0
    },
    {
      "from": 13.88,
      "to": 14.9,
      "sid": 10,
      "location": 2,
      "content": "大家有信心",
      "music": 0.0
    },
    {
      "from": 14.9,
      "to": 16.18,
      "sid": 11,
      "location": 2,
      "content": "而是举手的有兴趣",
      "music": 0.0
    },
    {
      "from": 16.18,
      "to": 17.5,
      "sid": 12,
      "location": 2,
      "content": "第二个问题真实回答",
      "music": 0.0
    },
    {
      "from": 17.5,
      "to": 20.679,
      "sid": 13,
      "location": 2,
      "content": "我怕当众丢脸的请举手",
      "music": 0.0
    },
    {
      "from": 20.679,
      "to": 21.319,
      "sid": 14,
      "location": 2,
      "content": "更多好",
      "music": 0.0
    },
    {
      "from": 21.319,
      "to": 22.86,
      "sid": 15,
      "location": 2,
      "content": "大家有支持心",
      "music": 0.0
    },
    {
      "from": 22.86,
      "to": 25.62,
      "sid": 16,
      "location": 2,
      "content": "等下第三又想露脸",
      "music": 0.0
    },
    {
      "from": 25.62,
      "to": 27.88,
      "sid": 17,
      "location": 2,
      "content": "又怕丢脸的请举手",
      "music": 0.0
    },
    {
      "from": 27.88,
      "to": 29.22,
      "sid": 18,
      "location": 2,
      "content": "太正常了",
      "music": 0.0
    },
    {
      "from": 29.22,
      "to": 31.42,
      "sid": 19,
      "location": 2,
      "content": "你们是什么心都有",
      "music": 0.0
    },
    {
      "from": 31.9,
      "to": 33.8,
      "sid": 20,
      "location": 2,
      "content": "有没举手的吗",
      "music": 0.0
    },
    {
      "from": 33.8,
      "to": 36.06,
      "sid": 21,
      "location": 2,
      "content": "说三种三种情况都没举",
      "music": 0.0
    },
    {
      "from": 36.06,
      "to": 36.66,
      "sid": 22,
      "location": 2,
      "content": "有没有",
      "music": 0.0
    },
    {
      "from": 36.66,
      "to": 38.01,
      "sid": 23,
      "location": 2,
      "content": "恭喜各位",
      "music": 0.0
    },
    {
      "from": 38.01,
      "to": 40.71,
      "sid": 24,
      "location": 2,
      "content": "我们这班没有没心没肺的",
      "music": 0.0
    },
    {
      "from": 40.71,
      "to": 43.45,
      "sid": 25,
      "location": 2,
      "content": "这就是你紧张的根源",
      "music": 0.0
    },
    {
      "from": 43.45,
      "to": 44.629,
      "sid": 26,
      "location": 2,
      "content": "知道了吗",
      "music": 0.0
    },
    {
      "from": 44.629,
      "to": 47.069,
      "sid": 27,
      "location": 2,
      "content": "你心里背着这么重的包袱",
      "music": 0.0
    },
    {
      "from": 47.069,
      "to": 47.849,
      "sid": 28,
      "location": 2,
      "content": "又想露脸",
      "music": 0.0
    },
    {
      "from": 47.849,
      "to": 49.25,
      "sid": 29,
      "location": 2,
      "content": "又怕丢脸",
      "music": 0.0
    },
    {
      "from": 49.25,
      "to": 50.85,
      "sid": 30,
      "location": 2,
      "content": "又想露脸又怕丢脸",
      "music": 0.0
    },
    {
      "from": 50.85,
      "to": 51.79,
      "sid": 31,
      "location": 2,
      "content": "你想想",
      "music": 0.0
    },
    {
      "from": 51.79,
      "to": 55.29,
      "sid": 32,
      "location": 2,
      "content": "这就是你紧张的原因",
      "music": 0.0
    },
    {
      "from": 56.34,
      "to": 60.13,
      "sid": 33,
      "location": 2,
      "content": "因此要从心理上摆脱这个包袱",
      "music": 0.0
    },
    {
      "from": 60.13,
      "to": 62.69,
      "sid": 34,
      "location": 2,
      "content": "我不就是想跟听众分享",
      "music": 0.0
    },
    {
      "from": 62.69,
      "to": 66.539,
      "sid": 35,
      "location": 2,
      "content": "我心中认为最好的东西什么",
      "music": 0.0
    },
    {
      "from": 66.539,
      "to": 69.41,
      "sid": 36,
      "location": 2,
      "content": "记住你是去分享",
      "music": 0.0
    },
    {
      "from": 69.61,
      "to": 71.47,
      "sid": 37,
      "location": 2,
      "content": "你别想露脸",
      "music": 0.0
    },
    {
      "from": 71.47,
      "to": 73.65,
      "sid": 38,
      "location": 2,
      "content": "也别怕失去什么",
      "music": 0.0
    },
    {
      "from": 73.65,
      "to": 75.21,
      "sid": 39,
      "location": 2,
      "content": "你本来就没什么",
      "music": 0.0
    },
    {
      "from": 75.21,
      "to": 76.83,
      "sid": 40,
      "location": 2,
      "content": "你怕失去什么呢",
      "music": 0.0
    },
    {
      "from": 76.83,
      "to": 77.59,
      "sid": 41,
      "location": 2,
      "content": "把烟先关了",
      "music": 0.9999995833335069
    },
    {
      "from": 77.59,
      "to": 78.91,
      "sid": 42,
      "location": 2,
      "content": "把烟枪关了走了吗",
      "music": 0.0
    },
    {
      "from": 79.99,
      "to": 80.889,
      "sid": 43,
      "location": 2,
      "content": "好",
      "music": 0.0
    },
    {
      "from": 82.849,
      "to": 85.569,
      "sid": 44,
      "location": 2,
      "content": "第二排除各种杂念",
      "music": 0.0
    },
    {
      "from": 87.009,
      "to": 89.55,
      "sid": 45,
      "location": 2,
      "content": "其实我刚才说的那些就是你的杂念",
      "music": 0.0
    },
    {
      "from": 89.55,
      "to": 91.07,
      "sid": 46,
      "location": 2,
      "content": "也提前给你讲了",
      "music": 0.0
    },
    {
      "from": 92.67,
      "to": 94.98,
      "sid": 47,
      "location": 2,
      "content": "不要关注别人的评价如何",
      "music": 0.0
    },
    {
      "from": 94.98,
      "to": 96.02,
      "sid": 48,
      "location": 2,
      "content": "别人怎么看",
      "music": 0.0
    },
    {
      "from": 96.02,
      "to": 98.02,
      "sid": 49,
      "location": 2,
      "content": "你可不要管是吧",
      "music": 0.0
    },
    {
      "from": 98.02,
      "to": 99.14,
      "sid": 50,
      "location": 2,
      "content": "你讲你的",
      "music": 0.0
    },
    {
      "from": 99.14,
      "to": 100.06,
      "sid": 51,
      "location": 2,
      "content": "说你好",
      "music": 0.9999996875000976
    },
    {
      "from": 100.06,
      "to": 102.62,
      "sid": 52,
      "location": 2,
      "content": "那些你担心的所谓评价人",
      "music": 0.0
    },
    {
      "from": 102.62,
      "to": 104.5,
      "sid": 53,
      "location": 2,
      "content": "他都没资格上来",
      "music": 0.0
    },
    {
      "from": 104.5,
      "to": 105.93,
      "sid": 54,
      "location": 2,
      "content": "那好吗",
      "music": 0.0
    },
    {
      "from": 105.93,
      "to": 107.83,
      "sid": 55,
      "location": 2,
      "content": "还有什么资格评价你呢",
      "music": 0.0
    },
    {
      "from": 107.83,
      "to": 108.93,
      "sid": 56,
      "location": 2,
      "content": "对不对",
      "music": 0.0
    },
    {
      "from": 108.93,
      "to": 110.71,
      "sid": 57,
      "location": 2,
      "content": "那么在这个阶段呢",
      "music": 0.0
    },
    {
      "from": 110.71,
      "to": 114.85,
      "sid": 58,
      "location": 2,
      "content": "那还可以继续对自己进行心理暗示",
      "music": 0.0
    },
    {
      "from": 114.85,
      "to": 115.77,
      "sid": 59,
      "location": 2,
      "content": "我刚才说了",
      "music": 0.0
    },
    {
      "from": 115.77,
      "to": 117.77,
      "sid": 60,
      "location": 2,
      "content": "把最好的东西分享给大家",
      "music": 0.0
    },
    {
      "from": 117.77,
      "to": 119.67,
      "sid": 61,
      "location": 2,
      "content": "这是一种暗示",
      "music": 0.0
    },
    {
      "from": 119.67,
      "to": 123.949,
      "sid": 62,
      "location": 2,
      "content": "我能站在这已经比没站在这人强多了",
      "music": 0.0
    },
    {
      "from": 123.949,
      "to": 127.169,
      "sid": 63,
      "location": 2,
      "content": "暗示我已经准备的很充分了",
      "music": 0.0
    },
    {
      "from": 127.169,
      "to": 128.049,
      "sid": 64,
      "location": 2,
      "content": "没有问题",
      "music": 0.0
    },
    {
      "from": 128.049,
      "to": 130.85,
      "sid": 65,
      "location": 2,
      "content": "这是暗示我一定能行",
      "music": 0.0
    },
    {
      "from": 130.85,
      "to": 132.51,
      "sid": 66,
      "location": 2,
      "content": "这是暗示",
      "music": 0.0
    },
    {
      "from": 133.01,
      "to": 136.81,
      "sid": 67,
      "location": 2,
      "content": "还有把听众想象成",
      "music": 0.0
    },
    {
      "from": 137.81,
      "to": 138.93,
      "sid": 68,
      "location": 2,
      "content": "但这也不太好",
      "music": 0.0
    },
    {
      "from": 138.93,
      "to": 141.36,
      "sid": 69,
      "location": 2,
      "content": "但是你别跟别人说啊",
      "music": 0.0
    },
    {
      "from": 141.72,
      "to": 144.88,
      "sid": 70,
      "location": 2,
      "content": "傻子都想要不",
      "music": 0.0
    },
    {
      "from": 144.88,
      "to": 148.84,
      "sid": 71,
      "location": 2,
      "content": "傻子能听我这听我这么一个初出茅庐的那在讲",
      "music": 0.0
    },
    {
      "from": 148.84,
      "to": 150.39,
      "sid": 72,
      "location": 2,
      "content": "我肯定还不如我呗",
      "music": 0.0
    },
    {
      "from": 150.39,
      "to": 151.31,
      "sid": 73,
      "location": 2,
      "content": "对吧",
      "music": 0.0
    },
    {
      "from": 151.31,
      "to": 152.75,
      "sid": 74,
      "location": 2,
      "content": "但你这说出来啊",
      "music": 0.0
    },
    {
      "from": 152.75,
      "to": 156.11,
      "sid": 75,
      "location": 2,
      "content": "我们说出来的话是目中无人",
      "music": 0.0
    },
    {
      "from": 156.11,
      "to": 157.41,
      "sid": 76,
      "location": 2,
      "content": "心中有人",
      "music": 0.0
    },
    {
      "from": 157.41,
      "to": 159.59,
      "sid": 77,
      "location": 2,
      "content": "听众是上帝",
      "music": 0.0
    },
    {
      "from": 160.24,
      "to": 162.68,
      "sid": 78,
      "location": 2,
      "content": "因此进入下一个心理调试",
      "music": 0.0
    },
    {
      "from": 163.76,
      "to": 166.92,
      "sid": 79,
      "location": 2,
      "content": "屋里没人你紧张吗",
      "music": 0.0
    },
    {
      "from": 166.92,
      "to": 168.4,
      "sid": 80,
      "location": 2,
      "content": "没人你肯定不紧张",
      "music": 0.0
    },
    {
      "from": 168.4,
      "to": 170.089,
      "sid": 81,
      "location": 2,
      "content": "你就你就别想",
      "music": 0.0
    },
    {
      "from": 170.329,
      "to": 171.969,
      "sid": 82,
      "location": 2,
      "content": "可你这下边也就坐着人",
      "music": 0.0
    },
    {
      "from": 171.969,
      "to": 173.729,
      "sid": 83,
      "location": 2,
      "content": "怎么办呢对吧",
      "music": 0.0
    },
    {
      "from": 174.769,
      "to": 177.629,
      "sid": 84,
      "location": 2,
      "content": "继续进行心理暗示啊",
      "music": 0.0
    },
    {
      "from": 177.629,
      "to": 180.84,
      "sid": 85,
      "location": 2,
      "content": "部署下面进行什么训练室呢",
      "music": 0.0
    },
    {
      "from": 180.84,
      "to": 182.48,
      "sid": 86,
      "location": 2,
      "content": "既然你要非要想下面有人",
      "music": 0.0
    },
    {
      "from": 182.48,
      "to": 185.269,
      "sid": 87,
      "location": 2,
      "content": "那就我要比下面做人强",
      "music": 0.0
    },
    {
      "from": 185.269,
      "to": 186.549,
      "sid": 88,
      "location": 2,
      "content": "是你的错",
      "music": 0.0
    },
    {
      "from": 186.549,
      "to": 187.829,
      "sid": 89,
      "location": 2,
      "content": "怎么个强呢",
      "music": 0.0
    },
    {
      "from": 187.829,
      "to": 190.22,
      "sid": 90,
      "location": 2,
      "content": "进行身份转换",
      "music": 0.0
    },
    {
      "from": 190.22,
      "to": 192.88,
      "sid": 91,
      "location": 2,
      "content": "此刻你已经不是现在的你了",
      "music": 0.0
    },
    {
      "from": 192.88,
      "to": 194.46,
      "sid": 92,
      "location": 2,
      "content": "你以为自己拔高",
      "music": 0.0
    },
    {
      "from": 194.46,
      "to": 195.22,
      "sid": 93,
      "location": 2,
      "content": "我是谁",
      "music": 0.0
    },
    {
      "from": 196.42,
      "to": 200.07,
      "sid": 94,
      "location": 2,
      "content": "我是南开的杰出代表",
      "music": 0.0
    },
    {
      "from": 203.19,
      "to": 206.75,
      "sid": 95,
      "location": 2,
      "content": "我是成功的象征",
      "music": 0.0
    },
    {
      "from": 207.15,
      "to": 209.27,
      "sid": 96,
      "location": 2,
      "content": "我是上帝的使臣",
      "music": 0.0
    },
    {
      "from": 210.63,
      "to": 212.07,
      "sid": 97,
      "location": 2,
      "content": "我是真理的化身",
      "music": 0.0
    },
    {
      "from": 212.07,
      "to": 214.84,
      "sid": 98,
      "location": 2,
      "content": "我是福音的传播者",
      "music": 0.0
    }
  ]
}