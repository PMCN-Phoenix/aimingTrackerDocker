    },
    {
      "from": 0.2,
      "to": 0.52,
      "sid": 2,
      "location": 2,
      "content": "大家好",
      "music": 0.0
    },
    {
      "from": 0.52,
      "to": 1.16,
      "sid": 3,
      "location": 2,
      "content": "这里GISE",
      "music": 0.0
    },
    {
      "from": 1.16,
      "to": 3.32,
      "sid": 4,
      "location": 2,
      "content": "今天我们聊一些怎么提升进步速度",
      "music": 0.0
    },
    {
      "from": 3.32,
      "to": 4.52,
      "sid": 5,
      "location": 2,
      "content": "缓解焦虑的真东西",
      "music": 0.0
    },
    {
      "from": 4.52,
      "to": 5.82,
      "sid": 6,
      "location": 2,
      "content": "如果你想成为本质高手",
      "music": 0.0
    },
    {
      "from": 5.82,
      "to": 7.64,
      "sid": 7,
      "location": 2,
      "content": "这期视频一定会对你有所帮助",
      "music": 0.0
    },
    {
      "from": 7.64,
      "to": 9.44,
      "sid": 8,
      "location": 2,
      "content": "我相信不少人都会有这样的体验",
      "music": 0.0
    },
    {
      "from": 9.44,
      "to": 11.1,
      "sid": 9,
      "location": 2,
      "content": "可能明明想着多练练练枪",
      "music": 0.0
    },
    {
      "from": 11.1,
      "to": 13.18,
      "sid": 10,
      "location": 2,
      "content": "或者要学习学习别人的打法思路",
      "music": 0.0
    },
    {
      "from": 13.18,
      "to": 14.54,
      "sid": 11,
      "location": 2,
      "content": "结果打开练习软件之后",
      "music": 0.0
    },
    {
      "from": 14.54,
      "to": 15.5,
      "sid": 12,
      "location": 2,
      "content": "不是在上面挂机",
      "music": 0.0
    },
    {
      "from": 15.5,
      "to": 17.78,
      "sid": 13,
      "location": 2,
      "content": "就是学着学着被别的东西勾走的注意力",
      "music": 0.0
    },
    {
      "from": 17.78,
      "to": 19.38,
      "sid": 14,
      "location": 2,
      "content": "又或者每天练习很多很多",
      "music": 0.0
    },
    {
      "from": 19.38,
      "to": 20.62,
      "sid": 15,
      "location": 2,
      "content": "但是感觉进步很少",
      "music": 0.0
    },
    {
      "from": 20.62,
      "to": 22.3,
      "sid": 16,
      "location": 2,
      "content": "或者在考核残局的时候",
      "music": 0.0
    },
    {
      "from": 22.3,
      "to": 23.68,
      "sid": 17,
      "location": 2,
      "content": "心里莫名的紧张烦躁",
      "music": 0.0
    },
    {
      "from": 23.68,
      "to": 25.28,
      "sid": 18,
      "location": 2,
      "content": "但是也说不上来顾虑什么",
      "music": 0.0
    },
    {
      "from": 25.28,
      "to": 27.2,
      "sid": 19,
      "location": 2,
      "content": "其实不管是玩游戏还是平常做事",
      "music": 0.0
    },
    {
      "from": 27.2,
      "to": 28.66,
      "sid": 20,
      "location": 2,
      "content": "这种状态都很常见",
      "music": 0.0
    },
    {
      "from": 28.66,
      "to": 31.12,
      "sid": 21,
      "location": 2,
      "content": "今天我就结合三角洲和我自己的亲身经验",
      "music": 0.0
    },
    {
      "from": 31.12,
      "to": 32.6,
      "sid": 22,
      "location": 2,
      "content": "和大家聊聊心态的核心",
      "music": 0.0
    },
    {
      "from": 32.6,
      "to": 34.74,
      "sid": 23,
      "location": 2,
      "content": "学会如何消除自己内心的模糊",
      "music": 0.0
    },
    {
      "from": 34.74,
      "to": 36.32,
      "sid": 24,
      "location": 2,
      "content": "沉下心做好当下事",
      "music": 0.0
    },
    {
      "from": 36.32,
      "to": 38.76,
      "sid": 25,
      "location": 2,
      "content": "这不仅能帮我们在游戏里稳步提升",
      "music": 0.0
    },
    {
      "from": 38.76,
      "to": 40.26,
      "sid": 26,
      "location": 2,
      "content": "对生活同样也有帮助",
      "music": 0.0
    },
    {
      "from": 40.26,
      "to": 41.6,
      "sid": 27,
      "location": 2,
      "content": "我们打一个比方",
      "music": 0.0
    },
    {
      "from": 41.6,
      "to": 43.96,
      "sid": 28,
      "location": 2,
      "content": "机器人和我们真人最大的区别是什么",
      "music": 0.0
    },
    {
      "from": 43.96,
      "to": 45.12,
      "sid": 29,
      "location": 2,
      "content": "答案是潜意识",
      "music": 0.0
    },
    {
      "from": 45.12,
      "to": 47.78,
      "sid": 30,
      "location": 2,
      "content": "机器人所有的动作都是程序设定好的",
      "music": 0.0
    },
    {
      "from": 47.78,
      "to": 48.96,
      "sid": 31,
      "location": 2,
      "content": "程序停止运作",
      "music": 0.0
    },
    {
      "from": 48.96,
      "to": 50.14,
      "sid": 32,
      "location": 2,
      "content": "他们就无法行动",
      "music": 0.0
    },
    {
      "from": 50.14,
      "to": 51.3,
      "sid": 33,
      "location": 2,
      "content": "但我们人不一样",
      "music": 0.0
    },
    {
      "from": 51.3,
      "to": 53.76,
      "sid": 34,
      "location": 2,
      "content": "就算对局里意识走神状态下滑",
      "music": 0.0
    },
    {
      "from": 53.76,
      "to": 55.46,
      "sid": 35,
      "location": 2,
      "content": "身体的操作也不会停止",
      "music": 0.0
    },
    {
      "from": 55.46,
      "to": 57.64,
      "sid": 36,
      "location": 2,
      "content": "这就是潜意识在持续发挥作用",
      "music": 0.0
    },
    {
      "from": 57.64,
      "to": 60.52,
      "sid": 37,
      "location": 2,
      "content": "可以把我们自身理解成一套稳定运行的系统",
      "music": 0.0
    },
    {
      "from": 60.52,
      "to": 63.16,
      "sid": 38,
      "location": 2,
      "content": "潜意识负责维持日常的基础琐事",
      "music": 0.0
    },
    {
      "from": 63.16,
      "to": 64.92,
      "sid": 39,
      "location": 2,
      "content": "保障自身的正常运转",
      "music": 0.0
    },
    {
      "from": 64.92,
      "to": 68.14,
      "sid": 40,
      "location": 2,
      "content": "而我们的主观意识则是用来安排规划行为",
      "music": 0.0
    },
    {
      "from": 68.14,
      "to": 68.68,
      "sid": 41,
      "location": 2,
      "content": "抉择",
      "music": 0.0
    },
    {
      "from": 68.68,
      "to": 70.44,
      "sid": 42,
      "location": 2,
      "content": "应对日常中的各种情况",
      "music": 0.0
    },
    {
      "from": 70.44,
      "to": 72.4,
      "sid": 43,
      "location": 2,
      "content": "但这套机制也会带来一个问题",
      "music": 0.0
    },
    {
      "from": 72.4,
      "to": 74.73,
      "sid": 44,
      "location": 2,
      "content": "那就是思维和行为上的模糊感",
      "music": 0.0
    },
    {
      "from": 74.73,
      "to": 78.11,
      "sid": 45,
      "location": 2,
      "content": "潜意识带来的本能习惯很容易影响我们的选择",
      "music": 0.0
    },
    {
      "from": 78.11,
      "to": 80.19,
      "sid": 46,
      "location": 2,
      "content": "可我们却很难主动去把控它",
      "music": 0.0
    },
    {
      "from": 80.19,
      "to": 82.06,
      "sid": 47,
      "location": 2,
      "content": "于是出现了很矛盾的情况",
      "music": 0.0
    },
    {
      "from": 82.06,
      "to": 83.28,
      "sid": 48,
      "location": 2,
      "content": "心里明明想变强",
      "music": 0.0
    },
    {
      "from": 83.28,
      "to": 84.16,
      "sid": 49,
      "location": 2,
      "content": "想成为高手",
      "music": 0.0
    },
    {
      "from": 84.16,
      "to": 85.94,
      "sid": 50,
      "location": 2,
      "content": "行动上却总是懈怠犹豫",
      "music": 0.0
    },
    {
      "from": 85.94,
      "to": 87.66,
      "sid": 51,
      "location": 2,
      "content": "比如说一个最常见的例子",
      "music": 0.0
    },
    {
      "from": 87.66,
      "to": 89.5,
      "sid": 52,
      "location": 2,
      "content": "明明知道一场游戏不该这么玩",
      "music": 0.0
    },
    {
      "from": 89.5,
      "to": 90.94,
      "sid": 53,
      "location": 2,
      "content": "但是还是不经过思考",
      "music": 0.0
    },
    {
      "from": 90.94,
      "to": 92.4,
      "sid": 54,
      "location": 2,
      "content": "一个大拉就白给出去了",
      "music": 0.0
    },
    {
      "from": 92.4,
      "to": 95.02,
      "sid": 55,
      "location": 2,
      "content": "这种说不清的迷茫也是很多人技术停滞",
      "music": 0.0
    },
    {
      "from": 95.02,
      "to": 96.66,
      "sid": 56,
      "location": 2,
      "content": "心态受影响的主要原因",
      "music": 0.0
    },
    {
      "from": 96.66,
      "to": 98.16,
      "sid": 57,
      "location": 2,
      "content": "不管是游戏还是生活",
      "music": 0.0
    },
    {
      "from": 98.16,
      "to": 99.66,
      "sid": 58,
      "location": 2,
      "content": "谁能减少这份模糊",
      "music": 0.0
    },
    {
      "from": 99.66,
      "to": 101.36,
      "sid": 59,
      "location": 2,
      "content": "谁就能走得更远更稳",
      "music": 0.0
    },
    {
      "from": 101.36,
      "to": 102.64,
      "sid": 60,
      "location": 2,
      "content": "想要成为本质高手",
      "music": 0.0
    },
    {
      "from": 102.64,
      "to": 104.64,
      "sid": 61,
      "location": 2,
      "content": "第一步就是要消除认知上的模糊",
      "music": 0.0
    },
    {
      "from": 104.64,
      "to": 106.08,
      "sid": 62,
      "location": 2,
      "content": "正视自己的技术短板",
      "music": 0.0
    },
    {
      "from": 106.08,
      "to": 108.2,
      "sid": 63,
      "location": 2,
      "content": "人本能的就会偏向省力的选择",
      "music": 0.0
    },
    {
      "from": 108.2,
      "to": 109.67,
      "sid": 64,
      "location": 2,
      "content": "放到游戏里也是一样",
      "music": 0.0
    },
    {
      "from": 109.67,
      "to": 111.71,
      "sid": 65,
      "location": 2,
      "content": "大家都愿意反复玩熟悉的地图",
      "music": 0.0
    },
    {
      "from": 111.71,
      "to": 113.94,
      "sid": 66,
      "location": 2,
      "content": "用顺手的角色打自己喜欢的距离",
      "music": 0.0
    },
    {
      "from": 113.94,
      "to": 115.82,
      "sid": 67,
      "location": 2,
      "content": "待在自己适应的对局强度里",
      "music": 0.0
    },
    {
      "from": 115.82,
      "to": 116.82,
      "sid": 68,
      "location": 2,
      "content": "毕竟练习A达",
      "music": 0.0
    },
    {
      "from": 118.64,
      "to": 119.5,
      "sid": 69,
      "location": 2,
      "content": "研究点位",
      "music": 0.0
    },
    {
      "from": 119.5,
      "to": 122.42,
      "sid": 70,
      "location": 2,
      "content": "复盘失误都需要花费不少的时间和精力",
      "music": 0.0
    },
    {
      "from": 122.42,
      "to": 124.72,
      "sid": 71,
      "location": 2,
      "content": "远不如打轻松低压的对局来得自在",
      "music": 0.0
    },
    {
      "from": 124.72,
      "to": 126.88,
      "sid": 72,
      "location": 2,
      "content": "这也是为什么很多玩家天天上线对局",
      "music": 0.0
    },
    {
      "from": 126.88,
      "to": 128.979,
      "sid": 73,
      "location": 2,
      "content": "打的不少技术却一直在原地踏步",
      "music": 0.0
    },
    {
      "from": 128.979,
      "to": 131.099,
      "sid": 74,
      "location": 2,
      "content": "因为大多数人总是在重复练习",
      "music": 0.0
    },
    {
      "from": 131.099,
      "to": 132.399,
      "sid": 75,
      "location": 2,
      "content": "自己已经掌握的内容",
      "music": 0.0
    },
    {
      "from": 132.399,
      "to": 134.019,
      "sid": 76,
      "location": 2,
      "content": "刻意避开不擅长的地方",
      "music": 0.0
    },
    {
      "from": 134.019,
      "to": 136.84,
      "sid": 77,
      "location": 2,
      "content": "输了对决也简单跳过回去总结问题",
      "music": 0.0
    },
    {
      "from": 136.84,
      "to": 137.66,
      "sid": 78,
      "location": 2,
      "content": "时间久了",
      "music": 0.0
    },
    {
      "from": 137.66,
      "to": 139.04,
      "sid": 79,
      "location": 2,
      "content": "薄弱点就越积越多",
      "music": 0.0
    },
    {
      "from": 139.04,
      "to": 140.32,
      "sid": 80,
      "location": 2,
      "content": "遇到意料之外的对局",
      "music": 0.0
    },
    {
      "from": 140.32,
      "to": 141.52,
      "sid": 81,
      "location": 2,
      "content": "自然就容易吃亏",
      "music": 0.0
    },
    {
      "from": 141.52,
      "to": 142.96,
      "sid": 82,
      "location": 2,
      "content": "反观那些本质高手",
      "music": 0.0
    },
    {
      "from": 142.96,
      "to": 144.12,
      "sid": 83,
      "location": 2,
      "content": "技术很好的大佬",
      "music": 0.0
    },
    {
      "from": 144.12,
      "to": 145.38,
      "sid": 84,
      "location": 2,
      "content": "做法就完全不同",
      "music": 0.0
    },
    {
      "from": 145.38,
      "to": 147.4,
      "sid": 85,
      "location": 2,
      "content": "他们不会一直呆在舒适区里",
      "music": 0.0
    },
    {
      "from": 147.4,
      "to": 149.26,
      "sid": 86,
      "location": 2,
      "content": "死亡的对局会主动看回放",
      "music": 0.0
    },
    {
      "from": 149.26,
      "to": 150.76,
      "sid": 87,
      "location": 2,
      "content": "找出自己失误的地方",
      "music": 0.0
    },
    {
      "from": 150.76,
      "to": 152.38,
      "sid": 88,
      "location": 2,
      "content": "枪法不稳就抛在训练场",
      "music": 0.0
    },
    {
      "from": 152.38,
      "to": 154.36,
      "sid": 89,
      "location": 2,
      "content": "反复练习那些自己不擅长的项目",
      "music": 0.0
    },
    {
      "from": 154.36,
      "to": 155.58,
      "sid": 90,
      "location": 2,
      "content": "玩不明白的角色",
      "music": 0.0
    },
    {
      "from": 155.58,
      "to": 156.68,
      "sid": 91,
      "location": 2,
      "content": "搞不懂的思路",
      "music": 0.0
    },
    {
      "from": 156.68,
      "to": 157.72,
      "sid": 92,
      "location": 2,
      "content": "就一点点摸索",
      "music": 0.0
    },
    {
      "from": 157.72,
      "to": 159.62,
      "sid": 93,
      "location": 2,
      "content": "钻研变强从来没有捷径",
      "music": 0.0
    },
    {
      "from": 159.62,
      "to": 162.48,
      "sid": 94,
      "location": 2,
      "content": "本质就是把自己模糊的短板一点点练扎实",
      "music": 0.0
    },
    {
      "from": 162.48,
      "to": 164.48,
      "sid": 95,
      "location": 2,
      "content": "没有人一开始就是顶尖水平",
      "music": 0.0
    },
    {
      "from": 164.48,
      "to": 165.78,
      "sid": 96,
      "location": 2,
      "content": "所有熟练的操作",
      "music": 0.0
    },
    {
      "from": 165.78,
      "to": 168.72,
      "sid": 97,
      "location": 2,
      "content": "欧美的打法都是靠一次次打磨积累出来的",
      "music": 0.0
    },
    {
      "from": 168.72,
      "to": 170.44,
      "sid": 98,
      "location": 2,
      "content": "如果你也想成为本质高手",
      "music": 0.0
    },
    {
      "from": 170.44,
      "to": 172.32,
      "sid": 99,
      "location": 2,
      "content": "不妨试着主动面对自己的不足",
      "music": 0.0
    },
    {
      "from": 172.32,
      "to": 174.34,
      "sid": 100,
      "location": 2,
      "content": "寻找那些在自己舒适区之外",
      "music": 0.0
    },
    {
      "from": 174.34,
      "to": 176.76,
      "sid": 101,
      "location": 2,
      "content": "但是又没有让人感到那么痛苦的练习",
      "music": 0.0
    },
    {
      "from": 176.76,
      "to": 178.94,
      "sid": 102,
      "location": 2,
      "content": "我相信你的实力自然就会慢慢突破",
      "music": 0.0
    },
    {
      "from": 178.94,
      "to": 179.62,
      "sid": 103,
      "location": 2,
      "content": "技术之外",
      "music": 0.0
    },
    {
      "from": 179.62,
      "to": 181.62,
      "sid": 104,
      "location": 2,
      "content": "心态也是对局中至关重要的一环",
      "music": 0.0
    },
    {
      "from": 181.62,
      "to": 183.0,
      "sid": 105,
      "location": 2,
      "content": "这就是我们要说的第二点",
      "music": 0.0
    },
    {
      "from": 183.0,
      "to": 184.28,
      "sid": 106,
      "location": 2,
      "content": "消除情绪上的模糊",
      "music": 0.0
    },
    {
      "from": 184.28,
      "to": 185.92,
      "sid": 107,
      "location": 2,
      "content": "玩三角洲的朋友都清楚",
      "music": 0.0
