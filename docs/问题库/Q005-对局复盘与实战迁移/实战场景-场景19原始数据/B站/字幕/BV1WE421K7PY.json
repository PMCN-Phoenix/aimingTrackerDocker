{
  "bvid": "BV1WE421K7PY",
  "lan": "ai-zh",
  "title": "【无畏契约】排位焦虑？上不去分？心态是如何影响上分的？",
  "owner": "时雨GodRain",
  "duration": 540,
  "body": [
    {
      "from": 0.86,
      "to": 4.58,
      "sid": 1,
      "location": 2,
      "content": "你是否经常在排位里神一把鬼一把打了一整天",
      "music": 0.0
    },
    {
      "from": 4.58,
      "to": 5.7,
      "sid": 2,
      "location": 2,
      "content": "却一分没上",
      "music": 0.0
    },
    {
      "from": 5.7,
      "to": 7.8,
      "sid": 3,
      "location": 2,
      "content": "你是否经常在渡劫局",
      "music": 0.0
    },
    {
      "from": 7.8,
      "to": 9.42,
      "sid": 4,
      "location": 2,
      "content": "自认为已经做好准备",
      "music": 0.0
    },
    {
      "from": 9.42,
      "to": 11.28,
      "sid": 5,
      "location": 2,
      "content": "却三番五次渡劫失败",
      "music": 0.0
    },
    {
      "from": 11.28,
      "to": 13.68,
      "sid": 6,
      "location": 2,
      "content": "你是否因为被队友压力了一句",
      "music": 0.0
    },
    {
      "from": 13.68,
      "to": 15.719,
      "sid": 7,
      "location": 2,
      "content": "而好几天不敢打开排位",
      "music": 0.0
    },
    {
      "from": 15.719,
      "to": 17.549,
      "sid": 8,
      "location": 2,
      "content": "就如视频标题所说",
      "music": 0.0
    },
    {
      "from": 17.549,
      "to": 21.17,
      "sid": 9,
      "location": 2,
      "content": "这是一期教你如何成为上分机器的视频",
      "music": 0.0
    },
    {
      "from": 21.17,
      "to": 24.05,
      "sid": 10,
      "location": 2,
      "content": "但这期视频并不会讲有关地图",
      "music": 0.0
    },
    {
      "from": 24.05,
      "to": 26.72,
      "sid": 11,
      "location": 2,
      "content": "理解枪法练习等等的技巧",
      "music": 0.0
    },
    {
      "from": 26.72,
      "to": 29.99,
      "sid": 12,
      "location": 2,
      "content": "诚然意识和枪法是上分的重要因素",
      "music": 0.0
    },
    {
      "from": 29.99,
      "to": 32.69,
      "sid": 13,
      "location": 2,
      "content": "但还有一个因素与他们同样重要",
      "music": 0.0
    },
    {
      "from": 32.69,
      "to": 33.94,
      "sid": 14,
      "location": 2,
      "content": "那就是心态",
      "music": 0.0
    },
    {
      "from": 33.94,
      "to": 37.489,
      "sid": 15,
      "location": 2,
      "content": "拥有一个良好的心态和状态也是非常重要的",
      "music": 0.0
    },
    {
      "from": 37.489,
      "to": 40.129,
      "sid": 16,
      "location": 2,
      "content": "那么本期视频将会教会你",
      "music": 0.0
    },
    {
      "from": 40.129,
      "to": 42.94,
      "sid": 17,
      "location": 2,
      "content": "我自己关于调整心态的感悟",
      "music": 0.0
    },
    {
      "from": 42.94,
      "to": 46.63,
      "sid": 18,
      "location": 2,
      "content": "以及我在网上看到的并觉得好用的",
      "music": 0.0
    },
    {
      "from": 46.63,
      "to": 48.72,
      "sid": 19,
      "location": 2,
      "content": "调整自身状态的方法",
      "music": 0.0
    },
    {
      "from": 48.72,
      "to": 50.7,
      "sid": 20,
      "location": 2,
      "content": "让你拥有良好的经济心态",
      "music": 0.0
    },
    {
      "from": 50.7,
      "to": 52.14,
      "sid": 21,
      "location": 2,
      "content": "避免排位焦虑",
      "music": 0.0
    },
    {
      "from": 52.14,
      "to": 55.2,
      "sid": 22,
      "location": 2,
      "content": "成为优秀的上分机器",
      "music": 0.0
    },
    {
      "from": 55.2,
      "to": 58.77,
      "sid": 23,
      "location": 2,
      "content": "我相信有很多玩家都有过这样的体验",
      "music": 0.0
    },
    {
      "from": 58.77,
      "to": 60.75,
      "sid": 24,
      "location": 2,
      "content": "对面有一个非常准的玩家",
      "music": 0.0
    },
    {
      "from": 60.75,
      "to": 62.88,
      "sid": 25,
      "location": 2,
      "content": "经常打你们就是one tap",
      "music": 0.0
    },
    {
      "from": 62.88,
      "to": 64.81,
      "sid": 26,
      "location": 2,
      "content": "又或者只有打你特别准",
      "music": 0.0
    },
    {
      "from": 64.81,
      "to": 66.28,
      "sid": 27,
      "location": 2,
      "content": "在接下来的回合里",
      "music": 0.0
    },
    {
      "from": 66.28,
      "to": 68.17,
      "sid": 28,
      "location": 2,
      "content": "只要是和他对位的时候",
      "music": 0.0
    },
    {
      "from": 68.17,
      "to": 69.97,
      "sid": 29,
      "location": 2,
      "content": "你会不敢与他对枪",
      "music": 0.0
    },
    {
      "from": 69.97,
      "to": 71.8,
      "sid": 30,
      "location": 2,
      "content": "从而丧失良好的timing",
      "music": 0.0
    },
    {
      "from": 71.8,
      "to": 73.37,
      "sid": 31,
      "location": 2,
      "content": "又或者止步不前",
      "music": 0.0
    },
    {
      "from": 73.37,
      "to": 75.07,
      "sid": 32,
      "location": 2,
      "content": "直至被他反杀",
      "music": 0.0
    },
    {
      "from": 75.07,
      "to": 78.07,
      "sid": 33,
      "location": 2,
      "content": "这种情况并不只出现在中低分段",
      "music": 0.0
    },
    {
      "from": 78.07,
      "to": 79.09,
      "sid": 34,
      "location": 2,
      "content": "在高分段",
      "music": 0.0
    },
    {
      "from": 79.09,
      "to": 82.61,
      "sid": 35,
      "location": 2,
      "content": "甚至在职业比赛里也会有这种现象发生",
      "music": 0.0
    },
    {
      "from": 82.61,
      "to": 86.1,
      "sid": 36,
      "location": 2,
      "content": "这就是我们常说的自信心被击垮",
      "music": 0.0
    },
    {
      "from": 86.1,
      "to": 88.08,
      "sid": 37,
      "location": 2,
      "content": "这件事其实并不羞耻",
      "music": 0.0
    },
    {
      "from": 88.08,
      "to": 89.52,
      "sid": 38,
      "location": 2,
      "content": "从心理学角度来讲",
      "music": 0.0
    },
    {
      "from": 89.52,
      "to": 92.289,
      "sid": 39,
      "location": 2,
      "content": "这种忌惮是人们的一种自我保护机制",
      "music": 0.0
    },
    {
      "from": 92.289,
      "to": 93.609,
      "sid": 40,
      "location": 2,
      "content": "是为了保护自己",
      "music": 0.0
    },
    {
      "from": 93.609,
      "to": 96.459,
      "sid": 41,
      "location": 2,
      "content": "不再受到同样的伤害的一种心理表现",
      "music": 0.0
    },
    {
      "from": 96.459,
      "to": 97.929,
      "sid": 42,
      "location": 2,
      "content": "而在职业赛场上",
      "music": 0.0
    },
    {
      "from": 97.929,
      "to": 100.2,
      "sid": 43,
      "location": 2,
      "content": "这种情况会出现的更频繁",
      "music": 0.0
    },
    {
      "from": 100.2,
      "to": 102.36,
      "sid": 44,
      "location": 2,
      "content": "职业选手们所承受的压力",
      "music": 0.0
    },
    {
      "from": 102.36,
      "to": 104.28,
      "sid": 45,
      "location": 2,
      "content": "是我们普通人无法想象的",
      "music": 0.0
    },
    {
      "from": 104.28,
      "to": 106.38,
      "sid": 46,
      "location": 2,
      "content": "这也是为什么职业队伍里",
      "music": 0.0
    },
    {
      "from": 106.38,
      "to": 109.1,
      "sid": 47,
      "location": 2,
      "content": "一定会有一名心理咨询师的原因",
      "music": 0.0
    },
    {
      "from": 109.1,
      "to": 111.62,
      "sid": 48,
      "location": 2,
      "content": "职业哥们可以通过心理咨询",
      "music": 0.0
    },
    {
      "from": 111.62,
      "to": 112.74,
      "sid": 49,
      "location": 2,
      "content": "从而建立信心",
      "music": 0.0
    },
    {
      "from": 112.74,
      "to": 114.69,
      "sid": 50,
      "location": 2,
      "content": "那么对于我们普通人",
      "music": 0.0
    },
    {
      "from": 114.69,
      "to": 117.54,
      "sid": 51,
      "location": 2,
      "content": "有没有什么好的建立自信心的方法呢",
      "music": 0.0
    },
    {
      "from": 117.54,
      "to": 119.9,
      "sid": 52,
      "location": 2,
      "content": "这里我提一个60分定律",
      "music": 0.0
    },
    {
      "from": 119.9,
      "to": 123.37,
      "sid": 53,
      "location": 2,
      "content": "简单点来说就是不要追求完美极致",
      "music": 0.0
    },
    {
      "from": 123.37,
      "to": 125.95,
      "sid": 54,
      "location": 2,
      "content": "首要目标是快速完成任务",
      "music": 0.0
    },
    {
      "from": 125.95,
      "to": 129.459,
      "sid": 55,
      "location": 2,
      "content": "再通过迭代来提高任务完成的效率",
      "music": 0.0
    },
    {
      "from": 129.459,
      "to": 132.009,
      "sid": 56,
      "location": 2,
      "content": "你不可能做到比所有人都强",
      "music": 0.0
    },
    {
      "from": 132.009,
      "to": 134.409,
      "sid": 57,
      "location": 2,
      "content": "总会有人站在你的头顶之上",
      "music": 0.0
    },
    {
      "from": 134.409,
      "to": 136.75,
      "sid": 58,
      "location": 2,
      "content": "而且这是一个团队游戏",
      "music": 0.0
    },
    {
      "from": 136.75,
      "to": 139.63,
      "sid": 59,
      "location": 2,
      "content": "一个人的胜利不代表整局游戏的胜利",
      "music": 0.0
    },
    {
      "from": 139.63,
      "to": 140.77,
      "sid": 60,
      "location": 2,
      "content": "如果你对不过",
      "music": 0.0
    },
    {
      "from": 140.77,
      "to": 142.3,
      "sid": 61,
      "location": 2,
      "content": "那就接受这个事实",
      "music": 0.0
    },
    {
      "from": 142.3,
      "to": 143.69,
      "sid": 62,
      "location": 2,
      "content": "转移你的注意力",
      "music": 0.0
    },
    {
      "from": 143.69,
      "to": 146.12,
      "sid": 63,
      "location": 2,
      "content": "想想如何帮助团队拿下胜利",
      "music": 0.0
    },
    {
      "from": 146.12,
      "to": 147.35,
      "sid": 64,
      "location": 2,
      "content": "赢了皆大欢喜",
      "music": 0.0
    },
    {
      "from": 147.35,
      "to": 149.15,
      "sid": 65,
      "location": 2,
      "content": "输了也不要气馁",
      "music": 0.0
    },
    {
      "from": 149.15,
      "to": 150.709,
      "sid": 66,
      "location": 2,
      "content": "没有人能一直赢下去",
      "music": 0.0
    },
    {
      "from": 150.709,
      "to": 153.199,
      "sid": 67,
      "location": 2,
      "content": "不要给自己建立太高的期望",
      "music": 0.0
    },
    {
      "from": 153.199,
      "to": 155.38,
      "sid": 68,
      "location": 2,
      "content": "也是建立信心的关键",
      "music": 0.0
    },
    {
      "from": 155.38,
      "to": 159.82,
      "sid": 69,
      "location": 2,
      "content": "可能有人这个时候跳出来说我他个鸡毛啊",
      "music": 0.0
    },
    {
      "from": 159.82,
      "to": 160.36,
      "sid": 70,
      "location": 2,
      "content": "我就不信",
      "music": 0.0
    },
    {
      "from": 160.36,
      "to": 160.96,
      "sid": 71,
      "location": 2,
      "content": "干不过他",
      "music": 0.0
    },
    {
      "from": 160.96,
      "to": 162.38,
      "sid": 72,
      "location": 2,
      "content": "我要给他爆了",
      "music": 0.0
    },
    {
      "from": 162.38,
      "to": 164.51,
      "sid": 73,
      "location": 2,
      "content": "有自信是一件好事",
      "music": 0.0
    },
    {
      "from": 164.51,
      "to": 167.0,
      "sid": 74,
      "location": 2,
      "content": "但太过自信的话就会变成自大了",
      "music": 0.0
    },
    {
      "from": 167.0,
      "to": 170.78,
      "sid": 75,
      "location": 2,
      "content": "我有一个朋友自诩为千场欧盟绝活哥",
      "music": 0.0
    },
    {
      "from": 170.78,
      "to": 173.04,
      "sid": 76,
      "location": 2,
      "content": "吊打钻石以下所有欧盟",
      "music": 0.0
    },
    {
      "from": 173.04,
      "to": 176.06,
      "sid": 77,
      "location": 2,
      "content": "有一天我带他体验了一下神话局的强度",
      "music": 0.0
    },
    {
      "from": 176.06,
      "to": 179.24,
      "sid": 78,
      "location": 2,
      "content": "他依旧用他的公式封烟推黑传送",
      "music": 0.0
    },
    {
      "from": 179.24,
      "to": 180.02,
      "sid": 79,
      "location": 2,
      "content": "绕后一条龙",
      "music": 0.0
    },
    {
      "from": 180.02,
      "to": 183.579,
      "sid": 80,
      "location": 2,
      "content": "把对面当傻子戏耍的游戏理解进行对局",
      "music": 0.0
    },
    {
      "from": 183.579,
      "to": 186.399,
      "sid": 81,
      "location": 2,
      "content": "下场就是到了游戏中期的时候",
      "music": 0.0
    },
    {
      "from": 186.399,
      "to": 188.47,
      "sid": 82,
      "location": 2,
      "content": "他已经被打的完全说不出话了",
      "music": 0.0
    },
    {
      "from": 188.47,
      "to": 190.09,
      "sid": 83,
      "location": 2,
      "content": "其实在我看来啊",
      "music": 0.0
    },
    {
      "from": 190.09,
      "to": 192.52,
      "sid": 84,
      "location": 2,
      "content": "有自信是一件很了不起的事情",
      "music": 0.0
    },
    {
      "from": 192.52,
      "to": 194.77,
      "sid": 85,
      "location": 2,
      "content": "但能在保持自信的同时",
      "music": 0.0
    },
    {
      "from": 194.77,
      "to": 197.13,
      "sid": 86,
      "location": 2,
      "content": "保持谦逊也是非常重要的",
      "music": 0.0
    },
    {
      "from": 197.13,
      "to": 198.84,
      "sid": 87,
      "location": 2,
      "content": "排位是随机的",
      "music": 0.0
    },
    {
      "from": 198.84,
      "to": 202.56,
      "sid": 88,
      "location": 2,
      "content": "你不可能每次都能精准匹配比你差的人",
      "music": 0.0
    },
    {
      "from": 202.56,
      "to": 203.76,
      "sid": 89,
      "location": 2,
      "content": "千局千灭",
      "music": 0.0
    },
    {
      "from": 203.76,
      "to": 205.38,
      "sid": 90,
      "location": 2,
      "content": "有时候太过自信",
      "music": 0.0
    },
    {
      "from": 205.38,
      "to": 209.62,
      "sid": 91,
      "location": 2,
      "content": "也会导致自己输掉一些本能拿下的对局",
      "music": 0.0
    },
    {
      "from": 209.62,
      "to": 212.92,
      "sid": 92,
      "location": 2,
      "content": "上面说到的自信是基于敌方的",
      "music": 0.0
    },
    {
      "from": 212.92,
      "to": 214.54,
      "sid": 93,
      "location": 2,
      "content": "而对于有些人而言",
      "music": 0.0
    },
    {
      "from": 214.54,
      "to": 217.34,
      "sid": 94,
      "location": 2,
      "content": "自信心的击垮是来源于自己的队友",
      "music": 0.0
    },
    {
      "from": 217.34,
      "to": 219.26,
      "sid": 95,
      "location": 2,
      "content": "也是我们常说的压力",
      "music": 0.0
    },
    {
      "from": 219.26,
      "to": 221.81,
      "sid": 96,
      "location": 2,
      "content": "怪他们会因为自己死了",
      "music": 0.0
    },
    {
      "from": 221.81,
      "to": 223.34,
      "sid": 97,
      "location": 2,
      "content": "从而无理由的怪罪",
      "music": 0.0
    },
    {
      "from": 223.34,
      "to": 224.33,
      "sid": 98,
      "location": 2,
      "content": "其余的队友",
      "music": 0.0
    },
    {
      "from": 224.33,
      "to": 228.95,
      "sid": 99,
      "location": 2,
      "content": "声称自己是因为没有什么什么的配合而死的",
      "music": 0.0
    },
    {
      "from": 228.95,
      "to": 231.11,
      "sid": 100,
      "location": 2,
      "content": "有些人一听哎不乐意了",
      "music": 0.0
    },
    {
      "from": 231.11,
      "to": 233.69,
      "sid": 101,
      "location": 2,
      "content": "打个游戏你还把自己当爷了是吧",
      "music": 0.0
    },
    {
      "from": 233.69,
      "to": 235.55,
      "sid": 102,
      "location": 2,
      "content": "噗噗开麦一顿乱喷",
      "music": 0.0
    },
    {
      "from": 235.55,
      "to": 236.45,
      "sid": 103,
      "location": 2,
      "content": "殊不知",
      "music": 0.0
    },
    {
      "from": 236.45,
      "to": 238.25,
      "sid": 104,
      "location": 2,
      "content": "因为两个人之间的纠纷啊",
      "music": 0.0
    },
    {
      "from": 238.25,
      "to": 240.48,
      "sid": 105,
      "location": 2,
      "content": "直接影响了整个团队的胜率",
      "music": 0.0
    },
    {
      "from": 240.48,
      "to": 242.64,
      "sid": 106,
      "location": 2,
      "content": "如果你真的是要上分的",
      "music": 0.0
    },
    {
      "from": 242.64,
      "to": 244.74,
      "sid": 107,
      "location": 2,
      "content": "如果你觉得自己有压力",
      "music": 0.0
    },
    {
      "from": 244.74,
      "to": 245.52,
      "sid": 108,
      "location": 2,
      "content": "别人的习惯",
      "music": 0.0
