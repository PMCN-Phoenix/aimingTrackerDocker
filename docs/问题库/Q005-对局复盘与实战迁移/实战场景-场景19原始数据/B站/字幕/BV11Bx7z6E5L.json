{
  "bvid": "BV11Bx7z6E5L",
  "lan": "ai-zh",
  "title": "有人枪法好，有人道具好，我们只有心态好。",
  "owner": "城北徐公-瓦",
  "duration": 480,
  "cid": 32875810538,
  "body": [
    {
      "from": 0.08,
      "to": 0.96,
      "sid": 1,
      "location": 2,
      "content": "打完这局之后",
      "music": 0.0
    },
    {
      "from": 0.96,
      "to": 2.34,
      "sid": 2,
      "location": 2,
      "content": "我就一直在想",
      "music": 0.0
    },
    {
      "from": 2.34,
      "to": 4.64,
      "sid": 3,
      "location": 2,
      "content": "究竟匹配系统是怎么做到",
      "music": 0.0
    },
    {
      "from": 4.64,
      "to": 6.86,
      "sid": 4,
      "location": 2,
      "content": "把我们五个精英匹在一起的",
      "music": 0.0
    },
    {
      "from": 6.86,
      "to": 8.34,
      "sid": 5,
      "location": 2,
      "content": "而打开话匣子",
      "music": 0.0
    },
    {
      "from": 8.34,
      "to": 11.17,
      "sid": 6,
      "location": 2,
      "content": "往往只需要一波精彩的残局",
      "music": 0.0
    },
    {
      "from": 11.17,
      "to": 12.89,
      "sid": 7,
      "location": 2,
      "content": "废了废了还是我",
      "music": 0.0
    },
    {
      "from": 15.21,
      "to": 17.25,
      "sid": 8,
      "location": 2,
      "content": "好剩余30秒",
      "music": 0.0
    },
    {
      "from": 20.6,
      "to": 24.04,
      "sid": 9,
      "location": 2,
      "content": "哎呀我敲我不换",
      "music": 0.0
    },
    {
      "from": 24.04,
      "to": 26.92,
      "sid": 10,
      "location": 2,
      "content": "我应该不换枪的",
      "music": 0.0
    },
    {
      "from": 27.12,
      "to": 29.52,
      "sid": 11,
      "location": 2,
      "content": "嗯嗯我妈小馋猫",
      "music": 0.0
    },
    {
      "from": 29.52,
      "to": 30.0,
      "sid": 12,
      "location": 2,
      "content": "卧槽",
      "music": 0.0
    },
    {
      "from": 30.0,
      "to": 31.4,
      "sid": 13,
      "location": 2,
      "content": "我贪他的皮肤好看",
      "music": 0.0
    },
    {
      "from": 32.59,
      "to": 34.47,
      "sid": 14,
      "location": 2,
      "content": "被队友调侃之后",
      "music": 0.0
    },
    {
      "from": 34.47,
      "to": 36.43,
      "sid": 15,
      "location": 2,
      "content": "为了证明我不是混子",
      "music": 0.0
    },
    {
      "from": 36.43,
      "to": 37.83,
      "sid": 16,
      "location": 2,
      "content": "我起了一把喷子",
      "music": 0.0
    },
    {
      "from": 37.83,
      "to": 39.31,
      "sid": 17,
      "location": 2,
      "content": "别说我不给面子",
      "music": 0.0
    },
    {
      "from": 39.31,
      "to": 41.65,
      "sid": 18,
      "location": 2,
      "content": "我要把对面打成孙子",
      "music": 0.0
    },
    {
      "from": 41.65,
      "to": 44.48,
      "sid": 19,
      "location": 2,
      "content": "我丢瞬爆王丢",
      "music": 0.0
    },
    {
      "from": 44.48,
      "to": 46.68,
      "sid": 20,
      "location": 2,
      "content": "如果我不是队伍里的大哥",
      "music": 0.0
    },
    {
      "from": 46.68,
      "to": 48.08,
      "sid": 21,
      "location": 2,
      "content": "那又能是谁呢",
      "music": 0.0
    },
    {
      "from": 48.08,
      "to": 49.84,
      "sid": 22,
      "location": 2,
      "content": "总不能是瑞娜吧",
      "music": 0.0
    },
    {
      "from": 49.84,
      "to": 53.09,
      "sid": 23,
      "location": 2,
      "content": "攻击敌人二楼哇",
      "music": 0.0
    },
    {
      "from": 53.09,
      "to": 53.73,
      "sid": 24,
      "location": 2,
      "content": "好香啊",
      "music": 0.0
    },
    {
      "from": 53.73,
      "to": 54.31,
      "sid": 25,
      "location": 2,
      "content": "兄弟",
      "music": 0.0
    },
    {
      "from": 54.31,
      "to": 56.97,
      "sid": 26,
      "location": 2,
      "content": "当我以为已经找到队伍的大哥时",
      "music": 0.0
    },
    {
      "from": 56.97,
      "to": 58.47,
      "sid": 27,
      "location": 2,
      "content": "没想到还有高手",
      "music": 0.0
    },
    {
      "from": 58.47,
      "to": 59.73,
      "sid": 28,
      "location": 2,
      "content": "我现在很生气",
      "music": 0.0
    },
    {
      "from": 59.73,
      "to": 60.83,
      "sid": 29,
      "location": 2,
      "content": "你知道吗",
      "music": 0.0
    },
    {
      "from": 60.83,
      "to": 62.89,
      "sid": 30,
      "location": 2,
      "content": "怎么说我我靠",
      "music": 0.0
    },
    {
      "from": 62.89,
      "to": 65.47,
      "sid": 31,
      "location": 2,
      "content": "我刚刚上抖音被骗了",
      "music": 0.0
    },
    {
      "from": 65.47,
      "to": 67.95,
      "sid": 32,
      "location": 2,
      "content": "这可恶的主播",
      "music": 0.0
    },
    {
      "from": 68.53,
      "to": 70.81,
      "sid": 33,
      "location": 2,
      "content": "呵呵骗我给他刷墨镜",
      "music": 0.0
    },
    {
      "from": 70.81,
      "to": 72.45,
      "sid": 34,
      "location": 2,
      "content": "结果他不带我",
      "music": 0.0
    },
    {
      "from": 75.6,
      "to": 76.96,
      "sid": 35,
      "location": 2,
      "content": "然后我我真的",
      "music": 0.0
    },
    {
      "from": 76.96,
      "to": 80.16,
      "sid": 36,
      "location": 2,
      "content": "我硬生生从早上十点多等到11点多",
      "music": 0.0
    },
    {
      "from": 80.16,
      "to": 82.07,
      "sid": 37,
      "location": 2,
      "content": "然后我自己开了",
      "music": 0.0
    },
    {
      "from": 82.31,
      "to": 82.87,
      "sid": 38,
      "location": 2,
      "content": "没事",
      "music": 0.0
    },
    {
      "from": 82.87,
      "to": 84.99,
      "sid": 39,
      "location": 2,
      "content": "兄弟我们五个很强",
      "music": 0.0
    },
    {
      "from": 86.27,
      "to": 86.95,
      "sid": 40,
      "location": 2,
      "content": "不行",
      "music": 0.0
    },
    {
      "from": 86.95,
      "to": 88.15,
      "sid": 41,
      "location": 2,
      "content": "兄弟等我老了",
      "music": 0.0
    },
    {
      "from": 88.15,
      "to": 89.31,
      "sid": 42,
      "location": 2,
      "content": "我一定找你卖保险",
      "music": 0.0
    },
    {
      "from": 89.31,
      "to": 90.53,
      "sid": 43,
      "location": 2,
      "content": "不难看出",
      "music": 0.0
    },
    {
      "from": 90.53,
      "to": 92.75,
      "sid": 44,
      "location": 2,
      "content": "这是一场群英荟萃的对局",
      "music": 0.0
    },
    {
      "from": 92.75,
      "to": 95.68,
      "sid": 45,
      "location": 2,
      "content": "但想要组成一支训练有素的队伍",
      "music": 0.0
    },
    {
      "from": 95.68,
      "to": 99.18,
      "sid": 46,
      "location": 2,
      "content": "仅凭瑞纳和斯凯这两条精英是不够的",
      "music": 0.0
    },
    {
      "from": 99.18,
      "to": 101.94,
      "sid": 47,
      "location": 2,
      "content": "还差一个急躁的马和稳健的牛",
      "music": 0.0
    },
    {
      "from": 101.94,
      "to": 102.78,
      "sid": 48,
      "location": 2,
      "content": "怕他个吊啊",
      "music": 0.0
    },
    {
      "from": 102.78,
      "to": 103.98,
      "sid": 49,
      "location": 2,
      "content": "兄弟冲",
      "music": 0.0
    },
    {
      "from": 105.13,
      "to": 106.01,
      "sid": 50,
      "location": 2,
      "content": "黑雾没弹人",
      "music": 0.0
    },
    {
      "from": 106.01,
      "to": 106.65,
      "sid": 51,
      "location": 2,
      "content": "黑雾没弹人",
      "music": 0.0
    },
    {
      "from": 106.65,
      "to": 107.21,
      "sid": 52,
      "location": 2,
      "content": "帮我架一下",
      "music": 0.0
    },
    {
      "from": 107.21,
      "to": 107.69,
      "sid": 53,
      "location": 2,
      "content": "帮我架一下",
      "music": 0.0
    },
    {
      "from": 107.69,
      "to": 110.87,
      "sid": 54,
      "location": 2,
      "content": "我下我下有人刚刚有人来给你炸",
      "music": 0.0
    },
    {
      "from": 110.87,
      "to": 111.87,
      "sid": 55,
      "location": 2,
      "content": "非常稳",
      "music": 0.0
    },
    {
      "from": 111.87,
      "to": 115.22,
      "sid": 56,
      "location": 2,
      "content": "武器已部署五大三燃烧弹要出吗",
      "music": 0.12537313058587743
    },
    {
      "from": 115.22,
      "to": 116.1,
      "sid": 57,
      "location": 2,
      "content": "没事别着急",
      "music": 0.0
    },
    {
      "from": 116.1,
      "to": 116.58,
      "sid": 58,
      "location": 2,
      "content": "不说了",
      "music": 0.0
    },
    {
      "from": 116.58,
      "to": 118.14,
      "sid": 59,
      "location": 2,
      "content": "不说不说不说不说不说",
      "music": 0.0
    },
    {
      "from": 118.14,
      "to": 118.7,
      "sid": 60,
      "location": 2,
      "content": "没人看",
      "music": 0.0
    },
    {
      "from": 118.7,
      "to": 119.98,
      "sid": 61,
      "location": 2,
      "content": "我非常",
      "music": 0.0
    },
    {
      "from": 119.98,
      "to": 123.74,
      "sid": 62,
      "location": 2,
      "content": "这个位置屁股有人有人有人到了",
      "music": 0.0
    },
    {
      "from": 123.74,
      "to": 127.72,
      "sid": 63,
      "location": 2,
      "content": "有一个就没了啊",
      "music": 0.0
    },
    {
      "from": 127.72,
      "to": 131.0,
      "sid": 64,
      "location": 2,
      "content": "A区有敌人黑屋黑屋啊",
      "music": 0.0
    },
    {
      "from": 131.0,
      "to": 134.31,
      "sid": 65,
      "location": 2,
      "content": "我们还真就像牛马一样被对面一脚踢飞",
      "music": 0.0
    },
    {
      "from": 134.31,
      "to": 136.05,
      "sid": 66,
      "location": 2,
      "content": "但在我们大哥眼里",
      "music": 0.0
    },
    {
      "from": 136.05,
      "to": 137.47,
      "sid": 67,
      "location": 2,
      "content": "对面也是牛马",
      "music": 0.0
    },
    {
      "from": 137.47,
      "to": 138.03,
      "sid": 68,
      "location": 2,
      "content": "交AK了",
      "music": 0.0
    },
    {
      "from": 138.03,
      "to": 138.65,
      "sid": 69,
      "location": 2,
      "content": "交AK了",
      "music": 0.0
    },
    {
      "from": 138.65,
      "to": 140.55,
      "sid": 70,
      "location": 2,
      "content": "飞鹰出击有害有害",
      "music": 0.0
    },
    {
      "from": 140.55,
      "to": 141.31,
      "sid": 71,
      "location": 2,
      "content": "上架上架了",
      "music": 0.0
    },
    {
      "from": 141.31,
      "to": 141.71,
      "sid": 72,
      "location": 2,
      "content": "上架了",
      "music": 0.0
    },
    {
      "from": 141.71,
      "to": 143.3,
      "sid": 73,
      "location": 2,
      "content": "我方还剩一人",
      "music": 0.0
    },
    {
      "from": 143.3,
      "to": 144.96,
      "sid": 74,
      "location": 2,
      "content": "还剩一名敌人",
      "music": 0.0
    },
    {
      "from": 144.96,
      "to": 146.94,
      "sid": 75,
      "location": 2,
      "content": "呜矿枪里面",
      "music": 0.0
    },
    {
      "from": 146.94,
      "to": 148.18,
      "sid": 76,
      "location": 2,
      "content": "你是瓜",
      "music": 0.0
    },
    {
      "from": 152.33,
      "to": 153.49,
      "sid": 77,
      "location": 2,
      "content": "不好哦",
      "music": 0.0
    },
    {
      "from": 153.49,
      "to": 154.69,
      "sid": 78,
      "location": 2,
      "content": "赢了nice啊",
      "music": 0.0
    },
    {
      "from": 155.69,
      "to": 156.41,
      "sid": 79,
      "location": 2,
      "content": "这么帅吗",
      "music": 0.0
    },
    {
      "from": 156.41,
      "to": 157.97,
      "sid": 80,
      "location": 2,
      "content": "兄弟兜里的蛇哇",
      "music": 0.0
    },
    {
      "from": 157.97,
      "to": 158.63,
      "sid": 81,
      "location": 2,
      "content": "这么帅",
      "music": 0.0
    },
    {
      "from": 158.63,
      "to": 159.41,
      "sid": 82,
      "location": 2,
      "content": "我操瑞娜",
      "music": 0.0
    },
    {
      "from": 159.41,
      "to": 160.49,
      "sid": 83,
      "location": 2,
      "content": "你这太帅了",
      "music": 0.0
    },
    {
      "from": 160.49,
      "to": 162.63,
      "sid": 84,
      "location": 2,
      "content": "兄弟卧槽",
      "music": 0.0
    },
    {
      "from": 162.63,
      "to": 164.27,
      "sid": 85,
      "location": 2,
      "content": "你这树里玩的跟挂一样",
      "music": 0.0
    },
    {
      "from": 165.67,
      "to": 166.87,
      "sid": 86,
      "location": 2,
      "content": "现在知道挂吗",
      "music": 0.0
    },
    {
      "from": 166.87,
      "to": 168.09,
      "sid": 87,
      "location": 2,
      "content": "现在知道给打码",
      "music": 0.0
    },
    {
      "from": 168.09,
      "to": 169.43,
      "sid": 88,
      "location": 2,
      "content": "刷墨镜",
      "music": 0.0
    },
    {
      "from": 169.78,
      "to": 170.78,
      "sid": 89,
      "location": 2,
      "content": "给你刷墨镜",
      "music": 0.0
    },
    {
      "from": 170.78,
      "to": 171.86,
      "sid": 90,
      "location": 2,
      "content": "兄弟给谁刷墨镜",
      "music": 0.0
    },
    {
      "from": 171.86,
      "to": 172.38,
      "sid": 91,
      "location": 2,
      "content": "知道了吧",
      "music": 0.0
    },
    {
      "from": 172.38,
      "to": 173.86,
      "sid": 92,
      "location": 2,
      "content": "兄弟哈哈",
      "music": 0.0
    },
    {
      "from": 173.86,
      "to": 174.78,
      "sid": 93,
      "location": 2,
      "content": "OKOK对了",
      "music": 0.0
    },
    {
      "from": 174.78,
      "to": 175.82,
      "sid": 94,
      "location": 2,
      "content": "我给你刷墨镜",
      "music": 0.0
    },
    {
      "from": 175.82,
      "to": 176.74,
      "sid": 95,
      "location": 2,
      "content": "你让我老了",
      "music": 0.0
    },
    {
      "from": 176.74,
      "to": 178.09,
      "sid": 96,
      "location": 2,
      "content": "给你卖个毛线就行",
      "music": 0.0
    },
    {
      "from": 178.09,
      "to": 180.21,
      "sid": 97,
      "location": 2,
      "content": "后来我们连输了好多局",
      "music": 0.0
    },
    {
      "from": 180.21,
      "to": 182.27,
      "sid": 98,
      "location": 2,
      "content": "但我们依然保持激情",
      "music": 0.0
    },
    {
      "from": 182.27,
      "to": 183.21,
      "sid": 99,
      "location": 2,
      "content": "有火有火",
      "music": 0.0
    },
    {
      "from": 183.21,
      "to": 184.56,
      "sid": 100,
      "location": 2,
      "content": "兄弟兄弟哦",
      "music": 0.0
    },
    {
      "from": 184.88,
      "to": 187.66,
      "sid": 101,
      "location": 2,
      "content": "哇这个火烫不烫烫不烫",
      "music": 0.0
    },
    {
      "from": 187.66,
      "to": 189.18,
      "sid": 102,
      "location": 2,
      "content": "别急别急没事",
      "music": 0.0
    },
    {
      "from": 189.18,
      "to": 190.98,
      "sid": 103,
      "location": 2,
      "content": "兄弟狗子先上好吗",
      "music": 0.0
    },
    {
      "from": 190.98,
      "to": 192.04,
      "sid": 104,
      "location": 2,
      "content": "狗子先上",
      "music": 0.0
    },
    {
      "from": 192.04,
      "to": 195.78,
      "sid": 105,
      "location": 2,
      "content": "OKOK我感觉他们真的是来打仗的",
      "music": 0.0
    },
    {
      "from": 195.78,
      "to": 199.86,
      "sid": 106,
      "location": 2,
      "content": "这时我已经觉得这局游戏无论最后胜利与否",
      "music": 0.0
    },
    {
      "from": 199.86,
      "to": 201.76,
      "sid": 107,
      "location": 2,
      "content": "都是一场尽兴的比赛",
      "music": 0.0
    },
    {
      "from": 201.76,
      "to": 203.18,
      "sid": 108,
      "location": 2,
      "content": "特别是杰峰哥",
      "music": 0.0
    },
    {
      "from": 203.18,
      "to": 205.64,
      "sid": 109,
      "location": 2,
      "content": "他给的反馈真是太高级了",
      "music": 0.0
    },
    {
      "from": 205.64,
      "to": 208.019,
      "sid": 110,
      "location": 2,
      "content": "对治疗哪有口奶粉兄弟的哇",
      "music": 0.0
    },
    {
      "from": 208.019,
      "to": 209.779,
      "sid": 111,
      "location": 2,
      "content": "可惜在实力面前",
      "music": 0.0
    },
    {
      "from": 209.779,
      "to": 212.18,
      "sid": 112,
      "location": 2,
      "content": "我们的激情好像不值一提",
      "music": 0.0
    },
    {
      "from": 212.18,
      "to": 214.18,
      "sid": 113,
      "location": 2,
      "content": "我们依然是一分都拿不到",
      "music": 0.0
    },
    {
