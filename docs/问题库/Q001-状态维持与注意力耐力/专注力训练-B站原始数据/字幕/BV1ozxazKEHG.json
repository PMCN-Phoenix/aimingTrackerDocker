    "location": 2,
    "music": 0.0,
    "sid": 171,
    "to": 418.55
  },
  {
    "content": "而你最容易欺骗自己",
    "from": 418.55,
    "location": 2,
    "music": 0.0,
    "sid": 172,
    "to": 420.94
  },
  {
    "content": "这意味着你无法欺骗自己",
