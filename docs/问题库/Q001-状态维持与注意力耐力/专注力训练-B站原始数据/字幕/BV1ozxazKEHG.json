    "location": 2,
    "music": 0.0,
    "sid": 209,
    "to": 518.4
  },
  {
    "content": "对自己诚实",
    "from": 518.52,
    "location": 2,
    "music": 0.0,
    "sid": 210,
    "to": 520.04
  },
  {
    "content": "你曾多少次许下改变的诺言",
    "from": 520.04,
    "location": 2,
    "music": 0.0,
    "sid": 211,
    "to": 522.5
  },
  {
    "content": "却在第一次困难时放弃",
