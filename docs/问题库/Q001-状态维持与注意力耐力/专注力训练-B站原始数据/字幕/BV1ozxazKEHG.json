    "location": 2,
    "music": 0.0,
    "sid": 155,
    "to": 378.98
  },
  {
    "content": "区别在于情感",
    "from": 378.98,
    "location": 2,
    "music": 0.0,
    "sid": 156,
    "to": 381.03
  },
  {
    "content": "享受过程的人无需外在动力",
    "from": 381.03,
    "location": 2,
    "music": 0.0,
    "sid": 157,
    "to": 385.11
  },
  {
    "content": "因为学习本身",
