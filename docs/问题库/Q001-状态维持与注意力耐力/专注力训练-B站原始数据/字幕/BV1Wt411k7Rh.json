[
  {
    "from": 0.92,
    "to": 3.4,
    "sid": 1,
    "location": 2,
    "content": "欢迎来到七天焦点"
  },
  {
    "from": 3.4,
    "to": 8.56,
    "sid": 2,
    "location": 2,
    "content": "一个旨在提高你日常生活注意力的正念计划"
  },
  {
    "from": 9.12,
    "to": 14.28,
    "sid": 3,
    "location": 2,
    "content": "生产力的最大贡献者之一是专注的能力"
  },
  {
    "from": 14.28,
    "to": 18.68,
    "sid": 4,
    "location": 2,
    "content": "那就是把我们的注意力集中在某件事上的能力"
  },
  {
    "from": 18.96,
    "to": 22.0,
    "sid": 5,
    "location": 2,
    "content": "专注帮助我们紧盯目标"
  },
  {
    "from": 22.0,
    "to": 23.98,
    "sid": 6,
    "location": 2,
    "content": "这是清晰的钥匙"
  },
  {
    "from": 23.98,
    "to": 26.46,
    "sid": 7,
    "location": 2,
    "content": "效率和浓度"
  },
  {
    "from": 26.759,
    "to": 32.558,
    "sid": 8,
    "location": 2,
    "content": "问题是注意力是一种有限的资源，分心无处不在"
  },
  {
    "from": 32.78,
    "to": 36.92,
    "sid": 9,
    "location": 2,
    "content": "我们是否发现自己被一个健谈的同事拉走了"
  },
  {
    "from": 36.92,
    "to": 38.16,
    "sid": 10,
    "location": 2,
    "content": "糖固定"
  },
  {
    "from": 38.16,
    "to": 41.33,
    "sid": 11,
    "location": 2,
    "content": "数字媒体还是网飞的新热门"
  },
  {
    "from": 41.33,
    "to": 45.5,
    "sid": 12,
    "location": 2,
    "content": "我们比以往任何时候都有更多的竞争来吸引我们的注意力"
  },
  {
    "from": 45.68,
    "to": 47.74,
    "sid": 13,
    "location": 2,
    "content": "我们忙于一心多用"
  },
  {
    "from": 47.74,
    "to": 49.58,
    "sid": 14,
    "location": 2,
    "content": "努力完成事情"
  },
  {
    "from": 49.58,
    "to": 51.96,
    "sid": 15,
    "location": 2,
    "content": "世界各地的人们都在经历"
  },
  {
    "from": 51.96,
    "to": 55.78,
    "sid": 16,
    "location": 2,
    "content": "对我们大多数人来说，这是一种不堪重负的流行病"
  },
  {
    "from": 55.78,
    "to": 62.019,
    "sid": 17,
    "location": 2,
    "content": "在接下来的七天里，锚定我们的注意力已经成为每天的挑战"
  },
  {
    "from": 62.1,
    "to": 65.58,
    "sid": 18,
    "location": 2,
    "content": "我们将探索如何通过学习来提高我们的注意力"
  },
  {
    "from": 65.58,
    "to": 70.0,
    "sid": 19,
    "location": 2,
    "content": "如何提高对习惯的认识，加深注意力"
  },
  {
    "from": 70.44,
    "to": 72.74,
    "sid": 20,
    "location": 2,
    "content": "我们将探索确定优先级的方法"
  },
  {
    "from": 73.02,
    "to": 79.42,
    "sid": 21,
    "location": 2,
    "content": "如何抵制数字分心的拉力，防止信息过载"
  },
  {
    "from": 79.58,
    "to": 83.22,
    "sid": 22,
    "location": 2,
    "content": "我们还将讨论放慢速度的好处"
  },
  {
    "from": 83.22,
    "to": 87.22,
    "sid": 23,
    "location": 2,
    "content": "今天一次做一件事"
  },
  {
    "from": 87.22,
    "to": 90.24,
    "sid": 24,
    "location": 2,
    "content": "我们将从最重要的一步开始"
  },
  {
    "from": 90.4,
    "to": 94.48,
    "sid": 25,
    "location": 2,
    "content": "发展对我们的习惯和倾向的认识"
  },
  {
    "from": 94.64,
    "to": 98.94,
    "sid": 26,
    "location": 2,
    "content": "如果我们能提高对自己倾向和实践的认识"
  },
  {
    "from": 98.94,
    "to": 104.16,
    "sid": 27,
    "location": 2,
    "content": "一天中每时每刻的意识会更少分心"
  },
  {
    "from": 104.16,
    "to": 105.64,
    "sid": 28,
    "location": 2,
    "content": "当我们"
  },
  {
    "from": 105.64,
    "to": 109.26,
    "sid": 29,
    "location": 2,
    "content": "我们就有更好的机会回到我们的焦点上"
  },
  {
    "from": 109.26,
    "to": 116.179,
    "sid": 30,
    "location": 2,
    "content": "更早地注意到我们已经渐行渐远是回来的第一步"
  },
  {
    "from": 116.74,
    "to": 121.48,
    "sid": 31,
    "location": 2,
    "content": "我们将很快探索我们的一些倾向，作为提高意识的一种方式"
  },
  {
    "from": 121.48,
    "to": 124.98,
    "sid": 32,
    "location": 2,
    "content": "但现在让我们开始练习"
  },
  {
    "from": 125.94,
    "to": 130.18,
    "sid": 33,
    "location": 2,
    "content": "找一个不被打扰的安静地方坐"
  },
  {
    "from": 131.46,
    "to": 136.4,
    "sid": 34,
    "location": 2,
    "content": "舒舒服服地坐着，挺直背，闭上眼睛"
  },
  {
    "from": 139.92,
    "to": 143.2,
    "sid": 35,
    "location": 2,
    "content": "肩膀和手容易休息"
  },
  {
    "from": 144.319,
    "to": 147.44,
    "sid": 36,
    "location": 2,
    "content": "感觉自己开始放松"
  },
  {
    "from": 168.519,
    "to": 169.86,
    "sid": 37,
    "location": 2,
    "content": "你的嘴唇"
  },
  {
    "from": 174.1,
    "to": 177.64,
    "sid": 38,
    "location": 2,
    "content": "深深吸气"
  },
  {
    "from": 181.34,
    "to": 183.48,
    "sid": 39,
    "location": 2,
    "content": "慢慢松开"
  },
  {
    "from": 188.079,
    "to": 193.22,
    "sid": 40,
    "location": 2,
    "content": "让你的胸部充满空气，然后释放它"
  },
  {
    "from": 198.659,
    "to": 204.8,
    "sid": 41,
    "location": 2,
    "content": "每次呼吸你都会更放松一点"
  },
  {
    "from": 220.959,
    "to": 223.6,
    "sid": 42,
    "location": 2,
    "content": "现在让你的呼吸恢复正常"
  },
  {
    "from": 225.139,
    "to": 228.54,
    "sid": 43,
    "location": 2,
    "content": "让它感觉轻盈轻松"
  },
  {
    "from": 234.64,
    "to": 241.76,
    "sid": 44,
    "location": 2,
    "content": "只要把注意力集中在呼吸上，注意哪里感觉最强烈"
  },
  {
    "from": 243.34,
    "to": 246.4,
    "sid": 45,
    "location": 2,
    "content": "那可能是肚子的升降"
  },
  {
    "from": 247.82,
    "to": 251.42,
    "sid": 46,
    "location": 2,
    "content": "肺的扩张和收缩"
  },
  {
    "from": 252.34,
    "to": 257.64,
    "sid": 47,
    "location": 2,
    "content": "也可能是凉爽或温暖的空气流过你的鼻孔"
  },
  {
    "from": 262.599,
    "to": 265.62,
    "sid": 48,
    "location": 2,
    "content": "呼吸最强烈的地方"
  },
  {
    "from": 266.26,
    "to": 268.7,
    "sid": 49,
    "location": 2,
    "content": "把你的注意力放在那一点上"
  },
  {
    "from": 268.7,
    "to": 271.52,
    "sid": 50,
    "location": 2,
    "content": "并全神贯注于此"
  },
  {
    "from": 275.96,
    "to": 277.22,
    "sid": 51,
    "location": 2,
    "content": "跟着呼吸"
  },
  {
    "from": 278.48,
    "to": 280.3,
    "sid": 52,
    "location": 2,
    "content": "一路跟着它进去"
  },
  {
    "from": 280.3,
    "to": 283.38,
    "sid": 53,
    "location": 2,
    "content": "直到吸气的最后"
  },
  {
    "from": 284.86,
    "to": 288.08,
    "sid": 54,
    "location": 2,
    "content": "然后当你的吸气结束时"
  },
  {
    "from": 288.46,
    "to": 292.9,
    "sid": 55,
    "location": 2,
    "content": "跟着呼吸一直到呼气"
  },
  {
    "from": 358.619,
    "to": 360.839,
    "sid": 56,
    "location": 2,
    "content": "你会时不时地发现"
  },
  {
    "from": 360.839,
    "to": 362.88,
    "sid": 57,
    "location": 2,
    "content": "你的思绪会飘忽不定"
  },
  {
    "from": 363.5,
    "to": 364.32,
    "sid": 58,
    "location": 2,
    "content": "别担心"
  },
  {
    "from": 364.32,
    "to": 365.06,
    "sid": 59,
    "location": 2,
    "content": "当这种情况发生时"
  },
  {
    "from": 366.18,
    "to": 366.98,
    "sid": 60,
    "location": 2,
    "content": "这不是问题"
  },
  {
    "from": 367.98,
    "to": 369.38,
    "sid": 61,
    "location": 2,
    "content": "这不是一个错误"
  },
  {
    "from": 370.0,
    "to": 372.04,
    "sid": 62,
    "location": 2,
    "content": "这就是头脑所做的"
  },
  {
    "from": 372.64,
    "to": 377.34,
    "sid": 63,
    "location": 2,
    "content": "只是借此机会注意到你已经渐行渐远了"
  },
  {
    "from": 378.18,
    "to": 380.46,
    "sid": 64,
    "location": 2,
    "content": "这就是练习的意义"
  },
  {
    "from": 381.78,
    "to": 383.42,
    "sid": 65,
    "location": 2,
    "content": "注意到我们的模式"
  },
  {
    "from": 384.22,
    "to": 385.6,
    "sid": 66,
    "location": 2,
    "content": "注意头脑"
  },
  {
    "from": 386.96,
    "to": 392.04,
    "sid": 67,
    "location": 2,
    "content": "注意到把我们从当下带走的分心"
  },
  {
    "from": 394.12,
    "to": 400.0,
    "sid": 68,
    "location": 2,
    "content": "每次你注意到你的思想在哪里而不持有任何判断"
  },
  {
    "from": 400.66,
    "to": 404.34,
    "sid": 69,
    "location": 2,
    "content": "轻轻地把你的注意力带回呼吸"
  },
  {
    "from": 406.26,
    "to": 410.84,
    "sid": 70,
    "location": 2,
    "content": "一遍又一遍地回到呼吸中"
  },
  {
    "from": 481.759,
    "to": 483.559,
    "sid": 71,
    "location": 2,
    "content": "注意你的心思在哪里"
  },
  {
    "from": 485.839,
    "to": 490.7,
    "sid": 72,
    "location": 2,
    "content": "如果你发现自己被善良温柔的耐心分心"
  },
  {
    "from": 492.34,
    "to": 494.2,
    "sid": 73,
    "location": 2,
    "content": "把注意力集中在呼吸上"
  },
  {
    "from": 495.62,
    "to": 497.86,
    "sid": 74,
    "location": 2,
    "content": "不断观察你的思想在哪里"
  },
  {
    "from": 498.9,
    "to": 503.02,
    "sid": 75,
    "location": 2,
    "content": "并不断回来作为你的愤怒"
  },
  {
    "from": 547.66,
    "to": 551.02,
    "sid": 76,
    "location": 2,
    "content": "在这种静止意识的状态下"
  },
  {
    "from": 551.76,
    "to": 557.439,
    "sid": 77,
    "location": 2,
    "content": "花点时间回顾一下一天中最常让你分心的事情"
  },
  {
    "from": 558.76,
    "to": 560.12,
    "sid": 78,
    "location": 2,
    "content": "可能是社交媒体"
  },
  {
    "from": 561.12,
    "to": 562.219,
    "sid": 79,
    "location": 2,
    "content": "电视"
  },
  {
    "from": 562.34,
    "to": 564.74,
    "sid": 80,
    "location": 2,
    "content": "健谈的同事或家庭成员"
  },
  {
    "from": 565.86,
    "to": 566.38,
    "sid": 81,
    "location": 2,
    "content": "食品"
  },
  {
    "from": 566.38,
    "to": 567.36,
    "sid": 82,
    "location": 2,
    "content": "购物"
  },
  {
    "from": 567.36,
    "to": 568.04,
    "sid": 83,
    "location": 2,
    "content": "电子邮件"
  },
  {
    "from": 568.04,
    "to": 569.24,
    "sid": 84,
    "location": 2,
    "content": "或者电话"
  },
  {
    "from": 570.2,
    "to": 573.06,
    "sid": 85,
    "location": 2,
    "content": "也许它忘记了你在做什么"
  },
  {
    "from": 573.06,
    "to": 575.64,
    "sid": 86,
    "location": 2,
    "content": "因为你一次尝试太多了"
  },
  {
    "from": 575.98,
    "to": 577.78,
    "sid": 87,
    "location": 2,
    "content": "整理你的办公桌"
  },
  {
    "from": 577.78,
    "to": 580.12,
    "sid": 88,
    "location": 2,
    "content": "或者迷失在白日梦中"
  },
  {
    "from": 581.34,
    "to": 586.459,
    "sid": 89,
    "location": 2,
    "content": "花点时间扫描一下典型的一天是什么样子的"
  },
  {
    "from": 586.98,
    "to": 588.86,
    "sid": 90,
    "location": 2,
    "content": "对自己诚实"
  },
  {
    "from": 588.86,
    "to": 594.56,
    "sid": 91,
    "location": 2,
    "content": "关于最常见的让你分心的事情"
  },
  {
    "from": 628.52,
    "to": 632.3,
    "sid": 92,
    "location": 2,
    "content": "所有这些分心的东西都有一个共同点"
  },
  {
    "from": 632.3,
    "to": 636.079,
    "sid": 93,
    "location": 2,
    "content": "是否偏离了我们的优先事项"
  },
  {
    "from": 636.64,
    "to": 639.5,
    "sid": 94,
    "location": 2,
    "content": "为了驯服这些干扰"
  },
  {
    "from": 639.5,
    "to": 645.38,
    "sid": 95,
    "location": 2,
    "content": "我们需要首先意识到什么最常引起我们的注意"
  },
  {
    "from": 645.8,
    "to": 649.52,
    "sid": 96,
    "location": 2,
    "content": "每次我们注意到我们被拉开了"
  },
  {
    "from": 649.98,
    "to": 653.939,
    "sid": 97,
    "location": 2,
    "content": "我们努力停下来把自己带回来"
  },
  {
    "from": 654.48,
    "to": 660.199,
    "sid": 98,
    "location": 2,
    "content": "就像我们呼吸一样，我们发现自己分心了"
  },
  {
    "from": 660.6,
    "to": 663.0,
    "sid": 99,
    "location": 2,
    "content": "我们的注意力被转移了"
  },
  {
    "from": 663.0,
    "to": 669.2,
    "sid": 100,
    "location": 2,
    "content": "所以我们暂停意识，今天回来"
  },
  {
    "from": 669.2,
    "to": 672.339,
    "sid": 101,
    "location": 2,
    "content": "只要注意到你分心的时候"
  },
  {
    "from": 672.58,
    "to": 674.38,
    "sid": 102,
    "location": 2,
    "content": "你不必做任何事情"
  },
  {
    "from": 674.38,
    "to": 675.04,
    "sid": 103,
    "location": 2,
    "content": "然而"
  },
  {
    "from": 675.04,
    "to": 679.04,
    "sid": 104,
    "location": 2,
    "content": "只是试着加强注意的质量"
  },
  {
    "from": 679.36,
    "to": 681.02,
    "sid": 105,
    "location": 2,
    "content": "这是第一步"
  },
  {
    "from": 683.8,
    "to": 686.939,
    "sid": 106,
    "location": 2,
    "content": "当我们接近练习结束时"
  },
  {
    "from": 687.92,
    "to": 691.02,
    "sid": 107,
    "location": 2,
    "content": "做最后几次深呼吸"
  },
  {
    "from": 701.82,
    "to": 708.8,
    "sid": 108,
    "location": 2,
    "content": "只是放松到身体中，设置注意的意图"
  },
  {
    "from": 723.64,
    "to": 725.32,
    "sid": 109,
    "location": 2,
    "content": "现在回到房间"
  },
  {
    "from": 727.28,
    "to": 729.16,
    "sid": 110,
    "location": 2,
    "content": "回到身体"
  },
  {
    "from": 729.68,
    "to": 730.84,
    "sid": 111,
    "location": 2,
    "content": "当你准备好了"
  },
  {
    "from": 732.0,
    "to": 734.14,
    "sid": 112,
    "location": 2,
    "content": "让你的眼睛睁开"
  },
  {
    "from": 735.98,
    "to": 740.5,
    "sid": 113,
    "location": 2,
    "content": "祝贺你完成了七天焦点中的第一天"
  },
  {
    "from": 741.7,
    "to": 744.54,
    "sid": 114,
    "location": 2,
    "content": "我们明天在这里见第二天"
  },
  {
    "from": 744.54,
    "to": 748.5,
    "sid": 115,
    "location": 2,
    "content": "在那里我们将探讨优先级的重要性"
  }
]