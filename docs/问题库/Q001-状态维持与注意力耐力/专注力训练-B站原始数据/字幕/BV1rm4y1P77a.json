[
  {
    "from": 0.12,
    "to": 1.98,
    "sid": 1,
    "location": 2,
    "content": "集中注意力真的有外挂",
    "music": 0.0
  },
  {
    "from": 1.98,
    "to": 3.42,
    "sid": 2,
    "location": 2,
    "content": "这篇内容真的已经绞尽了脑汁",
    "music": 0.0
  },
  {
    "from": 3.42,
    "to": 5.199,
    "sid": 3,
    "location": 2,
    "content": "我看了所有我能看的资料",
    "music": 0.0
  },
  {
    "from": 5.199,
    "to": 9.039,
    "sid": 4,
    "location": 2,
    "content": "分享四个我目前认为最先进的注意力训练方法",
    "music": 0.0
  },
  {
    "from": 9.039,
    "to": 9.279,
    "sid": 5,
    "location": 2,
    "content": "什么",
    "music": 0.0
  },
  {
    "from": 9.279,
    "to": 10.119,
    "sid": 6,
    "location": 2,
    "content": "这个视频太长了",
    "music": 0.0
  },
  {
    "from": 10.119,
    "to": 10.86,
    "sid": 7,
    "location": 2,
    "content": "你看不下去",
    "music": 0.0
  },
  {
    "from": 10.86,
    "to": 12.33,
    "sid": 8,
    "location": 2,
    "content": "什么读书的时候老是走神",
    "music": 0.0
  },
  {
    "from": 12.33,
    "to": 13.68,
    "sid": 9,
    "location": 2,
    "content": "或者家里有小朋友",
    "music": 0.0
  },
  {
    "from": 13.68,
    "to": 14.64,
    "sid": 10,
    "location": 2,
    "content": "或者真的什么考研的",
    "music": 0.0
  },
  {
    "from": 14.64,
    "to": 16.74,
    "sid": 11,
    "location": 2,
    "content": "一定要看我上面说的这个豆瓣高校人生",
    "music": 0.0
  },
  {
    "from": 16.74,
    "to": 18.2,
    "sid": 12,
    "location": 2,
    "content": "如果你是一个注意力不集中",
    "music": 0.0
  },
  {
    "from": 18.2,
    "to": 18.86,
    "sid": 13,
    "location": 2,
    "content": "执行力很差的人",
    "music": 0.0
  },
  {
    "from": 18.86,
    "to": 20.24,
    "sid": 14,
    "location": 2,
    "content": "你一定要先去看那篇",
    "music": 0.0
  },
  {
    "from": 20.24,
    "to": 21.2,
    "sid": 15,
    "location": 2,
    "content": "然后再来看这篇",
    "music": 0.0
  },
  {
    "from": 21.2,
    "to": 22.16,
    "sid": 16,
    "location": 2,
    "content": "这篇是加强篇",
    "music": 0.0
  },
  {
    "from": 22.16,
    "to": 24.44,
    "sid": 17,
    "location": 2,
    "content": "就是专门跟你分享四个具体的训练",
    "music": 0.0
  },
  {
    "from": 24.44,
    "to": 25.5,
    "sid": 18,
    "location": 2,
    "content": "你注意力深度",
    "music": 0.0
  },
  {
    "from": 25.5,
    "to": 27.42,
    "sid": 19,
    "location": 2,
    "content": "还有你注意力持久度的方法",
    "music": 0.0
  },
  {
    "from": 27.42,
    "to": 27.9,
    "sid": 20,
    "location": 2,
    "content": "记得点赞",
    "music": 0.0
  },
  {
    "from": 27.9,
    "to": 28.92,
    "sid": 21,
    "location": 2,
    "content": "第一个方法冥想",
    "music": 0.0
  },
  {
    "from": 28.92,
    "to": 31.94,
    "sid": 22,
    "location": 2,
    "content": "冥想被证明可以改善专注力和执行力的论文",
    "music": 0.0
  },
  {
    "from": 31.94,
    "to": 32.42,
    "sid": 23,
    "location": 2,
    "content": "你就放满",
    "music": 0.0
  },
  {
    "from": 32.42,
    "to": 34.7,
    "sid": 24,
    "location": 2,
    "content": "我整个视频都放不下太多太多这样的论文了",
    "music": 0.0
  },
  {
    "from": 34.7,
    "to": 37.499,
    "sid": 25,
    "location": 2,
    "content": "但是很多人以为的冥想就是我打坐",
    "music": 0.0
  },
  {
    "from": 37.499,
    "to": 39.69,
    "sid": 26,
    "location": 2,
    "content": "然后闭上眼睛观察我的呼吸",
    "music": 0.0
  },
  {
    "from": 39.69,
    "to": 41.25,
    "sid": 27,
    "location": 2,
    "content": "如果你经常做这种冥想的话",
    "music": 0.0
  },
  {
    "from": 41.25,
    "to": 42.33,
    "sid": 28,
    "location": 2,
    "content": "那么有一定的概率",
    "music": 0.0
  },
  {
    "from": 42.33,
    "to": 43.71,
    "sid": 29,
    "location": 2,
    "content": "你的注意力会越来越不集中",
    "music": 0.0
  },
  {
    "from": 43.71,
    "to": 45.57,
    "sid": 30,
    "location": 2,
    "content": "为什么当我们正常放松的情况下",
    "music": 0.0
  },
  {
    "from": 45.57,
    "to": 46.83,
    "sid": 31,
    "location": 2,
    "content": "我们的注意力是分散的哦",
    "music": 0.0
  },
  {
    "from": 46.83,
    "to": 48.5,
    "sid": 32,
    "location": 2,
    "content": "虽然我的眼睛正在看着你",
    "music": 0.0
  },
  {
    "from": 48.5,
    "to": 50.54,
    "sid": 33,
    "location": 2,
    "content": "但是实际上这个侧边有什么东西在动",
    "music": 0.0
  },
  {
    "from": 50.54,
    "to": 51.62,
    "sid": 34,
    "location": 2,
    "content": "我是可以感觉到的",
    "music": 0.0
  },
  {
    "from": 51.62,
    "to": 53.0,
    "sid": 35,
    "location": 2,
    "content": "因为我们的大脑会分散一部分的注意力",
    "music": 0.0
  },
  {
    "from": 53.0,
    "to": 54.14,
    "sid": 36,
    "location": 2,
    "content": "在我们周围的环境",
    "music": 0.0
  },
  {
    "from": 54.14,
    "to": 56.93,
    "sid": 37,
    "location": 2,
    "content": "所以冥想的第一步就是把你周围分散的注意力",
    "music": 0.0
  },
  {
    "from": 56.93,
    "to": 58.57,
    "sid": 38,
    "location": 2,
    "content": "集中成这样的一个点",
    "music": 0.0
  },
  {
    "from": 58.57,
    "to": 60.85,
    "sid": 39,
    "location": 2,
    "content": "我们这个注意力的点主要会在两个方面",
    "music": 0.0
  },
  {
    "from": 60.85,
    "to": 62.41,
    "sid": 40,
    "location": 2,
    "content": "第一个方面就是你自身",
    "music": 0.0
  },
  {
    "from": 62.41,
    "to": 65.17,
    "sid": 41,
    "location": 2,
    "content": "当我们把这个注意力的点放在了我身体",
    "music": 0.0
  },
  {
    "from": 65.17,
    "to": 66.64,
    "sid": 42,
    "location": 2,
    "content": "皮肤以内的所有地方",
    "music": 0.0
  },
  {
    "from": 66.64,
    "to": 67.54,
    "sid": 43,
    "location": 2,
    "content": "比如说我的器官",
    "music": 0.0
  },
  {
    "from": 67.54,
    "to": 68.33,
    "sid": 44,
    "location": 2,
    "content": "我的呼吸",
    "music": 0.0
  },
  {
    "from": 68.33,
    "to": 70.37,
    "sid": 45,
    "location": 2,
    "content": "甚至是我脑袋里面的想法的时候",
    "music": 0.0
  },
  {
    "from": 70.37,
    "to": 71.87,
    "sid": 46,
    "location": 2,
    "content": "这种情况叫做内感",
    "music": 0.0
  },
  {
    "from": 71.87,
    "to": 73.07,
    "sid": 47,
    "location": 2,
    "content": "但是这个注意力的点",
    "music": 0.0
  },
  {
    "from": 73.07,
    "to": 75.17,
    "sid": 48,
    "location": 2,
    "content": "它也可以放在你周围的环境里面啊",
    "music": 0.0
  },
  {
    "from": 75.17,
    "to": 76.45,
    "sid": 49,
    "location": 2,
    "content": "比如说放在后面这个柜子上",
    "music": 0.0
  },
  {
    "from": 76.45,
    "to": 77.62,
    "sid": 50,
    "location": 2,
    "content": "放在我这个电脑上",
    "music": 0.0
  },
  {
    "from": 77.62,
    "to": 78.91,
    "sid": 51,
    "location": 2,
    "content": "甚至是放在一本书上",
    "music": 0.0
  },
  {
    "from": 78.91,
    "to": 80.0,
    "sid": 52,
    "location": 2,
    "content": "当这个注意力的点",
    "music": 0.0
  },
  {
    "from": 80.0,
    "to": 82.04,
    "sid": 53,
    "location": 2,
    "content": "放在了你的周围环境上的时候",
    "music": 0.0
  },
  {
    "from": 82.04,
    "to": 83.15,
    "sid": 54,
    "location": 2,
    "content": "这就称之为国外感",
    "music": 0.0
  },
  {
    "from": 83.15,
    "to": 85.46,
    "sid": 55,
    "location": 2,
    "content": "而且当我们集中注意力去做一件事情的时候",
    "music": 0.0
  },
  {
    "from": 85.46,
    "to": 88.14,
    "sid": 56,
    "location": 2,
    "content": "我们这个注意力的点是随着你正在做的事情",
    "music": 0.0
  },
  {
    "from": 88.14,
    "to": 89.74,
    "sid": 57,
    "location": 2,
    "content": "来回的在这条线上移动的",
    "music": 0.0
  },
  {
    "from": 89.74,
    "to": 90.22,
    "sid": 58,
    "location": 2,
    "content": "打个比方",
    "music": 0.0
  },
  {
    "from": 90.22,
    "to": 91.42,
    "sid": 59,
    "location": 2,
    "content": "我现在正在听你说话啊",
    "music": 0.0
  },
  {
    "from": 91.42,
    "to": 92.14,
    "sid": 60,
    "location": 2,
    "content": "我听你说话的时候",
    "music": 0.0
  },
  {
    "from": 92.14,
    "to": 94.18,
    "sid": 61,
    "location": 2,
    "content": "我注意力的这个点是更偏向于外的",
    "music": 0.0
  },
  {
    "from": 94.18,
    "to": 96.46,
    "sid": 62,
    "location": 2,
    "content": "然后当我在想你说的这个话是什么意思的时候",
    "music": 0.0
  },
  {
    "from": 96.46,
    "to": 97.96,
    "sid": 63,
    "location": 2,
    "content": "我的注意力就更偏向于内感",
    "music": 0.0
  },
  {
    "from": 97.96,
    "to": 99.08,
    "sid": 64,
    "location": 2,
    "content": "当我想清楚了",
    "music": 0.0
  },
  {
    "from": 99.08,
    "to": 100.28,
    "sid": 65,
    "location": 2,
    "content": "再次跟你说话的时候",
    "music": 0.0
  },
  {
    "from": 100.28,
    "to": 102.02,
    "sid": 66,
    "location": 2,
    "content": "这个注意力的点会往外感移动",
    "music": 0.0
  },
  {
    "from": 102.02,
    "to": 102.98,
    "sid": 67,
    "location": 2,
    "content": "但是它还在内感上",
    "music": 0.0
  },
  {
    "from": 102.98,
    "to": 104.22,
    "sid": 68,
    "location": 2,
    "content": "因为当我们在输出的时候",
    "music": 0.0
  },
  {
    "from": 104.22,
    "to": 105.54,
    "sid": 69,
    "location": 2,
    "content": "内感还是占了主导地位",
    "music": 0.0
  },
  {
    "from": 105.54,
    "to": 106.56,
    "sid": 70,
    "location": 2,
    "content": "只是增加了一些外感",
    "music": 0.0
  },
  {
    "from": 106.56,
    "to": 107.88,
    "sid": 71,
    "location": 2,
    "content": "所以什么叫做注意力集中",
    "music": 0.0
  },
  {
    "from": 107.88,
    "to": 109.8,
    "sid": 72,
    "location": 2,
    "content": "注意力集中的意思就是你注意力的这个点",
    "music": 0.0
  },
  {
    "from": 109.8,
    "to": 112.2,
    "sid": 73,
    "location": 2,
    "content": "可以随着你当下正在做的这件事情",
    "music": 0.0
  },
  {
    "from": 112.2,
    "to": 115.44,
    "sid": 74,
    "location": 2,
    "content": "自由的在内感和外感的这条线上来回的移动",
    "music": 0.0
  },
  {
    "from": 115.44,
    "to": 116.76,
    "sid": 75,
    "location": 2,
    "content": "那什么叫做注意力不集中",
    "music": 0.0
  },
  {
    "from": 116.76,
    "to": 117.72,
    "sid": 76,
    "location": 2,
    "content": "什么叫做走神呢",
    "music": 0.0
  },
  {
    "from": 117.72,
    "to": 119.79,
    "sid": 77,
    "location": 2,
    "content": "走神的意思就是你注意力的这个点",
    "music": 0.0
  },
  {
    "from": 119.79,
    "to": 122.52,
    "sid": 78,
    "location": 2,
    "content": "它不再随着你正在做的这件事情来回的移动",
    "music": 0.0
  },
  {
    "from": 122.52,
    "to": 123.93,
    "sid": 79,
    "location": 2,
    "content": "它进入到了一个固定的状态",
    "music": 0.0
  },
  {
    "from": 123.93,
    "to": 126.7,
    "sid": 80,
    "location": 2,
    "content": "有非常多人你注意力的点都是固定在了内感上",
    "music": 0.0
  },
  {
    "from": 126.7,
    "to": 128.14,
    "sid": 81,
    "location": 2,
    "content": "这样的人他会有什么样的表现呢",
    "music": 0.0
  },
  {
    "from": 128.14,
    "to": 129.82,
    "sid": 82,
    "location": 2,
    "content": "就比如说有一个人在跟我说话",
    "music": 0.0
  },
  {
    "from": 129.82,
    "to": 131.02,
    "sid": 83,
    "location": 2,
    "content": "但是我听不见他在说什么",
    "music": 0.0
  },
  {
    "from": 131.02,
    "to": 133.16,
    "sid": 84,
    "location": 2,
    "content": "我就看到他的嘴巴叭叭叭叭一直在扒",
    "music": 0.0
  },
  {
    "from": 133.16,
    "to": 135.44,
    "sid": 85,
    "location": 2,
    "content": "这种情况就是属于原本你的注意力的点",
    "music": 0.0
  },
  {
    "from": 135.44,
    "to": 137.12,
    "sid": 86,
    "location": 2,
    "content": "应该更偏向于在这个外感的位置",
    "music": 0.0
  },
  {
    "from": 137.12,
    "to": 139.64,
    "sid": 87,
    "location": 2,
    "content": "但是这些人的点它被固定在了内感上",
    "music": 0.0
  },
  {
    "from": 139.64,
    "to": 140.66,
    "sid": 88,
    "location": 2,
    "content": "不再来回移动了",
    "music": 0.0
  },
  {
    "from": 140.66,
    "to": 142.16,
    "sid": 89,
    "location": 2,
    "content": "比如有非常多人喜欢幻想",
    "music": 0.0
  },
  {
    "from": 142.16,
    "to": 143.69,
    "sid": 90,
    "location": 2,
    "content": "他停留在自己的内心世界里面",
    "music": 0.0
  },
  {
    "from": 143.69,
    "to": 145.319,
    "sid": 91,
    "location": 2,
    "content": "还有一些社恐的人啊",
    "music": 0.0
  },
  {
    "from": 145.319,
    "to": 146.519,
    "sid": 92,
    "location": 2,
    "content": "他在跟人家社交的时候",
    "music": 0.0
  },
  {
    "from": 146.519,
    "to": 147.839,
    "sid": 93,
    "location": 2,
    "content": "他的注意力不在社交上",
    "music": 0.0
  },
  {
    "from": 147.839,
    "to": 149.099,
    "sid": 94,
    "location": 2,
    "content": "他的注意力放在了啊",
    "music": 0.0
  },
  {
    "from": 149.099,
    "to": 150.26,
    "sid": 95,
    "location": 2,
    "content": "我的脸红不红啊",
    "music": 0.0
  },
  {
    "from": 150.26,
    "to": 151.55,
    "sid": 96,
    "location": 2,
    "content": "我的心跳快不快啊",
    "music": 0.0
  },
  {
    "from": 151.55,
    "to": 152.54,
    "sid": 97,
    "location": 2,
    "content": "我尴不尴尬",
    "music": 0.0
  },
  {
    "from": 152.54,
    "to": 153.92,
    "sid": 98,
    "location": 2,
    "content": "或者我的牙齿上有没有东西",
    "music": 0.0
  },
  {
    "from": 153.92,
    "to": 156.22,
    "sid": 99,
    "location": 2,
    "content": "这些通通都属于内感太严重",
    "music": 0.0
  },
  {
    "from": 156.22,
    "to": 158.62,
    "sid": 100,
    "location": 2,
    "content": "当然也有一些人他是更偏向于外感",
    "music": 0.0
  },
  {
    "from": 158.62,
    "to": 159.7,
    "sid": 101,
    "location": 2,
    "content": "比如当你要写作业的时候",
    "music": 0.0
  },
  {
    "from": 159.7,
    "to": 161.459,
    "sid": 102,
    "location": 2,
    "content": "你老是想要去玩旁边的手机",
    "music": 0.0
  },
  {
    "from": 161.459,
    "to": 163.259,
    "sid": 103,
    "location": 2,
    "content": "或者你老是想要逗这只猫猫",
    "music": 0.0
  },
  {
    "from": 163.259,
    "to": 163.799,
    "sid": 104,
    "location": 2,
    "content": "逗狗狗",
    "music": 0.0
  },
  {
    "from": 163.799,
    "to": 165.94,
    "sid": 105,
    "location": 2,
    "content": "或者你老是被窗外的一些风景给吸引注意力",
    "music": 0.0
  },
  {
    "from": 165.94,
    "to": 167.05,
    "sid": 106,
    "location": 2,
    "content": "外感严重的人",
    "music": 0.0
  },
  {
    "from": 167.05,
    "to": 169.84,
    "sid": 107,
    "location": 2,
    "content": "他们往往很难感受到身体的一些活动",
    "music": 0.0
  },
  {
    "from": 169.84,
    "to": 170.62,
    "sid": 108,
    "location": 2,
    "content": "大部分情况下",
    "music": 0.0
  },
  {
    "from": 170.62,
    "to": 172.78,
    "sid": 109,
    "location": 2,
    "content": "他们都会被外部的环境不断刺激到",
    "music": 0.0
  },
  {
    "from": 172.78,
