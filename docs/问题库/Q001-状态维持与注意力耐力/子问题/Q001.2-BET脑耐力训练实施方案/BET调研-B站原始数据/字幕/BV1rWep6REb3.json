[
  {
    "from": 0.04,
    "to": 3.34,
    "sid": 1,
    "location": 2,
    "content": "大多数人需要三个月才能搞懂一个新学科",
    "music": 0.0
  },
  {
    "from": 3.34,
    "to": 5.86,
    "sid": 2,
    "location": 2,
    "content": "牛津学生七天就能掌握一个新课题",
    "music": 0.0
  },
  {
    "from": 5.86,
    "to": 8.22,
    "sid": 3,
    "location": 2,
    "content": "然后面对面为一个世界级专家辩护",
    "music": 0.0
  },
  {
    "from": 8.22,
    "to": 10.46,
    "sid": 4,
    "location": 2,
    "content": "而对方会攻击他们说的每一句话",
    "music": 0.0
  },
  {
    "from": 10.46,
    "to": 11.99,
    "sid": 5,
    "location": 2,
    "content": "他们并不比你聪明",
    "music": 0.0
  },
  {
    "from": 11.99,
    "to": 15.07,
    "sid": 6,
    "location": 2,
    "content": "他们只是用了三个学校永远不会教的狠招",
    "music": 0.0
  },
  {
    "from": 15.07,
    "to": 17.55,
    "sid": 7,
    "location": 2,
    "content": "第三个大多数人听了都会想",
    "music": 0.0
  },
  {
    "from": 17.55,
    "to": 19.63,
    "sid": 8,
    "location": 2,
    "content": "这是我听过最蠢的建议",
    "music": 0.0
  },
  {
    "from": 19.63,
    "to": 23.13,
    "sid": 9,
    "location": 2,
    "content": "然后他们一试学习速度就超过了身边所有朋友",
    "music": 0.0
  },
  {
    "from": 23.13,
    "to": 24.28,
    "sid": 10,
    "location": 2,
    "content": "先说第一个",
    "music": 0.0
  },
  {
    "from": 24.28,
    "to": 25.8,
    "sid": 11,
    "location": 2,
    "content": "大多数人错在这里",
    "music": 0.0
  },
  {
    "from": 25.8,
    "to": 27.94,
    "sid": 12,
    "location": 2,
    "content": "他们照着大纲学第一章",
    "music": 0.0
  },
  {
    "from": 27.94,
    "to": 29.0,
    "sid": 13,
    "location": 2,
    "content": "然后第二章",
    "music": 0.0
  },
  {
    "from": 29.0,
    "to": 31.27,
    "sid": 14,
    "location": 2,
    "content": "然后第三章全部覆盖",
    "music": 0.0
  },
  {
    "from": 31.27,
    "to": 32.53,
    "sid": 15,
    "location": 2,
    "content": "把课程学完",
    "music": 0.0
  },
  {
    "from": 32.53,
    "to": 35.05,
    "sid": 16,
    "location": 2,
    "content": "以为理解会在某个地方自然出现",
    "music": 0.0
  },
  {
    "from": 35.05,
    "to": 37.82,
    "sid": 17,
    "location": 2,
    "content": "并不会覆盖式学习不等于理解",
    "music": 0.0
  },
  {
    "from": 37.82,
    "to": 39.42,
    "sid": 18,
    "location": 2,
    "content": "你可以翻完整本教材",
    "music": 0.0
  },
  {
    "from": 39.42,
    "to": 41.82,
    "sid": 19,
    "location": 2,
    "content": "却连其中一个观点都无法为他辩护",
    "music": 0.0
  },
  {
    "from": 41.82,
    "to": 43.8,
    "sid": 20,
    "location": 2,
    "content": "牛津学生不是照着大纲学",
    "music": 0.0
  },
  {
    "from": 43.8,
    "to": 45.58,
    "sid": 21,
    "location": 2,
    "content": "而是照着截止日期学",
    "music": 0.0
  },
  {
    "from": 45.58,
    "to": 47.0,
    "sid": 22,
    "location": 2,
    "content": "这叫导师制",
    "music": 0.0
  },
  {
    "from": 47.0,
    "to": 48.44,
    "sid": 23,
    "location": 2,
    "content": "他是这样运作的",
    "music": 0.0
  },
  {
    "from": 48.44,
    "to": 50.38,
    "sid": 24,
    "location": 2,
    "content": "每周学生拿到一个问题",
    "music": 0.0
  },
  {
    "from": 50.38,
    "to": 51.34,
    "sid": 25,
    "location": 2,
    "content": "不是一个课题",
    "music": 0.0
  },
  {
    "from": 51.34,
    "to": 52.379,
    "sid": 26,
    "location": 2,
    "content": "是一个问题",
    "music": 0.0
  },
  {
    "from": 52.379,
    "to": 54.319,
    "sid": 27,
    "location": 2,
    "content": "法国大革命是不可避免的吗",
    "music": 0.0
  },
  {
    "from": 54.319,
    "to": 55.759,
    "sid": 28,
    "location": 2,
    "content": "自由意志存在吗",
    "music": 0.0
  },
  {
    "from": 55.759,
    "to": 58.269,
    "sid": 29,
    "location": 2,
    "content": "工业革命让工人变得更富有了吗",
    "music": 0.0
  },
  {
    "from": 58.269,
    "to": 59.949,
    "sid": 30,
    "location": 2,
    "content": "问题在任何阅读开始之前",
    "music": 0.0
  },
  {
    "from": 59.949,
    "to": 61.429,
    "sid": 31,
    "location": 2,
    "content": "就已经选定再读一遍",
    "music": 0.0
  },
  {
    "from": 61.429,
    "to": 61.969,
    "sid": 32,
    "location": 2,
    "content": "这句话",
    "music": 0.0
  },
  {
    "from": 61.969,
    "to": 63.069,
    "sid": 33,
    "location": 2,
    "content": "问题先来",
    "music": 0.0
  },
  {
    "from": 63.069,
    "to": 64.409,
    "sid": 34,
    "location": 2,
    "content": "阅读在后",
    "music": 0.0
  },
  {
    "from": 64.409,
    "to": 66.05,
    "sid": 35,
    "location": 2,
    "content": "为什么顺序很重要",
    "music": 0.0
  },
  {
    "from": 66.05,
    "to": 68.9,
    "sid": 36,
    "location": 2,
    "content": "因为一个问题会把你的大脑变成狩猎型大脑",
    "music": 0.0
  },
  {
    "from": 68.9,
    "to": 70.58,
    "sid": 37,
    "location": 2,
    "content": "当你知道自己在找什么时",
    "music": 0.0
  },
  {
    "from": 70.58,
    "to": 71.78,
    "sid": 38,
    "location": 2,
    "content": "每一页要么有用",
    "music": 0.0
  },
  {
    "from": 71.78,
    "to": 72.48,
    "sid": 39,
    "location": 2,
    "content": "要么没用",
    "music": 0.0
  },
  {
    "from": 72.48,
    "to": 73.7,
    "sid": 40,
    "location": 2,
    "content": "你不再被动吸收",
    "music": 0.0
  },
  {
    "from": 73.7,
    "to": 75.08,
    "sid": 41,
    "location": 2,
    "content": "你开始主动搜寻",
    "music": 0.0
  },
  {
    "from": 75.08,
    "to": 77.479,
    "sid": 42,
    "location": 2,
    "content": "筛选会自然发生到周末",
    "music": 0.0
  },
  {
    "from": 77.479,
    "to": 79.519,
    "sid": 43,
    "location": 2,
    "content": "学生必须交出一份交付成果",
    "music": 0.0
  },
  {
    "from": 79.519,
    "to": 80.219,
    "sid": 44,
    "location": 2,
    "content": "不是笔记",
    "music": 0.0
  },
  {
    "from": 80.219,
    "to": 80.979,
    "sid": 45,
    "location": 2,
    "content": "不是划线",
    "music": 0.0
  },
  {
    "from": 80.979,
    "to": 81.779,
    "sid": 46,
    "location": 2,
    "content": "不是摘要",
    "music": 0.0
  },
  {
    "from": 81.779,
    "to": 83.36,
    "sid": 47,
    "location": 2,
    "content": "而是一篇成文的论证",
    "music": 0.0
  },
  {
    "from": 83.36,
    "to": 84.36,
    "sid": 48,
    "location": 2,
    "content": "大约2000字",
    "music": 0.0
  },
  {
    "from": 84.36,
    "to": 86.26,
    "sid": 49,
    "location": 2,
    "content": "提出一个立场并为之辩护",
    "music": 0.0
  },
  {
    "from": 86.26,
    "to": 87.699,
    "sid": 50,
    "location": 2,
    "content": "然后就是那个房间",
    "music": 0.0
  },
  {
    "from": 87.699,
    "to": 89.179,
    "sid": 51,
    "location": 2,
    "content": "学生坐在导师对面",
    "music": 0.0
  },
  {
    "from": 89.179,
    "to": 91.439,
    "sid": 52,
    "location": 2,
    "content": "而导师往往是这个具体问题上",
    "music": 0.0
  },
  {
    "from": 91.439,
    "to": 93.53,
    "sid": 53,
    "location": 2,
    "content": "人在市的最顶尖专家之一",
    "music": 0.0
  },
  {
    "from": 93.53,
    "to": 95.53,
    "sid": 54,
    "location": 2,
    "content": "学生大声读出自己的论证",
    "music": 0.0
  },
  {
    "from": 95.53,
    "to": 97.21,
    "sid": 55,
    "location": 2,
    "content": "专家则逐行拆解",
    "music": 0.0
  },
  {
    "from": 97.21,
    "to": 98.89,
    "sid": 56,
    "location": 2,
    "content": "你为什么相信这一点",
    "music": 0.0
  },
  {
    "from": 98.89,
    "to": 100.19,
    "sid": 57,
    "location": 2,
    "content": "反正怎么解释",
    "music": 0.0
  },
  {
    "from": 100.19,
    "to": 102.37,
    "sid": 58,
    "location": 2,
    "content": "为这个主张辩护一小时",
    "music": 0.0
  },
  {
    "from": 102.37,
    "to": 103.29,
    "sid": 59,
    "location": 2,
    "content": "无处躲藏",
    "music": 0.0
  },
  {
    "from": 103.29,
    "to": 105.289,
    "sid": 60,
    "location": 2,
    "content": "也没有小组可以隐身其中",
    "music": 0.0
  },
  {
    "from": 105.289,
    "to": 107.389,
    "sid": 61,
    "location": 2,
    "content": "但这里有个所有人都忽略的地方",
    "music": 0.0
  },
  {
    "from": 107.389,
    "to": 109.71,
    "sid": 62,
    "location": 2,
    "content": "每周的论文不打分NN",
    "music": 0.0
  },
  {
    "from": 109.71,
    "to": 111.71,
    "sid": 63,
    "location": 2,
    "content": "而且牛津也没有学期考试",
    "music": 0.0
  },
  {
    "from": 111.71,
    "to": 113.65,
    "sid": 64,
    "location": 2,
    "content": "每学期初有一次模拟试卷",
    "music": 0.0
  },
  {
    "from": 113.65,
    "to": 115.79,
    "sid": 65,
    "location": 2,
    "content": "叫学期初摸底考也不计分",
    "music": 0.0
  },
  {
    "from": 115.79,
    "to": 118.73,
    "sid": 66,
    "location": 2,
    "content": "真正的考试要到最后一年的最后几周才来",
    "music": 0.0
  },
  {
    "from": 118.73,
    "to": 120.86,
    "sid": 67,
    "location": 2,
    "content": "而那些考试决定整个学位",
    "music": 0.0
  },
  {
    "from": 120.86,
    "to": 123.44,
    "sid": 68,
    "location": 2,
    "content": "所以整整3年学生可以每周都错",
    "music": 0.0
  },
  {
    "from": 123.44,
    "to": 125.02,
    "sid": 69,
    "location": 2,
    "content": "而且不用付出任何代价",
    "music": 0.0
  },
  {
    "from": 125.02,
    "to": 126.24,
    "sid": 70,
    "location": 2,
    "content": "这不是缺陷",
    "music": 0.0
  },
  {
    "from": 126.24,
    "to": 127.53,
    "sid": 71,
    "location": 2,
    "content": "这才是引擎",
    "music": 0.0
  },
  {
    "from": 127.53,
    "to": 128.87,
    "sid": 72,
    "location": 2,
    "content": "犯错没有成本",
    "music": 0.0
  },
  {
    "from": 128.87,
    "to": 130.93,
    "sid": 73,
    "location": 2,
    "content": "所以学生会选择真实的立场",
    "music": 0.0
  },
  {
    "from": 130.93,
    "to": 132.579,
    "sid": 74,
    "location": 2,
    "content": "而不是安全的立场",
    "music": 0.0
  },
  {
    "from": 132.579,
    "to": 135.439,
    "sid": 75,
    "location": 2,
    "content": "而一个在周四被彻底击垮的真实立场",
    "music": 0.0
  },
  {
    "from": 135.439,
    "to": 137.519,
    "sid": 76,
    "location": 2,
    "content": "比一个月的笔记更有价值",
    "music": 0.0
  },
  {
    "from": 137.519,
    "to": 138.919,
    "sid": 77,
    "location": 2,
    "content": "学生走出来的时候",
    "music": 0.0
  },
  {
    "from": 138.919,
    "to": 141.039,
    "sid": 78,
    "location": 2,
    "content": "清楚知道自己思路断在哪里",
    "music": 0.0
  },
  {
    "from": 141.039,
    "to": 143.059,
    "sid": 79,
    "location": 2,
    "content": "每七天被纠正一次",
    "music": 0.0
  },
  {
    "from": 143.059,
    "to": 145.37,
    "sid": 80,
    "location": 2,
    "content": "升级一次你的版本",
    "music": 0.0
  },
  {
    "from": 145.37,
    "to": 147.05,
    "sid": 81,
    "location": 2,
    "content": "周一在读任何东西之前",
    "music": 0.0
  },
  {
    "from": 147.05,
    "to": 148.209,
    "sid": 82,
    "location": 2,
    "content": "先挑一个问题",
    "music": 0.0
  },
  {
    "from": 148.209,
    "to": 150.049,
    "sid": 83,
    "location": 2,
    "content": "要挑一个你能为之论证的问题",
    "music": 0.0
  },
  {
    "from": 150.049,
    "to": 151.749,
    "sid": 84,
    "location": 2,
    "content": "不是一个可以随便浏览的话题",
    "music": 0.0
  },
  {
    "from": 151.749,
    "to": 153.129,
    "sid": 85,
    "location": 2,
    "content": "比如不要选营养",
    "music": 0.0
  },
  {
    "from": 153.129,
    "to": 154.209,
    "sid": 86,
    "location": 2,
    "content": "要选早餐",
    "music": 0.0
  },
  {
    "from": 154.209,
    "to": 156.43,
    "sid": 87,
    "location": 2,
    "content": "真的是一天中最重要的一餐吗",
    "music": 0.0
  },
  {
    "from": 156.43,
    "to": 158.09,
    "sid": 88,
    "location": 2,
    "content": "设一个截止日期",
    "music": 0.0
  },
  {
    "from": 158.09,
    "to": 160.58,
    "sid": 89,
    "location": 2,
    "content": "周五写一页纸回答这个问题",
    "music": 0.0
  },
  {
    "from": 160.58,
    "to": 161.92,
    "sid": 90,
    "location": 2,
    "content": "并为答案辩护",
    "music": 0.0
  },
  {
    "from": 161.92,
    "to": 164.0,
    "sid": 91,
    "location": 2,
    "content": "然后拿给一个会反驳你的人",
    "music": 0.0
  },
  {
    "from": 164.0,
    "to": 165.49,
    "sid": 92,
    "location": 2,
    "content": "看朋友论坛",
    "music": 0.0
  },
  {
    "from": 165.49,
    "to": 168.39,
    "sid": 93,
    "location": 2,
    "content": "或者你让他攻击这篇东西的AI",
    "music": 0.0
  },
  {
    "from": 168.39,
    "to": 169.49,
    "sid": 94,
    "location": 2,
    "content": "关键在这",
    "music": 0.0
  },
  {
    "from": 169.49,
    "to": 172.0,
    "sid": 95,
    "location": 2,
    "content": "待截止日期的问题会催生学习",
    "music": 0.0
  },
  {
    "from": 172.0,
    "to": 173.24,
    "sid": 96,
    "location": 2,
    "content": "带时间表的大纲",
    "music": 0.0
  },
  {
    "from": 173.24,
    "to": 174.92,
    "sid": 97,
    "location": 2,
    "content": "只会催生覆盖式学习",
    "music": 0.0
  },
  {
    "from": 174.92,
    "to": 175.9,
    "sid": 98,
    "location": 2,
    "content": "先挑问题",
    "music": 0.0
  },
  {
    "from": 175.9,
    "to": 177.96,
    "sid": 99,
    "location": 2,
    "content": "把做出一份论证当作终点线",
    "music": 0.0
  },
  {
    "from": 177.96,
    "to": 179.04,
    "sid": 100,
    "location": 2,
    "content": "而不是记笔记",
    "music": 0.0
  },
  {
    "from": 179.04,
    "to": 180.14,
    "sid": 101,
    "location": 2,
    "content": "这是第一个方法",
    "music": 0.0
  },
  {
    "from": 180.14,
    "to": 181.3,
    "sid": 102,
    "location": 2,
    "content": "但里面有个陷阱",
    "music": 0.0
  },
  {
    "from": 181.3,
    "to": 183.76,
    "sid": 103,
    "location": 2,
    "content": "大多数人抓住问题就立刻开始回答",
    "music": 0.0
  },
  {
    "from": 183.76,
    "to": 185.88,
    "sid": 104,
    "location": 2,
    "content": "而这恰恰会造就一个自信",
    "music": 0.0
  },
  {
    "from": 185.88,
    "to": 186.48,
    "sid": 105,
    "location": 2,
    "content": "文笔好",
    "music": 0.0
  },
  {
    "from": 186.48,
    "to": 188.18,
    "sid": 106,
    "location": 2,
    "content": "但完全空洞的论证",
    "music": 0.0
  },
  {
    "from": 188.18,
    "to": 189.94,
    "sid": 107,
    "location": 2,
    "content": "牛津对这点有对策",
    "music": 0.0
  },
  {
    "from": 189.94,
    "to": 192.24,
    "sid": 108,
    "location": 2,
    "content": "学校教给你的是这样读题",
    "music": 0.0
  },
  {
    "from": 192.24,
    "to": 194.21,
    "sid": 109,
    "location": 2,
    "content": "答题答得快",
    "music": 0.0
  },
  {
    "from": 194.21,
    "to": 195.07,
    "sid": 110,
    "location": 2,
    "content": "显得聪明",
    "music": 0.0
  },
  {
    "from": 195.07,
    "to": 196.51,
    "sid": 111,
    "location": 2,
    "content": "先举手的人赢",
    "music": 0.0
  },
  {
    "from": 196.51,
    "to": 198.11,
    "sid": 112,
    "location": 2,
