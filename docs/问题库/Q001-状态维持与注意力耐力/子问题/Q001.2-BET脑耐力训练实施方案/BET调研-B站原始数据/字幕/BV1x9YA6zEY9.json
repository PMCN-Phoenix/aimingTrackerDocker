[
  {
    "from": 0.0,
    "to": 2.04,
    "sid": 1,
    "location": 2,
    "content": "当人们跟我说你想太多了的时候",
    "music": 0.0
  },
  {
    "from": 2.04,
    "to": 2.84,
    "sid": 2,
    "location": 2,
    "content": "我总是说不",
    "music": 0.0
  },
  {
    "from": 2.84,
    "to": 4.08,
    "sid": 3,
    "location": 2,
    "content": "我只是想了正常的量",
    "music": 0.0
  },
  {
    "from": 4.08,
    "to": 5.36,
    "sid": 4,
    "location": 2,
    "content": "我只是不擅长这个",
    "music": 0.0
  },
  {
    "from": 5.36,
    "to": 5.84,
    "sid": 5,
    "location": 2,
    "content": "说实话",
    "music": 0.0
  },
  {
    "from": 5.84,
    "to": 7.38,
    "sid": 6,
    "location": 2,
    "content": "我觉得我们大多数人都是这样",
    "music": 0.0
  },
  {
    "from": 7.38,
    "to": 8.56,
    "sid": 7,
    "location": 2,
    "content": "我们不是想太多",
    "music": 0.0
  },
  {
    "from": 8.56,
    "to": 10.34,
    "sid": 8,
    "location": 2,
    "content": "我们就是没能清晰思考",
    "music": 0.0
  },
  {
    "from": 10.34,
    "to": 11.76,
    "sid": 9,
    "location": 2,
    "content": "但有少数人能看到",
    "music": 0.0
  },
  {
    "from": 11.76,
    "to": 13.76,
    "sid": 10,
    "location": 2,
    "content": "他们看见了其他人错过的东西",
    "music": 0.0
  },
  {
    "from": 13.76,
    "to": 15.5,
    "sid": 11,
    "location": 2,
    "content": "在第二次世界大战期间",
    "music": 0.0
  },
  {
    "from": 15.5,
    "to": 18.91,
    "sid": 12,
    "location": 2,
    "content": "美军研究了那些完成任务返航的轰炸机",
    "music": 0.0
  },
  {
    "from": 18.91,
    "to": 21.27,
    "sid": 13,
    "location": 2,
    "content": "弹孔大多在机翼和机尾",
    "music": 0.0
  },
  {
    "from": 21.27,
    "to": 22.67,
    "sid": 14,
    "location": 2,
    "content": "所以计划很简单",
    "music": 0.0
  },
  {
    "from": 22.67,
    "to": 24.92,
    "sid": 15,
    "location": 2,
    "content": "给机翼和机尾加装装甲",
    "music": 0.0
  },
  {
    "from": 24.92,
    "to": 27.98,
    "sid": 16,
    "location": 2,
    "content": "然后一位名叫亚伯拉罕瓦尔德的数学家",
    "music": 0.0
  },
  {
    "from": 27.98,
    "to": 29.8,
    "sid": 17,
    "location": 2,
    "content": "看着同样的飞机说不",
    "music": 0.0
  },
  {
    "from": 29.8,
    "to": 32.66,
    "sid": 18,
    "location": 2,
    "content": "我们应该把装甲架在没有弹孔的地方",
    "music": 0.0
  },
  {
    "from": 32.66,
    "to": 35.36,
    "sid": 19,
    "location": 2,
    "content": "因为那些位置中弹的飞机都没能飞回来",
    "music": 0.0
  },
  {
    "from": 35.36,
    "to": 37.56,
    "sid": 20,
    "location": 2,
    "content": "其他人看到的都是同样的返航飞机",
    "music": 0.0
  },
  {
    "from": 37.56,
    "to": 39.16,
    "sid": 21,
    "location": 2,
    "content": "为什么只有他看出了问题",
    "music": 0.0
  },
  {
    "from": 39.16,
    "to": 40.34,
    "sid": 22,
    "location": 2,
    "content": "他真是个天才",
    "music": 0.0
  },
  {
    "from": 40.34,
    "to": 41.84,
    "sid": 23,
    "location": 2,
    "content": "还是脑子里做的那件事",
    "music": 0.0
  },
  {
    "from": 41.84,
    "to": 42.84,
    "sid": 24,
    "location": 2,
    "content": "你也可以学会",
    "music": 0.0
  },
  {
    "from": 42.84,
    "to": 44.22,
    "sid": 25,
    "location": 2,
    "content": "而如果你学会了",
    "music": 0.0
  },
  {
    "from": 44.22,
    "to": 46.64,
    "sid": 26,
    "location": 2,
    "content": "你会开始在自己生活中看到哪些",
    "music": 0.0
  },
  {
    "from": 46.64,
    "to": 48.26,
    "sid": 27,
    "location": 2,
    "content": "你一直错过的东西",
    "music": 0.0
  },
  {
    "from": 48.26,
    "to": 49.92,
    "sid": 28,
    "location": 2,
    "content": "所以让我们一探究竟",
    "music": 0.0
  },
  {
    "from": 49.92,
    "to": 51.82,
    "sid": 29,
    "location": 2,
    "content": "瓦尔德看的不是弹孔",
    "music": 0.0
  },
  {
    "from": 51.82,
    "to": 53.92,
    "sid": 30,
    "location": 2,
    "content": "他看的是那些不在场的飞机",
    "music": 0.0
  },
  {
    "from": 53.92,
    "to": 56.269,
    "sid": 31,
    "location": 2,
    "content": "机场上的每架飞机都飞回来了",
    "music": 0.0
  },
  {
    "from": 56.269,
    "to": 58.029,
    "sid": 32,
    "location": 2,
    "content": "所以上面的每一个弹孔",
    "music": 0.0
  },
  {
    "from": 58.029,
    "to": 59.989,
    "sid": 33,
    "location": 2,
    "content": "都是飞机能扛过去的弹孔",
    "music": 0.0
  },
  {
    "from": 59.989,
    "to": 62.169,
    "sid": 34,
    "location": 2,
    "content": "机翼和机尾满是弹孔",
    "music": 0.0
  },
  {
    "from": 62.169,
    "to": 64.879,
    "sid": 35,
    "location": 2,
    "content": "因为飞机这些部位中弹后还能继续飞",
    "music": 0.0
  },
  {
    "from": 64.879,
    "to": 66.419,
    "sid": 36,
    "location": 2,
    "content": "引擎几乎完好无损",
    "music": 0.0
  },
  {
    "from": 66.419,
    "to": 68.059,
    "sid": 37,
    "location": 2,
    "content": "不是因为没人击中引擎",
    "music": 0.0
  },
  {
    "from": 68.059,
    "to": 71.179,
    "sid": 38,
    "location": 2,
    "content": "而是因为引擎被击中的飞机再也没能返航",
    "music": 0.0
  },
  {
    "from": 71.179,
    "to": 74.36,
    "sid": 39,
    "location": 2,
    "content": "被统计到将军们研究着眼前的飞机",
    "music": 0.0
  },
  {
    "from": 74.36,
    "to": 76.98,
    "sid": 40,
    "location": 2,
    "content": "瓦尔德问的是那些不在他面前的飞机",
    "music": 0.0
  },
  {
    "from": 76.98,
    "to": 78.42,
    "sid": 41,
    "location": 2,
    "content": "整个诀窍就在这里",
    "music": 0.0
  },
  {
    "from": 78.42,
    "to": 79.52,
    "sid": 42,
    "location": 2,
    "content": "而且你可以学会",
    "music": 0.0
  },
  {
    "from": 79.52,
    "to": 80.6,
    "sid": 43,
    "location": 2,
    "content": "这是个问题",
    "music": 0.0
  },
  {
    "from": 80.6,
    "to": 81.96,
    "sid": 44,
    "location": 2,
    "content": "我没看到的是什么",
    "music": 0.0
  },
  {
    "from": 81.96,
    "to": 83.33,
    "sid": 45,
    "location": 2,
    "content": "为什么我没看到",
    "music": 0.0
  },
  {
    "from": 83.33,
    "to": 85.59,
    "sid": 46,
    "location": 2,
    "content": "而且你不需要一场战争来联系",
    "music": 0.0
  },
  {
    "from": 85.59,
    "to": 86.87,
    "sid": 47,
    "location": 2,
    "content": "你需要三个问题",
    "music": 0.0
  },
  {
    "from": 86.87,
    "to": 89.24,
    "sid": 48,
    "location": 2,
    "content": "这三个问题在一家咖啡店就能用上",
    "music": 0.0
  },
  {
    "from": 89.24,
    "to": 90.76,
    "sid": 49,
    "location": 2,
    "content": "想象你开了一家咖啡店",
    "music": 0.0
  },
  {
    "from": 90.76,
    "to": 92.82,
    "sid": 50,
    "location": 2,
    "content": "一个柜台前面有台收音机",
    "music": 0.0
  },
  {
    "from": 92.82,
    "to": 93.98,
    "sid": 51,
    "location": 2,
    "content": "顾客在那付款",
    "music": 0.0
  },
  {
    "from": 93.98,
    "to": 95.2,
    "sid": 52,
    "location": 2,
    "content": "后面有台咖啡机",
    "music": 0.0
  },
  {
    "from": 95.2,
    "to": 96.97,
    "sid": 53,
    "location": 2,
    "content": "一个人负责做所有饮品",
    "music": 0.0
  },
  {
    "from": 96.97,
    "to": 99.09,
    "sid": 54,
    "location": 2,
    "content": "每天早上队伍都排到门口",
    "music": 0.0
  },
  {
    "from": 99.09,
    "to": 101.02,
    "sid": 55,
    "location": 2,
    "content": "顾客抱怨等待时间太长",
    "music": 0.0
  },
  {
    "from": 101.02,
    "to": 102.24,
    "sid": 56,
    "location": 2,
    "content": "你看到排队的人",
    "music": 0.0
  },
  {
    "from": 102.24,
    "to": 103.86,
    "sid": 57,
    "location": 2,
    "content": "看到收银台前只有一个人",
    "music": 0.0
  },
  {
    "from": 103.86,
    "to": 105.37,
    "sid": 58,
    "location": 2,
    "content": "答案似乎显而易见",
    "music": 0.0
  },
  {
    "from": 105.37,
    "to": 106.79,
    "sid": 59,
    "location": 2,
    "content": "你又雇了一个收银员",
    "music": 0.0
  },
  {
    "from": 106.79,
    "to": 107.69,
    "sid": 60,
    "location": 2,
    "content": "他管用",
    "music": 0.0
  },
  {
    "from": 107.69,
    "to": 108.43,
    "sid": 61,
    "location": 2,
    "content": "算是吧",
    "music": 0.0
  },
  {
    "from": 108.43,
    "to": 109.67,
    "sid": 62,
    "location": 2,
    "content": "顾客付钱更快",
    "music": 0.0
  },
  {
    "from": 109.67,
    "to": 111.53,
    "sid": 63,
    "location": 2,
    "content": "于是他们走到柜台另一端",
    "music": 0.0
  },
  {
    "from": 111.53,
    "to": 112.13,
    "sid": 64,
    "location": 2,
    "content": "改在那里",
    "music": 0.0
  },
  {
    "from": 112.13,
    "to": 113.92,
    "sid": 65,
    "location": 2,
    "content": "等咖啡机前的那个人",
    "music": 0.0
  },
  {
    "from": 113.92,
    "to": 115.7,
    "sid": 66,
    "location": 2,
    "content": "已经在以最快速度做饮料了",
    "music": 0.0
  },
  {
    "from": 115.7,
    "to": 117.26,
    "sid": 67,
    "location": 2,
    "content": "现在订单来的更快了",
    "music": 0.0
  },
  {
    "from": 117.26,
    "to": 118.06,
    "sid": 68,
    "location": 2,
    "content": "咖啡不会",
    "music": 0.0
  },
  {
    "from": 118.06,
    "to": 120.03,
    "sid": 69,
    "location": 2,
    "content": "你已经为多一名收银员付了钱",
    "music": 0.0
  },
  {
    "from": 120.03,
    "to": 121.75,
    "sid": 70,
    "location": 2,
    "content": "顾客有了个不一样的站位",
    "music": 0.0
  },
  {
    "from": 121.75,
    "to": 123.919,
    "sid": 71,
    "location": 2,
    "content": "错误发生在你雇人之前",
    "music": 0.0
  },
  {
    "from": 123.919,
    "to": 125.319,
    "sid": 72,
    "location": 2,
    "content": "你看着长长的队伍",
    "music": 0.0
  },
  {
    "from": 125.319,
    "to": 127.019,
    "sid": 73,
    "location": 2,
    "content": "就断定他为什么排这么长",
    "music": 0.0
  },
  {
    "from": 127.019,
    "to": 127.919,
    "sid": 74,
    "location": 2,
    "content": "顾客在等",
    "music": 0.0
  },
  {
    "from": 127.919,
    "to": 129.019,
    "sid": 75,
    "location": 2,
    "content": "是你看到的",
    "music": 0.0
  },
  {
    "from": 129.019,
    "to": 130.479,
    "sid": 76,
    "location": 2,
    "content": "我们需要另一位收银员",
    "music": 0.0
  },
  {
    "from": 130.479,
    "to": 132.079,
    "sid": 77,
    "location": 2,
    "content": "只是你对原因的猜测",
    "music": 0.0
  },
  {
    "from": 132.079,
    "to": 134.519,
    "sid": 78,
    "location": 2,
    "content": "那两件事感觉就像同一个念头",
    "music": 0.0
  },
  {
    "from": 134.519,
    "to": 135.599,
    "sid": 79,
    "location": 2,
    "content": "他们是两个",
    "music": 0.0
  },
  {
    "from": 135.599,
    "to": 138.19,
    "sid": 80,
    "location": 2,
    "content": "所以第一个问题是我实际知道什么",
    "music": 0.0
  },
  {
    "from": 138.19,
    "to": 139.93,
    "sid": 81,
    "location": 2,
    "content": "在修理任何东西之前",
    "music": 0.0
  },
  {
    "from": 139.93,
    "to": 143.04,
    "sid": 82,
    "location": 2,
    "content": "先站在店里观察顾客站在哪里",
    "music": 0.0
  },
  {
    "from": 143.04,
    "to": 144.5,
    "sid": 83,
    "location": 2,
    "content": "他们点过餐了吗",
    "music": 0.0
  },
  {
    "from": 144.5,
    "to": 145.76,
    "sid": 84,
    "location": 2,
    "content": "他们付过钱了吗",
    "music": 0.0
  },
  {
    "from": 145.76,
    "to": 148.1,
    "sid": 85,
    "location": 2,
    "content": "他们是不是拿着小票在等咖啡",
    "music": 0.0
  },
  {
    "from": 148.1,
    "to": 151.02,
    "sid": 86,
    "location": 2,
    "content": "这家店里大多数在等的人已经付过钱了",
    "music": 0.0
  },
  {
    "from": 151.02,
    "to": 153.079,
    "sid": 87,
    "location": 2,
    "content": "他们在等那个在机器旁边的人",
    "music": 0.0
  },
  {
    "from": 153.079,
    "to": 154.959,
    "sid": 88,
    "location": 2,
    "content": "现在你知道了等待在哪里",
    "music": 0.0
  },
  {
    "from": 154.959,
    "to": 156.979,
    "sid": 89,
    "location": 2,
    "content": "但你仍然不知道该怎么处理它",
    "music": 0.0
  },
  {
    "from": 156.979,
    "to": 158.239,
    "sid": 90,
    "location": 2,
    "content": "你的第一个解决方案",
    "music": 0.0
  },
  {
    "from": 158.239,
    "to": 159.239,
    "sid": 91,
    "location": 2,
    "content": "假设付款更快",
    "music": 0.0
  },
  {
    "from": 159.239,
    "to": 160.9,
    "sid": 92,
    "location": 2,
    "content": "就意味着等待时间更短",
    "music": 0.0
  },
  {
    "from": 160.9,
    "to": 161.6,
    "sid": 93,
    "location": 2,
    "content": "没有",
    "music": 0.0
  },
  {
    "from": 161.6,
    "to": 163.92,
    "sid": 94,
    "location": 2,
    "content": "因为付款从来都不是最慢的环节",
    "music": 0.0
  },
  {
    "from": 163.92,
    "to": 166.62,
    "sid": 95,
    "location": 2,
    "content": "做咖啡就是这就是那个模式",
    "music": 0.0
  },
  {
    "from": 166.62,
    "to": 168.92,
    "sid": 96,
    "location": 2,
    "content": "我们解决一个问题上最显眼的部分",
    "music": 0.0
  },
  {
    "from": 168.92,
    "to": 170.26,
    "sid": 97,
    "location": 2,
    "content": "就把它当成问题的",
    "music": 0.0
  },
  {
    "from": 170.26,
    "to": 172.03,
    "sid": 98,
    "location": 2,
    "content": "全部收银台钱的队伍",
    "music": 0.0
  },
  {
    "from": 172.03,
    "to": 175.05,
    "sid": 99,
    "location": 2,
    "content": "一眼就能看到操作机器的人排在队伍后面",
    "music": 0.0
  },
  {
    "from": 175.05,
    "to": 176.09,
    "sid": 100,
    "location": 2,
    "content": "所以没人看见",
    "music": 0.0
  },
  {
    "from": 176.09,
    "to": 177.5,
    "sid": 101,
    "location": 2,
    "content": "所以第二个问题是",
    "music": 0.0
  },
  {
    "from": 177.5,
    "to": 180.72,
    "sid": 102,
    "location": 2,
    "content": "我在假设什么去找站在机器旁的那个人",
    "music": 0.0
  },
  {
    "from": 180.72,
    "to": 183.11,
    "sid": 103,
    "location": 2,
    "content": "问问他们高峰期什么让他们慢下来",
    "music": 0.0
  },
  {
    "from": 183.11,
    "to": 184.89,
    "sid": 104,
    "location": 2,
    "content": "看他们做十倍饮品",
    "music": 0.0
  },
  {
    "from": 184.89,
    "to": 186.69,
    "sid": 105,
    "location": 2,
    "content": "找到耗时最长的那部分",
    "music": 0.0
  },
  {
    "from": 186.69,
    "to": 187.63,
    "sid": 106,
    "location": 2,
    "content": "假如他们告诉你",
    "music": 0.0
  },
  {
    "from": 187.63,
    "to": 188.93,
    "sid": 107,
    "location": 2,
    "content": "饮料本身没问题",
    "music": 0.0
  },
  {
    "from": 188.93,
    "to": 191.83,
    "sid": 108,
    "location": 2,
    "content": "问题在于高峰期他们要一边看订单",
    "music": 0.0
  },
  {
    "from": 191.83,
    "to": 192.45,
    "sid": 109,
    "location": 2,
    "content": "打奶泡",
    "music": 0.0
  },
  {
    "from": 192.45,
    "to": 193.579,
    "sid": 110,
    "location": 2,
    "content": "一边递杯子",
    "music": 0.0
