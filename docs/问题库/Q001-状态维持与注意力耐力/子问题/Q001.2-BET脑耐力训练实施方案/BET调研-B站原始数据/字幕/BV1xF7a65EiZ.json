[
  {
    "content": "大家好，我是马克",
    "from": 0.08,
    "location": 2,
    "music": 0.0,
    "sid": 1,
    "to": 0.86
  },
  {
    "content": "所以我尝试每天盯着一面墙",
    "from": 0.86,
    "location": 2,
    "music": 0.0,
    "sid": 2,
    "to": 2.12
  },
  {
    "content": "连续三十天每天如此，看看专注力会有什么变化",
    "from": 2.12,
    "location": 2,
    "music": 0.0,
    "sid": 3,
    "to": 5.08
  },
  {
    "content": "每天进入深度工作区前",
    "from": 5.08,
    "location": 2,
    "music": 0.0,
    "sid": 4,
    "to": 7.66
  },
  {
    "content": "我需要完成当天最重要的纪律性工作",
    "from": 7.66,
    "location": 2,
    "music": 0.0,
    "sid": 5,
    "to": 10.64
  },
  {
    "content": "我会坐到椅子上",
    "from": 10.64,
    "location": 2,
    "music": 0.0,
    "sid": 6,
    "to": 11.66
  },
