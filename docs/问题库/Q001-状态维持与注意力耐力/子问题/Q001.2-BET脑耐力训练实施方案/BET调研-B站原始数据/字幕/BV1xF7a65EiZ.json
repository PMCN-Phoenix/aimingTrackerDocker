    "location": 2,
    "music": 0.0,
    "sid": 20,
    "to": 34.1
  },
  {
    "content": "这些人对多巴胺在大脑中的运作机制",
    "from": 34.1,
    "location": 2,
    "music": 0.0,
    "sid": 21,
    "to": 37.57
  },
  {
    "content": "了解得非常肤浅",
    "from": 37.57,
    "location": 2,
    "music": 0.0,
    "sid": 22,
    "to": 40.91
  },
  {
