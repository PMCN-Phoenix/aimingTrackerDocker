    "to": 309.38,
    "sid": 119,
    "location": 2,
    "content": "这就是问题所在"
  },
  {
    "from": 309.4,
    "to": 312.52,
    "sid": 120,
    "location": 2,
    "content": "你不能只是做大量的卧推，并期望能够做完全的刨花"
  },
  {
    "from": 312.52,
    "to": 314.28,
    "sid": 121,
    "location": 2,
    "content": "我们需要有针对性地训练"
  },
  {
    "from": 314.3,
    "to": 315.77,
    "sid": 122,
    "location": 2,
    "content": "我们心中的目标"
