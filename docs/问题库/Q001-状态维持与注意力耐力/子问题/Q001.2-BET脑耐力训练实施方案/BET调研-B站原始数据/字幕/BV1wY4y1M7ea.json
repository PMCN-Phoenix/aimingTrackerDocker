  {
    "from": 540.52,
    "to": 541.03,
    "sid": 214,
    "location": 2,
    "content": "作为一些"
  },
  {
    "from": 541.03,
    "to": 543.61,
    "sid": 215,
    "location": 2,
    "content": "我们能体验到的信息越多"
  },
  {
    "from": 543.61,
    "to": 546.1,
    "sid": 216,
    "location": 2,
    "content": "这些看起来可能涉及大脑的额叶区域"
  },
  {
    "from": 546.12,
    "to": 550.23,
    "sid": 217,
    "location": 2,
    "content": "以及后皮质区和皮质下结构"
  },
  {
    "from": 550.23,
    "to": 550.56,
    "sid": 218,
    "location": 2,
    "content": "然而"
  },
  {
    "from": 550.56,
    "to": 556.23,
    "sid": 219,
    "location": 2,
    "content": "精确的大脑区域被利用 可能是由任务的性质决定的"
  },
  {
    "from": 556.23,
    "to": 559.47,
    "sid": 220,
    "location": 2,
    "content": "这被称为工作内存的组件进程视图"
  },
  {
    "from": 559.47,
    "to": 561.02,
    "sid": 221,
    "location": 2,
    "content": "这只是一个领先的理论"
