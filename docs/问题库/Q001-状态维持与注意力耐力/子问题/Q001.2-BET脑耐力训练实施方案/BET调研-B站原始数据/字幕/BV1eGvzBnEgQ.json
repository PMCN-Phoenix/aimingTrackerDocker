[
  {
    "content": "如果我说你的智商并非固定不变",
    "from": 0.04,
    "location": 2,
    "music": 0.0,
    "sid": 1,
    "to": 2.92
  },
  {
    "content": "不是在十八岁",
    "from": 2.92,
    "location": 2,
    "music": 0.0,
    "sid": 2,
    "to": 4.279
  },
  {
    "content": "也不是在二十五岁",
    "from": 4.279,
    "location": 2,
    "music": 0.0,
    "sid": 3,
    "to": 5.619
  },
  {
    "content": "甚至五十年后依然如此",
    "from": 5.619,
    "location": 2,
    "music": 0.0,
    "sid": 4,
    "to": 8.01
  },
  {
    "content": "我们被告知智力是遗传的",
    "from": 8.01,
    "location": 2,
    "music": 0.0,
    "sid": 5,
    "to": 10.47
  },
  {
    "content": "与生俱来的特质",
    "from": 10.47,
    "location": 2,
    "music": 0.0,
    "sid": 6,
    "to": 12.05
  },
  {
    "content": "无法改变的特质",
    "from": 12.05,
    "location": 2,
    "music": 0.0,
    "sid": 7,
    "to": 13.77
  },
  {
    "content": "但历史上最聪明的人讲述着不同故事",
    "from": 13.77,
    "location": 2,
    "music": 0.0,
    "sid": 8,
    "to": 16.91
  },
  {
    "content": "爱因斯坦童年时被认为反应迟钝",
    "from": 16.91,
    "location": 2,
    "music": 0.0,
    "sid": 9,
    "to": 20.07
  },
  {
    "content": "他的老师认为他缺乏智力",
    "from": 20.07,
    "location": 2,
    "music": 0.0,
    "sid": 10,
    "to": 22.71
  },
  {
    "content": "查尔斯",
    "from": 22.71,
    "location": 2,
    "music": 0.0,
    "sid": 11,
    "to": 23.25
  },
  {
    "content": "达尔文是个讨厌背诵的普通学生",
    "from": 23.25,
    "location": 2,
    "music": 0.0,
    "sid": 12,
    "to": 26.71
  },
  {
    "content": "爱迪生曾被学校开除",
    "from": 26.71,
    "location": 2,
    "music": 0.0,
    "sid": 13,
    "to": 29.21
  },
  {
    "content": "被判定为无法教导",
    "from": 29.21,
    "location": 2,
    "music": 0.0,
    "sid": 14,
    "to": 31.21
  },
  {
    "content": "然而这些人重塑了人类的思维方式",
    "from": 31.21,
    "location": 2,
    "music": 0.0,
    "sid": 15,
    "to": 34.69
  },
  {
    "content": "所以发生了什么变化",
    "from": 34.69,
    "location": 2,
    "music": 0.0,
    "sid": 16,
    "to": 36.09
  },
  {
    "content": "不是他们的基因",
    "from": 36.09,
    "location": 2,
    "music": 0.0,
    "sid": 17,
    "to": 37.43
  },
  {
    "content": "不是他们的学校",
    "from": 37.43,
    "location": 2,
    "music": 0.0,
    "sid": 18,
    "to": 38.67
  },
  {
    "content": "是他们的习惯改变了",
    "from": 38.67,
    "location": 2,
    "music": 0.0,
    "sid": 19,
    "to": 40.21
  },
  {
    "content": "改变了大脑的工作方式",
    "from": 40.21,
    "location": 2,
    "music": 0.0,
    "sid": 20,
    "to": 42.57
  },
  {
    "content": "我将展示研究证实能提升智力的习惯",
    "from": 42.57,
    "location": 2,
    "music": 0.0,
    "sid": 21,
    "to": 46.65
  },
  {
    "content": "以及历史上伟人们如何运用这些习惯",
    "from": 46.65,
    "location": 2,
    "music": 0.0,
    "sid": 22,
    "to": 49.55
  },
  {
    "content": "在神经科学解释之前很久",
    "from": 49.55,
    "location": 2,
    "music": 0.0,
    "sid": 23,
    "to": 56.3
  },
  {
    "content": "大多数人认为智力增长来自摄入更多信息",
    "from": 56.3,
    "location": 2,
    "music": 0.0,
    "sid": 24,
    "to": 60.88
  },
  {
    "content": "更多播客",
    "from": 60.88,
    "location": 2,
    "music": 0.0,
    "sid": 25,
    "to": 62.11
  },
  {
    "content": "更多资讯",
    "from": 62.11,
    "location": 2,
    "music": 0.0,
    "sid": 26,
    "to": 63.29
  },
  {
    "content": "但神经科学研究显示相反",
    "from": 63.29,
    "location": 2,
    "music": 0.0,
    "sid": 27,
    "to": 65.99
  },
  {
    "content": "你的大脑会变得更聪明",
    "from": 65.99,
    "location": 2,
    "music": 0.0,
    "sid": 28,
    "to": 67.79
  },
  {
    "content": "当被迫进行无输入思考时",
    "from": 67.79,
    "location": 2,
    "music": 0.0,
    "sid": 29,
    "to": 70.09
  },
  {
    "content": "这会激活默认模式网络",
    "from": 70.09,
    "location": 2,
    "music": 0.0,
    "sid": 30,
    "to": 73.33
  },
  {
    "content": "负责抽象思维的系统",
    "from": 73.33,
    "location": 2,
    "music": 0.0,
    "sid": 31,
    "to": 77.05
  },
  {
    "content": "顿悟",
    "from": 77.05,
    "location": 2,
    "music": 0.0,
    "sid": 32,
    "to": 78.19
  },
  {
    "content": "长期推理",
    "from": 78.19,
    "location": 2,
    "music": 0.0,
    "sid": 33,
    "to": 79.75
  },
  {
    "content": "创造力",
    "from": 79.75,
    "location": 2,
    "music": 0.0,
    "sid": 34,
    "to": 81.33
  },
  {
    "content": "爱因斯坦曾进行思想实验",
    "from": 81.49,
    "location": 2,
    "music": 0.0,
    "sid": 35,
    "to": 84.65
  },
  {
    "content": "他并不总是计算",
    "from": 84.65,
    "location": 2,
    "music": 0.0,
    "sid": 36,
    "to": 86.35
  },
  {
    "content": "而是想象会发生什么",
    "from": 86.35,
    "location": 2,
    "music": 0.0,
    "sid": 37,
    "to": 88.21
  },
  {
    "content": "如果我追逐一束光",
    "from": 88.21,
    "location": 2,
    "music": 0.0,
    "sid": 38,
    "to": 89.85
  },
  {
    "content": "如果引力弯曲空间会怎样",
    "from": 89.85,
    "location": 2,
    "music": 0.0,
    "sid": 39,
    "to": 92.23
  },
  {
    "content": "他会独自漫步数小时",
    "from": 92.23,
    "location": 2,
    "music": 0.0,
    "sid": 40,
    "to": 94.27
  },
  {
    "content": "没有书籍",
    "from": 94.27,
    "location": 2,
    "music": 0.0,
    "sid": 41,
    "to": 95.19
  },
  {
    "content": "没有笔记",
    "from": 95.19,
    "location": 2,
    "music": 0.0,
    "sid": 42,
    "to": 96.03
  },
  {
    "content": "纯粹的思考",
    "from": 96.03,
    "location": 2,
    "music": 0.0,
    "sid": 43,
    "to": 97.93
  },
  {
    "content": "现代研究表明定期进行无干扰思考的人在解决问题能力上更高",
    "from": 98.09,
    "location": 2,
    "music": 0.0,
    "sid": 44,
    "to": 105.02
  },
  {
    "content": "战略推理和创造力方面更优",
    "from": 105.02,
    "location": 2,
    "music": 0.0,
    "sid": 45,
    "to": 108.3
  },
  {
    "content": "聪明的习惯",
    "from": 108.3,
    "location": 2,
    "music": 0.0,
    "sid": 46,
    "to": 109.36
  },
  {
    "content": "每日思考漫步",
    "from": 109.36,
    "location": 2,
    "music": 0.0,
    "sid": 47,
    "to": 110.8
  },
  {
    "content": "不带手机",
    "from": 110.8,
    "location": 2,
    "music": 0.0,
    "sid": 48,
    "to": 111.6
  },
  {
    "content": "不听音乐",
    "from": 111.6,
    "location": 2,
    "music": 0.0,
    "sid": 49,
    "to": 112.5
  },
  {
    "content": "最初不接收任何输入",
    "from": 112.5,
    "location": 2,
    "music": 0.0,
    "sid": 50,
    "to": 114.25
  },
  {
    "content": "感觉很无聊",
    "from": 114.25,
    "location": 2,
    "music": 0.0,
    "sid": 51,
    "to": 115.27
  },
  {
    "content": "然后不舒服",
    "from": 115.27,
    "location": 2,
    "music": 0.0,
    "sid": 52,
    "to": 116.57
  },
  {
    "content": "然后有启发性",
    "from": 116.57,
    "location": 2,
    "music": 0.0,
    "sid": 53,
    "to": 118.539
  },
  {
    "content": "那种不适感",
    "from": 118.539,
    "location": 2,
    "music": 0.0,
    "sid": 54,
    "to": 119.959
  },
  {
    "content": "这就是智力在成长",
    "from": 119.959,
    "location": 2,
    "music": 0.0,
    "sid": 55,
    "to": 123.22
  },
  {
    "content": "先经历两次挣扎再求助",
    "from": 123.22,
    "location": 2,
    "music": 0.0,
    "sid": 56,
    "to": 125.32
  },
  {
    "content": "高智商的人不会急于给出答案",
    "from": 125.32,
    "location": 2,
    "music": 0.0,
    "sid": 57,
    "to": 128.28
  },
  {
    "content": "他们会延迟帮助",
    "from": 128.28,
    "location": 2,
    "music": 0.0,
    "sid": 58,
    "to": 129.88
  },
  {
    "content": "心理学家称之为建设性挣扎",
    "from": 129.88,
    "location": 2,
    "music": 0.0,
    "sid": 59,
    "to": 132.74
  },
  {
    "content": "大脑在尝试时会变得更强大",
    "from": 132.74,
    "location": 2,
    "music": 0.0,
    "sid": 60,
    "to": 134.94
  },
  {
    "content": "失败了",
    "from": 134.94,
    "location": 2,
    "music": 0.0,
    "sid": 61,
    "to": 135.62
  },
  {
    "content": "调整后重新尝试",
    "from": 135.62,
    "location": 2,
    "music": 0.0,
    "sid": 62,
    "to": 137.78
  },
  {
    "content": "本杰明·富兰克林就是这样训练自己的",
    "from": 137.78,
    "location": 2,
    "music": 0.0,
    "sid": 63,
    "to": 140.43
  },
  {
    "content": "他会阅读一篇文章",
    "from": 140.43,
    "location": 2,
    "music": 0.0,
    "sid": 64,
    "to": 141.87
  },
  {
    "content": "然后收起来",
    "from": 141.87,
    "location": 2,
    "music": 0.0,
    "sid": 65,
    "to": 142.69
  },
  {
    "content": "接着试着凭记忆重写",
    "from": 142.69,
    "location": 2,
    "music": 0.0,
    "sid": 66,
    "to": 144.81
  },
  {
    "content": "只有在挣扎之后",
    "from": 144.81,
    "location": 2,
    "music": 0.0,
    "sid": 67,
    "to": 146.31
  },
  {
    "content": "才会与原文对比",
    "from": 146.31,
    "location": 2,
    "music": 0.0,
    "sid": 68,
    "to": 148.49
  },
  {
    "content": "这迫使大脑提取信息",
    "from": 148.49,
    "location": 2,
    "music": 0.0,
    "sid": 69,
    "to": 151.47
  },
  {
    "content": "重新组织",
    "from": 151.47,
    "location": 2,
    "music": 0.0,
    "sid": 70,
    "to": 152.61
  },
  {
    "content": "精炼内容",
    "from": 152.61,
    "location": 2,
    "music": 0.0,
    "sid": 71,
    "to": 153.51
  },
  {
    "content": "现代脑成像显示，挣扎激活的神经通路比被动解释更深层",
    "from": 153.51,
    "location": 2,
    "music": 0.0,
    "sid": 72,
    "to": 160.399
  },
  {
    "content": "这就是即时解决方案为何显得高效",
    "from": 160.399,
    "location": 2,
    "music": 0.0,
    "sid": 73,
    "to": 163.779
  },
  {
    "content": "但很快从记忆中消失",
    "from": 163.779,
    "location": 2,
    "music": 0.0,
    "sid": 74,
    "to": 165.699
  },
  {
    "content": "在求助前养成最佳习惯",
    "from": 165.699,
    "location": 2,
    "music": 0.0,
    "sid": 75,
    "to": 168.779
  },
  {
    "content": "你最好的答案",
    "from": 168.779,
    "location": 2,
    "music": 0.0,
    "sid": 76,
    "to": 169.739
  },
  {
    "content": "即使答案错误",
    "from": 169.739,
    "location": 2,
    "music": 0.0,
    "sid": 77,
    "to": 171.179
  },
  {
    "content": "挣扎不代表低智商",
    "from": 171.179,
    "location": 2,
    "music": 0.0,
    "sid": 78,
    "to": 173.599
  },
  {
    "content": "这是构建智力的习惯机制",
    "from": 173.599,
    "location": 2,
    "music": 0.0,
    "sid": 79,
    "to": 176.36
  },
  {
    "content": "三写作用于思考而非记录",
    "from": 176.36,
    "location": 2,
    "music": 0.0,
    "sid": 80,
    "to": 179.49
  },
  {
    "content": "大多数人写作是为了存贮信息",
    "from": 179.49,
    "location": 2,
    "music": 0.0,
    "sid": 81,
    "to": 181.75
  },
  {
    "content": "聪明人写作是为了理清思路",
    "from": 181.75,
    "location": 2,
    "music": 0.0,
    "sid": 82,
    "to": 184.19
  },
  {
    "content": "达芬奇从不写文章",
    "from": 184.19,
    "location": 2,
    "music": 0.0,
    "sid": 83,
    "to": 186.67
  },
  {
    "content": "他写问题",
    "from": 186.67,
    "location": 2,
    "music": 0.0,
    "sid": 84,
    "to": 187.93
  },
  {
    "content": "图表",
    "from": 187.93,
    "location": 2,
    "music": 0.0,
    "sid": 85,
    "to": 189.03
  },
  {
    "content": "片段",
    "from": 189.03,
    "location": 2,
    "music": 0.0,
    "sid": 86,
    "to": 189.89
  },
  {
    "content": "矛盾点",
    "from": 189.89,
    "location": 2,
    "music": 0.0,
    "sid": 87,
    "to": 191.06
  },
  {
    "content": "他的笔记毫无条理",
    "from": 191.06,
    "location": 2,
    "music": 0.0,
    "sid": 88,
    "to": 192.86
  },
  {
    "content": "充满活力",
    "from": 192.86,
    "location": 2,
    "music": 0.0,
    "sid": 89,
    "to": 194.36
  },
  {
    "content": "写作迫使大脑放慢速度",
    "from": 194.36,
    "location": 2,
    "music": 0.0,
    "sid": 90,
    "to": 197.7
  },
  {
    "content": "发现漏洞",
    "from": 197.7,
    "location": 2,
    "music": 0.0,
    "sid": 91,
    "to": 199.04
  },
  {
    "content": "将模糊想法",
    "from": 199.04,
    "location": 2,
    "music": 0.0,
    "sid": 92,
    "to": 200.52
  },
  {
    "content": "变得精准",
    "from": 200.52,
    "location": 2,
    "music": 0.0,
    "sid": 93,
    "to": 201.27
  },
  {
    "content": "普林斯顿和UCLA的研究表明",
    "from": 201.27,
    "location": 2,
    "music": 0.0,
    "sid": 94,
    "to": 205.68
  },
  {
    "content": "手写写作在概念理解上远超打字或阅读",
    "from": 205.68,
    "location": 2,
    "music": 0.0,
    "sid": 95,
    "to": 209.6
  },
  {
    "content": "因为写作让思维可视化",
    "from": 209.6,
    "location": 2,
    "music": 0.0,
    "sid": 96,
    "to": 212.829
  },
  {
    "content": "聪明习惯",
    "from": 212.829,
    "location": 2,
    "music": 0.0,
    "sid": 97,
    "to": 213.909
  },
  {
    "content": "每日思维日记",
    "from": 213.909,
    "location": 2,
    "music": 0.0,
    "sid": 98,
    "to": 215.749
  },
  {
    "content": "不是记录今日所做",
    "from": 215.749,
    "location": 2,
    "music": 0.0,
    "sid": 99,
    "to": 217.909
  },
  {
    "content": "而是真正理解的内容",
    "from": 217.909,
    "location": 2,
    "music": 0.0,
    "sid": 100,
    "to": 220.79
  },
  {
    "content": "让我感到困惑的是",
    "from": 220.79,
    "location": 2,
    "music": 0.0,
    "sid": 101,
    "to": 222.399
  },
  {
    "content": "那种未完成的想法",
    "from": 222.399,
    "location": 2,
    "music": 0.0,
    "sid": 102,
    "to": 223.999
  },
  {
    "content": "思想被检验的地方，智慧便生长",
    "from": 225.119,
    "location": 2,
    "music": 0.0,
    "sid": 103,
    "to": 227.279
  },
  {
    "content": "不是习惯的堆砌",
    "from": 227.279,
    "location": 2,
    "music": 0.0,
    "sid": 104,
    "to": 228.799
  },
  {
    "content": "四个思维模型构建法",
    "from": 228.799,
    "location": 2,
    "music": 0.0,
    "sid": 105,
    "to": 231.329
  },
  {
    "content": "高",
    "from": 231.329,
    "location": 2,
    "music": 0.0,
    "sid": 106,
    "to": 231.929
  },
  {
    "content": "智商个体",
    "from": 231.929,
    "location": 2,
    "music": 0.0,
    "sid": 107,
    "to": 233.029
  },
  {
    "content": "他们不仅掌握事实",
    "from": 233.029,
    "location": 2,
    "music": 0.0,
    "sid": 108,
    "to": 234.409
  },
  {
    "content": "更能理解系统运作",
    "from": 234.409,
    "location": 2,
    "music": 0.0,
    "sid": 109,
    "to": 236.269
  },
  {
    "content": "查理·芒格称之为思维模型的网格",
    "from": 236.269,
    "location": 2,
    "music": 0.0,
    "sid": 110,
    "to": 240.579
  },
  {
    "content": "物理学教授因果关系",
    "from": 240.579,
    "location": 2,
    "music": 0.0,
    "sid": 111,
    "to": 242.699
  },
  {
    "content": "生物学教授适应机制",
    "from": 242.699,
    "location": 2,
    "music": 0.0,
    "sid": 112,
    "to": 244.939
