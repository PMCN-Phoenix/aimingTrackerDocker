[
  {
    "from": 0.1,
    "to": 1.14,
    "sid": 1,
    "location": 2,
    "content": "如果我告诉你",
    "music": 0.0
  },
  {
    "from": 1.14,
    "to": 2.82,
    "sid": 2,
    "location": 2,
    "content": "天才的大脑和你的大脑",
    "music": 0.0
  },
  {
    "from": 2.82,
    "to": 4.74,
    "sid": 3,
    "location": 2,
    "content": "在生理结构上几乎一模一样",
    "music": 0.0
  },
  {
    "from": 4.74,
    "to": 5.62,
    "sid": 4,
    "location": 2,
    "content": "你信吗",
    "music": 0.0
  },
  {
    "from": 5.62,
    "to": 7.02,
    "sid": 5,
    "location": 2,
    "content": "同样的神经元数量",
    "music": 0.0
  },
  {
    "from": 7.02,
    "to": 8.24,
    "sid": 6,
    "location": 2,
    "content": "同样的突出密度",
    "music": 0.0
  },
  {
    "from": 8.24,
    "to": 10.3,
    "sid": 7,
    "location": 2,
    "content": "同样的灰质白质比例",
    "music": 0.0
  },
  {
    "from": 10.3,
    "to": 11.82,
    "sid": 8,
    "location": 2,
    "content": "脑科学已经证实",
    "music": 0.0
  },
  {
    "from": 11.82,
    "to": 13.52,
    "sid": 9,
    "location": 2,
    "content": "没有任何一项生理指标",
    "music": 0.0
  },
  {
    "from": 13.52,
    "to": 15.58,
    "sid": 10,
    "location": 2,
    "content": "能把天才和普通人区分开",
    "music": 0.0
  },
  {
    "from": 15.58,
    "to": 17.09,
    "sid": 11,
    "location": 2,
    "content": "那区别到底在哪",
    "music": 0.0
  },
  {
    "from": 17.09,
    "to": 20.53,
    "sid": 12,
    "location": 2,
    "content": "科学家用脑成像设备扫描了一批公认的天才",
    "music": 0.0
  },
  {
    "from": 20.53,
    "to": 23.79,
    "sid": 13,
    "location": 2,
    "content": "想看看他们的大脑在解题时到底有多疯狂",
    "music": 0.0
  },
  {
    "from": 23.79,
    "to": 25.65,
    "sid": 14,
    "location": 2,
    "content": "结果所有人都愣住了",
    "music": 0.0
  },
  {
    "from": 25.65,
    "to": 28.15,
    "sid": 15,
    "location": 2,
    "content": "天才的大脑在处理复杂问题时",
    "music": 0.0
  },
  {
    "from": 28.15,
    "to": 30.23,
    "sid": 16,
    "location": 2,
    "content": "激活的区域比普通人更少",
    "music": 0.0
  },
  {
    "from": 30.23,
    "to": 31.82,
    "sid": 17,
    "location": 2,
    "content": "不是更多是更少",
    "music": 0.0
  },
  {
    "from": 31.82,
    "to": 34.26,
    "sid": 18,
    "location": 2,
    "content": "普通人的大脑像一锅沸腾的开水",
    "music": 0.0
  },
  {
    "from": 34.26,
    "to": 35.12,
    "sid": 19,
    "location": 2,
    "content": "到处冒泡",
    "music": 0.0
  },
  {
    "from": 35.12,
    "to": 35.98,
    "sid": 20,
    "location": 2,
    "content": "到处耗能",
    "music": 0.0
  },
  {
    "from": 35.98,
    "to": 37.22,
    "sid": 21,
    "location": 2,
    "content": "但什么都没煮熟",
    "music": 0.0
  },
  {
    "from": 37.22,
    "to": 39.16,
    "sid": 22,
    "location": 2,
    "content": "天才的大脑像一束激光",
    "music": 0.0
  },
  {
    "from": 39.16,
    "to": 41.08,
    "sid": 23,
    "location": 2,
    "content": "所有能量集中在一个点上",
    "music": 0.0
  },
  {
    "from": 41.08,
    "to": 42.17,
    "sid": 24,
    "location": 2,
    "content": "一击穿透",
    "music": 0.0
  },
  {
    "from": 42.17,
    "to": 44.39,
    "sid": 25,
    "location": 2,
    "content": "这意味着天才不是脑子好使",
    "music": 0.0
  },
  {
    "from": 44.39,
    "to": 45.75,
    "sid": 26,
    "location": 2,
    "content": "而是脑子会审",
    "music": 0.0
  },
  {
    "from": 45.75,
    "to": 46.71,
    "sid": 27,
    "location": 2,
    "content": "更关键的是",
    "music": 0.0
  },
  {
    "from": 46.71,
    "to": 48.79,
    "sid": 28,
    "location": 2,
    "content": "这种会审的能力不是天生的",
    "music": 0.0
  },
  {
    "from": 48.79,
    "to": 50.23,
    "sid": 29,
    "location": 2,
    "content": "是被训练出来的",
    "music": 0.0
  },
  {
    "from": 50.23,
    "to": 53.15,
    "sid": 30,
    "location": 2,
    "content": "大多数人穷尽一生都在拼命寻找答案",
    "music": 0.0
  },
  {
    "from": 53.15,
    "to": 54.97,
    "sid": 31,
    "location": 2,
    "content": "但天才根本不找答案",
    "music": 0.0
  },
  {
    "from": 54.97,
    "to": 58.05,
    "sid": 32,
    "location": 2,
    "content": "他们做的事情比找答案高了整整一个维度",
    "music": 0.0
  },
  {
    "from": 58.05,
    "to": 60.95,
    "sid": 33,
    "location": 2,
    "content": "今天我们就从五个维度来深度拆解",
    "music": 0.0
  },
  {
    "from": 60.95,
    "to": 63.58,
    "sid": 34,
    "location": 2,
    "content": "天才们的脑子到底是怎样炼成的",
    "music": 0.0
  },
  {
    "from": 63.58,
    "to": 66.18,
    "sid": 35,
    "location": 2,
    "content": "每一个方法你今天开始就能用上",
    "music": 0.0
  },
  {
    "from": 66.18,
    "to": 69.82,
    "sid": 36,
    "location": 2,
    "content": "看完你会彻底改变聪明这两个字的定义",
    "music": 0.0
  },
  {
    "from": 74.44,
    "to": 76.68,
    "sid": 37,
    "location": 2,
    "content": "天才做的第一步是删除",
    "music": 0.0
  },
  {
    "from": 76.68,
    "to": 77.8,
    "sid": 38,
    "location": 2,
    "content": "不是学更多",
    "music": 0.0
  },
  {
    "from": 77.8,
    "to": 78.9,
    "sid": 39,
    "location": 2,
    "content": "不是想更多",
    "music": 0.0
  },
  {
    "from": 78.9,
    "to": 81.07,
    "sid": 40,
    "location": 2,
    "content": "而是砍掉更多人的工作",
    "music": 0.0
  },
  {
    "from": 81.07,
    "to": 82.57,
    "sid": 41,
    "location": 2,
    "content": "记忆容量是有限的",
    "music": 0.0
  },
  {
    "from": 82.57,
    "to": 85.27,
    "sid": 42,
    "location": 2,
    "content": "大概只能同时处理4~7个信息块",
    "music": 0.0
  },
  {
    "from": 85.27,
    "to": 87.63,
    "sid": 43,
    "location": 2,
    "content": "当你试图同时考虑太多变量",
    "music": 0.0
  },
  {
    "from": 87.63,
    "to": 88.75,
    "sid": 44,
    "location": 2,
    "content": "大脑就会过载",
    "music": 0.0
  },
  {
    "from": 88.75,
    "to": 90.289,
    "sid": 45,
    "location": 2,
    "content": "判断力直线下降",
    "music": 0.0
  },
  {
    "from": 90.289,
    "to": 92.709,
    "sid": 46,
    "location": 2,
    "content": "就像一台电脑同时开了50个网页",
    "music": 0.0
  },
  {
    "from": 92.709,
    "to": 93.769,
    "sid": 47,
    "location": 2,
    "content": "不是更高效",
    "music": 0.0
  },
  {
    "from": 93.769,
    "to": 95.169,
    "sid": 48,
    "location": 2,
    "content": "而是直接卡死",
    "music": 0.0
  },
  {
    "from": 95.169,
    "to": 96.9,
    "sid": 49,
    "location": 2,
    "content": "天才深谙这一点",
    "music": 0.0
  },
  {
    "from": 96.9,
    "to": 98.88,
    "sid": 50,
    "location": 2,
    "content": "他们不是能处理更多信息",
    "music": 0.0
  },
  {
    "from": 98.88,
    "to": 102.24,
    "sid": 51,
    "location": 2,
    "content": "而是更擅长判断哪些信息根本不值得处理",
    "music": 0.0
  },
  {
    "from": 102.24,
    "to": 103.34,
    "sid": 52,
    "location": 2,
    "content": "1997年",
    "music": 0.0
  },
  {
    "from": 103.34,
    "to": 104.88,
    "sid": 53,
    "location": 2,
    "content": "乔布斯回归苹果",
    "music": 0.0
  },
  {
    "from": 104.88,
    "to": 107.7,
    "sid": 54,
    "location": 2,
    "content": "当时苹果有超过350条产品线",
    "music": 0.0
  },
  {
    "from": 107.7,
    "to": 109.1,
    "sid": 55,
    "location": 2,
    "content": "公司濒临破产",
    "music": 0.0
  },
  {
    "from": 109.1,
    "to": 112.44,
    "sid": 56,
    "location": 2,
    "content": "所有人都在讨论该推出什么新产品来救命",
    "music": 0.0
  },
  {
    "from": 112.44,
    "to": 115.14,
    "sid": 57,
    "location": 2,
    "content": "乔布斯做了一件所有人都觉得疯了的事",
    "music": 0.0
  },
  {
    "from": 115.14,
    "to": 117.02,
    "sid": 58,
    "location": 2,
    "content": "他砍掉了其中340条",
    "music": 0.0
  },
  {
    "from": 117.02,
    "to": 118.12,
    "sid": 59,
    "location": 2,
    "content": "只留下十条",
    "music": 0.0
  },
  {
    "from": 118.12,
    "to": 119.32,
    "sid": 60,
    "location": 2,
    "content": "董事会炸了锅",
    "music": 0.0
  },
  {
    "from": 119.32,
    "to": 121.24,
    "sid": 61,
    "location": 2,
    "content": "媒体说他在自掘坟墓",
    "music": 0.0
  },
  {
    "from": 121.24,
    "to": 123.729,
    "sid": 62,
    "location": 2,
    "content": "但两年后苹果起死回生",
    "music": 0.0
  },
  {
    "from": 123.729,
    "to": 125.429,
    "sid": 63,
    "location": 2,
    "content": "乔布斯后来说过一句话",
    "music": 0.0
  },
  {
    "from": 125.429,
    "to": 127.749,
    "sid": 64,
    "location": 2,
    "content": "专注不是对你要做的事情说事",
    "music": 0.0
  },
  {
    "from": 127.749,
    "to": 130.62,
    "sid": 65,
    "location": 2,
    "content": "而是对其他100个好主意说不",
    "music": 0.0
  },
  {
    "from": 130.62,
    "to": 133.64,
    "sid": 66,
    "location": 2,
    "content": "米开朗基罗被问到如何雕出大卫像",
    "music": 0.0
  },
  {
    "from": 133.64,
    "to": 135.08,
    "sid": 67,
    "location": 2,
    "content": "据传他的回答是",
    "music": 0.0
  },
  {
    "from": 135.08,
    "to": 136.72,
    "sid": 68,
    "location": 2,
    "content": "大卫本来就在石头里",
    "music": 0.0
  },
  {
    "from": 136.72,
    "to": 138.899,
    "sid": 69,
    "location": 2,
    "content": "我只是把多余的部分去掉了",
    "music": 0.0
  },
  {
    "from": 138.899,
    "to": 140.079,
    "sid": 70,
    "location": 2,
    "content": "这不是谦虚",
    "music": 0.0
  },
  {
    "from": 140.079,
    "to": 142.059,
    "sid": 71,
    "location": 2,
    "content": "这是一种思维方式的宣言",
    "music": 0.0
  },
  {
    "from": 142.059,
    "to": 143.659,
    "sid": 72,
    "location": 2,
    "content": "普通人面对一个问题",
    "music": 0.0
  },
  {
    "from": 143.659,
    "to": 145.96,
    "sid": 73,
    "location": 2,
    "content": "本能反应是我还需要什么",
    "music": 0.0
  },
  {
    "from": 145.96,
    "to": 147.84,
    "sid": 74,
    "location": 2,
    "content": "天才面对同一个问题",
    "music": 0.0
  },
  {
    "from": 147.84,
    "to": 149.98,
    "sid": 75,
    "location": 2,
    "content": "本能反应是我应该扔掉什么",
    "music": 0.0
  },
  {
    "from": 149.98,
    "to": 152.74,
    "sid": 76,
    "location": 2,
    "content": "真正的高手不是能想到别人想不到的",
    "music": 0.0
  },
  {
    "from": 152.74,
    "to": 154.9,
    "sid": 77,
    "location": 2,
    "content": "而是能忽略别人忽略不了的",
    "music": 0.0
  },
  {
    "from": 154.9,
    "to": 157.94,
    "sid": 78,
    "location": 2,
    "content": "回想一下你自己是不是每次做决策的时候",
    "music": 0.0
  },
  {
    "from": 157.94,
    "to": 159.82,
    "sid": 79,
    "location": 2,
    "content": "脑子里塞满了各种外衣和",
    "music": 0.0
  },
  {
    "from": 159.82,
    "to": 162.81,
    "sid": 80,
    "location": 2,
    "content": "但是这种习惯的根源藏在你大脑",
    "music": 0.0
  },
  {
    "from": 162.81,
    "to": 165.54,
    "sid": 81,
    "location": 2,
    "content": "一个你从未留意过的区域里",
    "music": 0.0
  },
  {
    "from": 165.92,
    "to": 168.84,
    "sid": 82,
    "location": 2,
    "content": "你大脑里有一个隐秘的网络",
    "music": 0.0
  },
  {
    "from": 168.84,
    "to": 170.42,
    "sid": 83,
    "location": 2,
    "content": "叫做默认模式网络",
    "music": 0.0
  },
  {
    "from": 170.42,
    "to": 172.12,
    "sid": 84,
    "location": 2,
    "content": "它在你发呆走神",
    "music": 0.0
  },
  {
    "from": 172.12,
    "to": 174.43,
    "sid": 85,
    "location": 2,
    "content": "洗澡散步的时候极度活跃",
    "music": 0.0
  },
  {
    "from": 174.43,
    "to": 177.53,
    "sid": 86,
    "location": 2,
    "content": "而这个网络恰恰是创造力的核心引擎",
    "music": 0.0
  },
  {
    "from": 177.53,
    "to": 179.65,
    "sid": 87,
    "location": 2,
    "content": "达尔文有一个雷打不动的习惯",
    "music": 0.0
  },
  {
    "from": 179.65,
    "to": 182.63,
    "sid": 88,
    "location": 2,
    "content": "他在自家庄园后面修了一条砂石小路",
    "music": 0.0
  },
  {
    "from": 182.63,
    "to": 184.55,
    "sid": 89,
    "location": 2,
    "content": "每天固定在上面走圈",
    "music": 0.0
  },
  {
    "from": 184.55,
    "to": 186.09,
    "sid": 90,
    "location": 2,
    "content": "起点放一堆石子",
    "music": 0.0
  },
  {
    "from": 186.09,
    "to": 187.57,
    "sid": 91,
    "location": 2,
    "content": "每走一圈踢掉一颗",
    "music": 0.0
  },
  {
    "from": 187.57,
    "to": 191.05,
    "sid": 92,
    "location": 2,
    "content": "他的很多关键洞见不是在书桌前想出来的",
    "music": 0.0
  },
  {
    "from": 191.05,
    "to": 193.21,
    "sid": 93,
    "location": 2,
    "content": "而是在这条路上走出来的",
    "music": 0.0
  },
  {
    "from": 193.21,
    "to": 196.94,
    "sid": 94,
    "location": 2,
    "content": "进化论的核心框架就是在这条沙径上成型的",
    "music": 0.0
  },
  {
    "from": 196.94,
    "to": 198.88,
    "sid": 95,
    "location": 2,
    "content": "爱迪生有一个更极端的做法",
    "music": 0.0
  },
  {
    "from": 198.88,
    "to": 200.0,
    "sid": 96,
    "location": 2,
    "content": "他会坐在椅子上",
    "music": 0.0
  },
  {
    "from": 200.0,
    "to": 201.36,
    "sid": 97,
    "location": 2,
    "content": "手里握着一颗钢球",
    "music": 0.0
  },
  {
    "from": 201.36,
    "to": 202.72,
    "sid": 98,
    "location": 2,
    "content": "然后闭眼打盹",
    "music": 0.0
  },
  {
    "from": 202.72,
    "to": 205.36,
    "sid": 99,
    "location": 2,
    "content": "当他刚刚滑入半梦半醒的边缘",
    "music": 0.0
  },
  {
    "from": 205.36,
    "to": 206.14,
    "sid": 100,
    "location": 2,
    "content": "手一松",
    "music": 0.0
  },
  {
    "from": 206.14,
    "to": 208.88,
    "sid": 101,
    "location": 2,
    "content": "钢球砸在地板上的声响把他惊醒",
    "music": 0.0
  },
  {
    "from": 208.88,
    "to": 211.66,
    "sid": 102,
    "location": 2,
    "content": "他发现就在那个意识模糊的瞬间",
    "music": 0.0
  },
  {
    "from": 211.66,
    "to": 214.69,
    "sid": 103,
    "location": 2,
    "content": "大脑会冒出清醒时根本想不到的念头",
    "music": 0.0
  },
  {
    "from": 214.69,
    "to": 218.26,
    "sid": 104,
    "location": 2,
    "content": "法国数学家庞加莱在自传里记录过一次经历",
    "music": 0.0
  },
  {
    "from": 218.26,
    "to": 220.64,
    "sid": 105,
    "location": 2,
    "content": "他被一个数学难题困住了好几周",
    "music": 0.0
  },
  {
    "from": 220.64,
    "to": 221.86,
    "sid": 106,
    "location": 2,
    "content": "怎么推都推不动",
    "music": 0.0
  },
  {
    "from": 221.86,
    "to": 223.93,
    "sid": 107,
    "location": 2,
    "content": "后来他放弃了去度假",
    "music": 0.0
  },
  {
    "from": 223.93,
    "to": 226.01,
    "sid": 108,
    "location": 2,
    "content": "结果在登上一辆公共马车",
    "music": 0.0
  },
  {
    "from": 226.01,
    "to": 227.89,
    "sid": 109,
    "location": 2,
