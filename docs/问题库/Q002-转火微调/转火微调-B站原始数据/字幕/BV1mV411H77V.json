    },
    {
      "from": 97.9,
      "to": 99.16,
      "sid": 38,
      "location": 2,
      "content": "余光找到下一个目标",
      "music": 0.0
    },
    {
      "from": 99.16,
      "to": 102.97,
      "sid": 39,
      "location": 2,
      "content": "然后心里面大概就测算了方向以及距离",
      "music": 0.0
    },
    {
      "from": 102.97,
      "to": 105.34,
      "sid": 40,
      "location": 2,
      "content": "然后就准备往下一个目标",
