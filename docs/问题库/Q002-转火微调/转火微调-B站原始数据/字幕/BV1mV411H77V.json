    },
    {
      "from": 124.56,
      "to": 130.59,
      "sid": 48,
      "location": 2,
      "content": "那么进阶进阶的人跟入门的人的区别在于哪里",
      "music": 0.0
    },
    {
      "from": 130.59,
      "to": 132.729,
      "sid": 49,
      "location": 2,
      "content": "在于呃",
      "music": 0.0
    },
    {
      "from": 132.729,
      "to": 135.939,
      "sid": 50,
      "location": 2,
      "content": "这这接下来说的就是你进阶之后",
      "music": 0.0
    },
    {
      "from": 135.939,
      "to": 138.039,
      "sid": 51,
      "location": 2,
      "content": "你需要去融会贯通",
      "music": 0.0
    },
    {
      "from": 138.039,
      "to": 139.719,
      "sid": 52,
      "location": 2,
      "content": "然后精益求精",
      "music": 0.0
    },
    {
      "from": 139.719,
      "to": 141.1,
      "sid": 53,
      "location": 2,
      "content": "要做好的事情",
      "music": 0.0
    },
    {
      "from": 141.44,
      "to": 143.06,
      "sid": 54,
      "location": 2,
      "content": "区别在于哪里",
      "music": 0.0
    },
    {
      "from": 143.399,
      "to": 145.589,
      "sid": 55,
      "location": 2,
      "content": "眼睛看到这个目标的时候",
