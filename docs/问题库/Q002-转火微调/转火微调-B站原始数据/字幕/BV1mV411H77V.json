{
  "bvid": "BV1mV411H77V",
  "status": "ok lang=ai-zh",
  "segments": [
    {
      "from": 0.74,
      "to": 2.6,
      "sid": 1,
      "location": 2,
      "content": "把录像打开再讲一遍",
      "music": 0.0
    },
    {
      "from": 2.6,
      "to": 4.28,
      "sid": 2,
      "location": 2,
      "content": "就刚刚没有听到的人",
      "music": 0.0
    },
    {
      "from": 4.28,
      "to": 5.72,
      "sid": 3,
      "location": 2,
      "content": "可能现在能再讲一遍",
      "music": 0.0
    },
    {
      "from": 5.72,
      "to": 8.899,
      "sid": 4,
      "location": 2,
      "content": "让你听看能不能听得明白喂",
      "music": 0.0
    },
    {
      "from": 8.899,
      "to": 10.969,
      "sid": 5,
      "location": 2,
      "content": "所以这个视频要给大家讲",
      "music": 0.0
    },
    {
      "from": 10.969,
      "to": 12.619,
      "sid": 6,
      "location": 2,
      "content": "为什么点小目标",
      "music": 0.0
    },
    {
      "from": 12.619,
      "to": 14.509,
      "sid": 7,
      "location": 2,
      "content": "很多人小目标会很慢",
      "music": 0.0
    },
    {
      "from": 14.509,
      "to": 18.3,
      "sid": 8,
      "location": 2,
      "content": "然后呃他没有办法提高",
      "music": 0.0
    },
    {
      "from": 18.3,
      "to": 19.71,
      "sid": 9,
      "location": 2,
      "content": "没有办法突破瓶颈",
      "music": 0.0
    },
    {
      "from": 19.71,
      "to": 22.74,
      "sid": 10,
      "location": 2,
      "content": "除开他练习量不够啊",
      "music": 0.0
    },
    {
      "from": 22.74,
      "to": 25.89,
      "sid": 11,
      "location": 2,
      "content": "以及他基础十分的差",
      "music": 0.0
    },
    {
      "from": 25.89,
      "to": 28.77,
      "sid": 12,
      "location": 2,
      "content": "就是入门情况这些除开这些",
      "music": 0.0
    },
    {
      "from": 28.77,
      "to": 31.38,
      "sid": 13,
      "location": 2,
      "content": "但入门情况的也可以听一听",
      "music": 0.0
    },
    {
      "from": 31.38,
      "to": 35.5,
      "sid": 14,
      "location": 2,
      "content": "你接下来有什么有什么样的难题需要去突破",
      "music": 0.0
    },
    {
      "from": 37.54,
      "to": 40.83,
      "sid": 15,
      "location": 2,
      "content": "我我把刚刚这个人点的东西拎出来看",
      "music": 0.0
    },
    {
      "from": 40.83,
      "to": 43.8,
      "sid": 16,
      "location": 2,
      "content": "他这个人其实已经算是他有经过一定练习",
      "music": 0.0
    },
    {
      "from": 43.8,
      "to": 47.55,
      "sid": 17,
      "location": 2,
      "content": "然后他点的就是严守协调基",
      "music": 0.0
    },
    {
      "from": 47.55,
      "to": 49.379,
      "sid": 18,
      "location": 2,
      "content": "基本没有什么问题的",
      "music": 0.0
    },
    {
      "from": 50.3,
      "to": 52.8,
      "sid": 19,
      "location": 2,
      "content": "也能点个9万多嘛对吧",
      "music": 0.0
    },
    {
      "from": 53.1,
      "to": 55.5,
      "sid": 20,
      "location": 2,
      "content": "那接下来要怎么突破瓶颈呢",
      "music": 0.0
    },
    {
      "from": 55.5,
      "to": 58.92,
      "sid": 21,
      "location": 2,
      "content": "他现在是不是点起来就是哦呃这个目标点完",
      "music": 0.0
    },
    {
      "from": 58.92,
      "to": 62.05,
      "sid": 22,
      "location": 2,
      "content": "点下一个目标是不是就十分的连贯啊",
      "music": 0.0
    },
    {
      "from": 62.05,
      "to": 64.09,
      "sid": 23,
      "location": 2,
      "content": "然后只是速度",
      "music": 0.0
    },
    {
      "from": 64.09,
      "to": 66.97,
      "sid": 24,
      "location": 2,
      "content": "就他瞄准的质量没有太大太大的问题吗",
      "music": 0.0
    },
    {
      "from": 66.97,
      "to": 68.36,
      "sid": 25,
      "location": 2,
      "content": "在这个速度下",
      "music": 0.0
    },
    {
      "from": 70.76,
      "to": 74.2,
      "sid": 26,
      "location": 2,
      "content": "那我嗯要怎么突破呢",
      "music": 0.0
    },
    {
      "from": 74.98,
      "to": 78.6,
      "sid": 27,
      "location": 2,
      "content": "除除开大家所说的所谓的轨迹",
      "music": 0.0
    },
    {
      "from": 78.6,
      "to": 81.24,
      "sid": 28,
      "location": 2,
      "content": "以及找目标这两件事情",
      "music": 0.0
    },
    {
      "from": 82.18,
      "to": 83.88,
      "sid": 29,
      "location": 2,
      "content": "当然我现在也得提一下嘛",
      "music": 0.0
    },
    {
      "from": 83.88,
      "to": 87.1,
      "sid": 30,
      "location": 2,
      "content": "就是首先你眼睛要找到一个目标",
      "music": 0.0
    },
    {
      "from": 87.1,
      "to": 89.84,
      "sid": 31,
      "location": 2,
      "content": "找到第一个目标点点下去的时候",
      "music": 0.0
    },
    {
      "from": 89.84,
      "to": 90.86,
      "sid": 32,
      "location": 2,
      "content": "你要找下一个目标",
