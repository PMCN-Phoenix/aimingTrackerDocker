{
  "bvid": "BV1nT411K7Lr",
  "status": "ok lang=ai-zh",
  "segments": [
    {
      "from": 0.44,
      "to": 2.74,
      "sid": 1,
      "location": 2,
      "content": "我会试着让这个介绍简短而甜蜜"
    },
    {
      "from": 2.74,
      "to": 6.4,
      "sid": 2,
      "location": 2,
      "content": "这些是我个人最喜欢玩的场景 来练习目标切换"
    },
    {
      "from": 6.4,
      "to": 10.16,
      "sid": 3,
      "location": 2,
      "content": "专注于让你的电影更快更准确"
    },
    {
      "from": 10.16,
      "to": 12.6,
      "sid": 4,
      "location": 2,
      "content": "这些任务对我在战场等游戏中的帮助很大"
    },
    {
      "from": 14.08,
      "to": 18.1,
      "sid": 5,
      "location": 2,
      "content": "使命召唤和顶点传奇"
    },
    {
      "from": 19.14,
      "to": 21.96,
      "sid": 6,
      "location": 2,
      "content": "每个场景的时间戳将在描述中"
    },
    {
      "from": 21.96,
      "to": 24.2,
      "sid": 7,
      "location": 2,
      "content": "我会简单地解释为什么我喜欢每一个"
    },
    {
      "from": 24.2,
      "to": 25.46,
      "sid": 8,
      "location": 2,
      "content": "以及它所帮助的"
    },
    {
      "from": 25.46,
      "to": 28.689,
      "sid": 9,
      "location": 2,
      "content": "以及在这种情况下的建议 FOV范围"
    },
    {
      "from": 28.689,
      "to": 31.489,
      "sid": 10,
      "location": 2,
      "content": "所有 FOV值将使用水平 FOV"
    },
    {
      "from": 31.489,
      "to": 34.96,
      "sid": 11,
      "location": 2,
      "content": "在 covax中和守望先锋的滑块是一样的"
    },
    {
      "from": 34.96,
      "to": 37.6,
      "sid": 12,
      "location": 2,
      "content": "如果你只是想下载所有这些场景的播放列表"
    },
    {
      "from": 37.6,
      "to": 39.8,
      "sid": 13,
      "location": 2,
      "content": "在描述的顶部有一个链接"
    },
    {
      "from": 40.06,
      "to": 41.26,
      "sid": 14,
      "location": 2,
      "content": "头圈开关"
    },
    {
      "from": 41.26,
      "to": 42.1,
      "sid": 15,
      "location": 2,
      "content": "小静"
    },
    {
      "from": 42.1,
      "to": 42.74,
      "sid": 16,
      "location": 2,
      "content": "不装弹"
    },
    {
      "from": 42.74,
      "to": 44.9,
      "sid": 17,
      "location": 2,
      "content": "这是我一直以来的最爱之一"
    },
    {
      "from": 44.9,
      "to": 48.2,
      "sid": 18,
      "location": 2,
      "content": "和一个超级有用的场景来提高你的开关精度"
    },
    {
      "from": 48.2,
      "to": 52.68,
      "sid": 19,
      "location": 2,
      "content": "这是由于它一致的广角镜头，通常在你的视野内"
    },
    {
      "from": 52.68,
      "to": 54.34,
      "sid": 20,
      "location": 2,
      "content": "以及非常小的目标"
    },
    {
      "from": 54.34,
      "to": 58.34,
      "sid": 21,
      "location": 2,
      "content": "迫使你准确快速地轻弹或微调整 以获得好成绩"
    },
    {
      "from": 58.34,
      "to": 59.18,
      "sid": 22,
      "location": 2,
      "content": "目标切换"
    },
    {
      "from": 59.18,
      "to": 61.58,
      "sid": 23,
      "location": 2,
      "content": "360静态和薄版本"
    },
    {
      "from": 61.58,
      "to": 64.7,
      "sid": 24,
      "location": 2,
      "content": "与列表中的其他场景相比，这两个场景都相当独特"
    },
    {
      "from": 64.7,
      "to": 65.74,
      "sid": 25,
      "location": 2,
      "content": "它们不是最受欢迎的"
    },
    {
      "from": 65.74,
      "to": 70.01,
      "sid": 26,
      "location": 2,
      "content": "但我发现它们对基于音频的方向感知非常有用"
    },
    {
      "from": 70.01,
      "to": 75.18,
      "sid": 27,
      "location": 2,
      "content": "我喜欢播放很高的画面，打开产卵的声音，试着弹到声音来自的地方"
    },
    {
      "from": 75.18,
      "to": 79.56,
      "sid": 28,
      "location": 2,
      "content": "在我看来，从音频线索中获得好的屏幕外电影是一项被低估的技能"
    },
    {
      "from": 79.56,
      "to": 81.81,
      "sid": 29,
      "location": 2,
      "content": "这是最好的练习方案"
    },
    {
      "from": 81.81,
      "to": 82.91,
      "sid": 30,
      "location": 2,
      "content": "如果你想挑战"
    },
    {
      "from": 82.91,
      "to": 84.27,
      "sid": 31,
      "location": 2,
      "content": "还可以播放瘦版"
    },
    {
      "from": 84.27,
      "to": 85.45,
      "sid": 32,
      "location": 2,
      "content": "这真的很难"
    },
    {
      "from": 85.45,
      "to": 88.639,
      "sid": 33,
      "location": 2,
      "content": "但很好的练习目标是俗气的"
    },
    {
      "from": 88.639,
      "to": 90.599,
      "sid": 34,
      "location": 2,
      "content": "老实说，这个场景很有趣"
    },
    {
      "from": 90.599,
      "to": 92.839,
      "sid": 35,
      "location": 2,
      "content": "这里唯一重要的是原始的轻弹速度"
    },
    {
      "from": 92.839,
      "to": 94.82,
      "sid": 36,
      "location": 2,
      "content": "你能把凶手串在一起"
    },
    {
      "from": 94.82,
      "to": 98.85,
      "sid": 37,
      "location": 2,
      "content": "在一分钟内保持这样的速度 需要很大的一致性"
    },
    {
      "from": 98.85,
      "to": 100.83,
      "sid": 38,
      "location": 2,
      "content": "粘质变化"
    },
    {
      "from": 100.83,
      "to": 103.37,
      "sid": 39,
      "location": 2,
      "content": "把我自己的情况写在这份清单上 有点奇怪"
    },
    {
      "from": 103.37,
      "to": 105.52,
      "sid": 40,
      "location": 2,
      "content": "但我真的觉得它非常有用"
    },
    {
      "from": 105.52,
      "to": 109.7,
      "sid": 41,
      "location": 2,
      "content": "它旨在帮助玩家更适应在较小的目标上弹得更快"
    },
    {
      "from": 109.7,
      "to": 112.68,
      "sid": 42,
      "location": 2,
      "content": "这是通过在整个场景中慢慢缩小目标来实现的"
    },
    {
      "from": 112.68,
      "to": 115.26,
      "sid": 43,
      "location": 2,
      "content": "但你通常会放慢轻弹速度"
    },
    {
      "from": 115.26,
      "to": 116.49,
      "sid": 44,
      "location": 2,
      "content": "在整个场景中"
    },
    {
      "from": 116.49,
      "to": 120.25,
      "sid": 45,
      "location": 2,
      "content": "如果目标一开始只是很小的，那就不会那么多了"
    },
    {
      "from": 120.25,
      "to": 122.57,
      "sid": 46,
      "location": 2,
      "content": "它会让你更适应它"
    },
    {
      "from": 122.57,
      "to": 126.07,
      "sid": 47,
      "location": 2,
      "content": "禅目标开关和禅目标开关速度 静态"
    },
    {
      "from": 126.07,
      "to": 128.63,
      "sid": 48,
      "location": 2,
      "content": "这些场景有很多超级怪异的角度"
    },
    {
      "from": 128.63,
      "to": 130.19,
      "sid": 49,
      "location": 2,
      "content": "在游戏中大多数时候"
    },
    {
      "from": 130.19,
      "to": 131.71,
      "sid": 50,
      "location": 2,
      "content": "你的开关将处于标准角度"
    },
    {
      "from": 131.71,
      "to": 134.459,
      "sid": 51,
      "location": 2,
      "content": "偶尔练习一下 不太常见的是好的"
    },
    {
      "from": 134.459,
      "to": 137.339,
      "sid": 52,
      "location": 2,
      "content": "标准版以中型移动目标为特色"
    },
    {
      "from": 137.339,
      "to": 141.179,
      "sid": 53,
      "location": 2,
      "content": "速度版本有一个稍微低的时间和稍微大的目标"
    },
    {
      "from": 141.179,
      "to": 143.31,
      "sid": 54,
      "location": 2,
      "content": "和他们一起显然没有移动"
    },
    {
      "from": 143.31,
      "to": 144.89,
      "sid": 55,
      "location": 2,
      "content": "三个六十静态"
    },
    {
      "from": 144.89,
      "to": 146.53,
      "sid": 56,
      "location": 2,
      "content": "这是我的另一个最爱"
    },
    {
      "from": 146.53,
      "to": 149.1,
      "sid": 57,
      "location": 2,
      "content": "另一个有着奇怪的垂直角度"
    },
    {
      "from": 149.1,
      "to": 151.44,
      "sid": 58,
      "location": 2,
      "content": "这部主要是关于准确的小电影"
    },
    {
      "from": 151.44,
      "to": 153.62,
      "sid": 59,
      "location": 2,
      "content": "但也包含了很多垂直开关"
    },
    {
      "from": 153.62,
      "to": 155.84,
      "sid": 60,
      "location": 2,
      "content": "老实说，很难适应"
    },
    {
      "from": 155.84,
      "to": 158.38,
      "sid": 61,
      "location": 2,
      "content": "它还需要很好的复位效率"
    },
    {
      "from": 158.38,
      "to": 160.58,
      "sid": 62,
      "location": 2,
      "content": "因为你要去你的老鼠划桨场的边缘"
    },
    {
      "from": 160.58,
      "to": 163.34,
      "sid": 63,
      "location": 2,
      "content": "让它成为训练陶狂热的好方法"
    },
    {
      "from": 163.34,
      "to": 165.42,
      "sid": 64,
      "location": 2,
      "content": "挥一八零，道狂"
    },
    {
      "from": 165.42,
      "to": 166.9,
      "sid": 65,
      "location": 2,
      "content": "弹一八小井"
    },
    {
      "from": 166.9,
      "to": 170.56,
      "sid": 66,
      "location": 2,
      "content": "这些场景看起来很相似，我在这个视频中把它们分组在一起"
    },
    {
      "from": 170.56,
      "to": 172.63,
      "sid": 67,
      "location": 2,
      "content": "老实说，它们在功能上非常不同"
    },
    {
      "from": 172.63,
      "to": 173.03,
      "sid": 68,
      "location": 2,
      "content": "好吧"
    },
    {
      "from": 173.03,
      "to": 173.75,
      "sid": 69,
      "location": 2,
      "content": "如果你不够好"
    },
    {
      "from": 173.75,
      "to": 176.45,
      "sid": 70,
      "location": 2,
      "content": "更大的一个可以是更有经验的玩家的轻弹练习"
    },
    {
      "from": 176.45,
      "to": 180.78,
      "sid": 71,
      "location": 2,
      "content": "它主要帮助获得知道何时关闭目标的感觉，并获得非常精确的目标"
    },
    {
      "from": 180.78,
      "to": 183.14,
      "sid": 72,
      "location": 2,
      "content": "它也是对一致性的测试"
    },
    {
      "from": 183.14,
      "to": 186.73,
      "sid": 73,
      "location": 2,
      "content": "迫使你在一分钟内快速准确地弹出电影"
    },
    {
      "from": 186.73,
      "to": 194.55,
      "sid": 74,
      "location": 2,
      "content": "对几乎每个人来说，较小的场景是在水平角度和更时髦的对角线角度进行电影一致性的很好的练习"
    },
    {
      "from": 194.55,
      "to": 196.69,
      "sid": 75,
      "location": 2,
      "content": "我真的很喜欢玩这两个场景"
    },
    {
      "from": 196.69,
      "to": 198.13,
      "sid": 76,
      "location": 2,
      "content": "尽管看起来有点傻"
    },
    {
      "from": 198.13,
      "to": 199.61,
      "sid": 77,
      "location": 2,
      "content": "我觉得他们帮了我很多"
    },
    {
      "from": 199.61,
      "to": 201.09,
      "sid": 78,
      "location": 2,
      "content": "PAT目标开关静态"
    },
    {
      "from": 201.09,
      "to": 201.71,
      "sid": 79,
      "location": 2,
      "content": "不装弹"
    },
    {
      "from": 201.71,
      "to": 203.53,
      "sid": 80,
      "location": 2,
      "content": "在这种情况下没什么可谈的"
    },
    {
      "from": 203.53,
      "to": 205.29,
      "sid": 81,
      "location": 2,
      "content": "老实说，我个人觉得这真的很有趣"
    },
    {
      "from": 205.29,
      "to": 208.37,
      "sid": 82,
      "location": 2,
      "content": "对于速度和开关一致性都是很好的练习"
    },
    {
      "from": 208.37,
      "to": 212.85,
      "sid": 83,
      "location": 2,
      "content": "大多数开关都是相当大的角度，你必须相当精确，以避免击中身体投篮"
    },
    {
      "from": 212.85,
      "to": 214.329,
      "sid": 84,
      "location": 2,
      "content": "会降低你的分数"
    },
    {
      "from": 214.329,
      "to": 215.849,
      "sid": 85,
      "location": 2,
      "content": "目标开关360"
    },
    {
      "from": 215.849,
      "to": 216.629,
      "sid": 86,
      "location": 2,
      "content": "不装弹"
    },
    {
      "from": 216.629,
      "to": 222.389,
      "sid": 87,
      "location": 2,
      "content": "这特别帮助了我的开关，这些开关超出了舒适的地方，使用手腕真的很不直观"
    },
    {
      "from": 222.389,
      "to": 226.82,
      "sid": 88,
      "location": 2,
      "content": "因为这帮助我更好地感觉到什么时候该在调整手腕和手臂之间切换"
    },
    {
      "from": 226.82,
      "to": 230.9,
      "sid": 89,
      "location": 2,
      "content": "使它更自然地这样做 一些毫秒的伏特"
    },
    {
      "from": 230.9,
      "to": 232.82,
      "sid": 90,
      "location": 2,
      "content": "虽然这种情况下有一个较低的 tk"
    },
    {
      "from": 232.82,
      "to": 235.84,
      "sid": 91,
      "location": 2,
      "content": "它比名单上的其他大多数需要更多的跟踪"
    },
    {
      "from": 235.84,
      "to": 240.879,
      "sid": 92,
      "location": 2,
      "content": "它的设计是为了帮助在目标之间切换，以不同的快速动作在这一个上得分"
    },
    {
      "from": 240.879,
      "to": 242.299,
      "sid": 93,
      "location": 2,
      "content": "火车停在中间区 域"
    },
    {
      "from": 242.299,
      "to": 248.2,
      "sid": 94,
      "location": 2,
      "content": "因为如果机器人向左或向右偏离太远，它们就会有疯狂的运动"
    },
    {
      "from": 248.2,
      "to": 254.28,
      "sid": 95,
      "location": 2,
      "content": "包括这个场景是因为它非常有用，可以跟踪更长的条纹，在开关之间杀死更高的时间"
    },
    {
      "from": 254.28,
      "to": 257.519,
      "sid": 96,
      "location": 2,
      "content": "并在目标海峡后准确地重新调整"
    },
    {
      "from": 257.519,
      "to": 260.039,
      "sid": 97,
      "location": 2,
      "content": "为更高的时间设定基准也很好"
    },
    {
      "from": 260.039,
      "to": 261.358,
      "sid": 98,
      "location": 2,
      "content": "杀死切换场景"
    },
    {
      "from": 261.358,
      "to": 263.36,
      "sid": 99,
      "location": 2,
      "content": "看看你在这方面有了多大的进步"
    },
    {
      "from": 263.36,
      "to": 264.94,
      "sid": 100,
      "location": 2,
      "content": "婴儿床速度"
    },
    {
      "from": 264.94,
      "to": 267.58,
      "sid": 101,
      "location": 2,
      "content": "这个场景是名单上最独特的场景之一"
    },
    {
      "from": 267.58,
      "to": 271.58,
      "sid": 102,
      "location": 2,
      "content": "我把它包括进去 是因为它对我学习如何适应"
    },
    {
      "from": 271.58,
      "to": 274.54,
      "sid": 103,
      "location": 2,
      "content": "不仅横条被目标中间切换"
    },
    {
      "from": 274.54,
      "to": 277.94,
      "sid": 104,
      "location": 2,
      "content": "但也是垂直的，需要更多的阅读目标的运动"
    },
    {
      "from": 277.94,
      "to": 279.32,
      "sid": 105,
      "location": 2,
      "content": "超级怪异的场景"
    },
    {
      "from": 279.32,
      "to": 280.51,
      "sid": 106,
      "location": 2,
      "content": "但我真的很喜欢"
    },
    {
      "from": 280.51,
      "to": 283.29,
      "sid": 107,
      "location": 2,
      "content": "Pat循环开关和 Pat循环静态开关"
    },
    {
      "from": 283.29,
      "to": 288.44,
      "sid": 108,
      "location": 2,
      "content": "这两个都是经典的场景，基本上是对原始垫目标开关的升级"
    },
    {
      "from": 288.44,
      "to": 293.07,
      "sid": 109,
      "location": 2,
      "content": "PET圆环切换是一个完美的场景，以基准整体速度切换能力"
    },
    {
      "from": 293.07,
      "to": 297.55,
      "sid": 110,
      "location": 2,
      "content": "静态版本真的帮助我在更尴尬的角度上建立速度，并变得更自信"
    },
    {
      "from": 297.55,
      "to": 301.19,
      "sid": 111,
      "location": 2,
      "content": "在目标开关处打开标准开关 360"
    },
    {
      "from": 301.19,
      "to": 302.79,
      "sid": 112,
      "location": 2,
      "content": "另一个广角场景"
    },
    {
      "from": 302.79,
      "to": 304.59,
      "sid": 113,
      "location": 2,
      "content": "不过，既然目标在这里移动"
    },
    {
      "from": 304.59,
      "to": 308.13,
      "sid": 114,
      "location": 2,
      "content": "几乎不可能一直把它们从屏幕外弹出来"
    },
    {
      "from": 308.13,
      "to": 312.61,
      "sid": 115,
      "location": 2,
