  "segments": [
    {
      "from": 0.04,
      "to": 3.54,
      "sid": 1,
      "location": 2,
      "content": "为什么你看到的高手瞄准都是一个甩枪过去",
      "music": 0.0
    },
    {
      "from": 3.54,
      "to": 5.42,
      "sid": 2,
      "location": 2,
      "content": "然后敌人就碎了",
      "music": 0.0
    },
    {
      "from": 5.42,
      "to": 7.64,
      "sid": 3,
      "location": 2,
      "content": "而你在靶场里面也甩枪",
      "music": 0.0
    },
    {
      "from": 7.64,
      "to": 9.58,
      "sid": 4,
      "location": 2,
      "content": "在实战中却做不出来",
      "music": 0.0
    },
    {
      "from": 9.58,
      "to": 12.88,
      "sid": 5,
      "location": 2,
      "content": "首先你练这个不存在的东西",
      "music": 0.0
    },
    {
      "from": 12.88,
      "to": 13.6,
      "sid": 6,
      "location": 2,
      "content": "你能念出来",
      "music": 0.0
    },
    {
      "from": 13.6,
      "to": 15.15,
      "sid": 7,
      "location": 2,
      "content": "瞄准就怪了",
      "music": 0.0
    },
    {
      "from": 15.15,
      "to": 18.31,
      "sid": 8,
      "location": 2,
      "content": "如果你单纯只是被一个定位造成的",
      "music": 0.0
    },
    {
      "from": 18.31,
      "to": 19.91,
      "sid": 9,
      "location": 2,
      "content": "击杀的现象给骗了",
      "music": 0.0
    },
    {
      "from": 19.91,
      "to": 20.81,
      "sid": 10,
      "location": 2,
      "content": "那就不对了",
      "music": 0.0
    },
    {
      "from": 20.81,
      "to": 24.875,
      "sid": 11,
      "location": 2,
      "content": "你看到的仅仅是一个高手瞄准很快的结果",
      "music": 0.0
    },
    {
      "from": 24.88,
      "to": 28.46,
      "sid": 12,
      "location": 2,
      "content": "但实际上他们的瞄准是经过了两个瞄准步骤的",
      "music": 0.0
    },
    {
      "from": 28.46,
      "to": 32.83,
      "sid": 13,
      "location": 2,
      "content": "你现在错误的追求一甩就爆头的操作",
      "music": 0.0
    },
    {
      "from": 32.83,
      "to": 34.67,
      "sid": 14,
      "location": 2,
      "content": "缺少了另外一半的操作",
      "music": 0.0
    },
    {
      "from": 34.67,
      "to": 38.11,
      "sid": 15,
      "location": 2,
      "content": "就练不出来和高手相同的结果了",
      "music": 0.0
    },
    {
      "from": 38.11,
      "to": 41.35,
      "sid": 16,
      "location": 2,
      "content": "完整的步骤应该是依次定位",
      "music": 0.0
    },
    {
      "from": 41.35,
      "to": 43.83,
      "sid": 17,
      "location": 2,
      "content": "然后再加微调急刹",
      "music": 0.0
    },
    {
      "from": 43.83,
      "to": 45.77,
      "sid": 18,
      "location": 2,
      "content": "然后就会有同学问了",
      "music": 0.0
    },
    {
      "from": 45.77,
      "to": 47.33,
      "sid": 19,
      "location": 2,
      "content": "为什么一定要有两个步骤",
      "music": 0.0
    },
    {
      "from": 47.33,
      "to": 51.12,
      "sid": 20,
      "location": 2,
      "content": "是因为瞄准的速度和瞄准的准度",
      "music": 0.0
    },
    {
      "from": 51.12,
      "to": 52.92,
      "sid": 21,
      "location": 2,
      "content": "两者是相互矛盾的",
      "music": 0.0
    },
    {
      "from": 52.92,
      "to": 53.62,
      "sid": 22,
      "location": 2,
      "content": "没办法",
      "music": 0.0
    },
    {
      "from": 53.62,
      "to": 57.02,
      "sid": 23,
      "location": 2,
      "content": "既要又要我们要很快的移动准心",
