{
  "bvid": "BV1Mm4y167aq",
  "status": "ok lang=ai-zh",
  "segments": [
    {
      "from": 0.6,
      "to": 1.14,
      "sid": 1,
      "location": 2,
      "content": "哈喽大家好",
      "music": 0.0
    },
    {
      "from": 1.14,
      "to": 2.04,
      "sid": 2,
      "location": 2,
      "content": "我是卡子",
      "music": 0.0
    },
    {
      "from": 2.04,
      "to": 4.5,
      "sid": 3,
      "location": 2,
      "content": "前两天有小伙伴在评论区以及私信问我",
      "music": 0.0
    },
    {
      "from": 4.5,
      "to": 5.96,
      "sid": 4,
      "location": 2,
      "content": "该如何练好微调",
      "music": 0.0
    },
    {
      "from": 5.96,
      "to": 7.22,
      "sid": 5,
      "location": 2,
      "content": "承蒙你们的关注",
      "music": 0.0
    },
    {
      "from": 7.22,
      "to": 9.08,
      "sid": 6,
      "location": 2,
      "content": "我赶出了这期教学视频",
      "music": 0.0
    },
    {
      "from": 9.08,
      "to": 11.72,
      "sid": 7,
      "location": 2,
      "content": "我花了两个月从钻石上到神话二",
      "music": 0.0
    },
    {
      "from": 11.72,
      "to": 13.94,
      "sid": 8,
      "location": 2,
      "content": "我的EW9000是170",
      "music": 0.0
    },
    {
      "from": 13.94,
      "to": 16.66,
      "sid": 9,
      "location": 2,
      "content": "而RM cw3是2990",
      "music": 0.0
    },
    {
      "from": 16.66,
      "to": 18.22,
      "sid": 10,
      "location": 2,
      "content": "作为两个热门项目的前排",
      "music": 0.0
    },
    {
      "from": 18.22,
      "to": 20.47,
      "sid": 11,
      "location": 2,
      "content": "我认为我对微调还是有一定理解的",
      "music": 0.0
    },
    {
      "from": 20.47,
      "to": 22.81,
      "sid": 12,
      "location": 2,
      "content": "如果你能理解并学习到我所讲的内容",
      "music": 0.0
    },
    {
      "from": 22.81,
      "to": 25.1,
      "sid": 13,
      "location": 2,
      "content": "微调与瞄准一定会有所提升",
      "music": 0.0
    },
    {
      "from": 25.1,
      "to": 26.78,
      "sid": 14,
      "location": 2,
      "content": "这期视频全是干货",
      "music": 0.0
    },
    {
      "from": 26.78,
      "to": 28.58,
      "sid": 15,
      "location": 2,
      "content": "但讲的不止限于瞄准",
      "music": 0.0
    },
    {
      "from": 28.58,
      "to": 30.2,
      "sid": 16,
      "location": 2,
      "content": "结尾部分有提到实战",
      "music": 0.0
    },
    {
      "from": 30.2,
      "to": 31.64,
      "sid": 17,
      "location": 2,
      "content": "感谢一键三连",
      "music": 0.0
    },
    {
      "from": 31.64,
      "to": 32.24,
      "sid": 18,
      "location": 2,
      "content": "好了",
      "music": 0.0
    },
    {
      "from": 32.24,
      "to": 32.9,
      "sid": 19,
      "location": 2,
      "content": "废话不多说",
      "music": 0.0
    },
    {
      "from": 32.9,
      "to": 34.0,
      "sid": 20,
      "location": 2,
      "content": "开始详解",
      "music": 0.0
    },
    {
      "from": 34.0,
      "to": 35.56,
      "sid": 21,
      "location": 2,
      "content": "下面要讲的都是我实践过的",
      "music": 0.0
    },
    {
      "from": 35.56,
      "to": 37.24,
      "sid": 22,
      "location": 2,
      "content": "瞄准理论与底层逻辑",
      "music": 0.0
    },
    {
      "from": 37.24,
      "to": 38.54,
      "sid": 23,
      "location": 2,
      "content": "可放心食用",
      "music": 0.0
    },
    {
      "from": 38.54,
      "to": 40.19,
      "sid": 24,
      "location": 2,
      "content": "瞄准有两种情况",
      "music": 0.0
    },
    {
      "from": 40.19,
      "to": 43.64,
      "sid": 25,
      "location": 2,
      "content": "一种是目标位置在聚焦范围内需要微调",
      "music": 0.0
    },
    {
      "from": 43.64,
      "to": 45.74,
      "sid": 26,
      "location": 2,
      "content": "另一种是目标位置在余光范围内",
      "music": 0.0
    },
    {
      "from": 45.74,
      "to": 47.16,
      "sid": 27,
      "location": 2,
      "content": "需要拉枪架微调",
      "music": 0.0
    },
    {
      "from": 47.16,
      "to": 49.98,
      "sid": 28,
      "location": 2,
      "content": "先着重讲讲聚焦范围内的微调",
      "music": 0.0
    },
    {
      "from": 49.98,
      "to": 50.7,
      "sid": 29,
      "location": 2,
      "content": "关于微调",
      "music": 0.0
    },
    {
      "from": 50.7,
      "to": 53.22,
      "sid": 30,
      "location": 2,
      "content": "我要讲的第一点是眼睛比手先到",
      "music": 0.0
    },
    {
      "from": 53.22,
      "to": 56.94,
      "sid": 31,
      "location": 2,
      "content": "也是老生常谈中手眼协调中的一项意思",
      "music": 0.0
    },
    {
      "from": 56.94,
      "to": 58.68,
      "sid": 32,
      "location": 2,
      "content": "就是在瞄准特别是微调时",
      "music": 0.0
    },
    {
      "from": 58.68,
      "to": 61.17,
      "sid": 33,
      "location": 2,
      "content": "你的眼睛要尽力全程聚焦目标",
      "music": 0.0
    },
    {
      "from": 61.17,
      "to": 64.61,
      "sid": 34,
      "location": 2,
      "content": "并且你的目光要比准星先到目标上",
      "music": 0.0
    },
    {
      "from": 64.61,
      "to": 66.1,
      "sid": 35,
      "location": 2,
      "content": "这是瞄准的精髓之一",
      "music": 0.0
    },
    {
      "from": 66.1,
      "to": 66.76,
      "sid": 36,
      "location": 2,
      "content": "一定要牢记",
      "music": 0.0
    },
    {
      "from": 66.76,
      "to": 68.38,
      "sid": 37,
      "location": 2,
      "content": "如果你瞄准中特别是微调时",
      "music": 0.0
    },
    {
      "from": 68.38,
      "to": 70.18,
      "sid": 38,
      "location": 2,
      "content": "没有做好准确阅读目标位置",
      "music": 0.0
    },
    {
      "from": 70.18,
      "to": 72.06,
      "sid": 39,
      "location": 2,
      "content": "就盲目地移动鼠标",
      "music": 0.0
    },
    {
      "from": 72.06,
      "to": 74.88,
      "sid": 40,
      "location": 2,
      "content": "就会出现要么准星超出目标位置很远",
      "music": 0.0
    },
    {
      "from": 74.88,
      "to": 77.13,
      "sid": 41,
      "location": 2,
      "content": "要么离目标位置很远的情况",
      "music": 0.0
    },
    {
      "from": 77.13,
      "to": 79.98,
      "sid": 42,
      "location": 2,
      "content": "你要做的就是当目标在聚焦范围内时",
      "music": 0.0
    },
    {
      "from": 79.98,
      "to": 82.14,
      "sid": 43,
      "location": 2,
      "content": "尽你最快的速度聚焦住目标",
      "music": 0.0
    },
    {
      "from": 82.14,
      "to": 84.16,
      "sid": 44,
      "location": 2,
      "content": "使用余光观察准星",
      "music": 0.0
    },
    {
      "from": 84.16,
      "to": 85.54,
      "sid": 45,
      "location": 2,
      "content": "在移动准星的过程中",
      "music": 0.0
    },
    {
      "from": 85.54,
      "to": 87.34,
      "sid": 46,
      "location": 2,
      "content": "用余光感受准星的速度",
      "music": 0.0
    },
    {
      "from": 87.34,
      "to": 90.16,
      "sid": 47,
      "location": 2,
      "content": "控制好发力时准心不要超过目标",
      "music": 0.0
    },
    {
      "from": 90.16,
      "to": 93.26,
      "sid": 48,
      "location": 2,
      "content": "从而在准星与目标重合的一瞬间开枪",
      "music": 0.0
    },
    {
      "from": 93.26,
      "to": 94.76,
      "sid": 49,
      "location": 2,
      "content": "按下左键的那一刻",
      "music": 0.0
    },
    {
      "from": 94.76,
      "to": 97.13,
      "sid": 50,
      "location": 2,
      "content": "在聚焦下一个微调范围内的目标",
      "music": 0.0
    },
    {
      "from": 97.13,
      "to": 98.66,
      "sid": 51,
      "location": 2,
      "content": "以此往复而移动",
      "music": 0.0
    },
    {
      "from": 98.66,
      "to": 100.94,
      "sid": 52,
      "location": 2,
      "content": "准星的速度与你的熟练度成正比",
      "music": 0.0
    },
    {
      "from": 100.94,
      "to": 104.06,
      "sid": 53,
      "location": 2,
      "content": "通过认真阅读目标位置与合理控制发力",
      "music": 0.0
    },
    {
      "from": 104.06,
      "to": 107.33,
      "sid": 54,
      "location": 2,
      "content": "慢慢练习就可以提升微调式的速度与准确度",
      "music": 0.0
    },
    {
      "from": 107.33,
      "to": 109.28,
      "sid": 55,
      "location": 2,
      "content": "记住不要甩甩",
      "music": 0.0
    },
    {
      "from": 109.28,
      "to": 112.1,
      "sid": 56,
      "location": 2,
      "content": "是观察不到准心与目标的相对位置的",
      "music": 0.0
    },
    {
      "from": 112.1,
      "to": 115.1,
      "sid": 57,
      "location": 2,
      "content": "而关于抓到准星与目标重合的一瞬间去开枪",
      "music": 0.0
    },
    {
      "from": 115.1,
      "to": 118.22,
      "sid": 58,
      "location": 2,
      "content": "大家如果看这格顶分局练枪大佬",
      "music": 0.0
    },
    {
      "from": 118.22,
      "to": 119.12,
      "sid": 59,
      "location": 2,
      "content": "他们的第一视角",
      "music": 0.0
    },
    {
      "from": 119.12,
      "to": 122.06,
      "sid": 60,
      "location": 2,
      "content": "就会发现他们的确认时间是非常短的",
      "music": 0.0
    },
    {
      "from": 122.06,
      "to": 123.68,
      "sid": 61,
      "location": 2,
      "content": "几乎没有确认时间",
      "music": 0.0
    },
    {
      "from": 123.68,
      "to": 125.06,
      "sid": 62,
      "location": 2,
      "content": "所以我们想变强",
      "music": 0.0
    },
    {
      "from": 125.06,
      "to": 127.56,
      "sid": 63,
      "location": 2,
      "content": "也需要训练来减少我们的确认时间",
      "music": 0.0
    },
    {
      "from": 127.56,
      "to": 129.93,
      "sid": 64,
      "location": 2,
      "content": "要做的就是用心聚焦好目标",
      "music": 0.0
    },
    {
      "from": 129.93,
      "to": 132.45,
      "sid": 65,
      "location": 2,
      "content": "用余光感受准星的速度与距离",
      "music": 0.0
    },
    {
      "from": 132.45,
      "to": 134.0,
      "sid": 66,
      "location": 2,
      "content": "就像是写字一样",
      "music": 0.0
    },
    {
      "from": 134.0,
      "to": 135.86,
      "sid": 67,
      "location": 2,
      "content": "鼠标滑到了目标身上",
      "music": 0.0
    },
    {
      "from": 135.86,
      "to": 138.0,
      "sid": 68,
      "location": 2,
      "content": "而不是甩到目标身上",
      "music": 0.0
    },
    {
      "from": 138.0,
      "to": 140.55,
      "sid": 69,
      "location": 2,
      "content": "在刚刚好重合的那一刻开枪",
      "music": 0.0
    },
    {
      "from": 140.55,
      "to": 141.96,
      "sid": 70,
      "location": 2,
      "content": "尽量不要划过头",
      "music": 0.0
    },
    {
      "from": 143.28,
      "to": 144.96,
      "sid": 71,
      "location": 2,
      "content": "就算重合型的移动速度很慢",
      "music": 0.0
    },
    {
      "from": 144.96,
      "to": 146.06,
      "sid": 72,
      "location": 2,
      "content": "也没有关系",
      "music": 0.0
    },
    {
      "from": 146.06,
      "to": 147.68,
      "sid": 73,
      "location": 2,
      "content": "随着熟练度的提升",
      "music": 0.0
    },
    {
      "from": 147.68,
      "to": 148.79,
      "sid": 74,
      "location": 2,
      "content": "速度也会提升",
      "music": 0.0
    },
    {
      "from": 148.79,
      "to": 150.77,
      "sid": 75,
      "location": 2,
      "content": "但要记住前提是重合",
      "music": 0.0
    },
    {
      "from": 150.77,
      "to": 152.12,
      "sid": 76,
      "location": 2,
      "content": "不要移动鼠标后",
      "music": 0.0
    },
    {
      "from": 152.12,
      "to": 153.56,
      "sid": 77,
      "location": 2,
      "content": "就想当然的开枪",
      "music": 0.0
    },
    {
      "from": 153.56,
      "to": 155.96,
      "sid": 78,
      "location": 2,
      "content": "多去找重合那一刹那的感觉",
      "music": 0.0
    },
    {
      "from": 155.96,
      "to": 158.44,
      "sid": 79,
      "location": 2,
      "content": "多去用余光感受准星的速度",
      "music": 0.0
    },
    {
      "from": 158.44,
      "to": 161.0,
      "sid": 80,
      "location": 2,
      "content": "让大脑习惯这个过程",
      "music": 0.0
    },
    {
      "from": 161.0,
      "to": 164.0,
      "sid": 81,
      "location": 2,
      "content": "这个过程与感觉也会随着熟练度的提升",
      "music": 0.0
    },
    {
      "from": 164.0,
      "to": 164.9,
      "sid": 82,
      "location": 2,
      "content": "潜移默化的存在",
      "music": 0.0
    },
    {
      "from": 164.9,
      "to": 166.49,
      "sid": 83,
      "location": 2,
      "content": "在我们的下意识的反应里",
      "music": 0.0
    },
    {
      "from": 166.49,
      "to": 167.24,
      "sid": 84,
      "location": 2,
      "content": "有时候",
      "music": 0.0
    },
    {
      "from": 167.24,
      "to": 167.9,
      "sid": 85,
      "location": 2,
      "content": "下意识的反应",
      "music": 0.0
    },
    {
      "from": 167.9,
      "to": 172.02,
      "sid": 86,
      "location": 2,
      "content": "往往比有意识的反应来得更迅速与准确",
      "music": 0.0
    },
    {
      "from": 172.02,
      "to": 174.39,
      "sid": 87,
      "location": 2,
      "content": "而当目标出现在余光范围里",
      "music": 0.0
    },
    {
      "from": 174.39,
      "to": 177.54,
      "sid": 88,
      "location": 2,
      "content": "也就是说准星与目标的距离较远时",
      "music": 0.0
    },
    {
      "from": 177.54,
      "to": 180.82,
      "sid": 89,
      "location": 2,
      "content": "要用余光尽量获取目标的大概位置",
      "music": 0.0
    },
    {
      "from": 180.82,
      "to": 182.77,
      "sid": 90,
      "location": 2,
      "content": "然后用力移动准星",
      "music": 0.0
    },
    {
      "from": 182.77,
      "to": 185.02,
      "sid": 91,
      "location": 2,
      "content": "随着准星与目标的接近",
      "music": 0.0
    },
    {
      "from": 185.02,
      "to": 187.42,
      "sid": 92,
      "location": 2,
      "content": "在移动的过程中尽量聚焦目标",
      "music": 0.0
    },
    {
      "from": 187.42,
      "to": 189.4,
      "sid": 93,
      "location": 2,
      "content": "然后重复微调时的步骤",
      "music": 0.0
    },
    {
      "from": 189.4,
      "to": 190.57,
      "sid": 94,
      "location": 2,
      "content": "要注意的是",
      "music": 0.0
    },
    {
      "from": 190.57,
      "to": 192.22,
      "sid": 95,
      "location": 2,
      "content": "可以在快接近时减速",
      "music": 0.0
    },
    {
      "from": 192.22,
      "to": 193.39,
      "sid": 96,
      "location": 2,
      "content": "但不要移过头",
      "music": 0.0
    },
    {
      "from": 193.39,
      "to": 195.2,
      "sid": 97,
      "location": 2,
      "content": "我说的用力指的不是甩",
      "music": 0.0
    },
    {
      "from": 195.2,
      "to": 196.94,
      "sid": 98,
      "location": 2,
      "content": "而是提高拉枪速度",
      "music": 0.0
    },
    {
      "from": 196.94,
      "to": 199.72,
      "sid": 99,
      "location": 2,
      "content": "使目标快速进入我们的微调范围内",
      "music": 0.0
    },
    {
      "from": 199.72,
      "to": 201.7,
      "sid": 100,
      "location": 2,
      "content": "然后用微调的方式开枪",
      "music": 0.0
    },
    {
      "from": 201.7,
      "to": 204.01,
      "sid": 101,
      "location": 2,
      "content": "最好把整个过程都衔接起来",
      "music": 0.0
    },
    {
      "from": 204.01,
      "to": 207.2,
      "sid": 102,
      "location": 2,
      "content": "熟练度的提高会使衔接的过程看起来更加丝滑",
      "music": 0.0
    },
    {
      "from": 207.2,
      "to": 208.04,
      "sid": 103,
      "location": 2,
      "content": "扩展一下",
      "music": 0.0
    },
    {
      "from": 208.04,
      "to": 210.02,
      "sid": 104,
      "location": 2,
      "content": "我相信热爱FPS的小伙伴",
      "music": 0.0
    },
    {
      "from": 210.02,
      "to": 211.46,
      "sid": 105,
      "location": 2,
      "content": "都一定经历过自己的握法",
      "music": 0.0
    },
    {
      "from": 211.46,
      "to": 212.66,
      "sid": 106,
      "location": 2,
      "content": "我直接给出结论",
      "music": 0.0
    },
    {
      "from": 212.66,
      "to": 213.14,
      "sid": 107,
      "location": 2,
      "content": "放弃他",
      "music": 0.0
    },
    {
      "from": 213.14,
      "to": 215.35,
      "sid": 108,
      "location": 2,
      "content": "我我不否认有使用power的高手",
      "music": 0.0
    },
    {
      "from": 215.35,
      "to": 216.76,
      "sid": 109,
