{
  "bvid": "BV1wG4y127mW",
  "status": "ok lang=ai-zh",
  "segments": [
    {
      "from": 0.04,
      "to": 2.029,
      "sid": 1,
      "location": 2,
      "content": "AIM是游戏中最受欢迎的机械师"
    },
    {
      "from": 2.029,
      "to": 6.75,
      "sid": 2,
      "location": 2,
      "content": "近年来，在理解其变量和发展方面取得了重大进展"
    },
    {
      "from": 6.75,
      "to": 10.55,
      "sid": 3,
      "location": 2,
      "content": "而瞄准机制可以分解成几个术语"
    },
    {
      "from": 10.55,
      "to": 15.15,
      "sid": 4,
      "location": 2,
      "content": "今天我们将深入研究动态点击"
    },
    {
      "from": 15.859,
      "to": 17.899,
      "sid": 5,
      "location": 2,
      "content": "这是命名井不可或缺的一部分"
    },
    {
      "from": 17.899,
      "to": 19.659,
      "sid": 6,
      "location": 2,
      "content": "但不要只是从我这里拿走"
    },
    {
      "from": 19.659,
      "to": 22.34,
      "sid": 7,
      "location": 2,
      "content": "今天的视频由Voltaic为您呈现"
    },
    {
      "from": 23.44,
      "to": 24.8,
      "sid": 8,
      "location": 2,
      "content": "我只想慢慢来不"
    },
    {
      "from": 24.8,
      "to": 29.56,
      "sid": 9,
      "location": 2,
      "content": "我只想让你们把这个由七万五千名成员组成的不和团体"
    },
    {
      "from": 29.56,
      "to": 32.94,
      "sid": 10,
      "location": 2,
      "content": "并继续增长，每周游客超过5000人"
    },
    {
      "from": 32.94,
      "to": 37.2,
      "sid": 11,
      "location": 2,
      "content": "这份指南来自伏打团队中久经考验的球员的经验和想法"
    },
    {
      "from": 37.2,
      "to": 39.46,
      "sid": 12,
      "location": 2,
      "content": "所以一定要坚持到视频结束"
    },
    {
      "from": 39.46,
      "to": 41.92,
      "sid": 13,
      "location": 2,
      "content": "从这些经验丰富的游戏玩家那里获得充分的洞察力"
    },
    {
      "from": 41.92,
      "to": 43.48,
      "sid": 14,
      "location": 2,
      "content": "让我们进入正题"
    },
    {
      "from": 43.78,
      "to": 47.4,
      "sid": 15,
      "location": 2,
      "content": "移动对手是所有竞技冠军中的三分"
    },
    {
      "from": 47.4,
      "to": 48.98,
      "sid": 16,
      "location": 2,
      "content": "取决于你玩什么"
    },
    {
      "from": 48.98,
      "to": 52.48,
      "sid": 17,
      "location": 2,
      "content": "处理这些情况会感到极其困难"
    },
    {
      "from": 52.48,
      "to": 57.58,
      "sid": 18,
      "location": 2,
      "content": "这在你的武器需要进入重置期的情况下尤其如此"
    },
    {
      "from": 57.58,
      "to": 60.4,
      "sid": 19,
      "location": 2,
      "content": "在开火后立即"
    },
    {
      "from": 60.4,
      "to": 64.379,
      "sid": 20,
      "location": 2,
      "content": "像这样意味着击中任何目标的误差幅度都很高"
    },
    {
      "from": 64.379,
      "to": 66.74,
      "sid": 21,
      "location": 2,
      "content": "对于一个移动的目标来说更是如此"
    },
    {
      "from": 66.74,
      "to": 67.4,
      "sid": 22,
      "location": 2,
      "content": "处理"
    },
    {
      "from": 67.4,
      "to": 67.72,
      "sid": 23,
      "location": 2,
      "content": "点击"
    },
    {
      "from": 67.72,
      "to": 68.7,
      "sid": 24,
      "location": 2,
      "content": "消除目标"
    },
    {
      "from": 68.7,
      "to": 74.48,
      "sid": 25,
      "location": 2,
      "content": "这是一套与大多数人熟悉的典型运动跟踪相对独立的技能"
    },
    {
      "from": 74.48,
      "to": 77.36,
      "sid": 26,
      "location": 2,
      "content": "因此，它需要有意地实践"
    },
    {
      "from": 77.36,
      "to": 81.7,
      "sid": 27,
      "location": 2,
      "content": "这就是创造像弧线射击这样的目标变化场景背后的原因"
    },
    {
      "from": 81.7,
      "to": 82.46,
      "sid": 28,
      "location": 2,
      "content": "角度射击"
    },
    {
      "from": 82.46,
      "to": 86.0,
      "sid": 29,
      "location": 2,
      "content": "和半其他我们归类为动态点击的"
    },
    {
      "from": 86.4,
      "to": 89.64,
      "sid": 30,
      "location": 2,
      "content": "动态点击是伏打基准子类别"
    },
    {
      "from": 89.64,
      "to": 95.1,
      "sid": 31,
      "location": 2,
      "content": "包含具有几个移动目标的任何场景，这些目标通过一组点击量被消除"
    },
    {
      "from": 95.1,
      "to": 98.66,
      "sid": 32,
      "location": 2,
      "content": "动态这个词是目标运动的描述符"
    },
    {
      "from": 98.66,
      "to": 101.94,
      "sid": 33,
      "location": 2,
      "content": "这通常具有不同程度的可预测性"
    },
    {
      "from": 101.94,
      "to": 106.18,
      "sid": 34,
      "location": 2,
      "content": "像浮头这样的场景会有目标带着明显的意图移动"
    },
    {
      "from": 106.18,
      "to": 107.5,
      "sid": 35,
      "location": 2,
      "content": "而像角度拍摄这样的东西"
    },
    {
      "from": 107.5,
      "to": 111.35,
      "sid": 36,
      "location": 2,
      "content": "会有瓷砖随着稍微难以察觉的运动而移动"
    },
    {
      "from": 111.35,
      "to": 117.07,
      "sid": 37,
      "location": 2,
      "content": "目标运动行为的这种差异将随后影响你如何消除它们"
    },
    {
      "from": 117.07,
      "to": 118.01,
      "sid": 38,
      "location": 2,
      "content": "幸运的是"
    },
    {
      "from": 118.01,
      "to": 120.29,
      "sid": 39,
      "location": 2,
      "content": "对于目标移动的所有可能方式"
    },
    {
      "from": 120.29,
      "to": 124.1,
      "sid": 40,
      "location": 2,
      "content": "消除它们的方法可以归结为两种方法"
    },
    {
      "from": 124.32,
      "to": 129.039,
      "sid": 41,
      "location": 2,
      "content": "这些方法应用于每个目标，甚至可以在相同的场景中互换使用"
    },
    {
      "from": 129.039,
      "to": 130.4,
      "sid": 42,
      "location": 2,
      "content": "由你酌情决定"
    },
    {
      "from": 130.5,
      "to": 134.399,
      "sid": 43,
      "location": 2,
      "content": "第一种方法是在单击之前执行命中确认"
    },
    {
      "from": 134.399,
      "to": 138.019,
      "sid": 44,
      "location": 2,
      "content": "这是当你在短时间内跟踪一个零星移动的目标时"
    },
    {
      "from": 138.019,
      "to": 142.26,
      "sid": 45,
      "location": 2,
      "content": "为了直观地确定你的淘汰尝试会有多成功"
    },
    {
      "from": 142.48,
      "to": 147.3,
      "sid": 46,
      "location": 2,
      "content": "这项技术适用于具有可预测运动模式的较大目标和较小目标"
    },
    {
      "from": 147.42,
      "to": 149.28,
      "sid": 47,
      "location": 2,
      "content": "随着你对命中的精通"
    },
    {
      "from": 149.28,
      "to": 151.6,
      "sid": 48,
      "location": 2,
      "content": "确认跟踪目标所需的时间"
    },
    {
      "from": 151.6,
      "to": 153.96,
      "sid": 49,
      "location": 2,
      "content": "在发射之前会不断减少"
    },
    {
      "from": 156.019,
      "to": 157.979,
      "sid": 50,
      "location": 2,
      "content": "你以为我在玩"
    },
    {
      "from": 157.979,
      "to": 160.019,
      "sid": 51,
      "location": 2,
      "content": "你们真的亲了我的脸"
    },
    {
      "from": 160.019,
      "to": 161.959,
      "sid": 52,
      "location": 2,
      "content": "为我的血祈祷"
    },
    {
      "from": 161.959,
      "to": 163.98,
      "sid": 53,
      "location": 2,
      "content": "我得回基地"
    },
    {
      "from": 164.06,
      "to": 165.96,
      "sid": 54,
      "location": 2,
      "content": "如果我的才华被浪费了呢"
    },
    {
      "from": 165.96,
      "to": 167.58,
      "sid": 55,
      "location": 2,
      "content": "你看到我的脸了吗"
    },
    {
      "from": 168.58,
      "to": 170.76,
      "sid": 56,
      "location": 2,
      "content": "作为地下室的包裹"
    },
    {
      "from": 170.76,
      "to": 171.92,
      "sid": 57,
      "location": 2,
      "content": "这个亮度"
    },
    {
      "from": 171.92,
      "to": 172.8,
      "sid": 58,
      "location": 2,
      "content": "我现在不在乎了"
    },
    {
      "from": 172.8,
      "to": 173.82,
      "sid": 59,
      "location": 2,
      "content": "踏板踩在金属上"
    },
    {
      "from": 173.82,
      "to": 174.88,
      "sid": 60,
      "location": 2,
      "content": "我现在永远不能退出"
    },
    {
      "from": 174.88,
      "to": 176.54,
      "sid": 61,
      "location": 2,
      "content": "我决不会让木偶参加比赛。"
    },
    {
      "from": 176.54,
      "to": 177.66,
      "sid": 62,
      "location": 2,
      "content": "我像花瓣一样牵线"
    },
    {
      "from": 177.66,
      "to": 178.62,
      "sid": 63,
      "location": 2,
      "content": "我们是在同一个游戏中吗"
    },
    {
      "from": 178.62,
      "to": 179.66,
      "sid": 64,
      "location": 2,
      "content": "但我在一个不同的水平上"
    },
    {
      "from": 179.66,
      "to": 180.28,
      "sid": 65,
      "location": 2,
      "content": "我通过了"
    },
    {
      "from": 180.28,
      "to": 182.26,
      "sid": 66,
      "location": 2,
      "content": "你得不停地磨，直到我躺在石膏里"
    },
    {
      "from": 182.26,
      "to": 183.12,
      "sid": 67,
      "location": 2,
      "content": "没有假棕色"
    },
    {
      "from": 183.12,
      "to": 184.36,
      "sid": 68,
      "location": 2,
      "content": "当你觉得太可塑性的时候"
    },
    {
      "from": 184.36,
      "to": 184.64,
      "sid": 69,
      "location": 2,
      "content": "是啊，是啊"
    },
    {
      "from": 184.64,
      "to": 186.04,
      "sid": 70,
      "location": 2,
      "content": "你们都觉得太格子了"
    },
    {
      "from": 186.04,
      "to": 186.68,
      "sid": 71,
      "location": 2,
      "content": "我的风格疯狂"
    },
    {
      "from": 186.68,
      "to": 187.98,
      "sid": 72,
      "location": 2,
      "content": "但它是直夹克"
    },
    {
      "from": 189.979,
      "to": 191.919,
      "sid": 73,
      "location": 2,
      "content": "第二种方法是目标引导"
    },
    {
      "from": 191.919,
      "to": 193.939,
      "sid": 74,
      "location": 2,
      "content": "把你的交叉放在你预期的地方"
    },
    {
      "from": 193.939,
      "to": 195.56,
      "sid": 75,
      "location": 2,
      "content": "与目标接触"
    },
    {
      "from": 195.56,
      "to": 199.42,
      "sid": 76,
      "location": 2,
      "content": "在基本层面上执行这个意味着在你做出有根据的猜测后"
    },
    {
      "from": 199.42,
      "to": 203.3,
      "sid": 77,
      "location": 2,
      "content": "你通过向空间中的一个固定点轻弹来作用它"
    },
    {
      "from": 203.3,
      "to": 206.44,
      "sid": 78,
      "location": 2,
      "content": "到达这个接触点之间的时间越短"
    },
    {
      "from": 206.44,
      "to": 208.26,
      "sid": 79,
      "location": 2,
      "content": "目标与十字准星相遇"
    },
    {
      "from": 208.26,
      "to": 210.56,
      "sid": 80,
      "location": 2,
      "content": "目标领导执行力越好"
    },
    {
      "from": 210.56,
      "to": 214.82,
      "sid": 81,
      "location": 2,
      "content": "另一个稍微复杂的执行方式是让你的接触点"
    },
    {
      "from": 214.82,
      "to": 217.28,
      "sid": 82,
      "location": 2,
      "content": "沿着目标遍历的轴"
    },
    {
      "from": 217.359,
      "to": 220.199,
      "sid": 83,
      "location": 2,
      "content": "深入解释这一概念的实施"
    },
    {
      "from": 220.199,
      "to": 222.82,
      "sid": 84,
      "location": 2,
      "content": "我们可以用场景爆米花作为例子"
    },
    {
      "from": 222.82,
      "to": 226.64,
      "sid": 85,
      "location": 2,
      "content": "因为在这个场景中目标的移动将使这项技术非常有用"
    },
    {
      "from": 226.64,
      "to": 230.18,
      "sid": 86,
      "location": 2,
      "content": "一个爆米花目标非常小，以很大的飞跃传播"
    },
    {
      "from": 230.18,
      "to": 234.24,
      "sid": 87,
      "location": 2,
      "content": "在宏观层面上相对容易理解和预测"
    },
    {
      "from": 234.24,
      "to": 234.9,
      "sid": 88,
      "location": 2,
      "content": "然而"
    },
    {
      "from": 234.9,
      "to": 237.18,
      "sid": 89,
      "location": 2,
      "content": "当目标沿着这个一般路径时"
    },
    {
      "from": 237.18,
      "to": 240.78,
      "sid": 90,
      "location": 2,
      "content": "速度变化和目标开始下降的不同时间"
    },
    {
      "from": 240.78,
      "to": 244.36,
      "sid": 91,
      "location": 2,
      "content": "考虑到这一点，使预测的微观变得不那么清楚"
    },
    {
      "from": 244.36,
      "to": 246.76,
      "sid": 92,
      "location": 2,
      "content": "我们考虑目标运动的轴"
    },
    {
      "from": 246.76,
      "to": 250.23,
      "sid": 93,
      "location": 2,
      "content": "为了简单起见，忽略Z轴提供的深度"
    },
    {
      "from": 250.23,
      "to": 252.87,
      "sid": 94,
      "location": 2,
      "content": "目标沿y轴的垂直运动"
    },
    {
      "from": 252.87,
      "to": 256.209,
      "sid": 95,
      "location": 2,
      "content": "是最容易预测的，因为它显然在推进"
    },
    {
      "from": 256.209,
      "to": 259.06,
      "sid": 96,
      "location": 2,
      "content": "短暂地到达顶点，然后下降"
    },
    {
      "from": 259.24,
      "to": 263.14,
      "sid": 97,
      "location": 2,
      "content": "如果我们通过在它前面抵消来使它的水平运动不那么重要"
    },
    {
      "from": 263.14,
      "to": 265.34,
      "sid": 98,
      "location": 2,
      "content": "当它变慢时，我们就能专注于目标"
    },
    {
      "from": 265.34,
      "to": 268.3,
      "sid": 99,
      "location": 2,
      "content": "当它离开顶点时，它是最可预测的"
    },
    {
      "from": 268.88,
      "to": 270.16,
      "sid": 100,
      "location": 2,
      "content": "所以在领导这个目标的时候"
    },
    {
      "from": 270.16,
      "to": 272.78,
      "sid": 101,
      "location": 2,
      "content": "我们将试图通过定位我们的交叉器来跟踪它的下降"
    },
    {
      "from": 272.78,
      "to": 276.14,
      "sid": 102,
      "location": 2,
      "content": "在它下面的y轴上，在它前面的x轴上"
    },
    {
      "from": 276.24,
      "to": 278.26,
      "sid": 103,
      "location": 2,
      "content": "当目标继续跳跃时"
    },
    {
      "from": 278.26,
      "to": 280.72,
      "sid": 104,
      "location": 2,
      "content": "我们将观察通过x轴的水平运动"
    },
    {
      "from": 280.72,
      "to": 284.12,
      "sid": 105,
      "location": 2,
      "content": "以保持我们最终创建的初始偏移量"
    },
    {
      "from": 284.12,
      "to": 285.44,
      "sid": 106,
      "location": 2,
      "content": "当我们继续这样做的时候"
    },
    {
      "from": 285.44,
      "to": 289.07,
      "sid": 107,
      "location": 2,
      "content": "当目标开始下降到地面时，它将拦截我们的十字准星"
    },
    {
      "from": 289.07,
      "to": 289.83,
      "sid": 108,
      "location": 2,
      "content": "知道什么时候该打"
    },
    {
      "from": 289.83,
      "to": 290.07,
      "sid": 109,
      "location": 2,
      "content": "确认"
    },
    {
      "from": 290.07,
      "to": 293.41,
      "sid": 110,
      "location": 2,
      "content": "或目标盖子是正确执行动态单击场景的基础"
    },
    {
      "from": 293.41,
      "to": 295.98,
      "sid": 111,
      "location": 2,
      "content": "，并会按个别情况实施"
    },
    {
      "from": 295.98,
      "to": 297.42,
      "sid": 112,
      "location": 2,
      "content": "这些技术的有效性"
    },
    {
      "from": 297.42,
      "to": 302.58,
      "sid": 113,
      "location": 2,
      "content": "翻译游戏需要根据你所面临的情况的接触来智能实现"
    },
    {
      "from": 302.86,
      "to": 306.14,
      "sid": 114,
      "location": 2,
      "content": "如果你想让牡丹花直接进入你的视野"
    },
    {
      "from": 306.14,
      "to": 309.56,
      "sid": 115,
      "location": 2,
      "content": "当你使用目标引导进行预测和移动时，你会想要放置你的十字准星"
    },
    {
      "from": 309.56,
      "to": 311.74,
      "sid": 116,
      "location": 2,
      "content": "在这种情况下，简化了您需要采取的操作"
    },
    {
      "from": 311.74,
      "to": 313.34,
      "sid": 117,
      "location": 2,
      "content": "以及你需要做出反应的刺激"
    },
    {
      "from": 313.34,
      "to": 315.89,
      "sid": 118,
      "location": 2,
      "content": "就像涉及这些方法的任何正确选择一样"
    },
    {
      "from": 315.89,
      "to": 316.93,
      "sid": 119,
      "location": 2,
      "content": "命中确认"
    },
    {
      "from": 316.93,
      "to": 317.89,
      "sid": 120,
      "location": 2,
      "content": "另一方面"
    },
    {
      "from": 317.89,
      "to": 318.81,
      "sid": 121,
      "location": 2,
      "content": "显示它们的有用性"
    },
    {
      "from": 318.81,
      "to": 322.37,
      "sid": 122,
      "location": 2,
      "content": "在需要向老虎发射多发子弹的情况下"
    },
    {
      "from": 322.37,
      "to": 323.76,
      "sid": 123,
      "location": 2,
      "content": "为了消除它"
    },
    {
      "from": 323.76,
      "to": 325.96,
      "sid": 124,
      "location": 2,
      "content": "对手的不可预测性"
    },
    {
      "from": 325.96,
      "to": 327.06,
      "sid": 125,
      "location": 2,
      "content": "在这种情况下"
    },
    {
      "from": 330.58,
      "to": 334.42,
      "sid": 126,
      "location": 2,
      "content": "同样值得理解的是，这些方法都依赖于阅读目标运动"
    },
    {
      "from": 334.42,
      "to": 338.44,
      "sid": 127,
      "location": 2,
      "content": "这是瞄准的一个方面，可能会受到你的老虎开关的严重影响"
    },
    {
      "from": 338.44,
      "to": 341.92,
      "sid": 128,
      "location": 2,
      "content": "平滑的开关将帮助您快速确定老虎是如何移动的"
    },
    {
      "from": 341.92,
      "to": 343.38,
      "sid": 129,
      "location": 2,
      "content": "关于你的十字架"
    },
    {
      "from": 343.38,
      "to": 346.46,
      "sid": 130,
      "location": 2,
      "content": "尤其是当背景上的视觉线索很少的时候"
    },
    {
      "from": 346.46,
      "to": 347.46,
      "sid": 131,
      "location": 2,
      "content": "你的目标在一点"
    },
    {
      "from": 347.46,
      "to": 351.84,
      "sid": 132,
      "location": 2,
      "content": "方向和速度的细微变化会使更剧烈的动作更难阅读"
    },
    {
      "from": 351.84,
      "to": 356.7,
      "sid": 133,
      "location": 2,
      "content": "那么它们最初可能会在脸上做出平滑的开关对克服这种情况很有价值"
    }
  ]
}