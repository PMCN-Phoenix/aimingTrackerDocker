    },
    {
      "from": 22.3,
      "to": 23.72,
      "sid": 9,
      "location": 2,
      "content": "首先问大家一个问题",
      "music": 0.0
    },
    {
      "from": 23.72,
      "to": 27.38,
      "sid": 10,
      "location": 2,
      "content": "瞄准时我们的眼睛到底是应该看准星还是看人",
