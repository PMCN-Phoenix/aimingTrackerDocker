    },
    {
      "from": 44.14,
      "to": 46.22,
      "sid": 19,
      "location": 2,
      "content": "但只要敌人一秒出现在你的视野里",
      "music": 0.0
    },
    {
      "from": 46.22,
      "to": 48.38,
      "sid": 20,
      "location": 2,
      "content": "就要立刻把重心切回到人上",
