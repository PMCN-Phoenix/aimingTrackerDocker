    },
    {
      "from": 27.38,
      "to": 28.5,
      "sid": 11,
      "location": 2,
      "content": "这个点很重要",
      "music": 0.0
    },
    {
      "from": 28.5,
      "to": 30.76,
      "sid": 12,
      "location": 2,
      "content": "决定你是否会在低段位原地踏步",
      "music": 0.0
    },
    {
      "from": 30.76,
      "to": 32.54,
      "sid": 13,
      "location": 2,
      "content": "答案其实并不非此即彼",
      "music": 0.0
    },
    {
      "from": 32.54,
      "to": 35.26,
      "sid": 14,
      "location": 2,
      "content": "在与我们训练一个职业教练RAJA深入交流过后",
