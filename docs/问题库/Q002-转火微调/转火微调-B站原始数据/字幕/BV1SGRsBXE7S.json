    },
    {
      "from": 35.26,
      "to": 37.04,
      "sid": 15,
      "location": 2,
      "content": "我深刻领悟了瞄准了",
      "music": 0.0
    },
    {
      "from": 37.04,
      "to": 39.12,
      "sid": 16,
      "location": 2,
      "content": "在预瞄赶路没见到人时",
