  "segments": [
    {
      "from": 0.12,
      "to": 0.68,
      "sid": 1,
      "location": 2,
      "content": "同一个人",
      "music": 0.0
    },
    {
      "from": 0.68,
      "to": 2.96,
      "sid": 2,
      "location": 2,
      "content": "这是顿悟后的瞄准视角",
      "music": 0.0
    },
    {
      "from": 6.76,
      "to": 8.74,
      "sid": 3,
      "location": 2,
      "content": "这是动物前的瞄准视角",
      "music": 0.0
    },
    {
      "from": 8.74,
      "to": 9.92,
      "sid": 4,
      "location": 2,
      "content": "卡啦卡啦",
      "music": 0.0
    },
    {
      "from": 9.92,
      "to": 12.91,
      "sid": 5,
      "location": 2,
      "content": "好在瞄准难度基本相同的情况下",
      "music": 0.0
    },
    {
      "from": 12.91,
      "to": 14.27,
      "sid": 6,
      "location": 2,
      "content": "后者到底差在哪",
      "music": 0.0
    },
    {
      "from": 14.27,
      "to": 14.67,
      "sid": 7,
      "location": 2,
      "content": "很简单",
      "music": 0.0
    },
    {
      "from": 14.67,
      "to": 15.11,
      "sid": 8,
      "location": 2,
      "content": "一个字",
      "music": 0.0
    },
    {
      "from": 15.11,
      "to": 16.11,
      "sid": 9,
      "location": 2,
      "content": "瞄准无确认",
      "music": 0.0
    },
    {
      "from": 16.11,
      "to": 17.71,
      "sid": 10,
      "location": 2,
      "content": "欢迎到策划TC1对一教学",
      "music": 0.0
    },
    {
      "from": 17.71,
      "to": 19.64,
      "sid": 11,
      "location": 2,
      "content": "首先我们来解是什么",
      "music": 0.0
    },
    {
      "from": 19.64,
      "to": 21.06,
      "sid": 12,
      "location": 2,
      "content": "是准确的瞄准确认感",
      "music": 0.0
    },
    {
      "from": 21.06,
      "to": 24.68,
      "sid": 13,
      "location": 2,
      "content": "一般我们把准星拉到附近的过程叫做定位",
      "music": 0.0
    },
    {
      "from": 24.68,
      "to": 26.82,
      "sid": 14,
      "location": 2,
      "content": "定位有误差后在小范围的波动",
      "music": 0.0
    },
    {
      "from": 26.82,
      "to": 27.92,
      "sid": 15,
      "location": 2,
      "content": "准星叫做微调",
      "music": 0.0
    },
    {
      "from": 27.92,
      "to": 29.54,
      "sid": 16,
      "location": 2,
      "content": "而整个定位微调中",
      "music": 0.0
    },
    {
      "from": 29.54,
      "to": 32.189,
      "sid": 17,
      "location": 2,
      "content": "持续判断准星是否和头部重合",
      "music": 0.0
    },
    {
      "from": 32.189,
      "to": 35.469,
      "sid": 18,
      "location": 2,
      "content": "确认基本重合后开枪的过程就叫瞄准确认",
      "music": 0.0
    },
    {
      "from": 35.469,
      "to": 37.149,
      "sid": 19,
      "location": 2,
      "content": "所以在这里你应该发现",
      "music": 0.0
    },
    {
      "from": 37.149,
      "to": 40.92,
      "sid": 20,
      "location": 2,
      "content": "瞄准确认并不是只作用于定位或微调",
      "music": 0.0
    },
    {
      "from": 40.92,
      "to": 44.2,
      "sid": 21,
      "location": 2,
      "content": "而是辅助两者只不过是确认的内容有区别",
      "music": 0.0
    },
    {
      "from": 44.2,
      "to": 45.64,
      "sid": 22,
      "location": 2,
      "content": "定位中的确确认是",
      "music": 0.0
    },
    {
      "from": 45.64,
      "to": 48.7,
      "sid": 23,
      "location": 2,
      "content": "当我们用较快的拉枪速度定位敌方时",
      "music": 0.0
    },
    {
      "from": 48.7,
      "to": 51.6,
      "sid": 24,
      "location": 2,
      "content": "先确认准本身跟敌方头部的距离差多少",
      "music": 0.0
    },
    {
      "from": 51.6,
      "to": 54.36,
      "sid": 25,
      "location": 2,
      "content": "一旦较近则说明属于较低的瞄准难度",
      "music": 0.0
    },
    {
      "from": 54.36,
      "to": 56.88,
      "sid": 26,
      "location": 2,
      "content": "微调中的确认是在上一步之后",
      "music": 0.0
    },
    {
      "from": 56.88,
      "to": 60.84,
      "sid": 27,
      "location": 2,
      "content": "用更精准的拖动来确认准星和头部是否重合",
      "music": 0.0
    },
    {
      "from": 60.84,
      "to": 63.08,
      "sid": 28,
      "location": 2,
      "content": "抓住重合的时机执行开枪操作",
      "music": 0.0
    },
    {
      "from": 63.08,
      "to": 65.32,
      "sid": 29,
      "location": 2,
      "content": "大家熟知的高分主播职业",
      "music": 0.0
    },
    {
      "from": 65.32,
      "to": 68.92,
      "sid": 30,
      "location": 2,
      "content": "因为手念的确认感就会把过程压缩到极致",
      "music": 0.0
    },
    {
      "from": 68.92,
      "to": 70.54,
      "sid": 31,
      "location": 2,
      "content": "所以瞄准就会很快",
      "music": 0.0
    },
    {
      "from": 70.54,
      "to": 72.66,
      "sid": 32,
      "location": 2,
      "content": "但很多正常玩家为了快",
      "music": 0.0
    },
    {
      "from": 72.66,
      "to": 74.58,
      "sid": 33,
      "location": 2,
      "content": "会下意识跳过确认的过程",
      "music": 0.0
    },
    {
      "from": 74.58,
      "to": 76.68,
      "sid": 34,
      "location": 2,
      "content": "也就是看到人就是开枪",
      "music": 0.0
    },
    {
      "from": 76.68,
      "to": 78.02,
      "sid": 35,
      "location": 2,
      "content": "没有看准镜的位置",
      "music": 0.0
    },
    {
      "from": 78.02,
      "to": 81.28,
      "sid": 36,
      "location": 2,
      "content": "这也是为什么总能看到两个人互相摆设",
      "music": 0.0
    },
    {
      "from": 81.28,
      "to": 83.94,
      "sid": 37,
      "location": 2,
      "content": "但是都打不动的情况就是没有确认",
      "music": 0.0
    },
    {
      "from": 83.94,
      "to": 85.18,
      "sid": 38,
      "location": 2,
      "content": "所以针对这种情况",
      "music": 0.0
    },
    {
      "from": 85.18,
      "to": 87.94,
      "sid": 39,
      "location": 2,
      "content": "给大家一套从定位到微调的综合性练习",
      "music": 0.0
    },
    {
      "from": 87.94,
      "to": 88.86,
      "sid": 40,
      "location": 2,
      "content": "每天18分钟",
      "music": 0.0
    },
    {
      "from": 88.86,
      "to": 91.76,
      "sid": 41,
      "location": 2,
      "content": "一周就能获得超凡级的震感",
      "music": 0.0
    },
    {
      "from": 91.76,
      "to": 93.36,
      "sid": 42,
      "location": 2,
      "content": "首先是赌定位训练",
      "music": 0.0
    },
    {
      "from": 93.36,
      "to": 95.1,
      "sid": 43,
      "location": 2,
      "content": "把机器人的数量调成五",
      "music": 0.0
    },
    {
      "from": 95.1,
      "to": 97.62,
      "sid": 44,
      "location": 2,
      "content": "用截风的凌空技能来到房梁",
      "music": 0.0
    },
    {
      "from": 97.62,
      "to": 99.34,
      "sid": 45,
      "location": 2,
      "content": "把boss的头部都当做小球",
      "music": 0.0
    },
    {
      "from": 99.34,
      "to": 100.94,
      "sid": 46,
      "location": 2,
      "content": "眼睛聚焦小球的同时",
      "music": 0.0
    },
    {
      "from": 100.94,
      "to": 103.78,
      "sid": 47,
      "location": 2,
      "content": "只用最精准的一发飞镖带确认感激打",
      "music": 0.0
    },
    {
      "from": 103.78,
      "to": 104.94,
      "sid": 48,
      "location": 2,
      "content": "每击打一个boss后",
      "music": 0.0
    },
    {
      "from": 104.94,
      "to": 105.98,
      "sid": 49,
      "location": 2,
      "content": "眼睛快速聚焦",
      "music": 0.0
    },
    {
      "from": 105.98,
      "to": 108.66,
      "sid": 50,
      "location": 2,
      "content": "下一个确保手眼协调进行瞄准",
      "music": 0.0
    },
    {
      "from": 108.66,
      "to": 111.22,
      "sid": 51,
      "location": 2,
      "content": "这一步需保证8分钟的练习时长",
      "music": 0.0
    },
    {
      "from": 111.22,
      "to": 113.44,
      "sid": 52,
      "location": 2,
      "content": "如果你游戏时长超过220个小时",
      "music": 0.0
    },
    {
      "from": 113.44,
      "to": 115.62,
