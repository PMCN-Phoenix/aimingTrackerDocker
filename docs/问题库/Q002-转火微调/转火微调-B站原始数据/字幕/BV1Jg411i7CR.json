{
  "bvid": "BV1Jg411i7CR",
  "status": "ok lang=ai-zh",
  "segments": [
    {
      "from": 0.24,
      "to": 1.08,
      "sid": 1,
      "location": 2,
      "content": "各位朋友大家好",
      "music": 0.0
    },
    {
      "from": 1.08,
      "to": 1.74,
      "sid": 2,
      "location": 2,
      "content": "我是东彦",
      "music": 0.0
    },
    {
      "from": 1.74,
      "to": 3.42,
      "sid": 3,
      "location": 2,
      "content": "那么先给带来一期瓦伦特的视频",
      "music": 0.0
    },
    {
      "from": 3.42,
      "to": 5.97,
      "sid": 4,
      "location": 2,
      "content": "细谈一下在游戏里的瞄准微调应该如何提高",
      "music": 0.0
    },
    {
      "from": 5.97,
      "to": 8.37,
      "sid": 5,
      "location": 2,
      "content": "就是我之前在这个参考教学中讲到过的一样",
      "music": 0.0
    },
    {
      "from": 8.37,
      "to": 9.99,
      "sid": 6,
      "location": 2,
      "content": "在瓦伦特利微调手上有三种",
      "music": 0.0
    },
    {
      "from": 9.99,
      "to": 11.43,
      "sid": 7,
      "location": 2,
      "content": "也就是右手的瞄准微调",
      "music": 0.0
    },
    {
      "from": 11.43,
      "to": 13.58,
      "sid": 8,
      "location": 2,
      "content": "左手的移动补偿以及扫射控枪补偿",
      "music": 0.0
    },
    {
      "from": 13.58,
      "to": 16.68,
      "sid": 9,
      "location": 2,
      "content": "那么其中呢右手的瞄准微调是中国注重微调的",
      "music": 0.0
    },
    {
      "from": 16.68,
      "to": 18.12,
      "sid": 10,
      "location": 2,
      "content": "既是准星不在目标上面",
      "music": 0.0
    },
    {
      "from": 18.12,
      "to": 19.38,
      "sid": 11,
      "location": 2,
      "content": "但准星相关的距离很近",
      "music": 0.0
    },
    {
      "from": 19.38,
      "to": 21.3,
      "sid": 12,
      "location": 2,
      "content": "需要我们尽快遇到准星文件的相对关系",
      "music": 0.0
    },
    {
      "from": 21.3,
      "to": 22.44,
      "sid": 13,
      "location": 2,
      "content": "并通过小费的微调",
      "music": 0.0
    },
    {
      "from": 22.44,
      "to": 24.32,
      "sid": 14,
      "location": 2,
      "content": "将准星定到目标头上的一个场景",
      "music": 0.0
    },
    {
      "from": 24.32,
      "to": 25.76,
      "sid": 15,
      "location": 2,
      "content": "那关于这方面的练习",
      "music": 0.0
    },
    {
      "from": 25.76,
      "to": 27.89,
      "sid": 16,
      "location": 2,
      "content": "我此前呢讲的比较这个概率啊",
      "music": 0.0
    },
    {
      "from": 27.89,
      "to": 30.04,
      "sid": 17,
      "location": 2,
      "content": "那今天我们就深入的谈一下这个话题",
      "music": 0.0
    },
    {
      "from": 30.04,
      "to": 30.82,
      "sid": 18,
      "location": 2,
      "content": "在视频的开头",
      "music": 0.0
    },
    {
      "from": 30.82,
      "to": 31.84,
      "sid": 19,
      "location": 2,
      "content": "我们还是错误一下",
      "music": 0.0
    },
    {
      "from": 31.84,
      "to": 32.38,
      "sid": 20,
      "location": 2,
      "content": "没有看过",
      "music": 0.0
    },
    {
      "from": 32.38,
      "to": 33.82,
      "sid": 21,
      "location": 2,
      "content": "可能以前的这些视频的新观众",
      "music": 0.0
    },
    {
      "from": 33.82,
      "to": 36.64,
      "sid": 22,
      "location": 2,
      "content": "我再提两个老生常谈的微调能这练习方式",
      "music": 0.0
    },
    {
      "from": 36.64,
      "to": 39.1,
      "sid": 23,
      "location": 2,
      "content": "首先在练习软件里面有专门的微调战力",
      "music": 0.0
    },
    {
      "from": 39.1,
      "to": 41.1,
      "sid": 24,
      "location": 2,
      "content": "练习项目可供我们这个练习啊",
      "music": 0.0
    },
    {
      "from": 41.1,
      "to": 42.54,
      "sid": 25,
      "location": 2,
      "content": "QUAK中的romos control",
      "music": 0.0
    },
    {
      "from": 42.54,
      "to": 44.76,
      "sid": 26,
      "location": 2,
      "content": "ak three以及in lab中的micro gusha",
      "music": 0.0
    },
    {
      "from": 44.76,
      "to": 46.38,
      "sid": 27,
      "location": 2,
      "content": "都有很好的一个练习的效果",
      "music": 0.0
    },
    {
      "from": 46.38,
      "to": 47.64,
      "sid": 28,
      "location": 2,
      "content": "那在这些项目的练习中",
      "music": 0.0
    },
    {
      "from": 47.64,
      "to": 49.44,
      "sid": 29,
      "location": 2,
      "content": "我们能磨练自己纯粹的瞄准能力",
      "music": 0.0
    },
    {
      "from": 49.44,
      "to": 51.42,
      "sid": 30,
      "location": 2,
      "content": "也就是说MIGO那练枪法软件呢",
      "music": 0.0
    },
    {
      "from": 51.42,
      "to": 53.4,
      "sid": 31,
      "location": 2,
      "content": "除了瞄准能力与实战枪法之间的关系",
      "music": 0.0
    },
    {
      "from": 53.4,
      "to": 54.84,
      "sid": 32,
      "location": 2,
      "content": "我们在瞄准系列教学",
      "music": 0.0
    },
    {
      "from": 54.84,
      "to": 56.48,
      "sid": 33,
      "location": 2,
      "content": "S204中也讲的很清楚了",
      "music": 0.0
    },
    {
      "from": 56.48,
      "to": 57.74,
      "sid": 34,
      "location": 2,
      "content": "非常推荐大家去看一下",
      "music": 0.0
    },
    {
      "from": 57.74,
      "to": 59.24,
      "sid": 35,
      "location": 2,
      "content": "国外链接会在时间下方",
      "music": 0.0
    },
    {
      "from": 59.24,
      "to": 60.92,
      "sid": 36,
      "location": 2,
      "content": "那有些朋友呢在练习枪软件里面",
      "music": 0.0
    },
    {
      "from": 60.92,
      "to": 62.98,
      "sid": 37,
      "location": 2,
      "content": "练出了比较不错的微调能力",
      "music": 0.0
    },
    {
      "from": 62.98,
      "to": 64.3,
      "sid": 38,
      "location": 2,
      "content": "在实战里面用不出来啊",
      "music": 0.0
    },
    {
      "from": 64.3,
      "to": 65.92,
      "sid": 39,
      "location": 2,
      "content": "就比如说实战里心里一紧张",
      "music": 0.0
    },
    {
      "from": 65.92,
      "to": 67.58,
      "sid": 40,
      "location": 2,
      "content": "可能就会不经过微调就开枪",
      "music": 0.0
    },
    {
      "from": 67.58,
      "to": 69.14,
      "sid": 41,
      "location": 2,
      "content": "习惯性的先开枪再瞄准",
      "music": 0.0
    },
    {
      "from": 69.14,
      "to": 70.61,
      "sid": 42,
      "location": 2,
      "content": "微调练得再好也用不出来",
      "music": 0.0
    },
    {
      "from": 70.61,
      "to": 72.2,
      "sid": 43,
      "location": 2,
      "content": "如果你在实战里有这种现象",
      "music": 0.0
    },
    {
      "from": 72.2,
      "to": 74.06,
      "sid": 44,
      "location": 2,
      "content": "那我多次提到过的捍卫者练习",
      "music": 0.0
    },
    {
      "from": 74.06,
      "to": 75.4,
      "sid": 45,
      "location": 2,
      "content": "将会极大地帮助到你",
      "music": 0.0
    },
    {
      "from": 75.4,
      "to": 76.6,
      "sid": 46,
      "location": 2,
      "content": "我们可以在死斗神",
      "music": 0.0
    },
    {
      "from": 76.6,
      "to": 79.3,
      "sid": 47,
      "location": 2,
      "content": "在天梯中只使用神社捍卫者等半自动枪法",
      "music": 0.0
    },
    {
      "from": 79.3,
      "to": 81.16,
      "sid": 48,
      "location": 2,
      "content": "而且进行练习能很好的帮助你养成",
      "music": 0.0
    },
    {
      "from": 81.16,
      "to": 82.69,
      "sid": 49,
      "location": 2,
      "content": "先瞄准再开枪法习惯",
      "music": 0.0
    },
    {
      "from": 82.69,
      "to": 84.1,
      "sid": 50,
      "location": 2,
      "content": "这种练习呢虽然很折磨",
      "music": 0.0
    },
    {
      "from": 84.1,
      "to": 86.66,
      "sid": 51,
      "location": 2,
      "content": "但能迅速的将练习翘软件磨练出的微调能力",
      "music": 0.0
    },
    {
      "from": 86.66,
      "to": 87.8,
      "sid": 52,
      "location": 2,
      "content": "转换到实战中",
      "music": 0.0
    },
    {
      "from": 87.8,
      "to": 90.02,
      "sid": 53,
      "location": 2,
      "content": "另外呢就是我此前一直强调过的",
      "music": 0.0
    },
    {
      "from": 90.02,
      "to": 91.98,
      "sid": 54,
      "location": 2,
      "content": "左手的移动对右手瞄准的补偿",
      "music": 0.0
    },
    {
      "from": 91.98,
      "to": 93.18,
      "sid": 55,
      "location": 2,
      "content": "即左右手的协调",
      "music": 0.0
    },
    {
      "from": 93.18,
      "to": 95.44,
      "sid": 56,
      "location": 2,
      "content": "也是影响实战有微调发挥的重要因素",
      "music": 0.0
    },
    {
      "from": 95.44,
      "to": 97.6,
      "sid": 57,
      "location": 2,
      "content": "比如说我们在移动的过程中遭遇了敌人",
      "music": 0.0
    },
    {
      "from": 97.6,
      "to": 100.26,
      "sid": 58,
      "location": 2,
      "content": "假如我们目前的准星位于敌人头部右侧",
      "music": 0.0
    },
    {
      "from": 100.26,
      "to": 102.42,
      "sid": 59,
      "location": 2,
      "content": "我们既可以在按A向左移动的同时",
      "music": 0.0
    },
    {
      "from": 102.42,
      "to": 103.53,
      "sid": 60,
      "location": 2,
      "content": "鼠标向左微调",
      "music": 0.0
    },
    {
      "from": 103.53,
      "to": 105.36,
      "sid": 61,
      "location": 2,
      "content": "也可以按D向右移动的同时",
      "music": 0.0
    },
    {
      "from": 105.36,
      "to": 107.26,
      "sid": 62,
      "location": 2,
      "content": "以更大幅度往左拉鼠标",
      "music": 0.0
    },
    {
      "from": 107.26,
      "to": 109.75,
      "sid": 63,
      "location": 2,
      "content": "最终让移动补偿右手的鼠标完成微调",
      "music": 0.0
    },
    {
      "from": 109.75,
      "to": 112.14,
      "sid": 64,
      "location": 2,
      "content": "后面上这几个素材都是比较好的案例",
      "music": 0.0
    },
    {
      "from": 112.14,
      "to": 113.88,
      "sid": 65,
      "location": 2,
      "content": "那关于如何练习这种能力",
      "music": 0.0
    },
    {
      "from": 113.88,
      "to": 114.6,
      "sid": 66,
      "location": 2,
      "content": "在初级阶段",
      "music": 0.0
    },
    {
      "from": 114.6,
      "to": 118.02,
      "sid": 67,
      "location": 2,
      "content": "我推荐大家在靶场里面在保持频繁变向的同时",
      "music": 0.0
    },
    {
      "from": 118.02,
      "to": 119.4,
      "sid": 68,
      "location": 2,
      "content": "对这个靶子进行定位",
      "music": 0.0
    },
    {
      "from": 119.4,
      "to": 122.34,
      "sid": 69,
      "location": 2,
      "content": "在熟练掌握了移动索敌左右手协调",
      "music": 0.0
    },
    {
      "from": 122.34,
      "to": 124.08,
      "sid": 70,
      "location": 2,
      "content": "完成微调这一套流程之后",
      "music": 0.0
    },
    {
      "from": 124.08,
      "to": 125.68,
      "sid": 71,
      "location": 2,
      "content": "可以进入更进一步的训练",
      "music": 0.0
    },
    {
      "from": 125.68,
      "to": 126.34,
      "sid": 72,
      "location": 2,
      "content": "也就是说",
      "music": 0.0
    },
    {
      "from": 126.34,
      "to": 128.98,
      "sid": 73,
      "location": 2,
      "content": "找一个朋友一起进入自定义选择遗落境地",
      "music": 0.0
    },
    {
      "from": 128.98,
      "to": 129.979,
      "sid": 74,
      "location": 2,
      "content": "打开密集选项",
      "music": 0.0
    },
    {
      "from": 129.979,
      "to": 130.939,
      "sid": 75,
      "location": 2,
      "content": "开启游戏后呢",
      "music": 0.0
    },
    {
      "from": 130.939,
      "to": 132.019,
      "sid": 76,
      "location": 2,
      "content": "两个人都选了捷风",
      "music": 0.0
    },
    {
      "from": 132.019,
      "to": 132.559,
      "sid": 77,
      "location": 2,
      "content": "进入游戏后",
      "music": 0.0
    },
    {
      "from": 132.559,
      "to": 133.579,
      "sid": 78,
      "location": 2,
      "content": "打开ESC的秘籍",
      "music": 0.0
    },
    {
      "from": 133.579,
      "to": 134.569,
      "sid": 79,
      "location": 2,
      "content": "打开自动重生",
      "music": 0.0
    },
    {
      "from": 134.569,
      "to": 136.159,
      "sid": 80,
      "location": 2,
      "content": "两个人来到C场两侧",
      "music": 0.0
    },
    {
      "from": 136.159,
      "to": 138.98,
      "sid": 81,
      "location": 2,
      "content": "往马路中间按C技能封一颗持续四秒的烟雾弹",
      "music": 0.0
    },
    {
      "from": 138.98,
      "to": 141.32,
      "sid": 82,
      "location": 2,
      "content": "双方在烟雾弹存在过程中保持移动",
      "music": 0.0
    },
    {
      "from": 141.32,
      "to": 142.76,
      "sid": 83,
      "location": 2,
      "content": "在烟雾弹消散一瞬间",
      "music": 0.0
    },
    {
      "from": 142.76,
      "to": 144.82,
      "sid": 84,
      "location": 2,
      "content": "尝试以最快的速度这个击杀敌人",
      "music": 0.0
    },
    {
      "from": 144.82,
      "to": 146.38,
      "sid": 85,
      "location": 2,
      "content": "通过这样的高频为单挑",
      "music": 0.0
    },
    {
      "from": 146.38,
      "to": 149.32,
      "sid": 86,
      "location": 2,
      "content": "我们就能更快更好的掌握左右手的协调能力",
      "music": 0.0
    },
    {
      "from": 149.32,
      "to": 151.42,
      "sid": 87,
      "location": 2,
      "content": "在实战中把自微调剂好用出来",
      "music": 0.0
    },
    {
      "from": 151.42,
      "to": 152.74,
      "sid": 88,
      "location": 2,
      "content": "那以上这些内容呢",
      "music": 0.0
    },
    {
      "from": 152.74,
      "to": 154.9,
      "sid": 89,
      "location": 2,
      "content": "我此前都或多或少的讲过蛮多次的",
      "music": 0.0
    },
    {
      "from": 154.9,
      "to": 157.02,
      "sid": 90,
      "location": 2,
      "content": "接下来这些内容是此前没有讲过的",
      "music": 0.0
    },
    {
      "from": 157.02,
      "to": 157.68,
      "sid": 91,
      "location": 2,
      "content": "细致化的",
      "music": 0.0
    },
    {
      "from": 157.68,
      "to": 161.58,
      "sid": 92,
      "location": 2,
      "content": "而且个人色彩明显的一些这个经验分享",
      "music": 0.0
    },
    {
      "from": 162.68,
      "to": 164.66,
      "sid": 93,
      "location": 2,
      "content": "我们先来谈一下握法与发力方式",
      "music": 0.0
    },
    {
      "from": 164.66,
      "to": 166.76,
      "sid": 94,
      "location": 2,
      "content": "一般来讲啊才知道奥特射击游戏里会说",
      "music": 0.0
    },
    {
      "from": 166.76,
      "to": 168.26,
      "sid": 95,
      "location": 2,
      "content": "握法虽然有理论上的最优解",
      "music": 0.0
    },
    {
      "from": 168.26,
      "to": 170.12,
      "sid": 96,
      "location": 2,
      "content": "但在实际应用上还是推荐大家怎么舒服",
      "music": 0.0
    },
    {
      "from": 170.12,
      "to": 170.94,
      "sid": 97,
      "location": 2,
      "content": "怎么来的",
      "music": 0.0
    },
    {
      "from": 170.94,
      "to": 173.16,
      "sid": 98,
      "location": 2,
      "content": "可是呢在极度强调瞬间的瞄准",
      "music": 0.0
    },
    {
      "from": 173.16,
      "to": 174.72,
      "sid": 99,
      "location": 2,
      "content": "微调的瓦兰特这一特定游戏里",
      "music": 0.0
    },
    {
      "from": 174.72,
      "to": 176.58,
      "sid": 100,
      "location": 2,
      "content": "有一种握法呢还是最好尽力避免的",
      "music": 0.0
    },
    {
      "from": 176.58,
      "to": 177.44,
      "sid": 101,
      "location": 2,
      "content": "那就是趴握",
      "music": 0.0
    },
    {
      "from": 177.44,
      "to": 178.1,
      "sid": 102,
      "location": 2,
      "content": "我们要知道",
      "music": 0.0
    },
    {
      "from": 178.1,
      "to": 180.8,
      "sid": 103,
      "location": 2,
      "content": "在游戏中瞄准会用到主要个人体发力部位里",
      "music": 0.0
    },
    {
      "from": 180.8,
      "to": 183.44,
      "sid": 104,
      "location": 2,
      "content": "对细微操作精度是肩膀远小于手臂",
      "music": 0.0
    },
    {
      "from": 183.44,
      "to": 183.92,
      "sid": 105,
      "location": 2,
      "content": "小于手腕",
      "music": 0.0
    },
    {
      "from": 183.92,
