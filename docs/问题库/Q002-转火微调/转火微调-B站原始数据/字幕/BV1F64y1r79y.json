{
  "bvid": "BV1F64y1r79y",
  "status": "ok lang=ai-zh",
  "segments": [
    {
      "from": 0.84,
      "to": 1.56,
      "sid": 1,
      "location": 2,
      "content": "我是巴尔多斯"
    },
    {
      "from": 1.56,
      "to": 4.64,
      "sid": 2,
      "location": 2,
      "content": "我有二十年玩FPS游戏的经验"
    },
    {
      "from": 4.64,
      "to": 7.8,
      "sid": 3,
      "location": 2,
      "content": "我有几个考克斯的最高分"
    },
    {
      "from": 7.8,
      "to": 9.61,
      "sid": 4,
      "location": 2,
      "content": "尤其是在静态点中"
    },
    {
      "from": 9.61,
      "to": 12.41,
      "sid": 5,
      "location": 2,
      "content": "你可能见过我在一墙六个目标的排行榜上"
    },
    {
      "from": 12.41,
      "to": 14.5,
      "sid": 6,
      "location": 2,
      "content": "小的或一堵墙六个目标"
    },
    {
      "from": 14.5,
      "to": 15.44,
      "sid": 7,
      "location": 2,
      "content": "所以我在做这个视频"
    },
    {
      "from": 15.44,
      "to": 17.36,
      "sid": 8,
      "location": 2,
      "content": "因为我现在许多次承诺"
    },
    {
      "from": 17.36,
      "to": 21.66,
      "sid": 9,
      "location": 2,
      "content": "然后我会做一个视频解释我是如何得到这个好的和静态的"
    },
    {
      "from": 21.66,
      "to": 23.9,
      "sid": 10,
      "location": 2,
      "content": "不过，首先我想从"
    },
    {
      "from": 23.9,
      "to": 25.8,
      "sid": 11,
      "location": 2,
      "content": "为什么静态点甚至有用"
    },
    {
      "from": 25.8,
      "to": 30.04,
      "sid": 12,
      "location": 2,
      "content": "你为什么要浪费时间试图改进静态点"
    },
    {
      "from": 30.04,
      "to": 33.54,
      "sid": 13,
      "location": 2,
      "content": "当然，你不会仅仅为了静态点本身而这么做"
    },
    {
      "from": 33.54,
      "to": 34.36,
      "sid": 14,
      "location": 2,
      "content": "但你会这么做"
    },
    {
      "from": 34.36,
      "to": 40.52,
      "sid": 15,
      "location": 2,
      "content": "因为静态点可以转化为你经常使用的某种瞄准"
    },
    {
      "from": 40.52,
      "to": 43.9,
      "sid": 16,
      "location": 2,
      "content": "在游戏中，基本上是轻弹到一个固定点"
    },
    {
      "from": 43.9,
      "to": 44.5,
      "sid": 17,
      "location": 2,
      "content": "比如说"
    },
    {
      "from": 44.5,
      "to": 48.04,
      "sid": 18,
      "location": 2,
      "content": "在一个竞争的战术FPS中，就像一种取得平衡"
    },
    {
      "from": 48.04,
      "to": 51.72,
      "sid": 19,
      "location": 2,
      "content": "你会用这种动作在不同的地方移动你的交叉"
    },
    {
      "from": 51.72,
      "to": 53.88,
      "sid": 20,
      "location": 2,
      "content": "这就是人们通常所说的交叉置换"
    },
    {
      "from": 53.88,
      "to": 54.92,
      "sid": 21,
      "location": 2,
      "content": "但如果你站着不动"
    },
    {
      "from": 54.92,
      "to": 56.8,
      "sid": 22,
      "location": 2,
      "content": "你听到脚步声，你需要移动你的十字准星"
    },
    {
      "from": 56.8,
      "to": 60.1,
      "sid": 23,
      "location": 2,
      "content": "在其他地方，你会用基本上静态的运动来做"
    },
    {
      "from": 60.1,
      "to": 61.68,
      "sid": 24,
      "location": 2,
      "content": "你需要快速准确"
    },
    {
      "from": 61.68,
      "to": 63.18,
      "sid": 25,
      "location": 2,
      "content": "因为如果你很慢"
    },
    {
      "from": 63.18,
      "to": 67.249,
      "sid": 26,
      "location": 2,
      "content": "那么你就冒着有人从角落里跑进来的风险"
    },
    {
      "from": 67.249,
      "to": 70.669,
      "sid": 27,
      "location": 2,
      "content": "在你把十字准星放在正确的位置之前"
    },
    {
      "from": 70.669,
      "to": 72.289,
      "sid": 28,
      "location": 2,
      "content": "如果你不准确"
    },
    {
      "from": 72.289,
      "to": 75.88,
      "sid": 29,
      "location": 2,
      "content": "那么当你听到他们的声音时，你就冒着点击角落的风险"
    },
    {
      "from": 75.88,
      "to": 78.86,
      "sid": 30,
      "location": 2,
      "content": "然后也许你会稍微偏离"
    },
    {
      "from": 78.86,
      "to": 79.58,
      "sid": 31,
      "location": 2,
      "content": "他们出来了"
    },
    {
      "from": 79.58,
      "to": 81.26,
      "sid": 32,
      "location": 2,
      "content": "你的十字准星不在正确的位置"
    },
    {
      "from": 81.26,
      "to": 82.58,
      "sid": 33,
      "location": 2,
      "content": "你将不得不再次轻弹"
    },
    {
      "from": 82.58,
      "to": 82.9,
      "sid": 34,
      "location": 2,
      "content": "那个"
    },
    {
      "from": 82.9,
      "to": 83.32,
      "sid": 35,
      "location": 2,
      "content": "当然啦"
    },
    {
      "from": 83.32,
      "to": 85.39,
      "sid": 36,
      "location": 2,
      "content": "降低你赢得战斗的机会"
    },
    {
      "from": 85.39,
      "to": 88.15,
      "sid": 37,
      "location": 2,
      "content": "所以这就是为什么你应该玩静态点"
    },
    {
      "from": 88.15,
      "to": 90.19,
      "sid": 38,
      "location": 2,
      "content": "基本上说到打电话给雄鹿和FPS"
    },
    {
      "from": 90.19,
      "to": 92.39,
      "sid": 39,
      "location": 2,
      "content": "同样的教练"
    },
    {
      "from": 93.48,
      "to": 96.76,
      "sid": 40,
      "location": 2,
      "content": "所以现在让我们讨论一下我是如何设法提高的"
    },
    {
      "from": 96.76,
      "to": 100.62,
      "sid": 41,
      "location": 2,
      "content": "所以首先你要记住我现在的分数非常高"
    },
    {
      "from": 100.62,
      "to": 102.22,
      "sid": 42,
      "location": 2,
      "content": "但我开始有点高"
    },
    {
      "from": 102.22,
      "to": 106.25,
      "sid": 43,
      "location": 2,
      "content": "因为我在FPS游戏方面的多年经验"
    },
    {
      "from": 106.25,
      "to": 107.95,
      "sid": 44,
      "location": 2,
      "content": "在我开始玩Cobux之前"
    },
    {
      "from": 107.95,
      "to": 110.99,
      "sid": 45,
      "location": 2,
      "content": "因为基本上当我开始在Covax中播放静态点时"
    },
    {
      "from": 113.53,
      "to": 116.12,
      "sid": 46,
      "location": 2,
      "content": "如果你能击中那种"
    },
    {
      "from": 116.12,
      "to": 117.2,
      "sid": 47,
      "location": 2,
      "content": "我当然在打"
    },
    {
      "from": 117.2,
      "to": 118.78,
      "sid": 48,
      "location": 2,
      "content": "因为你知道你必须把它放在上下文中"
    },
    {
      "from": 123.87,
      "to": 125.89,
      "sid": 49,
      "location": 2,
      "content": "我甚至摸过Covax"
    },
    {
      "from": 125.89,
      "to": 127.01,
      "sid": 50,
      "location": 2,
      "content": "但除此之外"
    },
    {
      "from": 127.01,
      "to": 132.659,
      "sid": 51,
      "location": 2,
      "content": "基本上，我以前在一个世界里大约有一千二百人，目标是小的"
    },
    {
      "from": 133.879,
      "to": 135.24,
      "sid": 52,
      "location": 2,
      "content": "所以是的"
    },
    {
      "from": 135.24,
      "to": 137.32,
      "sid": 53,
      "location": 2,
      "content": "考虑到刚开始，还不错"
    },
    {
      "from": 137.32,
      "to": 139.34,
      "sid": 54,
      "location": 2,
      "content": "但也不可怕"
    },
    {
      "from": 139.34,
      "to": 142.18,
      "sid": 55,
      "location": 2,
      "content": "我有点卡住了"
    },
    {
      "from": 142.18,
      "to": 144.16,
      "sid": 56,
      "location": 2,
      "content": "别以为我进步了"
    },
    {
      "from": 144.16,
      "to": 144.94,
      "sid": 57,
      "location": 2,
      "content": "因为它不是"
    },
    {
      "from": 144.94,
      "to": 147.5,
      "sid": 58,
      "location": 2,
      "content": "我会放一点图形"
    },
    {
      "from": 147.64,
      "to": 152.879,
      "sid": 59,
      "location": 2,
      "content": "屏幕上有一张我得分的小图表给你看"
    },
    {
      "from": 152.879,
      "to": 155.63,
      "sid": 60,
      "location": 2,
      "content": "当然，我是如何提高的"
    },
    {
      "from": 155.63,
      "to": 157.89,
      "sid": 61,
      "location": 2,
      "content": "所以基本上每个人都告诉我参与其中"
    },
    {
      "from": 157.89,
      "to": 162.31,
      "sid": 62,
      "location": 2,
      "content": "你知道在命名社区我应该追求速度"
    },
    {
      "from": 162.31,
      "to": 165.17,
      "sid": 63,
      "location": 2,
      "content": "但我觉得那不是正确的方法"
    },
    {
      "from": 165.17,
      "to": 169.21,
      "sid": 64,
      "location": 2,
      "content": "因为我的想法是为什么你会追求速度而不是准确性"
    },
    {
      "from": 169.21,
      "to": 173.11,
      "sid": 65,
      "location": 2,
      "content": "当完美的运行有百分之百的准确性"
    },
    {
      "from": 173.11,
      "to": 176.81,
      "sid": 66,
      "location": 2,
      "content": "就像基本上我接近了它"
    },
    {
      "from": 180.13,
      "to": 182.28,
      "sid": 67,
      "location": 2,
      "content": "因为我的想法是"
    },
    {
      "from": 182.28,
      "to": 187.59,
      "sid": 68,
      "location": 2,
      "content": "我需要能够完美而缓慢地做出我需要的动作"
    },
    {
      "from": 187.59,
      "to": 188.69,
      "sid": 69,
      "location": 2,
      "content": "在我加快速度之前"
    },
    {
      "from": 188.69,
      "to": 191.31,
      "sid": 70,
      "location": 2,
      "content": "所以我实际上开始得到更低的分数"
    },
    {
      "from": 191.31,
      "to": 192.53,
      "sid": 71,
      "location": 2,
      "content": "但是精度更高"
    },
    {
      "from": 192.53,
      "to": 194.61,
      "sid": 72,
      "location": 2,
      "content": "我强迫自己慢下来"
    },
    {
      "from": 194.61,
      "to": 198.01,
      "sid": 73,
      "location": 2,
      "content": "确保我现在百分百达到目标"
    },
    {
      "from": 198.01,
      "to": 200.61,
      "sid": 74,
      "location": 2,
      "content": "最初我用的是同样的填字游戏，我在平衡中使用"
    },
    {
      "from": 200.61,
      "to": 202.44,
      "sid": 75,
      "location": 2,
      "content": "中间有一个空隙"
    },
    {
      "from": 202.44,
      "to": 206.68,
      "sid": 76,
      "location": 2,
      "content": "基本上，我在穿越过程中非常努力地集中注意力"
    },
    {
      "from": 206.68,
      "to": 207.92,
      "sid": 77,
      "location": 2,
      "content": "只点击"
    },
    {
      "from": 207.92,
      "to": 211.38,
      "sid": 78,
      "location": 2,
      "content": "如果我百分之百确定中间有黑色"
    },
    {
      "from": 211.38,
      "to": 212.62,
      "sid": 79,
      "location": 2,
      "content": "因为我用黑点"
    },
    {
      "from": 212.62,
      "to": 216.54,
      "sid": 80,
      "location": 2,
      "content": "所以基本上我开始一次又一次地得到100%的QC"
    },
    {
      "from": 216.54,
      "to": 222.76,
      "sid": 81,
      "location": 2,
      "content": "一开始分数下降然后又开始上升"
    },
    {
      "from": 222.94,
      "to": 223.68,
      "sid": 82,
      "location": 2,
      "content": "你知道的"
    },
    {
      "from": 223.68,
      "to": 230.099,
      "sid": 83,
      "location": 2,
      "content": "问题是你需要在一段时间内"
    },
    {
      "from": 230.099,
      "to": 233.09,
      "sid": 84,
      "location": 2,
      "content": "你会得到比你得到的更低的分数"
    },
    {
      "from": 233.09,
      "to": 235.19,
      "sid": 85,
      "location": 2,
      "content": "但那基本上是因为你忘记了"
    },
    {
      "from": 237.709,
      "to": 241.009,
      "sid": 86,
      "location": 2,
      "content": "你还需要明白你应该接近的方式"
    },
    {
      "from": 241.009,
      "to": 247.409,
      "sid": 87,
      "location": 2,
      "content": "轻弹和静态点实际上不是一个平稳的运动，因为这将"
    },
    {
      "from": 247.409,
      "to": 248.909,
      "sid": 88,
      "location": 2,
      "content": "如果你开得很快"
    },
    {
      "from": 248.909,
      "to": 250.249,
      "sid": 89,
      "location": 2,
      "content": "这将是非常非常困难的"
    },
    {
      "from": 250.249,
      "to": 250.629,
      "sid": 90,
      "location": 2,
      "content": "其实"
    },
    {
      "from": 250.629,
      "to": 251.409,
      "sid": 91,
      "location": 2,
      "content": "你知道的"
    },
    {
      "from": 251.409,
      "to": 252.669,
      "sid": 92,
      "location": 2,
      "content": "始终击中目标"
    },
    {
      "from": 252.669,
      "to": 254.079,
      "sid": 93,
      "location": 2,
      "content": "如果你像那样移动"
    },
    {
      "from": 254.079,
      "to": 256.339,
      "sid": 94,
      "location": 2,
      "content": "否则只会让你慢下来"
    },
    {
      "from": 256.339,
      "to": 259.279,
      "sid": 95,
      "location": 2,
      "content": "这个想法是做一个非常快的薄片"
    },
    {
      "from": 259.279,
      "to": 261.579,
      "sid": 96,
      "location": 2,
      "content": "用你的手臂尽可能快"
    },
    {
      "from": 261.74,
      "to": 264.54,
      "sid": 97,
      "location": 2,
      "content": "然后你会在靠近点的地方结束"
    },
    {
      "from": 264.54,
      "to": 265.8,
      "sid": 98,
      "location": 2,
      "content": "甚至可能在点上"
    },
    {
      "from": 265.8,
      "to": 267.23,
      "sid": 99,
      "location": 2,
      "content": "当你一旦变得很好"
    },
    {
      "from": 267.23,
      "to": 271.43,
      "sid": 100,
      "location": 2,
      "content": "然后你知道你必须等待你的大脑意识到你在哪里着陆"
    },
    {
      "from": 271.43,
      "to": 274.31,
      "sid": 101,
      "location": 2,
      "content": "或者根据运动预测你会在哪里着陆"
    },
    {
      "from": 274.31,
      "to": 275.95,
      "sid": 102,
      "location": 2,
      "content": "取决于你有多好"
    },
    {
      "from": 275.95,
      "to": 281.27,
      "sid": 103,
      "location": 2,
      "content": "然后微校正微校正意味着你基本上又吓坏了"
    },
    {
      "from": 281.27,
      "to": 283.13,
      "sid": 104,
      "location": 2,
      "content": "而是在一个非常非常非常小的角度"
    },
    {
      "from": 283.13,
      "to": 284.23,
      "sid": 105,
      "location": 2,
      "content": "所以这不是一部真正的电影"
    },
    {
      "from": 284.23,
      "to": 287.08,
      "sid": 106,
      "location": 2,
      "content": "因为你只是手的一个小动作"
    },
    {
      "from": 287.08,
      "to": 289.04,
      "sid": 107,
      "location": 2,
      "content": "然后你在点上结束"
    },
    {
      "from": 289.04,
      "to": 289.74,
      "sid": 108,
      "location": 2,
      "content": "就是这个意思"
    },
    {
      "from": 289.74,
      "to": 291.16,
      "sid": 109,
      "location": 2,
      "content": "所以你分裂成运动"
    },
    {
      "from": 291.16,
      "to": 293.67,
      "sid": 110,
      "location": 2,
      "content": "但就像一开始"
    },
    {
      "from": 293.67,
      "to": 295.77,
      "sid": 111,
      "location": 2,
      "content": "你可以在薄片上跑得非常快"
    },
    {
      "from": 295.77,
      "to": 297.99,
      "sid": 112,
      "location": 2,
      "content": "但慢慢进行微校正"
    },
    {
      "from": 297.99,
      "to": 300.13,
