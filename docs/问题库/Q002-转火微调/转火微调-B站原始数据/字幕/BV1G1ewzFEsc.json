    },
    {
      "from": 286.87,
      "to": 287.89,
      "sid": 98,
      "location": 2,
      "content": "你就不要开枪",
      "music": 0.0
    },
    {
      "from": 287.89,
      "to": 288.93,
      "sid": 99,
      "location": 2,
      "content": "然后慢下来",
      "music": 0.0
    },
    {
      "from": 288.93,
      "to": 290.93,
      "sid": 100,
      "location": 2,
      "content": "准心对准他的头再开枪",
      "music": 0.0
    },
    {
      "from": 290.93,
      "to": 293.03,
      "sid": 101,
      "location": 2,
      "content": "这就是一个微调",
      "music": 0.0
    },
    {
      "from": 294.62,
      "to": 297.24,
      "sid": 102,
      "location": 2,
      "content": "那平时练习就是可以这样练油快",
      "music": 0.0
    },
    {
      "from": 297.24,
      "to": 298.96,
      "sid": 103,
      "location": 2,
      "content": "然后确认在他头上了",
      "music": 0.0
    },
    {
      "from": 298.96,
      "to": 299.38,
      "sid": 104,
      "location": 2,
      "content": "没",
      "music": 0.0
    },
    {
      "from": 299.38,
      "to": 299.78,
      "sid": 105,
      "location": 2,
      "content": "在他头上",
      "music": 0.0
    },
    {
      "from": 299.78,
      "to": 300.82,
      "sid": 106,
      "location": 2,
      "content": "你就调整一下",
      "music": 0.0
    },
    {
      "from": 300.82,
      "to": 301.54,
      "sid": 107,
      "location": 2,
      "content": "调整一下手部",
      "music": 0.0
    },
    {
      "from": 301.54,
      "to": 303.15,
      "sid": 108,
