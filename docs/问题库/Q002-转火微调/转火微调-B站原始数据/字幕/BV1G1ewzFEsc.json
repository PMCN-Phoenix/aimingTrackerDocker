{
  "bvid": "BV1G1ewzFEsc",
  "status": "ok lang=ai-zh",
  "segments": [
    {
      "from": 0.0,
      "to": 2.0,
      "sid": 1,
      "location": 2,
      "content": "还剩一人",
      "music": 0.0
    },
    {
      "from": 4.8,
      "to": 9.36,
      "sid": 2,
      "location": 2,
      "content": "我看着一打一打一击制敌人",
      "music": 0.0
    },
    {
      "from": 10.08,
      "to": 12.64,
      "sid": 3,
      "location": 2,
      "content": "在瞄准中",
      "music": 0.0
    },
    {
      "from": 12.64,
      "to": 15.18,
      "sid": 4,
      "location": 2,
      "content": "疫苗与微调是缺一不可的",
      "music": 0.0
    },
    {
      "from": 15.18,
      "to": 17.76,
      "sid": 5,
      "location": 2,
      "content": "上次我的育苗教学广受大家好评",
      "music": 0.0
    },
    {
      "from": 17.76,
      "to": 18.92,
      "sid": 6,
      "location": 2,
      "content": "说我讲的细节",
      "music": 0.0
    },
    {
      "from": 18.92,
      "to": 21.74,
      "sid": 7,
      "location": 2,
      "content": "那么这次我将展开来讲一讲什么是微调",
      "music": 0.0
    },
    {
      "from": 21.74,
      "to": 23.18,
      "sid": 8,
      "location": 2,
      "content": "微调需要注意什么",
      "music": 0.0
    },
    {
      "from": 23.18,
      "to": 25.07,
      "sid": 9,
      "location": 2,
      "content": "应该如何正确做出微调",
      "music": 0.0
    },
    {
      "from": 25.07,
      "to": 26.01,
      "sid": 10,
      "location": 2,
      "content": "我是四七",
      "music": 0.0
    },
    {
      "from": 26.01,
      "to": 29.259,
      "sid": 11,
      "location": 2,
      "content": "希望我的微调教学能让你领悟到苗子的真谛",
      "music": 0.0
    },
    {
      "from": 29.259,
      "to": 31.419,
      "sid": 12,
      "location": 2,
      "content": "我将把微调分为两个部分讲",
      "music": 0.0
    },
    {
      "from": 31.419,
      "to": 34.57,
      "sid": 13,
      "location": 2,
      "content": "第一部分是训练场练习感受微调",
      "music": 0.0
    },
    {
      "from": 34.57,
      "to": 36.63,
      "sid": 14,
      "location": 2,
      "content": "第二部分是实战微调",
      "music": 0.0
    },
    {
      "from": 36.63,
      "to": 40.98,
      "sid": 15,
      "location": 2,
      "content": "微调是建立在你有充足的疫苗情况下进行的",
      "music": 0.0
    },
    {
      "from": 41.38,
      "to": 43.38,
      "sid": 16,
      "location": 2,
      "content": "首先练习场的微调",
      "music": 0.0
    },
    {
      "from": 43.38,
      "to": 44.82,
      "sid": 17,
      "location": 2,
      "content": "我会讲到移动微调",
      "music": 0.0
    },
    {
      "from": 44.82,
      "to": 47.739,
      "sid": 18,
      "location": 2,
      "content": "手部微调和一个预判性的微调",
      "music": 0.0
    },
    {
      "from": 47.739,
      "to": 51.739,
      "sid": 19,
      "location": 2,
      "content": "那么接下来我们就进入练习场来仔细的讲一讲",
      "music": 0.0
    },
    {
      "from": 51.739,
      "to": 55.299,
      "sid": 20,
      "location": 2,
      "content": "这三种微调该如何结合到一起",
      "music": 0.0
    },
    {
      "from": 62.32,
      "to": 67.02,
      "sid": 21,
      "location": 2,
      "content": "微调是建立在你有充足的疫苗情况下进行的",
      "music": 0.0
    },
    {
      "from": 67.02,
      "to": 71.31,
      "sid": 22,
      "location": 2,
      "content": "首先在练习场中需要先感受你自身手腕的发力",
      "music": 0.0
    },
    {
      "from": 71.31,
      "to": 73.01,
      "sid": 23,
      "location": 2,
      "content": "每个人的鼠标灵敏度不同",
      "music": 0.0
    },
    {
      "from": 73.01,
      "to": 74.91,
      "sid": 24,
      "location": 2,
      "content": "手腕的发力大小也不同",
      "music": 0.0
    },
    {
      "from": 74.91,
      "to": 77.57,
      "sid": 25,
      "location": 2,
      "content": "那么微调有很多种方式",
      "music": 0.0
    },
    {
      "from": 77.57,
      "to": 79.21,
      "sid": 26,
      "location": 2,
      "content": "一种是你的手不动",
      "music": 0.0
    },
    {
      "from": 79.21,
      "to": 79.93,
      "sid": 27,
      "location": 2,
      "content": "手不动",
      "music": 0.0
    },
    {
      "from": 79.93,
      "to": 81.11,
      "sid": 28,
      "location": 2,
      "content": "用你的身体去动",
      "music": 0.0
    },
    {
      "from": 81.11,
      "to": 83.78,
      "sid": 29,
      "location": 2,
      "content": "这就是移动移动的微调",
      "music": 0.0
    },
    {
      "from": 84.02,
      "to": 86.16,
      "sid": 30,
      "location": 2,
      "content": "当你的身体动了你的准心",
      "music": 0.0
    },
    {
      "from": 86.16,
      "to": 88.46,
      "sid": 31,
      "location": 2,
      "content": "哎你的画面也会跟着一起动",
      "music": 0.0
    },
    {
      "from": 88.46,
      "to": 91.52,
      "sid": 32,
      "location": 2,
      "content": "然后你看现在我的手是不动的",
      "music": 0.0
    },
    {
      "from": 91.52,
      "to": 93.06,
      "sid": 33,
      "location": 2,
      "content": "然后我就ADAD",
      "music": 0.0
    },
    {
      "from": 93.06,
      "to": 97.5,
      "sid": 34,
      "location": 2,
      "content": "我的准心就在这个头的左右两边在动啊",
      "music": 0.0
    },
    {
      "from": 97.5,
      "to": 99.4,
      "sid": 35,
      "location": 2,
      "content": "我A稍微再按一下A",
      "music": 0.0
    },
    {
      "from": 99.4,
      "to": 103.05,
      "sid": 36,
      "location": 2,
      "content": "这个时候这个整形就对准这个机器人的头",
      "music": 0.0
    },
    {
      "from": 103.05,
      "to": 106.13,
      "sid": 37,
      "location": 2,
      "content": "这个微调方式叫做移动微调",
      "music": 0.0
    },
    {
      "from": 106.59,
      "to": 108.29,
      "sid": 38,
      "location": 2,
      "content": "那么手部微调是什么呢",
      "music": 0.0
    },
    {
      "from": 108.29,
      "to": 111.31,
      "sid": 39,
      "location": 2,
      "content": "手部微调就是你的人是不动的啊",
      "music": 0.0
    },
    {
      "from": 111.31,
      "to": 113.84,
      "sid": 40,
      "location": 2,
      "content": "然后用你的手去瞄他的头",
      "music": 0.0
    },
    {
      "from": 113.84,
      "to": 116.82,
      "sid": 41,
      "location": 2,
      "content": "在他头附近的时候慢慢的调整到他头上",
      "music": 0.0
    },
    {
      "from": 118.02,
      "to": 120.02,
      "sid": 42,
      "location": 2,
      "content": "这种叫手部微调",
      "music": 0.0
    },
    {
      "from": 120.61,
      "to": 122.41,
      "sid": 43,
      "location": 2,
      "content": "还有一种是预判性微调",
      "music": 0.0
    },
    {
      "from": 122.41,
      "to": 126.56,
      "sid": 44,
      "location": 2,
      "content": "预判性微调就是要结合实战实战里",
      "music": 0.0
    },
    {
      "from": 126.56,
      "to": 130.96,
      "sid": 45,
      "location": 2,
      "content": "实战里面那些人都是会不规律的移动对吧",
      "music": 0.0
    },
    {
      "from": 130.96,
      "to": 132.76,
      "sid": 46,
      "location": 2,
      "content": "如果分段低一点呢",
      "music": 0.0
    },
    {
      "from": 132.76,
      "to": 135.66,
      "sid": 47,
      "location": 2,
      "content": "他就是可能就是左右这样摆摆动",
      "music": 0.0
    },
    {
      "from": 135.66,
      "to": 140.55,
      "sid": 48,
      "location": 2,
      "content": "然后先把机器人变成移动的机器人",
      "music": 0.0
    },
    {
      "from": 140.67,
      "to": 142.93,
      "sid": 49,
      "location": 2,
      "content": "这个时候你看这机器人是移动的",
      "music": 0.0
    },
    {
      "from": 142.93,
      "to": 145.41,
      "sid": 50,
      "location": 2,
      "content": "那这个时候你就要有一种预判性的微调",
      "music": 0.0
    },
    {
      "from": 145.41,
      "to": 149.01,
      "sid": 51,
      "location": 2,
      "content": "你不能完全的去把准星调整到他头上",
      "music": 0.0
    },
    {
      "from": 149.01,
      "to": 150.21,
      "sid": 52,
      "location": 2,
      "content": "那这个时候他又移动了",
      "music": 0.0
    },
    {
      "from": 150.21,
      "to": 151.25,
      "sid": 53,
      "location": 2,
      "content": "那你开枪",
      "music": 0.0
    },
    {
      "from": 151.25,
      "to": 153.55,
      "sid": 54,
      "location": 2,
      "content": "你开枪的那一发子弹就是不准的",
      "music": 0.0
    },
    {
      "from": 153.55,
      "to": 155.97,
      "sid": 55,
      "location": 2,
      "content": "你可以稍微等他过来对吧",
      "music": 0.0
    },
    {
      "from": 155.97,
      "to": 158.75,
      "sid": 56,
      "location": 2,
      "content": "预判一下他过来的量",
      "music": 0.0
    },
    {
      "from": 159.43,
      "to": 160.45,
      "sid": 57,
      "location": 2,
      "content": "等他过来",
      "music": 0.0
    },
    {
      "from": 160.45,
      "to": 162.65,
      "sid": 58,
      "location": 2,
      "content": "就这种就是预判性的微调",
      "music": 0.0
    },
    {
      "from": 162.65,
      "to": 164.09,
      "sid": 59,
      "location": 2,
      "content": "你可以调整到他头旁边",
      "music": 0.0
    },
    {
      "from": 164.09,
      "to": 165.95,
      "sid": 60,
      "location": 2,
      "content": "然后等他移动过来的一瞬间",
      "music": 0.0
    },
    {
      "from": 165.95,
      "to": 168.23,
      "sid": 61,
      "location": 2,
      "content": "那样开枪去打",
      "music": 0.0
    },
    {
      "from": 168.54,
      "to": 171.9,
      "sid": 62,
      "location": 2,
      "content": "就从中间截断他的移动",
      "music": 0.0
    },
    {
      "from": 176.0,
      "to": 178.63,
      "sid": 63,
      "location": 2,
      "content": "嗯大概就是这样这个意思",
      "music": 0.0
    },
    {
      "from": 178.63,
      "to": 179.63,
      "sid": 64,
      "location": 2,
      "content": "那在实战里",
      "music": 0.0
    },
    {
      "from": 179.63,
      "to": 184.27,
      "sid": 65,
      "location": 2,
      "content": "你不可能说单一的就把这种啊移动的微调",
      "music": 0.0
    },
    {
      "from": 184.27,
      "to": 185.47,
      "sid": 66,
      "location": 2,
      "content": "用手部的微调",
      "music": 0.0
    },
    {
      "from": 185.47,
      "to": 188.59,
      "sid": 67,
      "location": 2,
      "content": "还有预判性的这种微调分开来操作",
      "music": 0.0
    },
    {
      "from": 188.59,
      "to": 191.57,
      "sid": 68,
      "location": 2,
      "content": "你应该把这三三样给结合在一起",
      "music": 0.0
    },
    {
      "from": 191.57,
      "to": 196.22,
      "sid": 69,
      "location": 2,
      "content": "在实战中你可以啊利用移动加上你的鼠标定位",
      "music": 0.0
    },
    {
      "from": 196.22,
      "to": 201.18,
      "sid": 70,
      "location": 2,
      "content": "加上你的手部预判性的微调去控制你",
      "music": 0.0
    },
    {
      "from": 201.54,
      "to": 204.74,
      "sid": 71,
      "location": 2,
      "content": "提升你自己的一个微调的能力",
      "music": 0.0
    },
    {
      "from": 209.82,
      "to": 213.18,
      "sid": 72,
      "location": 2,
      "content": "啊一开始练微调可以怎么练呢",
      "music": 0.0
    },
    {
      "from": 214.35,
      "to": 219.11,
      "sid": 73,
      "location": 2,
      "content": "你看另外条可以先把机器人变成固定靶",
      "music": 0.0
    },
    {
      "from": 220.66,
      "to": 222.26,
      "sid": 74,
      "location": 2,
      "content": "把机器人变固定吧",
      "music": 0.0
    },
    {
      "from": 222.26,
      "to": 223.94,
      "sid": 75,
      "location": 2,
      "content": "然后准心",
      "music": 0.0
    },
    {
      "from": 224.43,
      "to": 226.75,
      "sid": 76,
      "location": 2,
      "content": "如果你的准心离敌人很远",
      "music": 0.0
    },
    {
      "from": 226.75,
      "to": 229.87,
      "sid": 77,
      "location": 2,
      "content": "我的我的操作是先用手腕啊",
      "music": 0.0
    },
    {
      "from": 229.87,
      "to": 235.47,
      "sid": 78,
      "location": 2,
      "content": "我的我的操作是用先用手臂去移动手臂",
      "music": 0.0
    },
    {
      "from": 235.47,
      "to": 236.35,
      "sid": 79,
      "location": 2,
      "content": "去移动鼠标",
      "music": 0.0
    },
    {
      "from": 236.35,
      "to": 240.15,
      "sid": 80,
      "location": 2,
      "content": "移动到这个机器人旁边头部大概的位置",
      "music": 0.0
    },
    {
      "from": 240.15,
      "to": 243.94,
      "sid": 81,
      "location": 2,
      "content": "再用手腕再用手腕去进行一个微调",
      "music": 0.0
    },
    {
      "from": 243.94,
      "to": 247.4,
      "sid": 82,
      "location": 2,
      "content": "就用手腕去去瞄准他的头部",
      "music": 0.0
    },
    {
      "from": 247.4,
      "to": 249.14,
      "sid": 83,
      "location": 2,
      "content": "就比如我现在准星在他头",
      "music": 0.0
    },
    {
      "from": 249.14,
      "to": 250.46,
      "sid": 84,
      "location": 2,
      "content": "左边一点或者右边一点",
      "music": 0.0
    },
    {
      "from": 250.46,
      "to": 253.46,
      "sid": 85,
      "location": 2,
      "content": "那我就用手腕手腕稍微动一下",
      "music": 0.0
    },
    {
      "from": 253.46,
      "to": 254.46,
      "sid": 86,
      "location": 2,
      "content": "往左边动一下",
      "music": 0.0
    },
    {
      "from": 254.46,
      "to": 257.38,
      "sid": 87,
      "location": 2,
      "content": "然后这个时候就瞄准他的头上了",
      "music": 0.0
    },
    {
      "from": 257.74,
      "to": 260.78,
      "sid": 88,
      "location": 2,
      "content": "这就是一种这就是微调",
      "music": 0.0
    },
    {
      "from": 265.84,
      "to": 267.82,
      "sid": 89,
      "location": 2,
      "content": "先由快到慢",
      "music": 0.0
    },
    {
      "from": 267.82,
      "to": 269.16,
      "sid": 90,
      "location": 2,
      "content": "就是微调的操作",
      "music": 0.0
    },
    {
      "from": 269.16,
      "to": 272.3,
      "sid": 91,
      "location": 2,
      "content": "就是先移动快的移动到他头旁边",
      "music": 0.0
    },
    {
      "from": 272.3,
      "to": 276.36,
      "sid": 92,
      "location": 2,
      "content": "然后再慢下来就快慢开枪了",
      "music": 0.0
    },
    {
      "from": 276.36,
      "to": 278.98,
      "sid": 93,
      "location": 2,
      "content": "再我再做的明显一点啊",
      "music": 0.0
    },
    {
      "from": 278.98,
      "to": 282.71,
      "sid": 94,
      "location": 2,
      "content": "快快就是说移到他头旁边要快",
      "music": 0.0
    },
    {
      "from": 282.71,
      "to": 284.43,
      "sid": 95,
      "location": 2,
      "content": "你在他头旁边之后",
      "music": 0.0
    },
    {
      "from": 284.43,
      "to": 285.73,
      "sid": 96,
      "location": 2,
      "content": "然后慢下来",
